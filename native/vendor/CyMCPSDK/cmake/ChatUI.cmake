if(NOT CYMCP_BUILD_AI)
  message(FATAL_ERROR "ChatUI requires CYMCP_BUILD_AI")
endif()
if(NOT TARGET CyUI::DocumentViews)
  if(NOT EXISTS "${CYMCP_CYUI_SOURCE_DIR}/CMakeLists.txt")
    message(FATAL_ERROR "Set CYMCP_CYUI_SOURCE_DIR to the CyUI checkout, or add CyUI::DocumentViews first")
  endif()
  # Function scope keeps these selective options out of the host's other modules.
  function(cymcp_add_cyui)
    set(CYUI_BUILD_DEMO OFF)
    set(CYUI_BUILD_AUDIO OFF)
    set(CYUI_BUILD_GALLERY OFF)
    set(CYUI_BUILD_TESTS OFF)
    set(CYUI_BUILD_WEB_CEF OFF)
    set(CYUI_MODULES DocumentViews)
    if(CYMCP_BUILD_CHAT_APP)
      list(APPEND CYUI_MODULES DocumentIO)
    endif()
    add_subdirectory("${CYMCP_CYUI_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/cyui" EXCLUDE_FROM_ALL)
  endfunction()
  cymcp_add_cyui()
endif()
cymcp_module(cymcp_chat_ui ChatUI src/chat_controller.cpp src/chat_panel.cpp)
target_link_libraries(cymcp_chat_ui PUBLIC CyMCP::AI $<BUILD_INTERFACE:CyUI::DocumentViews>)
# CyUI is supplied by the consuming host and has no install/export package yet.
# The package config attaches its existing target when ChatUI is requested.
# Separate component: the SDK umbrella and ordinary installed consumers stay GUI-free.
install(TARGETS cymcp_chat_ui EXPORT CyMCPSDKChatUITargets ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
install(EXPORT CyMCPSDKChatUITargets NAMESPACE CyMCP:: DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/CyMCPSDK)
if(CYMCP_BUILD_CHAT_APP)
  if(NOT CYMCP_BUILD_MCP)
    message(FATAL_ERROR "The example app requires CYMCP_BUILD_MCP for bidirectional command tests")
  endif()
  if(NOT WIN32)
    message(FATAL_ERROR "The example chat application uses Win32/DX11. ChatUI itself uses the host's portable ImGui backend.")
  endif()
  if(NOT TARGET CyUI::DocumentIO)
    message(FATAL_ERROR "The Windows chat application requires the CyUI DocumentIO module for rich clipboard paste.")
  endif()
  set(CYMCP_IMGUI_BACKEND_DIR "" CACHE PATH "Dear ImGui backends folder for the Windows chat example")
  if(NOT CYMCP_IMGUI_BACKEND_DIR)
    set(CYMCP_IMGUI_BACKEND_DIR "${CYMCP_CYUI_SOURCE_DIR}/third_party/imgui/backends")
  endif()
  if(NOT EXISTS "${CYMCP_IMGUI_BACKEND_DIR}/imgui_impl_dx11.cpp")
    message(FATAL_ERROR "Set CYMCP_IMGUI_BACKEND_DIR to the host's Dear ImGui backends directory")
  endif()
  add_executable(cymcp_chat_app WIN32 examples/chat_app/main.cpp
    "${CYMCP_IMGUI_BACKEND_DIR}/imgui_impl_win32.cpp"
    "${CYMCP_IMGUI_BACKEND_DIR}/imgui_impl_dx11.cpp")
  target_include_directories(cymcp_chat_app PRIVATE "${CYMCP_IMGUI_BACKEND_DIR}")
  target_link_libraries(cymcp_chat_app PRIVATE CyMCP::ChatUI CyMCP::MCP CyUI::DocumentIO d3d11 dxgi d3dcompiler
    dwmapi comdlg32 shell32 shlwapi ole32 windowscodecs)
  if(TARGET CyMCP::Local)
    target_link_libraries(cymcp_chat_app PRIVATE CyMCP::Local)
    target_compile_definitions(cymcp_chat_app PRIVATE CYMCP_CHAT_HAS_LOCAL=1)
  endif()
  target_compile_definitions(cymcp_chat_app PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN UNICODE _UNICODE)
  target_compile_options(cymcp_chat_app PRIVATE $<$<CXX_COMPILER_ID:MSVC>:/utf-8>)
  install(TARGETS cymcp_chat_app RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
  install(DIRECTORY Documentation DESTINATION ${CMAKE_INSTALL_BINDIR})
  if(CYMCP_CYUI_SOURCE_DIR)
    foreach(notice LICENSE THIRD_PARTY_NOTICES.md third_party/imgui/LICENSE.txt third_party/md4c/LICENSE.md
        third_party/lexilla/License.txt third_party/scintilla/License.txt
        third_party/SciTE-Properties-License.txt third_party/jetbrains-mono/OFL.txt third_party/miniz/LICENSE)
      if(EXISTS "${CYMCP_CYUI_SOURCE_DIR}/${notice}")
        string(REPLACE "/" "-" notice_name "${notice}")
        install(FILES "${CYMCP_CYUI_SOURCE_DIR}/${notice}"
          DESTINATION ${CMAKE_INSTALL_DATADIR}/CyMCPSDK/licenses RENAME "CyUI-${notice_name}")
      endif()
    endforeach()
  endif()
  install(FILES examples/chat_app/stb-MIT.txt DESTINATION ${CMAKE_INSTALL_DATADIR}/CyMCPSDK/licenses)
endif()
if(CYMCP_BUILD_TESTS)
  add_executable(cymcp_chat_ui_tests tests/chat_ui_tests.cpp)
  target_link_libraries(cymcp_chat_ui_tests PRIVATE CyMCP::ChatUI)
  if(CYMCP_BUILD_CHAT_APP)
    target_compile_definitions(cymcp_chat_ui_tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN CYMCP_CHAT_TEST_WIN32_CLIPBOARD)
    target_link_libraries(cymcp_chat_ui_tests PRIVATE CyUI::DocumentIO ole32 shell32 windowscodecs)
  endif()
  target_compile_options(cymcp_chat_ui_tests PRIVATE $<$<CXX_COMPILER_ID:MSVC>:/utf-8>)
  add_test(NAME chat_ui COMMAND cymcp_chat_ui_tests)
  set_tests_properties(chat_ui PROPERTIES TIMEOUT 60)
  if(CYMCP_BUILD_CHAT_APP)
    add_executable(cymcp_chat_workspace_tests tests/chat_workspace_tests.cpp)
    target_link_libraries(cymcp_chat_workspace_tests PRIVATE CyMCP::ChatUI)
    target_compile_options(cymcp_chat_workspace_tests PRIVATE $<$<CXX_COMPILER_ID:MSVC>:/utf-8>)
    add_test(NAME chat_workspace COMMAND cymcp_chat_workspace_tests)
    set_tests_properties(chat_workspace PROPERTIES TIMEOUT 30)
    add_test(NAME chat_app_smoke COMMAND cymcp_chat_app --smoke --capture "${CMAKE_CURRENT_BINARY_DIR}/chat-smoke.png")
    set_tests_properties(chat_app_smoke PROPERTIES TIMEOUT 45)
    add_test(NAME chat_app_smoke_fr COMMAND cymcp_chat_app --smoke --language fr --capture "${CMAKE_CURRENT_BINARY_DIR}/chat-smoke-fr.png")
    set_tests_properties(chat_app_smoke_fr PROPERTIES TIMEOUT 45)
    add_executable(cymcp_chat_app_tests tests/chat_app_tests.cpp)
    target_include_directories(cymcp_chat_app_tests SYSTEM PRIVATE third_party/httplib)
    target_link_libraries(cymcp_chat_app_tests PRIVATE CyMCP::MCP shlwapi)
    target_compile_definitions(cymcp_chat_app_tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_compile_options(cymcp_chat_app_tests PRIVATE $<$<CXX_COMPILER_ID:MSVC>:/utf-8>)
    add_test(NAME chat_app_bidirectional COMMAND cymcp_chat_app_tests
      $<TARGET_FILE:cymcp_chat_app> $<TARGET_FILE:cymcp_fixture>
      "${CMAKE_CURRENT_SOURCE_DIR}/assets/screenshots/providers-en.png")
    set_tests_properties(chat_app_bidirectional PROPERTIES TIMEOUT 90)
  endif()
endif()
