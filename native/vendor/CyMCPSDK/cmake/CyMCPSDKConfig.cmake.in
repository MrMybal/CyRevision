@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@CYMCP_BUILD_HTTP@ AND NOT WIN32)
  find_dependency(CURL)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CyMCPSDKTargets.cmake")
foreach(component IN LISTS CyMCPSDK_FIND_COMPONENTS)
  if(component STREQUAL "ChatUI")
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/CyMCPSDKChatUITargets.cmake" AND TARGET CyUI::DocumentViews)
      include("${CMAKE_CURRENT_LIST_DIR}/CyMCPSDKChatUITargets.cmake")
      set_property(TARGET CyMCP::ChatUI APPEND PROPERTY INTERFACE_LINK_LIBRARIES CyUI::DocumentViews)
      set(CyMCPSDK_ChatUI_FOUND TRUE)
    else()
      set(CyMCPSDK_ChatUI_FOUND FALSE)
      set(CyMCPSDK_NOT_FOUND_MESSAGE "ChatUI requires a UI-enabled SDK build and the host's CyUI::DocumentViews target; add CyUI before find_package(CyMCPSDK COMPONENTS ChatUI).")
    endif()
  elseif(TARGET CyMCP::${component})
    set(CyMCPSDK_${component}_FOUND TRUE)
  else()
    set(CyMCPSDK_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(CyMCPSDK)
