[CyRevision]
ExecutablePath=C:/Tools/CyRevision/CyRevision.Desktop.exe

; Nom visible dans les réservations souples. Par défaut : utilisateur du système.
AdvisoryDisplayName=Prénom

; Une réservation est renouvelée chaque minute tant que l'éditeur reste ouvert.
; Elle expire automatiquement après cette durée si l'éditeur s'arrête ou perd le partage.
AdvisoryExpirationMinutes=30
