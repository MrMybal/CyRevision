<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <VersionPrefix>0.1.25</VersionPrefix>
    <Product>CyRevision</Product>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <NuGetAudit Condition="'$(CI)' != 'true'">false</NuGetAudit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Neutralize compiler source locations, including CallerFilePath strings. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
  </PropertyGroup>
</Project>
