<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:CyRevision.Desktop.Controls"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        x:Class="CyRevision.Desktop.MainWindow"
        Title="CyRevision Alpha"
        Icon="/Assets/Branding/cyrevision-icon-master.png"
        Width="1480"
        Height="900"
        MinWidth="1024"
        MinHeight="680"
        x:CompileBindings="False"
        Background="#1E1F22">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#3574F0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#393B40" />
            <Setter Property="Foreground" Value="#DFE1E5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#4A2930" />
            <Setter Property="Foreground" Value="#FF9BAB" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="9,5" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="27" />
        </Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#9B9DA3" /></Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#26282B" />
            <Setter Property="BorderBrush" Value="#393B40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#1E1F22" />
            <Setter Property="BorderBrush" Value="#4B4D52" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="27" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="7,3" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Height" Value="27" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style Selector="CheckBox"><Setter Property="FontSize" Value="11.5" /></Style>
        <Style Selector="ToggleButton.panelToggle">
            <Setter Property="Background" Value="#1E1F22" />
            <Setter Property="Foreground" Value="#AFB1B7" />
            <Setter Property="BorderBrush" Value="#4B4D52" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style Selector="ToggleButton.panelToggle:checked">
            <Setter Property="Background" Value="#203D50" />
            <Setter Property="Foreground" Value="#7DE2CC" />
            <Setter Property="BorderBrush" Value="#3BAA96" />
        </Style>
        <Style Selector="ToggleButton.layoutChoice">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#AFB1B7" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style Selector="ToggleButton.layoutChoice:pointerover">
            <Setter Property="Background" Value="#34363A" />
            <Setter Property="Foreground" Value="#F2F3F5" />
        </Style>
        <Style Selector="ToggleButton.layoutChoice:checked">
            <Setter Property="Background" Value="#34363A" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="BorderBrush" Value="#6C7078" />
        </Style>
        <Style Selector="ToggleButton.workspaceCategory">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A9ABB2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,6,12,5" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ToggleButton.workspaceCategory:pointerover">
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="Background" Value="#2B2D30" />
        </Style>
        <Style Selector="ToggleButton.workspaceCategory:checked">
            <Setter Property="Foreground" Value="#7DE2CC" />
            <Setter Property="BorderBrush" Value="#4EC9B0" />
            <Setter Property="Background" Value="#26282B" />
        </Style>
        <Style Selector="Menu.topMenu">
            <Setter Property="Background" Value="#242529" />
            <Setter Property="Foreground" Value="#DFE1E5" />
            <Setter Property="Padding" Value="7,0" />
        </Style>
        <Style Selector="Menu.topMenu MenuItem">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="9,4" />
        </Style>
        <Style Selector="Menu.topMenu MenuItem:pointerover">
            <Setter Property="Background" Value="#393B40" />
        </Style>
        <Style Selector="TreeView.compactTree TreeViewItem">
            <Setter Property="MinHeight" Value="23" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style Selector="DataGrid.historyCompact DataGridRow">
            <Setter Property="MinHeight" Value="25" />
        </Style>
        <Style Selector="DataGrid.historyCompact DataGridCell">
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style Selector="DataGrid.historyCompact DataGridColumnHeader">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="9.5" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="28,48,*,26" ColumnDefinitions="204,*">
        <Menu Grid.Row="0" Grid.ColumnSpan="2" Classes="topMenu">
            <MenuItem Header="File">
                <MenuItem Header="Add folder..." HotKey="Ctrl+Shift+O" Click="OnAddFolderClick" />
                <MenuItem Header="Open repository..." HotKey="Ctrl+O" Click="OnAddExistingClick" />
                <MenuItem Header="Create repository..." HotKey="Ctrl+N" Click="OnCreateGitClick" />
                <Separator />
                <MenuItem Header="Remove selected project" IsEnabled="{Binding HasSelectedProject}" Click="OnRemoveProjectClick" />
                <Separator />
                <MenuItem Header="Exit" HotKey="Ctrl+Q" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Find in files..." Click="OnOpenGlobalSearchClick" />
                <Separator />
                <MenuItem Header="Refresh project" HotKey="F5" IsEnabled="{Binding HasSelectedProject}" Click="OnRefreshClick" />
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Project overview" Click="OnShowProjectWorkspaceClick" />
                <MenuItem Header="Changes" Click="OnShowChangesWorkspaceClick" />
                <MenuItem Header="Code explorer" Click="OnShowCodeWorkspaceClick" />
                <MenuItem Header="Repository console &amp; logs" Click="OnShowConsoleWorkspaceClick" />
                <MenuItem Header="History" Click="OnShowHistoryWorkspaceClick" />
                <MenuItem Header="Git graphs" Click="OnShowGitGraphsWorkspaceClick" />
                <Separator />
                <MenuItem Header="Open detached workspace">
                    <MenuItem Header="History explorer" Click="OnOpenDetachedHistoryClick" />
                    <MenuItem Header="Code explorer" Click="OnOpenDetachedCodeClick" />
                    <MenuItem Header="Multi restore" Click="OnOpenDetachedMultiRestoreClick" />
                    <MenuItem Header="Branch compare &amp; cherry-pick" Click="OnOpenDetachedCherryPickClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Workspace layout">
                    <MenuItem Header="Save current layout" Click="OnSaveWorkspaceLayoutClick" />
                    <MenuItem Header="Reset layout" Click="OnResetWorkspaceLayoutClick" />
                    <Separator />
                    <MenuItem Header="Changes: Review" Click="OnBalancedChangesLayoutClick" />
                    <MenuItem Header="Changes: Diff focus" Click="OnDiffFocusChangesLayoutClick" />
                    <MenuItem Header="Code: Balanced" Click="OnBalancedCodeLayoutClick" />
                    <MenuItem Header="Code: Editor focus" Click="OnEditorFocusCodeLayoutClick" />
                    <MenuItem Header="Code: Search focus" Click="OnSearchFocusCodeLayoutClick" />
                    <MenuItem Header="History: Columns" Click="OnColumnsHistoryLayoutClick" />
                    <MenuItem Header="History: Review" Click="OnReviewHistoryLayoutClick" />
                    <MenuItem Header="History: Diff focus" Click="OnDiffFocusedHistoryLayoutClick" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Git" IsEnabled="{Binding HasSelectedProject}">
                <MenuItem Header="Refresh" Click="OnRefreshClick" />
                <Separator />
                <MenuItem Header="Stage all" Click="OnStageAllClick" />
                <MenuItem Header="Unstage all" Click="OnUnstageAllClick" />
                <MenuItem Header="Commit changes..." Click="OnShowChangesWorkspaceClick" />
                <Separator />
                <MenuItem Header="Fetch" Click="OnFetchClick" />
                <MenuItem Header="Pull" Click="OnPullClick" />
                <MenuItem Header="Push" Click="OnPushClick" />
                <Separator />
                <MenuItem Header="Branches" Click="OnShowBranchesWorkspaceClick" />
                <MenuItem Header="Commit Explorer window…" Click="OnOpenCommitExplorerWindowClick" />
                <MenuItem Header="Compare branches &amp; cherry-pick" Click="OnShowCherryPickWorkspaceClick" />
                <MenuItem Header="Multi restore composer" Click="OnShowMultiRestoreWorkspaceClick" />
                <MenuItem Header="Pull Requests" Click="OnShowPullRequestsWorkspaceClick" />
                <MenuItem Header="File locks" Click="OnShowLfsLocksWorkspaceClick" />
                <MenuItem Header="Git LFS" Click="OnShowGitLfsWorkspaceClick" />
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Repository console &amp; logs" Click="OnShowConsoleWorkspaceClick" />
                <Separator />
                <MenuItem Header="System integration">
                    <MenuItem x:Name="LaunchAtLoginMenuItem"
                              Header="Launch at system login"
                              ToggleType="CheckBox"
                              Click="OnToggleLaunchAtLoginClick" />
                    <MenuItem x:Name="StartHiddenAtLoginMenuItem"
                              Header="Start hidden in tray"
                              ToggleType="CheckBox"
                              Click="OnToggleStartHiddenAtLoginClick" />
                    <MenuItem x:Name="CloseToTrayMenuItem"
                              Header="Close window to tray"
                              ToggleType="CheckBox"
                              Click="OnToggleCloseToTrayClick" />
                    <MenuItem x:Name="ShowTrayIconMenuItem"
                              Header="Show system tray icon"
                              ToggleType="CheckBox"
                              Click="OnToggleShowTrayIconClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Backups" Click="OnShowBackupsWorkspaceClick" />
                <MenuItem Header="Synchronization" Click="OnShowSynchronizationWorkspaceClick" />
                <Separator />
                <MenuItem Header="WireGuard VPN" Click="OnShowVpnWorkspaceClick" />
                <MenuItem Header="Swarm over VPN" Click="OnShowSwarmWorkspaceClick" />
                <MenuItem Header="VPN files" Click="OnShowVpnFilesWorkspaceClick" />
                <MenuItem Header="Remote builds" Click="OnShowRemoteBuildsWorkspaceClick" />
                <Separator />
                <MenuItem Header="Discord agent" Click="OnShowDiscordWorkspaceClick" />
                <MenuItem Header="AI assistant" Click="OnShowAiWorkspaceClick" />
                <MenuItem Header="MCP" Click="OnShowMcpWorkspaceClick" />
                <MenuItem Header="Plugins" Click="OnShowPluginsWorkspaceClick" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="Offline documentation" Click="OnShowHelpWorkspaceClick" />
                <MenuItem Header="Check for updates" Click="OnCheckForUpdatesClick" />
                <Separator />
                <MenuItem Header="About CyRevision" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#2B2D30" BorderBrush="#393B40" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="190,*,Auto" Margin="10,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="6" ClipToBounds="True" Background="#17191D">
                        <Image Source="/Assets/Branding/cyrevision-icon-master.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="CyRevision" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                    <Border Background="#49381E" BorderBrush="#A8792C" BorderThickness="1"
                            CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                        <TextBlock Text="ALPHA" Foreground="#FFD479" FontSize="8" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding CurrentProjectName}" FontSize="13" FontWeight="Bold" Foreground="#F2F3F5" />
                        <Border Background="#203B38" CornerRadius="4" Padding="7,1">
                            <TextBlock Text="{Binding CurrentBranch}" FontSize="13" FontWeight="Bold" Foreground="#78D7B7" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding RepositoryPath}" FontSize="9.5" Classes="muted" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox Width="112"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NativeName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="secondary" Content="Ajouter un dossier" Click="OnAddFolderClick" />
                    <Button Classes="secondary" Content="Ouvrir un dépôt" Click="OnAddExistingClick" />
                    <Button Classes="primary" Content="Créer un dépôt" Click="OnCreateGitClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="0" Background="#25272A" BorderBrush="#393B40" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Margin="6,8">
                <Grid ColumnDefinitions="*,Auto" Margin="4,0,2,5">
                    <TextBlock Text="PROJECTS" FontSize="9" FontWeight="Bold" Classes="muted" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="danger" Content="Remove" Padding="7,3" MinHeight="23"
                            Click="OnRemoveProjectClick" IsEnabled="{Binding HasSelectedProject}" />
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,3">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1" Background="#242C47" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="{Binding Mode}" FontSize="8.5" Foreground="#B8C1D8" />
                                </Border>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding RootPath}" FontSize="8.5" Classes="muted"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" Margin="0,2,0,1" ColumnSpacing="6">
                                    <TextBlock Text="{Binding BranchName}" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{Binding StatusColor}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding LoadDetail}" FontSize="8" Classes="muted"
                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Grid.Row="3" Grid.ColumnSpan="2" Minimum="0" Maximum="100"
                                             Value="{Binding LoadProgress}" IsVisible="{Binding IsLoading}" Height="2" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Background="#151D31" CornerRadius="6" Padding="8">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#758098" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SyncState}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding SyncDetails}" TextWrapping="Wrap" FontSize="9" Classes="muted" />
                        <TextBlock Text="Personal Syncthing is not managed" FontSize="9" Foreground="#78D7B7" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Grid.Column="1" Margin="10,7" RowDefinitions="Auto,Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding ChangeSummary}" FontSize="21" FontWeight="Bold"
                               Foreground="{Binding ChangeSummaryColor}" />
                    <TextBlock Text="{Binding ToolStatus}" FontSize="9.5" Classes="muted" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Button Classes="secondary" Content="Actualiser" Click="OnRefreshClick" />
                    <Button Classes="secondary" Content="Fetch remotes" Click="OnFetchClick" />
                    <Button Classes="secondary" Content="Pull" Click="OnPullClick" />
                    <Button Classes="primary" Content="Push" Click="OnPushClick" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#242529" BorderBrush="#393B40" BorderThickness="1"
                    CornerRadius="5" Margin="0,0,0,5" Padding="4,0">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="OverviewCategoryToggle" Classes="workspaceCategory" Content="Overview"
                                  Click="OnOverviewCategoryClick" />
                    <ToggleButton x:Name="GitCategoryToggle" Classes="workspaceCategory" Content="Git"
                                  Click="OnGitCategoryClick" />
                    <ToggleButton x:Name="CodeCategoryToggle" Classes="workspaceCategory" Content="Code &amp; Assets"
                                  Click="OnCodeCategoryClick" />
                    <ToggleButton x:Name="NetworkCategoryToggle" Classes="workspaceCategory" Content="Team &amp; Network"
                                  Click="OnNetworkCategoryClick" />
                    <ToggleButton x:Name="ExtensionsCategoryToggle" Classes="workspaceCategory" Content="Extensions &amp; Help"
                                  Click="OnExtensionsCategoryClick" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" IsVisible="{Binding IsLongOperationActive}" Background="#202633"
                    BorderBrush="#35435C" BorderThickness="1" CornerRadius="5" Padding="7,4" Margin="0,0,0,5">
                <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="9">
                    <TextBlock Text="{Binding LongOperationStage}" Foreground="#B8C7E6" FontSize="9.5"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding LongOperationProgress}"
                                 IsIndeterminate="{Binding IsLongOperationIndeterminate}" Height="6" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding CurrentProjectName}" Foreground="#78D7B7"
                               FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TabControl x:Name="WorkspaceTabs" Grid.Row="3">
                <TabItem x:Name="ProjectWorkspaceTab" Header="Projet">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="1.15*,1*" ColumnSpacing="8">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Mode de fonctionnement" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Chaque module reste indépendant : Git peut fonctionner sans Sync et inversement." TextWrapping="Wrap" Classes="muted" />
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Classes="muted" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Classes="primary" Content="Appliquer ce mode" Click="OnApplyPresetClick" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <StackPanel Spacing="9">
                                <TextBlock Text="Profils disponibles" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Git uniquement" FontWeight="SemiBold" />
                                <TextBlock Text="Git + Sync" FontWeight="SemiBold" />
                                <TextBlock Text="Sync uniquement" FontWeight="SemiBold" />
                                <TextBlock Text="Sync + versions" FontWeight="SemiBold" />
                                <TextBlock Text="Backup uniquement" FontWeight="SemiBold" />
                                <Border Height="1" Background="#29324A" Margin="0,7" />
                                <TextBlock Text="Changer de profil ne supprime jamais les données déjà stockées." TextWrapping="Wrap" FontSize="11" Foreground="#78D7B7" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="MembersWorkspaceTab" Header="Members">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="8">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Project members" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ProjectMembersSummary}" Classes="muted" FontSize="10.5" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="secondary" Content="Refresh status"
                                        Click="OnRefreshProjectMembersClick" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="1*,7,1*,7,1*">
                            <Border Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="42,*">
                                    <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Sync identities" FontWeight="SemiBold" />
                                            <TextBlock Text="Authorized devices and live connection state" Classes="muted" FontSize="9" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding SyncProjectMembers}"
                                              AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                              GridLinesVisibility="Horizontal" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="82" />
                                            <DataGridTemplateColumn Header="Status" Width="88">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" />
                                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Identity" Binding="{Binding Identity}" Width="100" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <GridSplitter Grid.Column="1" Width="7" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                          Background="#45484E" Cursor="SizeWestEast" />

                            <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="42,*">
                                    <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Git contributors" FontWeight="SemiBold" />
                                            <TextBlock Text="Authors found in the loaded repository history" Classes="muted" FontSize="9" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding GitProjectMembers}"
                                              AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                              GridLinesVisibility="Horizontal" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Author" Binding="{Binding DisplayName}" Width="*" />
                                            <DataGridTextColumn Header="Activity" Binding="{Binding Status}" Width="84" />
                                            <DataGridTextColumn Header="Last commit" Binding="{Binding LastActivity}" Width="112" />
                                            <DataGridTextColumn Header="Email" Binding="{Binding Identity}" Width="130" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <GridSplitter Grid.Column="3" Width="7" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                          Background="#45484E" Cursor="SizeWestEast" />

                            <Border Grid.Column="4" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="42,*">
                                    <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="VPN peers" FontWeight="SemiBold" />
                                            <TextBlock Text="WireGuard capabilities and handshake state" Classes="muted" FontSize="9" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding VpnProjectMembers}"
                                              AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                              GridLinesVisibility="Horizontal" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Peer" Binding="{Binding DisplayName}" Width="*" />
                                            <DataGridTemplateColumn Header="Status" Width="88">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" />
                                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Address" Binding="{Binding Identity}" Width="100" />
                                            <DataGridTextColumn Header="Capabilities" Binding="{Binding Role}" Width="120" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ChangesWorkspaceTab" Header="Modifications">
                    <Grid x:Name="ChangesWorkspaceGrid" Margin="0,8,0,0"
                          ColumnDefinitions="1.05*,8,1.35*" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                        <Border Grid.ColumnSpan="3" Background="#26282B" BorderBrush="#393B40" BorderThickness="1"
                                CornerRadius="6" Padding="7,5">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Text="LAYOUT" FontSize="9" FontWeight="Bold" Foreground="#7E8189"
                                           VerticalAlignment="Center" Margin="3,0,2,0" />
                                <ToggleButton x:Name="ChangesBalancedLayoutToggle" Grid.Column="1" Classes="layoutChoice"
                                              Content="Review" Click="OnBalancedChangesLayoutClick"
                                              ToolTip.Tip="Balanced file list and diff" />
                                <ToggleButton x:Name="ChangesDiffFocusLayoutToggle" Grid.Column="2" Classes="layoutChoice"
                                              Content="Diff focus" Click="OnDiffFocusChangesLayoutClick"
                                              ToolTip.Tip="Give more space to the diff viewer" />
                                <TextBlock Grid.Column="3" Text="Drag the divider to resize panels. Layout sizes are saved locally."
                                           FontSize="9.5" Classes="muted" VerticalAlignment="Center" Margin="8,0" />
                                <ToggleButton x:Name="ChangesDiffToggle" Grid.Column="4" Classes="layoutChoice" Content="Diff"
                                              Click="OnChangesDiffToggleClick" ToolTip.Tip="Show or hide the inline diff preview" />
                                <Button Grid.Column="5" Classes="secondary" Content="Open diff ↗" Click="OnOpenChangesDiffWindowClick" />
                                <Button Grid.Column="6" Classes="secondary" Content="Save layout" Click="OnSaveWorkspaceLayoutClick" />
                                <Button Grid.Column="7" Classes="secondary" Content="Reset" Click="OnResetWorkspaceLayoutClick" />
                            </Grid>
                        </Border>

                        <Border x:Name="ChangesListPanel" Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True" MinWidth="300">
                            <Grid RowDefinitions="42,28,34,*,32">
                                <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,0">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="5">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Commit editor" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Choose exactly what is committed" Classes="muted" FontSize="8.5" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary" Content="Scan untracked" Click="OnScanAllUntrackedClick" Padding="8,4"
                                                ToolTip.Tip="Expand every untracked folder. This can take time on very large Unreal projects." />
                                        <Button Grid.Column="2" Classes="secondary" Content="Include all" Click="OnIncludeAllChangesClick" Padding="8,4" />
                                        <Button Grid.Column="3" Classes="secondary" Content="Keep all" Click="OnKeepAllChangesClick" Padding="8,4" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Background="#232427" BorderBrush="#34363A" BorderThickness="0,0,0,1" Padding="9,0">
                                    <TextBlock Text="{Binding ChangePreparationSummary}" Classes="muted" FontSize="9"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Border>

                                <Grid Grid.Row="2" ColumnDefinitions="*,112" ColumnSpacing="6" Margin="6,4">
                                    <TextBox Text="{Binding ChangeSearch, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Search files, folders, state, lock owner or area…" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ChangeSortOptions}"
                                              SelectedItem="{Binding ChangeSort}" ToolTip.Tip="Sort change list" />
                                </Grid>

                                <TabControl Grid.Row="3" Padding="0" Background="Transparent">
                                    <TabItem Header="List">
                                        <DataGrid ItemsSource="{Binding FilteredPreparedChanges}" SelectedItem="{Binding SelectedChange}"
                                                  Classes="historyCompact" AutoGenerateColumns="False" IsReadOnly="True"
                                                  GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="31">
                                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  ToolTip.Tip="Include this file in the next commit" />
                                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="File" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                        <Grid RowDefinitions="Auto,Auto" Margin="1,2">
                                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Row="1" Text="{Binding DirectoryPath}" TextTrimming="CharacterEllipsis"
                                                                       Classes="muted" FontSize="8.5" />
                                                        </Grid>
                                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="State" Width="74">
                                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                        <TextBlock Text="{Binding State}" Foreground="{Binding StatusColor}" />
                                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Lock" Width="105">
                                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                        <TextBlock Text="{Binding LockShort}" Foreground="{Binding LockColor}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LockOwner}" />
                                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="78" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>

                                    <TabItem Header="Folders">
                                        <TreeView x:Name="ChangesFolderTree" ItemsSource="{Binding ChangeTree}"
                                                  SelectedItem="{Binding SelectedChangeTreeNode, Mode=TwoWay}"
                                                  SelectionChanged="OnChangeTreeSelectionChanged"
                                                  Classes="compactTree" Background="Transparent" BorderThickness="0" Margin="3">
                                            <TreeView.ItemTemplate>
                                                <TreeDataTemplate ItemsSource="{Binding Children}">
                                                    <Grid ColumnDefinitions="16,20,*,Auto" Height="22" Margin="0" ToolTip.Tip="{Binding RelativePath}">
                                                        <TextBlock Text="{Binding Icon}" Foreground="{Binding AccentColor}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <CheckBox Grid.Column="1" IsVisible="{Binding HasChange}" IsEnabled="{Binding CanInclude}"
                                                                  IsChecked="{Binding Change.IsIncluded, Mode=TwoWay}"
                                                                  VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{Binding AccentColor}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="4,0,2,0">
                                                            <TextBlock Text="{Binding Change.PreparationState}" Foreground="{Binding Change.PreparationColor}" FontSize="8.5" />
                                                            <TextBlock Text="{Binding Change.LockShort}" Foreground="{Binding Change.LockColor}" FontSize="8.5" />
                                                            <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="8" />
                                                        </StackPanel>
                                                    </Grid>
                                                </TreeDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </TabItem>

                                    <TabItem Header="Local only">
                                        <Grid RowDefinitions="Auto,*">
                                            <Border Background="#24262A" Padding="9,6">
                                                <TextBlock Text="Persistent per-project list. These untracked files are never committed; .gitignore is unchanged."
                                                           Classes="muted" FontSize="9" TextWrapping="Wrap" />
                                            </Border>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredLocalOnlyChanges}" SelectedItem="{Binding SelectedChange}"
                                                      Classes="historyCompact" AutoGenerateColumns="False" IsReadOnly="True"
                                                      GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
                                                    <DataGridTextColumn Header="Folder" Binding="{Binding DirectoryPath}" Width="1.4*" />
                                                    <DataGridTextColumn Header="Lock" Binding="{Binding LockShort}" Width="95" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>
                                </TabControl>

                                <Border Grid.Row="4" Background="#232427" BorderBrush="#34363A" BorderThickness="0,1,0,0" Padding="5,2">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="5">
                                        <Button Classes="secondary" Content="Set local" Click="OnSetSelectedChangeLocalClick"
                                                Padding="6,2" MinHeight="22" FontSize="9.5" ToolTip.Tip="Move the selected untracked file to the local-only list" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Restore to list" Click="OnRestoreSelectedLocalChangeClick"
                                                Padding="6,2" MinHeight="22" FontSize="9.5" ToolTip.Tip="Return a local-only file to commit preparation" />
                                        <Button Grid.Column="3" Classes="danger" Content="Rollback…" Click="OnRollbackSelectedChangeClick"
                                                Padding="6,2" MinHeight="22" FontSize="9.5" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <GridSplitter x:Name="ChangesWorkspaceSplitter" Grid.Row="1" Grid.Column="1" Width="8"
                                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                      Background="#4B4D52" Cursor="SizeWestEast" />

                        <Border x:Name="ChangesDiffPanel" Grid.Row="1" Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True" MinWidth="360">
                            <Grid RowDefinitions="42,28,*">
                                <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,0">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Diff preview" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedChange.Path}" Classes="muted" FontSize="8.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedChange.PreparationState}"
                                                   Foreground="{Binding SelectedChange.PreparationColor}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Background="#232427" BorderBrush="#34363A" BorderThickness="0,0,0,1" Padding="9,0">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="9">
                                        <TextBlock Text="{Binding SelectedChange.State}" Foreground="{Binding SelectedChange.StatusColor}" FontSize="9" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedChange.Area}" Classes="muted" FontSize="9" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding SelectedChange.LockOwner}" Foreground="{Binding SelectedChange.LockColor}"
                                                   FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <controls:CodeDiffView Grid.Row="2"
                                                       DiffText="{Binding DiffText}"
                                                       FilePath="{Binding SelectedChange.Path}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="card" Padding="9">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="7">
                                <TextBlock Text="Commit" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ChangePreparationSummary}" Classes="muted" FontSize="9.5"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Row="1" Grid.Column="2" Classes="secondary" Content="Stage selected" Click="OnStageAllClick" />
                                <Button Grid.Row="1" Grid.Column="3" Classes="danger" Content="Rollback selected…" Click="OnRollbackIncludedChangesClick" />
                                <Button Grid.Row="1" Grid.Column="4" Classes="primary" Content="Commit selected" Click="OnCommitClick"
                                        IsEnabled="{Binding CanCommitPreparedChanges}" />
                                <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CommitMessage}"
                                         PlaceholderText="Describe the selected changes…" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="SolutionExplorerWorkspaceTab" Header="Solution Explorer">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,*" RowSpacing="7">
                        <Border Classes="card" Padding="9">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,140,1,Auto,Auto,Auto" ColumnSpacing="7">
                                <TextBox Text="{Binding CodeTreeFilter, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Search files or folders in the project…" />
                                <CheckBox Grid.Column="1" Content="Hidden" IsChecked="{Binding CodeIncludeHidden}"
                                          VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="primary" Content="Refresh" Click="OnRefreshCodeWorkspaceClick" />
                                <TextBlock Grid.Column="3" Text="AUTO" Classes="muted" FontSize="9" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="4" ItemsSource="{Binding CodeAutoRefreshFrequencies}"
                                          SelectedItem="{Binding CodeAutoRefreshFrequency}" />
                                <Border Grid.Column="5" Width="1" Background="#4B4D52" Margin="3,0" />
                                <TextBlock Grid.Column="6" Text="VIEW" Classes="muted" FontSize="9" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <ToggleButton x:Name="SolutionTreeLayoutToggle" Grid.Column="7" Classes="layoutChoice"
                                              Content="Tree" IsChecked="True" Click="OnSolutionTreeLayoutClick" />
                                <ToggleButton x:Name="SolutionListLayoutToggle" Grid.Column="8" Classes="layoutChoice"
                                              Content="List" Click="OnSolutionListLayoutClick" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" IsVisible="{Binding IsCodeWorkspaceLoading}" Background="#202633"
                                BorderBrush="#393B40" BorderThickness="1" CornerRadius="4" Padding="9,5">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock Text="Indexing project files…" Classes="muted" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1" IsIndeterminate="True" Height="5" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" ColumnDefinitions="0.9*,8,1.4*">
                            <Border Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="38,*">
                                    <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Project files" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{Binding CodeWorkspaceSummary}" Classes="muted" FontSize="8.5"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CodeWorkspaceLastUpdatedText}" Foreground="#78D7B7"
                                                           FontSize="8.5" HorizontalAlignment="Right" />
                                                <TextBlock Text="Caches and build outputs excluded" Classes="muted"
                                                           FontSize="8" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TreeView x:Name="SolutionTreePanel" Grid.Row="1" ItemsSource="{Binding CodeTree}"
                                              SelectedItem="{Binding SelectedCodeNode}" Classes="compactTree"
                                              Background="Transparent" BorderThickness="0" Margin="3">
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                                <Grid ColumnDefinitions="22,*,Auto" Margin="1,1" ToolTip.Tip="{Binding RelativePath}">
                                                    <Border Width="18" Height="18" CornerRadius="3" Background="#31343A">
                                                        <TextBlock Text="{Binding Icon}" FontSize="8" FontWeight="Bold"
                                                                   Foreground="{Binding AccentColor}" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding AccentColor}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" FontSize="8.5"
                                                               VerticalAlignment="Center" Margin="4,0" />
                                                </Grid>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>

                                    <DataGrid x:Name="SolutionListPanel" Grid.Row="1" ItemsSource="{Binding CodeFileList}"
                                              SelectedItem="{Binding SelectedCodeNode}" IsVisible="False"
                                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              Background="Transparent" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="190" />
                                            <DataGridTextColumn Header="Path" Binding="{Binding RelativePath}" Width="*" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding Language}" Width="90" />
                                            <DataGridTextColumn Header="Size" Binding="{Binding Detail}" Width="110" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                          Background="#4B4D52" Cursor="SizeWestEast" />

                            <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="42,*">
                                    <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="File preview" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding CodePreviewSummary}" Classes="muted" FontSize="9"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <controls:SyntaxHighlightedCodeView Grid.Row="1" Text="{Binding CodePreviewText}"
                                                                        FilePath="{Binding SelectedCodeNode.RelativePath}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="CodeWorkspaceTab" Header="Code">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="7">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,115,Auto,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                                <TextBox x:Name="GlobalCodeSearch" Text="{Binding CodeSearchQuery}"
                                         PlaceholderText="Search text, symbol, or pattern across the project…"
                                         KeyDown="OnCodeSearchBoxKeyDown" />
                                <TextBox Grid.Column="1" Text="{Binding CodeFilePatterns}"
                                         PlaceholderText="*.cs;*.cpp" ToolTip.Tip="Optional file patterns separated with semicolons" />
                                <Button Grid.Column="2" Classes="primary" Content="Search" Click="OnSearchCodeClick" />
                                <Button Grid.Column="3" Classes="secondary" Content="Cancel" Click="OnCancelCodeSearchClick" />
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="14" Margin="2,7,0,0">
                                    <CheckBox Content="Match case" IsChecked="{Binding CodeSearchMatchCase}" />
                                    <CheckBox Content="Whole words" IsChecked="{Binding CodeSearchWholeWord}" />
                                    <CheckBox Content="Regular expression" IsChecked="{Binding CodeSearchRegex}" />
                                    <TextBlock Text="Ctrl+Shift+F" Foreground="#78D7B7" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CodeSearchSummary}" Classes="muted" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="3,0">
                            <TextBlock Text="{Binding CodeWorkspaceSummary}" FontSize="10.5" Classes="muted" />
                            <TextBlock Grid.Column="1" Text="Heavy build/cache folders are excluded automatically"
                                       FontSize="10.5" Foreground="#78D7B7" />
                        </Grid>

                        <Border Grid.Row="2" Background="#26282B" BorderBrush="#393B40" BorderThickness="1"
                                CornerRadius="6" Padding="7,5">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,1,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Text="LAYOUT" FontSize="9" FontWeight="Bold" Foreground="#7E8189"
                                           VerticalAlignment="Center" Margin="3,0,2,0" />
                                <ToggleButton x:Name="CodeBalancedLayoutToggle" Grid.Column="1" Classes="layoutChoice"
                                              Content="Balanced" Click="OnBalancedCodeLayoutClick" />
                                <ToggleButton x:Name="CodeEditorFocusLayoutToggle" Grid.Column="2" Classes="layoutChoice"
                                              Content="Editor" Click="OnEditorFocusCodeLayoutClick" />
                                <ToggleButton x:Name="CodeSearchFocusLayoutToggle" Grid.Column="3" Classes="layoutChoice"
                                              Content="Search" Click="OnSearchFocusCodeLayoutClick" />
                                <Border Grid.Column="4" Width="1" Height="18" Background="#4B4D52" Margin="4,0" />
                                <TextBlock Grid.Column="5" Text="PANELS" FontSize="9" FontWeight="Bold" Foreground="#7E8189"
                                           VerticalAlignment="Center" />
                                <ToggleButton x:Name="CodeExplorerPanelToggle" Grid.Column="6" Classes="panelToggle"
                                              Content="Explorer" Click="OnCodePanelToggleClick" />
                                <ToggleButton x:Name="CodeSymbolsPanelToggle" Grid.Column="7" Classes="panelToggle"
                                              Content="Symbols" Click="OnCodePanelToggleClick" />
                                <ToggleButton x:Name="CodeResultsPanelToggle" Grid.Column="8" Classes="panelToggle"
                                              Content="Results" Click="OnCodePanelToggleClick" />
                                <TextBlock Grid.Column="9" Text="Drag dividers to resize · workspace is saved locally"
                                           FontSize="9.5" Classes="muted" VerticalAlignment="Center" Margin="8,0" />
                                <Button Grid.Column="10" Classes="secondary" Content="Save layout" Click="OnSaveWorkspaceLayoutClick" />
                                <Button Grid.Column="11" Classes="secondary" Content="Reset" Click="OnResetWorkspaceLayoutClick" />
                            </Grid>
                        </Border>

                        <Grid x:Name="CodeDockWorkspaceGrid" Grid.Row="3" ColumnDefinitions="0.8*,8,1.45*,8,1*">
                            <Border x:Name="CodeExplorerPanel" Classes="card" Padding="0" ClipToBounds="True" MinWidth="190">
                                <Grid RowDefinitions="Auto,Auto,*">
                                    <Grid Margin="7,6,7,3" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Project" FontSize="11.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CodeWorkspaceSummary}" FontSize="8.5" Classes="muted"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary" Content="↻" Width="27" Padding="5,3"
                                                Click="OnRefreshCodeWorkspaceClick" ToolTip.Tip="Refresh project tree" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="7,2,7,4" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                        <TextBox Text="{Binding CodeTreeFilter}" PlaceholderText="Filter files…" MinHeight="25" FontSize="10" />
                                        <CheckBox Grid.Column="1" Content="Hidden" FontSize="9.5" IsChecked="{Binding CodeIncludeHidden}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                    <TreeView Grid.Row="2" ItemsSource="{Binding CodeTree}" SelectedItem="{Binding SelectedCodeNode}"
                                              Classes="compactTree" Background="Transparent" BorderThickness="0" Margin="2,0,3,4">
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                                <Grid ColumnDefinitions="22,*,Auto" Margin="1,1" ToolTip.Tip="{Binding RelativePath}">
                                                    <Border Width="18" Height="18" CornerRadius="3" Background="#31343A">
                                                        <TextBlock Text="{Binding Icon}" FontSize="8" FontWeight="Bold"
                                                                   Foreground="{Binding AccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding AccentColor}" VerticalAlignment="Center" Margin="4,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="8.5" Classes="muted"
                                                               VerticalAlignment="Center" Margin="4,0,2,0" />
                                                </Grid>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </Grid>
                            </Border>

                            <GridSplitter x:Name="CodeExplorerSplitter" Grid.Column="1" Width="8"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                          Background="#4B4D52" Cursor="SizeWestEast" />

                            <Border x:Name="CodeEditorPanel" Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True" MinWidth="300">
                                <Grid x:Name="CodeEditorDockGrid" RowDefinitions="Auto,1*,8,0.32*">
                                    <Grid Margin="10,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Editor preview" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CodePreviewSummary}" FontSize="10" Classes="muted"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary" Content="History of selection"
                                                Click="OnCodeSelectionHistoryClick"
                                                ToolTip.Tip="Select lines in the editor, then follow only those lines through Git" />
                                    </Grid>
                                    <controls:SyntaxHighlightedCodeView x:Name="CodePreview" Grid.Row="1"
                                                                        Text="{Binding CodePreviewText}"
                                                                        FilePath="{Binding SelectedCodeNode.RelativePath}" />
                                    <GridSplitter x:Name="CodeSymbolsSplitter" Grid.Row="2" Height="8"
                                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                                  Background="#4B4D52" Cursor="SizeNorthSouth" />
                                    <Border x:Name="CodeSymbolsPanel" Grid.Row="3" BorderBrush="#393B40" BorderThickness="0,1,0,0"
                                            MinHeight="90">
                                        <Grid RowDefinitions="Auto,*">
                                            <Grid Margin="10,6" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Symbols" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding CodeSelectionSummary}" FontSize="10" Classes="muted"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding CodeSymbols}" SelectedItem="{Binding SelectedCodeSymbol}"
                                                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                      Background="Transparent" BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="85" />
                                                    <DataGridTextColumn Header="Symbol" Binding="{Binding Name}" Width="*" />
                                                    <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="65" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <GridSplitter x:Name="CodeResultsSplitter" Grid.Column="3" Width="8"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                          Background="#4B4D52" Cursor="SizeWestEast" />

                            <Border x:Name="CodeResultsPanel" Grid.Column="4" Classes="card" Padding="0" ClipToBounds="True" MinWidth="230">
                                <TabControl>
                                    <TabItem Header="Search results">
                                        <DataGrid ItemsSource="{Binding CodeSearchResults}" SelectedItem="{Binding SelectedCodeSearchResult}"
                                                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                  Background="Transparent" BorderThickness="0" Margin="3">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="145" />
                                                <DataGridTextColumn Header="Preview" Binding="{Binding Preview}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="Git history">
                                        <Grid RowDefinitions="Auto,*">
                                            <TextBlock Text="File, folder, or selected-line history" FontSize="10.5" Classes="muted" Margin="8,6" />
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding CodeHistory}"
                                                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                      Background="Transparent" BorderThickness="0" Margin="3">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Rev" Binding="{Binding ShortHash}" Width="65" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding Subject}" Width="*" />
                                                    <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="95" />
                                                    <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="120" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ConsoleWorkspaceTab" Header="Console &amp; Logs">
                    <TabControl x:Name="ConsoleAndLogsTabs" Margin="0,8,0,0">
                        <TabItem Header="Repository console">
                            <Grid Margin="5" RowDefinitions="Auto,*,Auto" RowSpacing="7">
                                <Border Classes="card" Padding="9">
                                    <Grid ColumnDefinitions="*,Auto,150,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="7" RowSpacing="4">
                                        <StackPanel>
                                            <TextBlock Text="Repository console" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RepositoryConsoleWorkingDirectory}" Foreground="#78D7B7"
                                                       FontFamily="Cascadia Mono, Consolas" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Shell" Classes="muted" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding RepositoryShells}"
                                                  SelectedItem="{Binding SelectedRepositoryShell}" />
                                        <Button Grid.Column="3" Classes="secondary" Content="Clear output"
                                                Click="OnClearRepositoryConsoleOutputClick" />
                                        <Button Grid.Column="4" Classes="danger" Content="Stop"
                                                IsEnabled="{Binding CanStopRepositoryCommand}" Click="OnStopRepositoryCommandClick" />
                                        <Button Grid.Column="5" Classes="primary" Content="Run"
                                                IsEnabled="{Binding CanRunRepositoryCommand}" Click="OnRunRepositoryCommandClick" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="Commands run in the selected project root with your user permissions. They may modify files or Git."
                                                   Foreground="#F2C66D" FontSize="9.5" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3"
                                                   Text="{Binding RepositoryConsoleStatus}" Classes="muted"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" ColumnDefinitions="*,8,360">
                                    <Border Classes="card" Padding="0" ClipToBounds="True">
                                        <Grid RowDefinitions="36,*">
                                            <Border Background="#2B2D30" BorderBrush="#393B40" BorderThickness="0,0,0,1" Padding="10,0">
                                                <TextBlock Text="Output" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBox x:Name="RepositoryConsoleOutputBox" Grid.Row="1"
                                                     Text="{Binding RepositoryConsoleOutput}" IsReadOnly="True"
                                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                                     FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                     Background="#0D111A" BorderThickness="0" Padding="9"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     TextChanged="OnRepositoryConsoleOutputTextChanged" />
                                        </Grid>
                                    </Border>

                                    <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns"
                                                  ResizeBehavior="PreviousAndNext" Background="#4B4D52" Cursor="SizeWestEast" />

                                    <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                        <Grid RowDefinitions="Auto,*,Auto">
                                            <StackPanel Margin="8,7,8,4" Spacing="5">
                                                <TextBlock Text="Persistent history for this project" FontWeight="SemiBold" />
                                                <TextBox Text="{Binding RepositoryConsoleHistorySearch, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="Search previous commands…" />
                                            </StackPanel>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredRepositoryCommandHistory}"
                                                      SelectedItem="{Binding SelectedRepositoryCommand}"
                                                      DoubleTapped="OnRepositoryCommandHistoryDoubleTapped"
                                                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                      Background="Transparent" BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*" />
                                                    <DataGridTextColumn Header="Shell" Binding="{Binding Shell}" Width="92" />
                                                    <DataGridTextColumn Header="Date" Binding="{Binding TimeText}" Width="118" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="7" Margin="8,5,8,8">
                                                <Button Classes="secondary" Content="Use selected" Click="OnUseRepositoryCommandClick" />
                                                <Button Classes="danger" Content="Clear history" Click="OnClearRepositoryConsoleHistoryClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Classes="card" Padding="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text=">" Foreground="#78D7B7" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBox x:Name="RepositoryConsoleInput" Grid.Column="1"
                                                 Text="{Binding RepositoryConsoleCommand, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Enter a command · Enter to run · Up/Down for history"
                                                 FontFamily="Cascadia Mono, Consolas" KeyDown="OnRepositoryConsoleInputKeyDown" />
                                        <Button Grid.Column="2" Classes="primary" Content="Run"
                                                IsEnabled="{Binding CanRunRepositoryCommand}" Click="OnRunRepositoryCommandClick" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Application log">
                            <Grid Margin="5" RowDefinitions="Auto,*,170" RowSpacing="7">
                                <Border Classes="card" Padding="9">
                                    <Grid ColumnDefinitions="*,145,Auto,Auto,Auto" ColumnSpacing="7" RowDefinitions="Auto,Auto">
                                        <TextBox Text="{Binding ApplicationLogSearch, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Search log message or area…" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding ApplicationLogLevelFilters}"
                                                  SelectedItem="{Binding ApplicationLogLevelFilter}" />
                                        <Button Grid.Column="2" Classes="secondary" Content="Refresh" Click="OnRefreshApplicationLogsClick" />
                                        <Button Grid.Column="3" Classes="secondary" Content="Open log folder ↗" Click="OnOpenApplicationLogFolderClick" />
                                        <Button Grid.Column="4" Classes="secondary" Content="Clear view" Click="OnClearApplicationLogViewClick" />
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding ApplicationLogProjectSummary}" Foreground="#78D7B7"
                                                       FontSize="9" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CurrentApplicationLogPath}"
                                                       Classes="muted" FontSize="9" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
                                    <DataGrid ItemsSource="{Binding FilteredApplicationLogEntries}"
                                              SelectedItem="{Binding SelectedApplicationLogEntry}"
                                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              Background="Transparent" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="165" />
                                            <DataGridTemplateColumn Header="Level" Width="105">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding LevelText}" Foreground="{Binding LevelColor}" FontWeight="SemiBold" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="125" />
                                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <Border Grid.Row="2" Classes="card" Padding="9">
                                    <Grid RowDefinitions="Auto,*">
                                        <TextBlock Text="Selected log details" FontWeight="SemiBold" />
                                        <TextBox Grid.Row="1" Text="{Binding SelectedApplicationLogEntry.Message}"
                                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                 FontFamily="Cascadia Mono, Consolas"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem x:Name="HistoryWorkspaceTab" Header="Historique">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,*" RowSpacing="7">
                        <Border Classes="card" Padding="13">
                            <Grid ColumnDefinitions="*,Auto,250,Auto,Auto,Auto" ColumnSpacing="10">
                                <TextBox Text="{Binding ExplorerSearch}" PlaceholderText="Rechercher par message, auteur ou hash…" />
                                <TextBlock Grid.Column="1" Text="Comparer avec" Classes="muted" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedComparisonRevision}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Inlines>
                                                    <Run Text="{Binding ShortHash}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding Subject}" />
                                                </TextBlock.Inlines>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="3" Classes="primary" Content="Comparer A ↔ B" Click="OnCompareExplorerCommitsClick" />
                                <Button Grid.Column="4" Classes="secondary" Content="Compose restore…" Click="OnShowMultiRestoreWorkspaceClick" />
                                <Button Grid.Column="5" Classes="secondary" Content="Fetch remotes" Click="OnFetchClick"
                                        ToolTip.Tip="Fetch remote refs, then include them in the history list" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#26282B" BorderBrush="#393B40" BorderThickness="1"
                                CornerRadius="6" Padding="7,5">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,1,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Text="LAYOUT" FontSize="9" FontWeight="Bold" Foreground="#7E8189"
                                           VerticalAlignment="Center" Margin="3,0,2,0" />
                                <ToggleButton x:Name="HistoryColumnsLayoutToggle" Grid.Column="1" Classes="layoutChoice"
                                              Content="Colonnes" Click="OnColumnsHistoryLayoutClick"
                                              ToolTip.Tip="Trois panneaux côte à côte" />
                                <ToggleButton x:Name="HistoryReviewLayoutToggle" Grid.Column="2" Classes="layoutChoice"
                                              Content="Révision" Click="OnReviewHistoryLayoutClick"
                                              ToolTip.Tip="Chronologie à gauche, fichiers et diff empilés" />
                                <ToggleButton x:Name="HistoryDiffFocusLayoutToggle" Grid.Column="3" Classes="layoutChoice"
                                              Content="Diff principal" Click="OnDiffFocusedHistoryLayoutClick"
                                              ToolTip.Tip="Grand diff avec panneaux secondaires empilés" />

                                <Border Grid.Column="4" Width="1" Height="18" Background="#4B4D52" Margin="4,0" />
                                <TextBlock Grid.Column="5" Text="PANNEAUX" FontSize="9" FontWeight="Bold" Foreground="#7E8189"
                                           VerticalAlignment="Center" Margin="3,0,2,0" />
                                <ToggleButton x:Name="HistoryTimelineToggle" Grid.Column="6" Classes="panelToggle"
                                              Content="Chronologie" IsChecked="True" Click="OnHistoryPanelToggleClick"
                                              ToolTip.Tip="Afficher la chronologie" />
                                <ToggleButton x:Name="HistoryFilesToggle" Grid.Column="7" Classes="panelToggle"
                                              Content="Fichiers" IsChecked="True" Click="OnHistoryPanelToggleClick"
                                              ToolTip.Tip="Afficher les fichiers" />
                                <ToggleButton x:Name="HistoryDiffToggle" Grid.Column="8" Classes="panelToggle"
                                              Content="Diff ciblé" IsChecked="True" Click="OnHistoryPanelToggleClick"
                                              ToolTip.Tip="Afficher le diff ciblé" />

                                <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock Text="Drag dividers to resize" FontSize="9.5" Classes="muted"
                                               VerticalAlignment="Center" Margin="6,0" />
                                    <Button Classes="secondary" Content="Save layout" Click="OnSaveWorkspaceLayoutClick" />
                                    <Button Classes="secondary" Content="Reset" Click="OnResetWorkspaceLayoutClick" />
                                </StackPanel>

                                <Button Grid.Column="10" Classes="secondary" Content="Ouvrir le diff dans une fenêtre ↗"
                                        Click="OnOpenFocusedDiffWindowClick" ToolTip.Tip="Ouvrir le diff ciblé dans une fenêtre redimensionnable" />
                                <Button Grid.Column="11" Classes="secondary" Content="Commit Explorer ↗"
                                        Click="OnOpenCommitExplorerWindowClick"
                                        ToolTip.Tip="Open commits, committed files and a live diff in a separate window" />
                            </Grid>
                        </Border>

                        <Grid x:Name="HistoryWorkspaceGrid" Grid.Row="2"
                              ColumnDefinitions="0.9*,6,1.25*,6,1.15*" RowDefinitions="*,0,0">
                            <Border x:Name="HistoryTimelinePanel" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Background="#2B2D30" BorderBrush="#393B40" BorderThickness="0,0,0,1" Padding="12,9">
                                        <StackPanel>
                                            <TextBlock Text="Chronologie" FontSize="14" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="Cliquez sur une révision pour l'inspecter." FontSize="9.5" Classes="muted" />
                                                <TextBlock Text="{Binding HistoryScope}" FontSize="9.5" Foreground="#61AFEF" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedExplorerRevision}"
                                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              Background="Transparent" BorderThickness="0" Margin="6,3,6,6">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Révision" Binding="{Binding ShortHash}" Width="78" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Subject}" Width="*" />
                                            <DataGridTextColumn Header="Auteur" Binding="{Binding AuthorName}" Width="110" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <GridSplitter x:Name="HistorySplitterOne" Grid.Column="1" Width="6" Margin="1,14"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                          Background="#4B4D52" Cursor="SizeWestEast" />

                            <Border x:Name="HistoryFilesPanel" Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,1.45*,Auto,0.75*">
                                    <Border Background="#2B2D30" BorderBrush="#393B40" BorderThickness="0,0,0,1" Padding="12,9">
                                        <StackPanel>
                                            <TextBlock Text="Fichiers de la révision" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ExplorerSummary}" FontSize="9.5" Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding ExplorerFiles}" SelectedItem="{Binding SelectedExplorerFile}"
                                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              Background="Transparent" BorderThickness="0" Margin="6,3,6,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="État" Binding="{Binding Kind}" Width="78" />
                                            <DataGridTextColumn Header="Fichier" Binding="{Binding Path}" Width="*" />
                                            <DataGridTextColumn Header="Variation" Binding="{Binding ChangeSummary}" Width="92" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="12,8,12,5">
                                        <TextBlock Text="Historique du fichier" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Exporter cette version…" Click="OnExportExplorerFileClick" />
                                    </Grid>
                                    <DataGrid Grid.Row="3" Classes="historyCompact" ItemsSource="{Binding ExplorerFileHistory}" AutoGenerateColumns="False"
                                              IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent"
                                              BorderThickness="0" Margin="6,0,6,6">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Révision" Binding="{Binding Revision.ShortHash}" Width="76" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Revision.Subject}" Width="*" />
                                            <DataGridTextColumn Header="Date" Binding="{Binding Revision.AuthoredAt}" Width="128" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <GridSplitter x:Name="HistorySplitterTwo" Grid.Column="3" Width="6" Margin="1,14"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                          Background="#4B4D52" Cursor="SizeWestEast" />

                            <Border x:Name="HistoryDiffPanel" Grid.Column="4" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,Auto,*">
                                    <Border Background="#2B2D30" BorderBrush="#393B40" BorderThickness="0,0,0,1" Padding="12,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel>
                                                <TextBlock Text="Diff ciblé" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="Lecture seule · aucun checkout" FontSize="9.5" Foreground="#78D7B7" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="secondary" Content="Ouvrir ↗"
                                                    Click="OnOpenFocusedDiffWindowClick"
                                                    ToolTip.Tip="Ouvrir le diff ciblé dans une fenêtre redimensionnable" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" IsVisible="{Binding IsExplorerAnyLoading}" Background="#202633" Padding="8,4">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <TextBlock Text="Loading diff…" Classes="muted" FontSize="9" />
                                            <ProgressBar Grid.Column="1" IsIndeterminate="True" Height="4" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <controls:CodeDiffView Grid.Row="2"
                                                           DiffText="{Binding ExplorerDiff}"
                                                           FilePath="{Binding SelectedExplorerFile.Path}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="CompositionWorkspaceTab" Header="Compose">
                    <controls:RevisionCompositionView x:Name="MainRevisionCompositionView" Margin="0,1,0,0" />
                </TabItem>

                <TabItem x:Name="BranchesWorkspaceTab" Header="Branches">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="1.1*,1*" ColumnSpacing="8">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,34,*,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="Local and remote branches" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Remote refs are read-only until you create or switch to a local branch"
                                                   FontSize="9" Classes="muted" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="secondary" Content="Fetch remotes" Click="OnFetchClick" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,105" ColumnSpacing="6" Margin="0,5,0,3">
                                    <TextBox Text="{Binding BranchSearch, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Search branch, remote or status…" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding BranchSortOptions}"
                                              SelectedItem="{Binding BranchSort}" />
                                </Grid>
                                <ListBox Grid.Row="2" Margin="0,3" ItemsSource="{Binding FilteredBranches}" SelectedItem="{Binding SelectedBranch}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="5,3" ColumnSpacing="8">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{Binding DisplayColor}"
                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TipSubject}" />
                                                <TextBlock Grid.Column="1" Text="{Binding ShortCommitHash}" Classes="muted" />
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Scope}" Foreground="{Binding DisplayColor}" FontSize="8.5" />
                                                    <TextBlock Text="{Binding PublicationStatus}" Foreground="{Binding PublicationColor}" FontSize="8.5" />
                                                    <TextBlock Text="{Binding SyncStatus}" Foreground="{Binding PublicationColor}" FontSize="8.5" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TipUpdateText}"
                                                           Classes="muted" FontSize="8.5" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="secondary" Content="Switch / create local" Click="OnCheckoutBranchClick" />
                                    <Button Classes="primary" Content="Merge" Click="OnMergeBranchClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="7">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Selected branch commits" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedBranchSummary}" Classes="muted" FontSize="9" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="secondary" Content="Open selected commit ↗"
                                            Click="OnOpenSelectedBranchCommitClick"
                                            ToolTip.Tip="Open the selected commit, its files and diffs in the external Commit Explorer" />
                                </Grid>
                                <Border Grid.Row="1" Background="#24262A" CornerRadius="5" Padding="8">
                                    <Grid ColumnDefinitions="1*,1*,1*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="COMPARISON BASE" Classes="muted" FontSize="8" />
                                            <TextBlock Text="{Binding SelectedBranchDetails.ComparisonBaseText}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="COMMITS AHEAD" Classes="muted" FontSize="8" />
                                            <TextBlock Text="{Binding SelectedBranchDetails.UniqueCommitText}" Foreground="#78D7B7"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="CREATED BY (INFERRED)" Classes="muted" FontSize="8" />
                                            <TextBlock Text="{Binding SelectedBranchDetails.CreatorText}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="ESTIMATED CREATION" Classes="muted" FontSize="8" />
                                            <TextBlock Text="{Binding SelectedBranchDetails.CreatedText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="LAST UPDATE" Classes="muted" FontSize="8" />
                                            <TextBlock Text="{Binding SelectedBranchDetails.UpdatedText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock Text="LAST COMMIT" Classes="muted" FontSize="8" />
                                            <TextBlock Text="{Binding SelectedBranchDetails.LastSubject}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding SelectedBranchDetails.LastAuthorName}" />
                                            <TextBlock Text="{Binding SelectedBranchDetails.LastAuthorName}" Classes="muted" FontSize="8.5" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataGrid x:Name="SelectedBranchCommitGrid" Grid.Row="2"
                                          ItemsSource="{Binding SelectedBranchHistory}"
                                          SelectedItem="{Binding SelectedBranchRevision, Mode=TwoWay}"
                                          DoubleTapped="OnSelectedBranchCommitDoubleTapped"
                                          Classes="historyCompact"
                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Commit" Binding="{Binding ShortHash}" Width="72" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Subject}" Width="*" />
                                        <DataGridTextColumn Header="Author" Binding="{Binding AuthorName}" Width="105" />
                                        <DataGridTextColumn Header="Date" Binding="{Binding AuthoredAt}" Width="130" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="3" Background="#24262A" CornerRadius="5" Padding="8">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="7" RowSpacing="5">
                                        <TextBlock Text="Create branch" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Remote origin" FontWeight="SemiBold" />
                                        <TextBox Grid.Row="1" x:Name="NewBranchName" PlaceholderText="feature/name" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Width="250" Text="{Binding RemoteUrl}" PlaceholderText="https:// or ssh://" />
                                        <Button Grid.Row="2" Classes="primary" Content="Create and switch" Click="OnCreateBranchClick" HorizontalAlignment="Left" />
                                        <Button Grid.Row="2" Grid.Column="1" Classes="secondary" Content="Save origin" Click="OnSaveRemoteClick" HorizontalAlignment="Left" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="PullRequestsWorkspaceTab" Header="Pull Requests">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="8">
                        <Border Classes="card" Padding="10">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Pull Request Manager" FontSize="16" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding PullRequestRepositoryName}" Foreground="#78D7B7" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PullRequestStatus}" Classes="muted" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                                    <ComboBox Width="105" ItemsSource="{Binding PullRequestStateFilters}"
                                              SelectedItem="{Binding PullRequestStateFilter}" />
                                    <Button Classes="secondary" Content="Detect remote" Click="OnResolvePullRequestRepositoryClick" />
                                    <Button Classes="primary" Content="Refresh" Click="OnRefreshPullRequestsClick" />
                                </StackPanel>
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,170,Auto,230,Auto,230,*,Auto"
                                      ColumnSpacing="7">
                                    <TextBlock Text="API" Classes="muted" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding PullRequestApiBaseUrl}"
                                             PlaceholderText="Auto / GitHub Enterprise API" />
                                    <TextBlock Grid.Column="2" Text="Token env" Classes="muted" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="3" Text="{Binding PullRequestTokenEnvironmentVariable}"
                                             PlaceholderText="GITHUB_TOKEN" />
                                    <TextBlock Grid.Column="4" Text="Session token" Classes="muted" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="5" Text="{Binding PullRequestToken}" PasswordChar="●"
                                             PlaceholderText="Never saved" />
                                    <TextBlock Grid.Column="6" Text="{Binding PullRequestAuthenticationState}" FontSize="9.5"
                                               Foreground="#F2C66D" VerticalAlignment="Center" Margin="8,0" />
                                    <Button Grid.Column="7" Classes="secondary" Content="Token help ↗"
                                            Click="OnOpenGitHubTokenHelpClick"
                                            ToolTip.Tip="Private repositories require a GitHub token with repository and pull-request access" />
                                </Grid>
                                <Border Grid.Row="2" Grid.ColumnSpan="2" IsVisible="{Binding IsPullRequestLoading}"
                                        Background="#202633" CornerRadius="4" Padding="8,4">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <TextBlock Text="Loading pull request data…" Classes="muted" FontSize="9" />
                                        <ProgressBar Grid.Column="1" IsIndeterminate="True" Height="4" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="420,8,*">
                            <Border Classes="card" Padding="0" ClipToBounds="True" MinWidth="310">
                                <TabControl>
                                    <TabItem Header="Requests">
                                        <Grid RowDefinitions="34,*">
                                            <TextBox Margin="4" Text="{Binding PullRequestSearch, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="Search pull requests by number, title, author, branch or state…" />
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredPullRequests}" SelectedItem="{Binding SelectedPullRequest}"
                                                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                  Background="Transparent" BorderThickness="0" Margin="4">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding NumberText}" Width="58" />
                                                <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="72" />
                                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="100" />
                                                <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedText}" Width="125" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Create">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="12" Spacing="8">
                                                <TextBlock Text="Create pull request" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="The source branch must already be pushed to the remote."
                                                           Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                                <TextBox Text="{Binding NewPullRequestTitle}" PlaceholderText="Title" />
                                                <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="Head branch" FontSize="10" Classes="muted" />
                                                        <TextBox Text="{Binding NewPullRequestHeadBranch}" PlaceholderText="feature/name" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="Base branch" FontSize="10" Classes="muted" />
                                                        <TextBox Text="{Binding NewPullRequestBaseBranch}" PlaceholderText="main" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBox Text="{Binding NewPullRequestBody}" AcceptsReturn="True" Height="180"
                                                         TextWrapping="Wrap" PlaceholderText="Description (Markdown)" />
                                                <CheckBox Content="Create as draft" IsChecked="{Binding NewPullRequestIsDraft}" />
                                                <Button Classes="primary" Content="Create pull request" Click="OnCreatePullRequestClick"
                                                        HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </Border>

                            <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns"
                                          ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                          Background="#4B4D52" Cursor="SizeWestEast" />

                            <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Background="#2B2D30" BorderBrush="#393B40" BorderThickness="0,0,0,1" Padding="12,9">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding SelectedPullRequest.NumberText}" FontWeight="Bold" Foreground="#78D7B7" />
                                                    <TextBlock Text="{Binding SelectedPullRequest.Title}" FontSize="15" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Background="#34363A" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding SelectedPullRequest.StateText}" FontSize="9" FontWeight="Bold"
                                                                   Foreground="#F2C66D" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedPullRequest.BranchText}" FontSize="10" Classes="muted" />
                                                <TextBlock Text="{Binding PullRequestDetailsSummary}" FontSize="10" Foreground="#78D7B7" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Classes="secondary" Content="Commit Explorer ↗"
                                                        Click="OnOpenPullRequestCommitExplorerClick"
                                                        IsEnabled="{Binding HasSelectedPullRequest}" />
                                                <Button Classes="secondary" Content="Open ↗" Click="OnOpenPullRequestClick"
                                                        IsEnabled="{Binding HasSelectedPullRequest}" />
                                                <Button Classes="secondary" Content="Checkout" Click="OnCheckoutPullRequestClick"
                                                        IsEnabled="{Binding HasSelectedPullRequest}" />
                                                <Button Classes="secondary" Content="Close / reopen" Click="OnTogglePullRequestStateClick"
                                                        IsEnabled="{Binding HasSelectedPullRequest}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding PullRequestBody}" TextWrapping="Wrap"
                                                       MaxHeight="72" Classes="muted" />
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                        VerticalAlignment="Bottom">
                                                <ComboBox Width="105" ItemsSource="{Binding PullRequestMergeMethods}"
                                                          SelectedItem="{Binding PullRequestMergeMethod}" />
                                                <Button Classes="primary" Content="Merge" Click="OnMergePullRequestClick"
                                                        IsEnabled="{Binding CanMergeSelectedPullRequest}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TabControl Grid.Row="1">
                                        <TabItem Header="Files and patch">
                                            <Grid RowDefinitions="30,*" Margin="4">
                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                                                    <TextBlock Text="LAYOUT" Classes="muted" FontSize="9" FontWeight="Bold"
                                                               VerticalAlignment="Center" />
                                                    <ToggleButton x:Name="PullRequestBalancedLayoutToggle" Grid.Column="1"
                                                                  Classes="layoutChoice" Content="Balanced" IsChecked="True"
                                                                  Click="OnPullRequestBalancedLayoutClick" />
                                                    <ToggleButton x:Name="PullRequestDiffFocusLayoutToggle" Grid.Column="2"
                                                                  Classes="layoutChoice" Content="Diff focus"
                                                                  Click="OnPullRequestDiffFocusLayoutClick" />
                                                    <TextBlock Text="Select a file to inspect its provider patch" Classes="muted" FontSize="9"
                                                               Grid.Column="3" VerticalAlignment="Center" />
                                                    <ToggleButton x:Name="PullRequestDiffToggle" Grid.Column="4" Classes="layoutChoice"
                                                                  Content="Diff" Click="OnPullRequestDiffToggleClick" />
                                                    <Button Grid.Column="5" Classes="secondary" Content="Open diff ↗"
                                                            Click="OnOpenPullRequestDiffWindowClick" />
                                                </Grid>
                                            <Grid x:Name="PullRequestFilesWorkspaceGrid" Grid.Row="1" ColumnDefinitions="0.78*,8,1.22*">
                                                <DataGrid ItemsSource="{Binding PullRequestFiles}" SelectedItem="{Binding SelectedPullRequestFile}"
                                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                          Background="Transparent" BorderThickness="0">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="78" />
                                                        <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*" />
                                                        <DataGridTextColumn Header="Change" Binding="{Binding ChangeText}" Width="95" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <GridSplitter x:Name="PullRequestDiffSplitter" Grid.Column="1" Width="8" ResizeDirection="Columns"
                                                              ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                                              Background="#4B4D52" Cursor="SizeWestEast" />
                                                <controls:CodeDiffView x:Name="PullRequestDiffPanel" Grid.Column="2" DiffText="{Binding PullRequestPatch}"
                                                                       FilePath="{Binding SelectedPullRequestFile.Path}" />
                                            </Grid>
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="Conversation">
                                            <Grid Margin="8" RowDefinitions="*,Auto" RowSpacing="8">
                                                <TabControl>
                                                    <TabItem Header="Comments">
                                                        <DataGrid ItemsSource="{Binding PullRequestComments}" AutoGenerateColumns="False"
                                                                  IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent"
                                                                  BorderThickness="0">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="110" />
                                                                <DataGridTextColumn Header="Comment" Binding="{Binding Body}" Width="*" />
                                                                <DataGridTextColumn Header="Date" Binding="{Binding CreatedText}" Width="135" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </TabItem>
                                                    <TabItem Header="Reviews">
                                                        <DataGrid ItemsSource="{Binding PullRequestReviews}" AutoGenerateColumns="False"
                                                                  IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent"
                                                                  BorderThickness="0">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="110" />
                                                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120" />
                                                                <DataGridTextColumn Header="Review" Binding="{Binding Body}" Width="*" />
                                                                <DataGridTextColumn Header="Date" Binding="{Binding SubmittedText}" Width="135" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </TabItem>
                                                </TabControl>
                                                <Grid Grid.Row="1" ColumnDefinitions="1*,Auto,1*,125,Auto" ColumnSpacing="7">
                                                    <TextBox Text="{Binding PullRequestComment}" PlaceholderText="General comment…" />
                                                    <Button Grid.Column="1" Classes="secondary" Content="Comment" Click="OnAddPullRequestCommentClick" />
                                                    <TextBox Grid.Column="2" Text="{Binding PullRequestReviewBody}" PlaceholderText="Review summary…" />
                                                    <ComboBox Grid.Column="3" ItemsSource="{Binding PullRequestReviewActions}"
                                                              SelectedItem="{Binding PullRequestReviewAction}" />
                                                    <Button Grid.Column="4" Classes="primary" Content="Submit review" Click="OnSubmitPullRequestReviewClick" />
                                                </Grid>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="GitGraphsWorkspaceTab" Header="Graphes Git">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="7">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Visualisations alternatives de l'historique" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding GitGraphSummary}" Classes="muted" TextWrapping="Wrap" />
                                    <TextBlock Text="Analyse locale et strictement en lecture seule. Aucun commit, index ou fichier n'est modifié."
                                               FontSize="10" Foreground="#78D7B7" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Commits" VerticalAlignment="Center" Classes="muted" FontSize="11" />
                                    <TextBox Text="{Binding GitGraphCommitLimit}" Width="62" />
                                    <TextBlock Text="Fichiers" VerticalAlignment="Center" Classes="muted" FontSize="11" />
                                    <TextBox Text="{Binding GitGraphFileLimit}" Width="56" />
                                    <CheckBox Content="Toutes les branches" IsChecked="{Binding GitGraphIncludeAllBranches}" VerticalAlignment="Center" />
                                    <Button Classes="primary" Content="Analyser le dépôt" Click="OnAnalyzeGitGraphsClick" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TabControl Grid.Row="1">
                            <TabItem Header="Réseau de commits">
                                <Border Margin="0,6,0,0" Classes="card" Padding="3">
                                    <controls:GitCommitGraphView Commits="{Binding GitGraphCommits}" CommitSelected="OnGraphCommitSelected" />
                                </Border>
                            </TabItem>

                            <TabItem Header="Relations entre fichiers">
                                <Grid Margin="0,6,0,0" ColumnDefinitions="*,5,300">
                                    <Border Classes="card" Padding="5">
                                        <Grid RowDefinitions="Auto,*">
                                            <WrapPanel Margin="10,6,10,3" Orientation="Horizontal">
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,0"><Border Width="9" Height="9" CornerRadius="5" Background="#55A7F3" VerticalAlignment="Center" /><TextBlock Text="Code" FontSize="10" Classes="muted" /></StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,0"><Border Width="9" Height="9" CornerRadius="5" Background="#A477D4" VerticalAlignment="Center" /><TextBlock Text="Unreal" FontSize="10" Classes="muted" /></StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,0"><Border Width="9" Height="9" CornerRadius="5" Background="#E56B91" VerticalAlignment="Center" /><TextBlock Text="Textures" FontSize="10" Classes="muted" /></StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,0"><Border Width="9" Height="9" CornerRadius="5" Background="#E5A94D" VerticalAlignment="Center" /><TextBlock Text="3D" FontSize="10" Classes="muted" /></StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,0"><Border Width="9" Height="9" CornerRadius="5" Background="#36C5A1" VerticalAlignment="Center" /><TextBlock Text="Audio" FontSize="10" Classes="muted" /></StackPanel>
                                                <TextBlock Text="Taille = quantité de modifications · lien = fichiers modifiés ensemble · liens les plus forts affichés" FontSize="10" Classes="muted" />
                                            </WrapPanel>
                                            <controls:GitFileRelationGraphView Grid.Row="1"
                                                                                  Files="{Binding GitFileActivities}"
                                                                                  Relations="{Binding GitFileRelations}" />
                                        </Grid>
                                    </Border>
                                    <GridSplitter Grid.Column="1" Width="6" Margin="1,16" ResizeDirection="Columns"
                                                  Background="#34415D" Cursor="SizeWestEast" />
                                    <Border Grid.Column="2" Classes="card" Padding="12" Margin="10,0,0,0" MinWidth="220">
                                        <Grid RowDefinitions="Auto,*">
                                            <StackPanel>
                                                <TextBlock Text="Fichiers les plus actifs" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="Cliquez ou survolez un nœud pour le détail." FontSize="10" Classes="muted" />
                                            </StackPanel>
                                            <DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding GitFileActivities}"
                                                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                      Background="Transparent" BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Fichier" Binding="{Binding Path}" Width="*" />
                                                    <DataGridTextColumn Header="Modif." Binding="{Binding ChangeCount}" Width="72" />
                                                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="92" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Activité d'équipe">
                                <Grid Margin="0,6,0,0" RowDefinitions="Auto,190,*" RowSpacing="7">
                                    <Border Classes="card" Padding="13">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Vue d'activité Git" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding GitInsightsSummary}" Classes="muted" TextWrapping="Wrap" />
                                            <TextBlock Text="Données calculées localement depuis les commits — aucun suivi utilisateur en arrière-plan."
                                                       FontSize="10" Foreground="#78D7B7" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Classes="card" Padding="5">
                                        <controls:GitActivityTimelineView Activity="{Binding GitDailyActivity}" />
                                    </Border>
                                    <Grid Grid.Row="2" ColumnDefinitions="1.15*,1*" ColumnSpacing="10">
                                        <Border Classes="card" Padding="10">
                                            <Grid RowDefinitions="Auto,*">
                                                <TextBlock Text="Contributeurs" FontSize="15" FontWeight="SemiBold" Margin="6" />
                                                <DataGrid Grid.Row="1" ItemsSource="{Binding GitContributors}" AutoGenerateColumns="False"
                                                          IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Auteur" Binding="{Binding AuthorName}" Width="*" />
                                                        <DataGridTextColumn Header="Commits" Binding="{Binding CommitCount}" Width="72" />
                                                        <DataGridTextColumn Header="Fichiers" Binding="{Binding FilesTouched}" Width="70" />
                                                        <DataGridTextColumn Header="Lignes" Binding="{Binding LineSummary}" Width="110" />
                                                        <DataGridTextColumn Header="Dernière activité" Binding="{Binding LastActiveAt}" Width="145" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" Classes="card" Padding="10">
                                            <Grid RowDefinitions="Auto,*">
                                                <TextBlock Text="Points chauds" FontSize="15" FontWeight="SemiBold" Margin="6" />
                                                <DataGrid Grid.Row="1" ItemsSource="{Binding GitHotFiles}" AutoGenerateColumns="False"
                                                          IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Fichier" Binding="{Binding Path}" Width="*" />
                                                        <DataGridTextColumn Header="Modif." Binding="{Binding ChangeCount}" Width="70" />
                                                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="92" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Dépendances Unreal" IsVisible="{Binding IsUnrealIntegrationEnabled}">
                                <Grid Margin="0,6,0,0" ColumnDefinitions="*,5,320">
                                    <Border Classes="card" Padding="5">
                                        <Grid RowDefinitions="Auto,*">
                                            <StackPanel Margin="10,7,10,5" Spacing="3">
                                                <TextBlock Text="Graphe des dépendances Unreal hors moteur" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding UnrealDependencySummary}" Classes="muted" TextWrapping="Wrap" />
                                                <TextBlock Text="Analyse simplifiée des références /Game détectables dans les .uasset et .umap présents localement."
                                                           FontSize="10" Foreground="#78D7B7" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <controls:GitFileRelationGraphView Grid.Row="1"
                                                                                  Files="{Binding UnrealDependencyFiles}"
                                                                                  Relations="{Binding UnrealDependencyRelations}" />
                                        </Grid>
                                    </Border>
                                    <GridSplitter Grid.Column="1" Width="6" Margin="1,16" ResizeDirection="Columns"
                                                  Background="#34415D" Cursor="SizeWestEast" />
                                    <Border Grid.Column="2" Classes="card" Padding="10" Margin="10,0,0,0">
                                        <Grid RowDefinitions="Auto,*">
                                            <StackPanel Margin="6,3,6,8">
                                                <TextBlock Text="Assets inspectés" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="Dépendances sortantes / références entrantes" FontSize="10" Classes="muted" />
                                            </StackPanel>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding UnrealAssets}" AutoGenerateColumns="False"
                                                      IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Asset" Binding="{Binding Path}" Width="*" />
                                                    <DataGridTextColumn Header="Type" Binding="{Binding AssetType}" Width="95" />
                                                    <DataGridTextColumn Header="Relations" Binding="{Binding RelationSummary}" Width="90" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <TabItem x:Name="LfsLocksWorkspaceTab" Header="File locks">
                            <Grid Margin="0,8,0,0" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                                <Border Classes="card" Padding="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Git LFS file locks" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding LfsLocksSummary}" Classes="muted" FontSize="10.5"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary" Content="Refresh"
                                                Click="OnRefreshLfsLocksClick" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" ColumnDefinitions="1.35*,7,1*">
                                    <Border Classes="card" Padding="0" ClipToBounds="True">
                                        <Grid RowDefinitions="42,34,*">
                                            <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1"
                                                    Padding="10,0">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="All project locks" FontWeight="SemiBold" />
                                                    <TextBlock Text="Verified remote locks, including files held by teammates"
                                                               Classes="muted" FontSize="9" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="danger"
                                                        IsVisible="{Binding HasSelectedProjectLocks}" Click="OnUnlockSelectedProjectLocksClick"
                                                        Padding="7,3" MinHeight="23">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="Unlock selected" />
                                                        <TextBlock Text="{Binding SelectedProjectLockCount}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Classes="danger" Content="Force unlock all…"
                                                        Click="OnForceUnlockAllLfsLocksClick" Padding="7,3" MinHeight="23"
                                                        ToolTip.Tip="Administrative action: also removes locks owned by other users" />
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,120,Auto" ColumnSpacing="6" Margin="5,4">
                                                <TextBox Text="{Binding AllLfsLockSearch, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="Search all locks by file, folder, owner, locked by, source or ID…" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding LfsLockSortOptions}"
                                                          SelectedItem="{Binding AllLfsLockSort}" />
                                                <TextBlock Grid.Column="2" Text="{Binding FilteredLfsLocks.Count}" Classes="muted"
                                                           VerticalAlignment="Center" ToolTip.Tip="Visible locks" />
                                            </Grid>
                                            <TabControl Grid.Row="2" Padding="0" Background="Transparent">
                                            <TabItem Header="List">
                                            <DataGrid x:Name="AllLfsLocksGrid" Classes="historyCompact" ItemsSource="{Binding FilteredLfsLocks}"
                                                      AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                                      GridLinesVisibility="Horizontal" Background="Transparent"
                                                      SelectionMode="Extended" SelectionChanged="OnAllLfsLocksSelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Owner" Width="92" SortMemberPath="Ownership">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <TextBlock Text="{Binding Ownership}" Foreground="{Binding OwnershipColor}" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="File" Width="*" SortMemberPath="Path">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <TextBlock Text="{Binding Path}" Foreground="{Binding FileColor}"
                                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Locked by" Width="120" SortMemberPath="OwnerName">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <TextBlock Text="{Binding OwnerName}" Foreground="{Binding OwnerColor}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Date" Binding="{Binding LockedAtText}" SortMemberPath="LockedAt" Width="120" />
                                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" SortMemberPath="Source" Width="62" />
                                                    <DataGridTextColumn Header="ID" Binding="{Binding ShortId}" SortMemberPath="Id" Width="82" />
                                                    <DataGridTemplateColumn Header="" Width="112">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <Button Classes="secondary" Content="{Binding UnlockAction}"
                                                                    Padding="7,3" MinHeight="23"
                                                                    Click="OnUnlockLfsLockClick" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            </TabItem>
                                            <TabItem Header="Folders">
                                                <TreeView ItemsSource="{Binding LfsLockTree}" Classes="compactTree"
                                                          Background="Transparent" BorderThickness="0" Margin="2">
                                                    <TreeView.ItemTemplate>
                                                        <TreeDataTemplate ItemsSource="{Binding Children}">
                                                            <Grid ColumnDefinitions="16,*,Auto" Height="22" Margin="0"
                                                                  ToolTip.Tip="{Binding RelativePath}">
                                                                <TextBlock Text="{Binding Icon}" Foreground="{Binding AccentColor}"
                                                                           HorizontalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding AccentColor}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted"
                                                                           FontSize="8" Margin="5,0,2,0" />
                                                            </Grid>
                                                        </TreeDataTemplate>
                                                    </TreeView.ItemTemplate>
                                                </TreeView>
                                            </TabItem>
                                            </TabControl>
                                        </Grid>
                                    </Border>

                                    <GridSplitter Grid.Column="1" Width="7" ResizeDirection="Columns"
                                                  ResizeBehavior="PreviousAndNext" Background="#45484E"
                                                  Cursor="SizeWestEast" />

                                    <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                        <Grid RowDefinitions="42,34,*">
                                            <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1"
                                                    Padding="10,0">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Locked by me" FontWeight="SemiBold" />
                                                    <TextBlock Text="Locks this Git LFS identity can release normally"
                                                               Classes="muted" FontSize="9" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="secondary"
                                                        IsVisible="{Binding HasSelectedMyLocks}" Click="OnUnlockSelectedMyLocksClick"
                                                        Padding="7,3" MinHeight="23">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="Unlock selected" />
                                                        <TextBlock Text="{Binding SelectedMyLockCount}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Classes="secondary" Content="Unlock all mine…"
                                                        Click="OnUnlockAllMyLfsLocksClick" Padding="7,3" MinHeight="23" />
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,120,Auto" ColumnSpacing="6" Margin="5,4">
                                                <TextBox Text="{Binding MyLfsLockSearch, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="Search my locks by file, folder, owner, source or ID…" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding LfsLockSortOptions}"
                                                          SelectedItem="{Binding MyLfsLockSort}" />
                                                <TextBlock Grid.Column="2" Text="{Binding FilteredMyLfsLocks.Count}" Classes="muted"
                                                           VerticalAlignment="Center" ToolTip.Tip="Visible locks" />
                                            </Grid>
                                            <TabControl Grid.Row="2" Padding="0" Background="Transparent">
                                            <TabItem Header="List">
                                            <DataGrid x:Name="MyLfsLocksGrid" Classes="historyCompact" ItemsSource="{Binding FilteredMyLfsLocks}"
                                                      AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                                      GridLinesVisibility="Horizontal" Background="Transparent"
                                                      SelectionMode="Extended" SelectionChanged="OnMyLfsLocksSelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="File" Width="*" SortMemberPath="Path">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <TextBlock Text="{Binding Path}" Foreground="{Binding FileColor}"
                                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Locked by" Binding="{Binding OwnerName}" SortMemberPath="OwnerName" Width="92" />
                                                    <DataGridTextColumn Header="Date" Binding="{Binding LockedAtText}" SortMemberPath="LockedAt" Width="120" />
                                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" SortMemberPath="Source" Width="62" />
                                                    <DataGridTextColumn Header="ID" Binding="{Binding ShortId}" SortMemberPath="Id" Width="82" />
                                                    <DataGridTemplateColumn Header="" Width="82">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <Button Classes="secondary" Content="Unlock" Padding="7,3" MinHeight="23"
                                                                    Click="OnUnlockLfsLockClick" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            </TabItem>
                                            <TabItem Header="Folders">
                                                <TreeView ItemsSource="{Binding MyLfsLockTree}" Classes="compactTree"
                                                          Background="Transparent" BorderThickness="0" Margin="2">
                                                    <TreeView.ItemTemplate>
                                                        <TreeDataTemplate ItemsSource="{Binding Children}">
                                                            <Grid ColumnDefinitions="16,*,Auto" Height="22" Margin="0"
                                                                  ToolTip.Tip="{Binding RelativePath}">
                                                                <TextBlock Text="{Binding Icon}" Foreground="{Binding AccentColor}"
                                                                           HorizontalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding AccentColor}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted"
                                                                           FontSize="8" Margin="5,0,2,0" />
                                                            </Grid>
                                                        </TreeDataTemplate>
                                                    </TreeView.ItemTemplate>
                                                </TreeView>
                                            </TabItem>
                                            </TabControl>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Background="#302A1F" BorderBrush="#68552F" BorderThickness="1"
                                        CornerRadius="5" Padding="9">
                                    <TextBlock Text="Force unlock is reserved for stale or abandoned locks. It can let two people modify the same binary asset; CyRevision always asks for confirmation before removing another user's lock."
                                               Foreground="#E5C07B" FontSize="10" TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                </TabItem>

                <TabItem x:Name="GitLfsWorkspaceTab" Header="Git LFS">
                    <TabControl Margin="0,8,0,0">
                        <TabItem Header="Time Machine">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="285,*,350" ColumnSpacing="8">
                        <Border Classes="card" Padding="12">
                            <Grid RowDefinitions="Auto,150,Auto,*">
                                <TextBlock Text="Motifs suivis par Git LFS" FontSize="16" FontWeight="SemiBold" Margin="5" />
                                <ListBox Grid.Row="1" Margin="0,7" ItemsSource="{Binding LfsPatterns}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="6">
                                                <TextBlock Text="{Binding Pattern}" FontFamily="Cascadia Mono,Consolas" />
                                                <TextBlock Grid.Column="1" Text="{Binding SourceFile}" Classes="muted" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="7" Margin="0,4,0,10">
                                    <TextBox Text="{Binding LfsPattern}" PlaceholderText="*.uasset" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Ajouter" Click="OnTrackLfsClick" />
                                </Grid>
                                <Grid Grid.Row="3" RowDefinitions="Auto,*">
                                    <Grid Margin="5,0,5,7" ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="Fichiers versionnés" FontWeight="SemiBold" />
                                            <TextBlock Text="On-demand inventory to keep large repositories responsive"
                                                       FontSize="10" Classes="muted" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary" Content="Load LFS files"
                                                Click="OnLoadLfsInventoryClick" Padding="8,4" />
                                    </Grid>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding LfsFiles}" SelectedItem="{Binding SelectedLfsFile}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="6">
                                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Availability}" Foreground="#78D7B7" FontSize="10" />
                                                    <TextBlock Grid.Row="1" Text="{Binding Kind}" Classes="muted" FontSize="10" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}" Classes="muted" FontSize="10" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card" Padding="12">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel Margin="5,2,5,9">
                                    <TextBlock Text="Time Machine LFS" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LfsTimelineSummary}" FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding LfsVersions}" SelectedItem="{Binding SelectedLfsVersion}"
                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Révision" Binding="{Binding Revision.ShortHash}" Width="76" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Revision.Subject}" Width="*" />
                                        <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" Width="78" />
                                        <DataGridTextColumn Header="Stockage" Binding="{Binding Availability}" Width="155" />
                                        <DataGridTextColumn Header="Date" Binding="{Binding Revision.AuthoredAt}" Width="135" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Classes="card" Padding="14">
                            <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
                                <StackPanel>
                                    <TextBlock Text="Aperçu de la version" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Textures affichées sans ouvrir Unreal" FontSize="10" Foreground="#78D7B7" />
                                </StackPanel>
                                <Border Grid.Row="1" Margin="0,12" Background="#0E1526" BorderBrush="#303A55" BorderThickness="1" CornerRadius="9">
                                    <Grid>
                                        <TextBlock Text="Aperçu disponible pour PNG, JPEG, TIFF, BMP et WebP"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                   MaxWidth="250" TextWrapping="Wrap" Classes="muted" />
                                        <Image Source="{Binding LfsPreview}" Stretch="Uniform" Margin="8" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="2" Spacing="5" Margin="0,0,0,12">
                                    <TextBlock Text="• Local : l'objet peut être prévisualisé, exporté ou restauré immédiatement." TextWrapping="Wrap" FontSize="10" Classes="muted" />
                                    <TextBlock Text="• Pair : présence annoncée dans un inventaire signé, sans téléchargement silencieux." TextWrapping="Wrap" FontSize="10" Classes="muted" />
                                    <TextBlock Text="• Archive : copie détectée dans l'archive froide configurée." TextWrapping="Wrap" FontSize="10" Classes="muted" />
                                    <TextBlock Text="• Missing : aucun emplacement vérifié n'est actuellement connu." TextWrapping="Wrap" FontSize="10" Classes="muted" />
                                    <TextBlock Text="• La restauration modifie seulement le fichier de travail et ne l'indexe pas." TextWrapping="Wrap" FontSize="10" Foreground="#E5A94D" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Text="{Binding PeerLfsTransferSummary}" Margin="0,0,0,9"
                                           FontSize="10" Foreground="#78D7B7" TextWrapping="Wrap" />
                                <StackPanel Grid.Row="4" Spacing="7">
                                    <Button Classes="primary" Content="Demander au pair" Click="OnRequestLfsVersionClick"
                                            IsEnabled="{Binding CanRequestSelectedLfsVersion}" HorizontalAlignment="Stretch" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Button Classes="secondary" Content="Exporter…" Click="OnExportLfsVersionClick"
                                                IsEnabled="{Binding SelectedLfsVersion.IsAvailableLocally}" />
                                        <Button Grid.Column="1" Classes="danger" Content="Restaurer dans le projet…"
                                                Click="OnRestoreLfsVersionClick" IsEnabled="{Binding SelectedLfsVersion.IsAvailableLocally}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                        </TabItem>
                        <TabItem Header="Storage &amp; safe cleanup">
                            <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                                <Border Classes="card" Padding="12">
                                    <Grid ColumnDefinitions="1.2*,Auto,1.2*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="7">
                                        <StackPanel Grid.ColumnSpan="4" Margin="0,0,0,4">
                                            <TextBlock Text="External Git LFS storage and retention policy" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="Local refs, stashes, indexes, and worktrees are always protected. Cleanup requires proof on a remote, peer, or verified archive." FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBox Grid.Row="1" Text="{Binding LfsExternalStoragePath}" PlaceholderText="External lfs.storage directory" />
                                        <Button Grid.Row="1" Grid.Column="1" Classes="secondary" Content="Browse..." Click="OnPickLfsExternalStorageClick" />
                                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding LfsManagementArchivePath}" PlaceholderText="Verified archive directory" />
                                        <Button Grid.Row="1" Grid.Column="3" Classes="secondary" Content="Browse..." Click="OnPickLfsManagementArchiveClick" />
                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="Remote" VerticalAlignment="Center" Classes="muted" />
                                            <TextBox Width="110" Text="{Binding LfsCleanupRemoteName}" />
                                            <CheckBox Content="Verify remote" IsChecked="{Binding LfsVerifyRemote}" VerticalAlignment="Center" />
                                            <TextBlock Text="Required copies" VerticalAlignment="Center" Classes="muted" />
                                            <TextBox Width="55" Text="{Binding LfsRequiredCopies}" />
                                            <TextBlock Text="Grace days" VerticalAlignment="Center" Classes="muted" />
                                            <TextBox Width="55" Text="{Binding LfsCleanupGraceDays}" />
                                            <TextBlock Text="Peer proof max age (h)" VerticalAlignment="Center" Classes="muted" />
                                            <TextBox Width="65" Text="{Binding LfsPeerProofMaximumAgeHours}" />
                                            <Button Classes="secondary" Content="Save policy" Click="OnSaveLfsManagementClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Classes="card" Padding="12">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding LfsStorageSummary}" TextWrapping="Wrap" />
                                            <TextBlock Text="Dry-run first: CyRevision never calls git lfs prune without remote verification." FontSize="10" Foreground="#78D7B7" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="primary" Content="Analyze" Click="OnAnalyzeLfsStorageClick" />
                                        <Button Grid.Column="2" Classes="secondary" Content="Archive candidates" Click="OnArchiveLfsCandidatesClick" />
                                        <Button Grid.Column="3" Classes="danger" Content="Clean verified objects..." Click="OnExecuteLfsCleanupClick" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2" ColumnDefinitions="1.55*,1*" ColumnSpacing="8">
                                    <Border Classes="card" Padding="10">
                                        <DataGrid ItemsSource="{Binding LfsCleanupItems}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="OID" Binding="{Binding OidSha256}" Width="185" />
                                                <DataGridTextColumn Header="Bytes" Binding="{Binding Size}" Width="90" />
                                                <DataGridTextColumn Header="Copies" Binding="{Binding Evidence.Count}" Width="65" />
                                                <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                    <Border Grid.Column="1" Classes="card" Padding="12">
                                        <Grid RowDefinitions="Auto,*,Auto">
                                            <TextBlock Text="Remote verification report" FontWeight="SemiBold" />
                                            <TextBox Grid.Row="1" Margin="0,8" Text="{Binding LfsRemoteVerification}" IsReadOnly="True"
                                                     AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                            <StackPanel Grid.Row="2" Spacing="7">
                                                <CheckBox Content="After verification, remove the old object cache" IsChecked="{Binding LfsRemoveOriginalAfterRelocation}" />
                                                <Button Classes="secondary" Content="Relocate and activate external storage..." Click="OnRelocateLfsStorageClick" />
                                                <TextBlock Text="A destination ownership marker prevents multiple repositories from sharing one lfs.storage directory." FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="3" Text="If a branch or PR exists only locally, its LFS objects remain protected. In decentralized mode, at least the configured number of fresh peer or archive copies is required." FontSize="10" Foreground="#E5A94D" TextWrapping="Wrap" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem x:Name="BackupsWorkspaceTab" Header="Sauvegardes">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="1.25*,1*" ColumnSpacing="8">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="Snapshots disponibles" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Les données identiques ne sont stockées qu'une fois." FontSize="11" Classes="muted" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="primary" Content="Sauvegarder maintenant" Click="OnCreateBackupClick" />
                                </Grid>
                                <DataGrid Grid.Row="1" Margin="0,12" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt}" Width="*" />
                                        <DataGridTextColumn Header="ID" Binding="{Binding ShortId}" Width="90" />
                                        <DataGridTextColumn Header="Taille" Binding="{Binding LogicalSize}" Width="90" />
                                        <DataGridTextColumn Header="Ajouté" Binding="{Binding StoredSize}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Grid.Row="2" Classes="secondary" Content="Restaurer la sélection dans…" Click="OnRestoreBackupClick" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <ScrollViewer>
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Stockage et conservation" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Emplacement local, volume réseau monté ou dossier NAS" FontSize="11" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Text="{Binding BackupStorePath}" IsReadOnly="True" PlaceholderText="Emplacement par défaut CyRevision" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Choisir…" Click="OnPickBackupStoreClick" />
                                    </Grid>
                                    <TextBlock Text="Mode de rétention" Margin="0,7,0,0" />
                                    <ComboBox ItemsSource="{Binding RetentionModes}" SelectedItem="{Binding SelectedRetentionMode}" />
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Versions max." FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding RetentionVersions}" PlaceholderText="30" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Âge max. (jours)" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding RetentionDays}" PlaceholderText="90" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Budget (Go)" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding RetentionBudgetGb}" PlaceholderText="illimité" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="#29324A" Margin="0,6" />
                                    <TextBlock Text="Archive froide des anciens snapshots" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Copie vers un disque, NAS ou stockage monté moins cher. Le stockage actif n'est jamais supprimé automatiquement."
                                               TextWrapping="Wrap" FontSize="10" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Text="{Binding ColdArchivePath}" IsReadOnly="True" PlaceholderText="Archive froide facultative" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Choisir…" Click="OnPickColdArchiveClick" />
                                    </Grid>
                                    <Grid ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Archiver après (jours)" FontSize="10" Classes="muted" />
                                            <TextBox Text="{Binding ColdArchiveAfterDays}" PlaceholderText="180" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ColdArchiveStatus}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" FontSize="10" Classes="muted" />
                                        <Button Grid.Column="2" Classes="secondary" Content="Archiver maintenant" Click="OnArchiveOldBackupsClick" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <Button Classes="primary" Content="Enregistrer la stratégie" Click="OnSaveBackupSettingsClick" HorizontalAlignment="Left" Margin="0,7,0,0" />
                                    <TextBlock Text="La restauration refuse d'écraser des fichiers existants afin de protéger le projet courant." TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="SynchronizationWorkspaceTab" Header="Synchronisation">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="1*,1.25*" ColumnSpacing="8">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Instance Syncthing CyRevision" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SyncState}" FontSize="14" FontWeight="SemiBold" Foreground="#78D7B7" />
                                <TextBlock Text="{Binding SyncDetails}" TextWrapping="Wrap" Classes="muted" />
                                <TextBlock Text="Exécutable" Margin="0,7,0,0" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding SyncthingExecutablePath}" IsReadOnly="True" PlaceholderText="Non configuré" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Choisir…" Click="OnPickSyncthingClick" />
                                </Grid>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="primary" Content="Démarrer" Click="OnStartSyncClick" Margin="0,4,7,4" />
                                    <Button Classes="secondary" Content="Pause" Click="OnPauseSyncClick" Margin="0,4,7,4" />
                                    <Button Classes="secondary" Content="Reprendre" Click="OnResumeSyncClick" Margin="0,4,7,4" />
                                    <Button Classes="danger" Content="Arrêter" Click="OnStopSyncClick" Margin="0,4,7,4" />
                                    <Button Classes="secondary" Content="Échanger Git maintenant" Click="OnExchangeGitClick" Margin="0,4,7,4" />
                                </WrapPanel>
                                <Border Background="#10241F" CornerRadius="8" Padding="11" Margin="0,8,0,0">
                                    <TextBlock Text="CyRevision utilise ses propres dossiers config/data, une API locale dédiée et ne recherche ni n'arrête les autres processus Syncthing." TextWrapping="Wrap" FontSize="11" Foreground="#78D7B7" />
                                </Border>
                                <Border Height="1" Background="#29324A" Margin="0,5" />
                                <TextBlock Text="Plan de synchronisation intelligent" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SmartSyncPlanSummary}" TextWrapping="Wrap" FontSize="10" Classes="muted" />
                                <Grid ColumnDefinitions="*,90,Auto" ColumnSpacing="7">
                                    <ComboBox ItemsSource="{Binding LfsHistoryModes}" SelectedItem="{Binding SelectedLfsHistoryMode}" />
                                    <TextBox Grid.Column="1" Text="{Binding SmartSyncRecentVersionCount}" PlaceholderText="Versions" />
                                    <CheckBox Grid.Column="2" Content="Répliquer les backups" IsChecked="{Binding SmartSyncReplicateBackups}" VerticalAlignment="Center" />
                                </Grid>
                                <ListBox ItemsSource="{Binding SmartSyncPlanItems}" MaxHeight="210">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="5">
                                                <TextBlock Text="{Binding Content}" FontWeight="SemiBold" />
                                                <Border Grid.Column="1" Background="#242C47" CornerRadius="5" Padding="6,2">
                                                    <TextBlock Text="{Binding Priority}" FontSize="9" Foreground="#B8C1D8" />
                                                </Border>
                                                <TextBlock Grid.Row="1" Text="{Binding Strategy}" FontSize="10" Classes="muted" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}" FontSize="10" Classes="muted" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,Auto,110,*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Admission sécurisée des pairs" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Échanges signés, invitation à usage unique et code de vérification." TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,105,*" ColumnSpacing="8" Margin="0,10,0,8">
                                    <ComboBox ItemsSource="{Binding PeerRoles}" SelectedItem="{Binding SelectedPeerRole}" MinWidth="145" />
                                    <TextBox Grid.Column="1" Text="{Binding PeerVerificationCode}" PlaceholderText="Code" />
                                    <Button Grid.Column="2" Classes="primary" Content="Créer une invitation (24 h)" Click="OnCreateInvitationClick" HorizontalAlignment="Left" />
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ListBox ItemsSource="{Binding PeerMembers}" SelectedItem="{Binding SelectedPeerMember}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="5" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Role}" Classes="muted" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DeviceIdShort}" FontFamily="Consolas" Classes="muted" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Grid.Column="1" Classes="danger" Content="Révoquer" Click="OnRevokePeerClick" VerticalAlignment="Top" />
                                </Grid>
                                <TextBox Grid.Row="3" Text="{Binding PeerExchangeText}" AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Cascadia Mono,Consolas" FontSize="11" PlaceholderText="Collez ici une invitation, une demande ou un certificat…"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <WrapPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Classes="secondary" Content="Préparer la demande" Click="OnPrepareJoinRequestClick" Margin="0,3,7,3" />
                                    <Button Classes="secondary" Content="Approuver la demande" Click="OnApproveJoinRequestClick" Margin="0,3,7,3" />
                                    <Button Classes="primary" Content="Importer le certificat" Click="OnImportMembershipGrantClick" Margin="0,3,7,3" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="VpnWorkspaceTab" Header="VPN WireGuard">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="0.95*,1.25*" ColumnSpacing="8">
                        <Border Classes="card">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Assistant WireGuard CyRevision" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding VpnState}" FontSize="14" FontWeight="SemiBold" Foreground="#78D7B7" />
                                    <TextBlock Text="{Binding VpnDetails}" TextWrapping="Wrap" Classes="muted" />
                                    <Grid ColumnDefinitions="190,*" ColumnSpacing="9">
                                        <StackPanel>
                                            <TextBlock Text="Moteur WireGuard" FontSize="11" Classes="muted" />
                                            <ComboBox ItemsSource="{Binding VpnBackendModes}" SelectedItem="{Binding SelectedVpnBackendMode}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding VpnBackendDetails}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" FontSize="10.5" Foreground="#78D7B7" />
                                    </Grid>
                                    <Button Classes="primary" Content="Configurer le moteur sélectionné" Click="OnConfigureVpnClick" HorizontalAlignment="Left" />

                                    <TextBlock Text="Runtime actif" Margin="0,5,0,0" />
                                    <TextBox Text="{Binding WireGuardExecutablePath}" IsReadOnly="True" PlaceholderText="WireGuard non détecté" />

                                    <Grid ColumnDefinitions="1.25*,1*,0.65*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Réseau privé" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding VpnNetworkCidr}" PlaceholderText="10.80.1.0/24" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Adresse locale" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding VpnLocalAddress}" PlaceholderText="10.80.1.1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Port" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding VpnListenPort}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Endpoint public ou DNS (facultatif)" FontSize="11" Classes="muted" />
                                    <TextBox Text="{Binding VpnPublicEndpoint}" PlaceholderText="vpn.mondomaine.fr:51820" />
                                    <TextBlock Text="Fonction de cet appareil" FontSize="11" Classes="muted" />
                                    <ComboBox ItemsSource="{Binding VpnCapabilities}" SelectedItem="{Binding SelectedVpnCapability}" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="secondary" Content="Enregistrer" Click="OnSaveVpnClick" Margin="0,3,7,3" />
                                        <Button Classes="primary" Content="Activer" Click="OnStartVpnClick" Margin="0,3,7,3" />
                                        <Button Classes="danger" Content="Arrêter" Click="OnStopVpnClick" Margin="0,3,7,3" />
                                        <Button Classes="secondary" Content="Actualiser" Click="OnRefreshVpnClick" Margin="0,3,7,3" />
                                    </WrapPanel>
                                    <Border Background="#10241F" CornerRadius="8" Padding="11">
                                        <TextBlock Text="CyRevision contrôle uniquement l'interface cyrev-* de ce projet. Tes autres tunnels WireGuard ne sont jamais arrêtés ni modifiés." TextWrapping="Wrap" FontSize="11" Foreground="#78D7B7" />
                                    </Border>
                                    <Expander Header="Guided setup · computer, firewall, router" Margin="0,3,0,0">
                                        <StackPanel Spacing="8" Margin="0,8,0,2">
                                            <TextBlock Text="{Binding VpnSetupSummary}" TextWrapping="Wrap" FontSize="11" Foreground="#78D7B7" />
                                            <WrapPanel Orientation="Horizontal">
                                                <CheckBox Content="This computer accepts incoming VPN connections"
                                                          IsChecked="{Binding VpnSetupAcceptIncoming}" Margin="0,2,14,2" />
                                                <CheckBox Content="Unreal Swarm over VPN"
                                                          IsChecked="{Binding VpnSetupAllowSwarm}" Margin="0,2,14,2" />
                                                <CheckBox Content="CyRevision control API over VPN"
                                                          IsChecked="{Binding VpnSetupAllowControlApi}" Margin="0,2,14,2" />
                                                <CheckBox Content="Secure file exchange over VPN"
                                                          IsChecked="{Binding VpnSetupAllowFileExchange}" Margin="0,2,14,2" />
                                                <CheckBox Content="Remote build agent over VPN"
                                                          IsChecked="{Binding VpnSetupAllowRemoteBuild}" Margin="0,2,14,2" />
                                            </WrapPanel>
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Classes="primary" Content="1 · Diagnose this computer"
                                                        Click="OnInspectVpnSetupClick" Margin="0,3,7,3" />
                                                <Button Classes="secondary" Content="2 · Apply firewall rules"
                                                        IsEnabled="{Binding VpnCanApplyFirewall}"
                                                        Click="OnApplyVpnFirewallClick" Margin="0,3,7,3" />
                                                <Button Classes="danger" Content="Remove CyRevision rules"
                                                        IsEnabled="{Binding VpnCanApplyFirewall}"
                                                        Click="OnRemoveVpnFirewallClick" Margin="0,3,7,3" />
                                                <Button Classes="secondary" Content="3 · Open router page"
                                                        IsEnabled="{Binding VpnCanOpenRouter}"
                                                        Click="OnOpenVpnRouterClick" Margin="0,3,7,3" />
                                                <Button Classes="secondary" Content="4 · Test tunnel and peers"
                                                        Click="OnTestVpnConnectivityClick" Margin="0,3,7,3" />
                                            </WrapPanel>
                                            <Border Background="#111A2D" CornerRadius="6" Padding="9">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding VpnSetupNetwork}" TextWrapping="Wrap" FontSize="10.5" />
                                                    <TextBlock Text="{Binding VpnFirewallStatus}" TextWrapping="Wrap" FontSize="10.5" Foreground="#78D7B7" />
                                                </StackPanel>
                                            </Border>
                                            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                                <StackPanel>
                                                    <TextBlock Text="Computer checklist" FontSize="10.5" Classes="muted" />
                                                    <TextBox Text="{Binding VpnComputerGuide}" IsReadOnly="True" AcceptsReturn="True"
                                                             TextWrapping="Wrap" MinHeight="105" FontSize="10" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Router / modem checklist" FontSize="10.5" Classes="muted" />
                                                    <TextBox Text="{Binding VpnRouterGuide}" IsReadOnly="True" AcceptsReturn="True"
                                                             TextWrapping="Wrap" MinHeight="105" FontSize="10" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Generated commands" FontSize="10.5" Classes="muted" />
                                            <TextBox Text="{Binding VpnFirewallCommands}" IsReadOnly="True" AcceptsReturn="True"
                                                     TextWrapping="Wrap" MinHeight="58" FontFamily="Cascadia Mono,Consolas" FontSize="9.5" />
                                            <TextBlock Text="Connectivity" FontSize="10.5" Classes="muted" />
                                            <TextBlock Text="{Binding VpnConnectivityStatus}" TextWrapping="Wrap"
                                                       FontSize="10.5" Foreground="#78D7B7" />
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock Text="Aperçu sécurisé de la configuration" FontSize="11" Classes="muted" />
                                    <TextBox Text="{Binding VpnConfigurationPreview}" IsReadOnly="True" AcceptsReturn="True"
                                             MinHeight="110" FontFamily="Cascadia Mono,Consolas" FontSize="10"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,125,Auto,150,Auto,Auto,125,Auto">
                                <StackPanel>
                                    <TextBlock Text="Pairs et services VPN" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="VPN seul, Swarm, CI ou service : aucun accès Git/Sync n'est ajouté automatiquement." TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                </StackPanel>
                                <DataGrid Grid.Row="1" Margin="0,10,0,8" ItemsSource="{Binding VpnPeers}" SelectedItem="{Binding SelectedVpnPeer}"
                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Appareil" Binding="{Binding DisplayName}" Width="1.1*" />
                                        <DataGridTextColumn Header="IP VPN" Binding="{Binding TunnelAddress}" Width="0.8*" />
                                        <DataGridTextColumn Header="Fonction" Binding="{Binding Capabilities}" Width="1.15*" />
                                        <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="1.2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Row="2" ColumnDefinitions="190,*" ColumnSpacing="8" Margin="0,2,0,8">
                                    <ComboBox ItemsSource="{Binding VpnCapabilities}" SelectedItem="{Binding SelectedVpnInvitationCapability}" />
                                    <Button Grid.Column="1" Classes="primary" Content="Créer une invitation VPN (24 h)" Click="OnCreateVpnInvitationClick" HorizontalAlignment="Left" />
                                </Grid>
                                <TextBox Grid.Row="3" Text="{Binding VpnExchangeText}" AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Cascadia Mono,Consolas" FontSize="10"
                                         PlaceholderText="Collez ici une invitation VPN ou la réponse signée d'un pair…"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="secondary" Content="Rejoindre l'invitation" Click="OnJoinVpnInvitationClick" Margin="0,3,7,3" />
                                        <Button Classes="primary" Content="Accepter la réponse" Click="OnAcceptVpnResponseClick" Margin="0,3,7,3" />
                                        <Button Classes="danger" Content="Retirer le pair" Click="OnRemoveVpnPeerClick" Margin="0,3,7,3" />
                                    </WrapPanel>
                                    <Border Grid.Column="1" Background="#1B2237" CornerRadius="8" Padding="10,6">
                                        <TextBlock Text="Swarm : Windows · TCP 8008/8009" FontSize="10" Foreground="#B8C1D8" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="5" Margin="0,10,0,4">
                                    <TextBlock Text="Signed VPN exchange through Sync" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Only signed invitations and responses are synchronized. Private keys never enter Sync."
                                               TextWrapping="Wrap" FontSize="10.5" Classes="muted" />
                                </StackPanel>
                                <DataGrid Grid.Row="6" ItemsSource="{Binding VpnSyncMessages}"
                                          SelectedItem="{Binding SelectedVpnSyncMessage}"
                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="0.8*" />
                                        <DataGridTextColumn Header="Sender" Binding="{Binding Sender}" Width="0.7*" />
                                        <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="1*" />
                                        <DataGridTextColumn Header="Expires" Binding="{Binding Expires}" Width="1*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Row="7" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="7" Margin="0,6,0,0">
                                    <Button Classes="primary" Content="Share current message"
                                            Click="OnPublishVpnSyncClick" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Refresh Sync inbox"
                                            Click="OnRefreshVpnSyncClick" />
                                    <Button Grid.Column="2" Classes="secondary" Content="Load selected"
                                            Click="OnLoadVpnSyncClick" />
                                    <TextBlock Grid.Column="3" Text="{Binding VpnSyncStatus}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" FontSize="10" Foreground="#78D7B7" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="SwarmWorkspaceTab" Header="Swarm over VPN">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="1.03*,0.97*" ColumnSpacing="8">
                        <Border Classes="card">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Unreal Swarm session" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Configure Swarm Agent and an optional Coordinator on the project WireGuard network. Swarm remains Windows-only."
                                               TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                    <TextBlock Text="{Binding SwarmStatus}" TextWrapping="Wrap" Foreground="#78D7B7" />

                                    <Grid ColumnDefinitions="180,*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="This computer" FontSize="10.5" Classes="muted" />
                                            <ComboBox ItemsSource="{Binding SwarmRoles}" SelectedItem="{Binding SelectedSwarmRole}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Coordinator VPN IPv4" FontSize="10.5" Classes="muted" />
                                            <TextBox Text="{Binding SwarmCoordinatorAddress}" PlaceholderText="10.80.40.1" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Local coordinator alias" FontSize="10.5" Classes="muted" />
                                    <TextBox Text="{Binding SwarmCoordinatorAlias}" PlaceholderText="cyrev-swarm-project" />
                                    <TextBlock Text="The alias is an optional local hosts/DNS entry. Swarm can also use the VPN IPv4 directly."
                                               TextWrapping="Wrap" FontSize="10" Classes="muted" />

                                    <TextBlock Text="SwarmAgent.exe" FontSize="10.5" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <TextBox Text="{Binding SwarmAgentPath}" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Browseâ€¦" Click="OnPickSwarmAgentClick" />
                                    </Grid>
                                    <TextBlock Text="SwarmCoordinator.exe" FontSize="10.5" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <TextBox Text="{Binding SwarmCoordinatorPath}" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Browseâ€¦" Click="OnPickSwarmCoordinatorClick" />
                                    </Grid>
                                    <TextBlock Text="SwarmAgent.Options.xml" FontSize="10.5" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <TextBox Text="{Binding SwarmOptionsPath}" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Browseâ€¦" Click="OnPickSwarmOptionsClick" />
                                    </Grid>

                                    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Agent group" FontSize="10.5" Classes="muted" />
                                            <TextBox Text="{Binding SwarmAgentGroup}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Allowed remote group" FontSize="10.5" Classes="muted" />
                                            <TextBox Text="{Binding SwarmAllowedGroup}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Allowed remote agent names" FontSize="10.5" Classes="muted" />
                                    <TextBox Text="{Binding SwarmAllowedAgents}" />
                                    <TextBlock Text="Swarm cache folder (optional)" FontSize="10.5" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <TextBox Text="{Binding SwarmCacheFolder}" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Browseâ€¦" Click="OnPickSwarmCacheClick" />
                                    </Grid>

                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="secondary" Content="Save session" Click="OnSaveSwarmClick" Margin="0,3,7,3" />
                                        <Button Classes="primary" Content="Apply Agent configuration" Click="OnApplySwarmOptionsClick" Margin="0,3,7,3" />
                                        <Button Classes="secondary" Content="Apply local DNS alias" Click="OnApplySwarmDnsClick" Margin="0,3,7,3" />
                                        <Button Classes="danger" Content="Remove local alias" Click="OnRemoveSwarmDnsClick" Margin="0,3,7,3" />
                                    </WrapPanel>
                                    <Border Background="#10241F" CornerRadius="7" Padding="10">
                                        <TextBlock Text="CyRevision backs up the existing Swarm XML and edits only known fields. Its DNS entry is enclosed in a project-owned block. Firewall rules remain restricted to the VPN subnet; never forward TCP 8008/8009 on the modem."
                                                   TextWrapping="Wrap" FontSize="10.5" Foreground="#78D7B7" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,Auto,*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Connection and configuration tests" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Tests the VPN address, executable paths, Agent XML, local DNS, project firewall and TCP 8008/8009."
                                               TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                </StackPanel>
                                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
                                    <Button Classes="primary" Content="Run full diagnosis" Click="OnDiagnoseSwarmClick" Margin="0,3,7,3" />
                                    <Button Classes="secondary" Content="Launch Agent" Click="OnLaunchSwarmAgentClick" Margin="0,3,7,3" />
                                    <Button Classes="secondary" Content="Launch Coordinator" Click="OnLaunchSwarmCoordinatorClick" Margin="0,3,7,3"
                                            IsEnabled="{Binding SwarmHostsCoordinator}" />
                                </WrapPanel>
                                <TextBox Grid.Row="2" Text="{Binding SwarmDiagnostic}" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas" FontSize="10.5"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <Border Grid.Row="3" Background="#1B2237" CornerRadius="7" Padding="10" Margin="0,8,0,0">
                                    <TextBlock Text="When automatic repair is unavailable, every failed check includes an exact corrective step. Swarm is never exposed to the public Internet."
                                               TextWrapping="Wrap" FontSize="10.5" Classes="muted" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="VpnFilesWorkspaceTab" Header="VPN files">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="0.92*,1.08*" ColumnSpacing="8">
                        <Border Classes="card">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Private inbox and explicit folder share" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="The endpoint binds only to this project's VPN IPv4. WireGuard encrypts transport and a 256-bit project token authorizes every operation."
                                               TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                    <TextBlock Text="{Binding VpnFileStatus}" TextWrapping="Wrap" Foreground="#78D7B7" />
                                    <Grid ColumnDefinitions="*,115" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Project access token" FontSize="10.5" Classes="muted" />
                                            <TextBox Text="{Binding VpnFileAccessToken}" PasswordChar="*" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="TCP port" FontSize="10.5" Classes="muted" />
                                            <TextBox Text="{Binding VpnFileListenPort}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Private inbox for received files" FontSize="10.5" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <TextBox Text="{Binding VpnFileInboxPath}" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Browseâ€¦" Click="OnPickVpnInboxClick" />
                                    </Grid>
                                    <TextBlock Text="Folder explicitly shared with authorized VPN peers" FontSize="10.5" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <TextBox Text="{Binding VpnFileSharedFolderPath}" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Browseâ€¦" Click="OnPickVpnSharedFolderClick" />
                                    </Grid>
                                    <WrapPanel Orientation="Horizontal">
                                        <CheckBox Content="Receive into inbox" IsChecked="{Binding VpnFileAllowReceive}" Margin="0,2,14,2" />
                                        <CheckBox Content="Expose file list" IsChecked="{Binding VpnFileAllowBrowse}" Margin="0,2,14,2" />
                                        <CheckBox Content="Allow downloads" IsChecked="{Binding VpnFileAllowDownload}" Margin="0,2,14,2" />
                                        <CheckBox Content="Start with project" IsChecked="{Binding VpnFileStartAutomatically}" Margin="0,2,14,2" />
                                    </WrapPanel>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="secondary" Content="Save" Click="OnSaveVpnFilesClick" Margin="0,3,7,3" />
                                        <Button Classes="primary" Content="Start endpoint" Click="OnStartVpnFilesClick" Margin="0,3,7,3" />
                                        <Button Classes="danger" Content="Stop endpoint" Click="OnStopVpnFilesClick" Margin="0,3,7,3" />
                                        <Button Classes="danger" Content="Rotate token" Click="OnRotateVpnFileTokenClick" Margin="0,3,7,3" />
                                    </WrapPanel>
                                    <Border Background="#10241F" CornerRadius="7" Padding="10">
                                        <TextBlock Text="Received files never overwrite existing files, every transfer is checked with SHA-256, partial files are discarded on failure, and symbolic links/junctions cannot escape the shared root. Share the token only through a separate trusted channel."
                                                   TextWrapping="Wrap" FontSize="10.5" Foreground="#78D7B7" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Send, receive and browse" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Select an authorized WireGuard peer. Git, Sync and repository files are not touched."
                                               TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,10,0,8">
                                    <ComboBox ItemsSource="{Binding VpnPeers}" SelectedItem="{Binding SelectedVpnFilePeer}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding TunnelAddress}" Classes="muted" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" Classes="secondary" Content="Test authenticated peer" Click="OnTestVpnFilePeerClick" />
                                </Grid>
                                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Classes="primary" Content="Send file to inboxâ€¦" Click="OnSendVpnFileClick" Margin="0,3,7,3" />
                                    <Button Classes="secondary" Content="Refresh shared folder" Click="OnRefreshVpnSharedFilesClick" Margin="0,3,7,3" />
                                    <Button Classes="secondary" Content="Download selectedâ€¦" Click="OnDownloadVpnSharedFileClick" Margin="0,3,7,3" />
                                </WrapPanel>
                                <DataGrid Grid.Row="3" ItemsSource="{Binding VpnSharedFiles}" SelectedItem="{Binding SelectedVpnSharedFile}"
                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Shared file" Binding="{Binding RelativePath}" Width="1.8*" />
                                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="0.55*" />
                                        <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="0.8*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="4" Text="No SMB share, no public listener, no automatic overwrite and no implicit repository access."
                                           Margin="0,8,0,0" TextWrapping="Wrap" FontSize="10.5" Classes="muted" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="RemoteBuildsWorkspaceTab" Header="Remote builds">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="0.9*,1.25*" ColumnSpacing="8">
                        <Border Classes="card" Padding="14">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8">
                                <StackPanel>
                                    <TextBlock Text="VPN remote build agent" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Run a locally allowlisted recipe on a CI/build machine without pushing a branch or polluting a Git remote." FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Project ID for agent.json:" FontSize="10" Foreground="#78D7B7" />
                                        <TextBlock Text="{Binding SelectedProject.Id}" FontSize="10" FontFamily="Cascadia Mono,Consolas" />
                                    </StackPanel>
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="Endpoint" VerticalAlignment="Center" Classes="muted" />
                                    <TextBox Grid.Column="1" Text="{Binding RemoteBuildEndpoint}" PlaceholderText="http://10.70.0.10:47841" />
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="Agent token" VerticalAlignment="Center" Classes="muted" />
                                    <TextBox Grid.Column="1" Text="{Binding RemoteBuildAccessToken}" PasswordChar="●" />
                                </Grid>
                                <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="Recipe ID" VerticalAlignment="Center" Classes="muted" />
                                    <TextBox Grid.Column="1" Text="{Binding RemoteBuildRecipeId}" PlaceholderText="unreal-win64-development" />
                                    <TextBlock Grid.Column="2" Text="Source" VerticalAlignment="Center" Classes="muted" />
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding RemoteBuildSourceModes}" SelectedItem="{Binding SelectedRemoteBuildSourceMode}" />
                                </Grid>
                                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding RemoteBuildArtifactDestination}" PlaceholderText="Downloaded artifact directory" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Browse..." Click="OnPickRemoteBuildArtifactsClick" />
                                </Grid>
                                <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10">
                                    <CheckBox Content="Trust plain HTTP only on private/VPN IP" IsChecked="{Binding RemoteBuildAllowPrivateHttp}" />
                                    <TextBlock Text="Max upload (GB)" VerticalAlignment="Center" Classes="muted" />
                                    <TextBox Width="70" Text="{Binding RemoteBuildMaximumUploadGb}" />
                                </StackPanel>
                                <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="secondary" Content="Save" Click="OnSaveRemoteBuildClick" />
                                    <Button Classes="secondary" Content="Test agent" Click="OnTestRemoteBuildClick" />
                                    <Button Classes="primary" Content="Start remote build" Click="OnStartRemoteBuildClick" />
                                    <Button Classes="danger" Content="Cancel" Click="OnCancelRemoteBuildClick" IsEnabled="{Binding IsRemoteBuildRunning}" />
                                </StackPanel>
                                <StackPanel Grid.Row="7" Margin="0,12,0,0" Spacing="6">
                                    <TextBlock Text="Security model" FontWeight="SemiBold" />
                                    <TextBlock Text="• The agent owns agent.json and the executable, arguments, timeout, workspace, and artifact allowlist." FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                    <TextBlock Text="• Existing workspace mode transfers no source; Uploaded snapshot sends tracked and non-ignored files without .git or build caches." FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                    <TextBlock Text="• Bind the agent to its WireGuard IP and never forward port 47841 on the router." FontSize="10" Foreground="#E5A94D" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card" Padding="14">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel>
                                    <TextBlock Text="Build status and live log" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RemoteBuildStatus}" FontSize="11" Foreground="#78D7B7" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Row="1" Margin="0,12,0,0" Text="{Binding RemoteBuildLog}" IsReadOnly="True"
                                         AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="DiscordWorkspaceTab" Header="Agent Discord">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="1.08*,0.92*" ColumnSpacing="8">
                        <Border Classes="card">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Notifications du projet vers Discord" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Le webhook choisit directement le salon cible. Aucun bot Discord complet ni jeton global n'est nécessaire."
                                               TextWrapping="Wrap" FontSize="11" Classes="muted" />

                                    <Grid ColumnDefinitions="180,*" ColumnSpacing="10" Margin="0,5,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Mode d'exécution" FontSize="11" Classes="muted" />
                                            <ComboBox ItemsSource="{Binding DiscordExecutionModes}"
                                                      SelectedItem="{Binding SelectedDiscordExecutionMode}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DiscordConnectionSummary}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   FontSize="11" Foreground="#78D7B7" />
                                    </Grid>

                                    <Border IsVisible="{Binding DiscordUsesAutonomousAgent}"
                                            Background="#1B2237" BorderBrush="#3D4965" BorderThickness="1"
                                            CornerRadius="6" Padding="10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Contrôle de l'agent autonome" FontSize="14" FontWeight="SemiBold" />
                                            <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="8">
                                                <StackPanel>
                                                    <TextBlock Text="Adresse de l'API" FontSize="10.5" Classes="muted" />
                                                    <TextBox Text="{Binding DiscordAgentEndpoint}" PlaceholderText="http://127.0.0.1:47831" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Jeton de contrôle" FontSize="10.5" Classes="muted" />
                                                    <TextBox Text="{Binding DiscordAgentApiToken}" PasswordChar="●"
                                                             PlaceholderText="{Binding DiscordControlTokenHint}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Chemin du dépôt vu par la machine agent" FontSize="10.5" Classes="muted" />
                                            <TextBox Text="{Binding DiscordAgentRepositoryPath}" PlaceholderText="D:\Projects\MonProjet ou /srv/projects/mon-projet" />
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <CheckBox Content="Autoriser HTTP uniquement dans un VPN WireGuard de confiance"
                                                          IsChecked="{Binding DiscordAllowPrivateHttp}"
                                                          VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Classes="secondary" Content="Connecter"
                                                        Click="OnConnectDiscordAgentClick" />
                                                <Button Grid.Column="2" Classes="primary" Content="Lancer l'agent local"
                                                        Click="OnLaunchLocalDiscordAgentClick" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Webhook entrant du salon" FontSize="11" Classes="muted" Margin="0,5,0,0" />
                                    <TextBox Text="{Binding DiscordWebhookUrl}"
                                             PasswordChar="●"
                                             PlaceholderText="{Binding DiscordWebhookHint}" />
                                    <TextBlock Text="L'URL existante n'est jamais réaffichée après son enregistrement."
                                               TextWrapping="Wrap" FontSize="10" Foreground="#78D7B7" />

                                    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Nom affiché" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding DiscordDisplayName}" PlaceholderText="CyRevision" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Nom du projet dans Discord" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding DiscordProjectLabel}" PlaceholderText="Mon projet" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Page web du dépôt (facultatif)" FontSize="11" Classes="muted" />
                                    <TextBox Text="{Binding DiscordRepositoryWebUrl}" PlaceholderText="https://github.com/organisation/projet" />

                                    <Grid ColumnDefinitions="145,*" ColumnSpacing="12">
                                        <StackPanel>
                                            <TextBlock Text="Intervalle (secondes)" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding DiscordPollIntervalSeconds}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="7" Margin="0,2,0,0">
                                            <CheckBox Content="Nouveaux commits groupés" IsChecked="{Binding DiscordNotifyCommits}" />
                                            <CheckBox Content="Changements de branche active" IsChecked="{Binding DiscordNotifyBranchChanges}" />
                                            <CheckBox Content="Démarrer automatiquement avec ce projet" IsChecked="{Binding DiscordStartAutomatically}" />
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Classes="secondary" Content="Enregistrer" Click="OnSaveDiscordAgentClick" Margin="0,3,7,3" />
                                        <Button Classes="secondary" Content="Envoyer un test" Click="OnTestDiscordWebhookClick" Margin="0,3,7,3" />
                                        <Button Classes="danger" Content="Retirer le webhook" Click="OnRemoveDiscordWebhookClick" Margin="0,3,7,3" />
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="État de l'agent" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DiscordAgentState}" FontSize="14" FontWeight="SemiBold" Foreground="#78D7B7" />
                                    <TextBlock Text="{Binding DiscordAgentDetails}" TextWrapping="Wrap" Classes="muted" />
                                    <TextBlock Text="{Binding DiscordLastActivity}" TextWrapping="Wrap" FontSize="11" Foreground="#B8C1D8" />
                                </StackPanel>

                                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,13,0,8">
                                    <Button Classes="primary" Content="Démarrer" Click="OnStartDiscordAgentClick" Margin="0,3,7,3" />
                                    <Button Classes="danger" Content="Arrêter" Click="OnStopDiscordAgentClick" Margin="0,3,7,3" />
                                    <Button Classes="secondary" Content="Vérifier maintenant" Click="OnCheckDiscordAgentClick" Margin="0,3,7,3" />
                                </WrapPanel>

                                <Border Grid.Row="2" Height="1" Background="#393B40" Margin="0,4,0,12" />

                                <StackPanel Grid.Row="3" Spacing="9">
                                    <TextBlock Text="Comportement" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="• Le premier démarrage mémorise HEAD sans publier l'ancien historique." TextWrapping="Wrap" />
                                    <TextBlock Text="• Les commits reçus par Pull, Sync ou créés localement sont détectés." TextWrapping="Wrap" />
                                    <TextBlock Text="• Le point de contrôle avance uniquement après une réponse Discord valide." TextWrapping="Wrap" />
                                    <TextBlock Text="• Les mentions Discord sont toujours désactivées dans les messages automatiques." TextWrapping="Wrap" />
                                    <TextBlock Text="• Active l'agent automatique sur une seule machine par projet pour éviter les doublons." TextWrapping="Wrap" />
                                    <TextBlock Text="• Le mode autonome continue de fonctionner lorsque l'interface CyRevision est fermée." TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Row="4" Background="#151D31" CornerRadius="6" Padding="11" Margin="0,12,0,0">
                                    <TextBlock Text="Les pull requests restent un événement propre à GitHub/GitLab. L'agent CyRevision couvre les mises à jour Git visibles localement, même sans forge centrale."
                                               TextWrapping="Wrap" FontSize="10.5" Foreground="#B8C1D8" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="WorkInProgressWorkspaceTab" Header="Travail en cours">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="1.45*,0.75*" ColumnSpacing="8">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel>
                                    <TextBlock Text="Réservations souples des assets" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Présence informative partagée par CyRevision, sans checkout ni verrou LFS."
                                               FontSize="11" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <DataGrid Grid.Row="1" Margin="0,12,0,0"
                                          ItemsSource="{Binding AdvisoryReservations}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Asset" Binding="{Binding Asset}" Width="1.7*" />
                                        <DataGridTextColumn Header="Personne" Binding="{Binding Owner}" Width="1*" />
                                        <DataGridTextColumn Header="Machine" Binding="{Binding Machine}" Width="1*" />
                                        <DataGridTextColumn Header="Actualisé" Binding="{Binding UpdatedAt}" Width="155" />
                                        <DataGridTextColumn Header="État" Binding="{Binding State}" Width="85" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <StackPanel Spacing="11">
                                <TextBlock Text="Mode non bloquant" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ReservationSummary}" TextWrapping="Wrap" Foreground="#78D7B7" />
                                <Border Height="1" Background="#29324A" Margin="0,4" />
                                <TextBlock Text="• Le fichier reste modifiable par tout le monde." TextWrapping="Wrap" />
                                <TextBlock Text="• Aucun checkout Unreal n'est déclenché." TextWrapping="Wrap" />
                                <TextBlock Text="• Aucun verrou Git LFS n'est créé." TextWrapping="Wrap" />
                                <TextBlock Text="• Le plugin renouvelle automatiquement le signalement pendant le travail." TextWrapping="Wrap" />
                                <TextBlock Text="• Après un crash ou un oubli, le signalement passe automatiquement à Expirée." TextWrapping="Wrap" />
                                <Border Height="1" Background="#29324A" Margin="0,4" />
                                <Button Classes="primary" Content="Actualiser" Click="OnRefreshAdvisoryReservationsClick" HorizontalAlignment="Left" />
                                <Button Classes="secondary" Content="Nettoyer les expirées" Click="OnCleanExpiredAdvisoryReservationsClick" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="AssetDiffWorkspaceTab" Header="Diff assets">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="1.1*,1*" ColumnSpacing="8">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="9">
                                <StackPanel>
                                    <TextBlock Text="Comparateur hors moteur" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Textures, OBJ, texte, binaire et inspection simplifiée .uasset/.umap." FontSize="11" Classes="muted" />
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding AssetBaselinePath}" IsReadOnly="True" PlaceholderText="Fichier de référence" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Référence…" Click="OnPickAssetBaselineClick" />
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding AssetCandidatePath}" IsReadOnly="True" PlaceholderText="Fichier candidat" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Candidat…" Click="OnPickAssetCandidateClick" />
                                    <Button Grid.Column="2" Classes="primary" Content="Comparer" Click="OnCompareAssetsClick" />
                                    <Button Grid.Column="3" Classes="secondary" Content="Sélection Git ↔ HEAD" Click="OnCompareSelectedToHeadClick" />
                                </Grid>
                                <TextBox Grid.Row="3" Text="{Binding AssetDiffReport}" IsReadOnly="True" AcceptsReturn="True"
                                         FontFamily="Cascadia Mono,Consolas" FontSize="11" TextWrapping="Wrap"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Text="Aperçu / heatmap" FontSize="17" FontWeight="SemiBold" />
                                <Border Grid.Row="1" Margin="0,12" Background="#0B1222" CornerRadius="8" ClipToBounds="True">
                                    <Image Source="{Binding AssetDiffPreview}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Grid.Row="2" Text="Les Blueprints et assets Unreal sont comparés sans l'éditeur par structure binaire et symboles détectables. Le plugin Unreal ajoutera ensuite un graphe visuel complet." TextWrapping="Wrap" FontSize="11" Classes="muted" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="AiWorkspaceTab" Header="AI Assistant">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="390,6,*">
                        <Border Classes="card" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="9">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="AI Workspace" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="Optional, project-scoped agent connection" FontSize="10.5" Classes="muted" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#203D50" BorderBrush="#3BAA96" BorderThickness="1"
                                                CornerRadius="4" Padding="7,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IsAiIntegrationEnabled, StringFormat='Enabled: {0}'}"
                                                       FontSize="10" Foreground="#7DE2CC" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding AiStatus}" TextWrapping="Wrap" Foreground="#78D7B7" />
                                    <TextBlock Text="Enable or disable this integration from the Plugins tab. API keys are never saved to disk."
                                               FontSize="10.5" Classes="muted" TextWrapping="Wrap" />
                                    <Border Height="1" Background="#393B40" />

                                    <TextBlock Text="Provider" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding AiProviders}" SelectedItem="{Binding SelectedAiProvider}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" FontSize="9.5" Classes="muted"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding AiProviderDescription}" FontSize="10.5" Classes="muted" TextWrapping="Wrap" />

                                    <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                        <TextBlock Text="Model" VerticalAlignment="Center" Classes="muted" />
                                        <TextBox Grid.Column="1" Text="{Binding AiModel}" PlaceholderText="Provider default" />
                                        <TextBlock Grid.Row="1" Text="Endpoint" VerticalAlignment="Center" Classes="muted" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AiEndpoint}" PlaceholderText="Responses API endpoint" />
                                        <TextBlock Grid.Row="2" Text="API key" VerticalAlignment="Center" Classes="muted" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AiApiKey}" PasswordChar="●"
                                                 PlaceholderText="Session only" />
                                        <TextBlock Grid.Row="3" Text="Codex CLI" VerticalAlignment="Center" Classes="muted" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AiExecutablePath}"
                                                 PlaceholderText="codex or an absolute executable path" />
                                    </Grid>

                                    <Border Height="1" Background="#393B40" />
                                    <TextBlock Text="Workspace permissions" FontWeight="SemiBold" />
                                    <CheckBox Content="Read repository (required)" IsChecked="True" IsEnabled="False" />
                                    <CheckBox Content="Modify files inside this project" IsChecked="{Binding AiAllowModify}"
                                              IsEnabled="{Binding AiProviderSupportsEdits}" />
                                    <CheckBox Content="Allow network / web search" IsChecked="{Binding AiAllowNetwork}" />
                                    <CheckBox Content="Stage changed files after success" IsChecked="{Binding AiStageAfterRun}"
                                              IsEnabled="{Binding AiAllowModify}" />
                                    <CheckBox Content="Create a Git commit after success" IsChecked="{Binding AiCommitAfterRun}"
                                              IsEnabled="{Binding AiStageAfterRun}" />
                                    <TextBox Text="{Binding AiCommitMessage}" PlaceholderText="Commit message" />
                                    <TextBlock Text="Codex never receives direct permission to push. Stage and commit operations are brokered by CyRevision after a successful run."
                                               FontSize="10.5" Foreground="#F2C66D" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns"
                                      Background="#393B40" Cursor="SizeWestEast" />

                        <Grid Grid.Column="2" RowDefinitions="0.9*,Auto,1.1*" RowSpacing="7">
                            <Border Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid Margin="11,9" ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="Task" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="The repository and current Code preview are attached automatically; unrelated changes must be preserved."
                                                       FontSize="10" Classes="muted" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="primary" Content="Run agent" Click="OnRunAiAgentClick"
                                                IsEnabled="{Binding IsAiIntegrationEnabled}" />
                                    </Grid>
                                    <TextBox Grid.Row="1" Text="{Binding AiPrompt}" AcceptsReturn="True" TextWrapping="Wrap"
                                             PlaceholderText="Example: inspect the selected subsystem, fix the issue, and run focused tests…"
                                             Padding="11" BorderThickness="0" CornerRadius="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Background="#202225" BorderBrush="#393B40" BorderThickness="1"
                                    CornerRadius="4" Padding="10,5">
                                <TextBlock Text="Permission boundary: read-only by default · workspace-write only when explicitly enabled · no automatic push"
                                           FontSize="10.5" Foreground="#78D7B7" />
                            </Border>
                            <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*">
                                    <TextBlock Text="Agent response" Margin="11,9" FontSize="15" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="1" Text="{Binding AiResponse}" IsReadOnly="True" AcceptsReturn="True"
                                             TextWrapping="Wrap" FontFamily="Cascadia Mono,JetBrains Mono,Consolas" FontSize="11"
                                             Padding="11" BorderThickness="0" CornerRadius="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="McpWorkspaceTab" Header="MCP">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="7">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Model Context Protocol" FontSize="16" FontWeight="SemiBold" />
                                        <Border Background="#34363A" CornerRadius="4" Padding="7,2">
                                            <TextBlock Text="{Binding AiMcpEmergencyState}" FontSize="9" FontWeight="Bold"
                                                       Foreground="#F2C66D" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding AiMcpStatus}" FontSize="10.5" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Content="Enable MCP for project" IsChecked="{Binding AiMcpEnabled}"
                                          VerticalAlignment="Center" />
                                <CheckBox Grid.Column="2" Content="Block unmanaged Codex servers" IsChecked="{Binding AiMcpBlockUnmanagedServers}"
                                          VerticalAlignment="Center" ToolTip.Tip="Only MCP servers listed here are exposed to the CyRevision agent run" />
                                <Button Grid.Column="3" Classes="secondary" Content="Unblock" Click="OnUnblockAiMcpClick" />
                                <Button Grid.Column="4" Classes="danger" Content="BLOCK ALL MCP" Click="OnEmergencyBlockAiMcpClick"
                                        ToolTip.Tip="Blocks every MCP server and cancels the current CyRevision AI run" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="385,6,*">
                            <Border Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Grid Margin="10,9" ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="Project MCP servers" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="Stored locally; never written into the repository" FontSize="9.5" Classes="muted" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="primary" Content="Save policy" Click="OnSaveAiMcpClick" />
                                    </Grid>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding AiMcpServers}" SelectedItem="{Binding SelectedAiMcpServer}"
                                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              Background="Transparent" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Server" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Transport" Binding="{Binding Transport}" Width="100" />
                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="70" />
                                            <DataGridTextColumn Header="Policy" Binding="{Binding PolicySummary}" Width="130" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Grid.Row="2" Margin="8" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="7">
                                        <Button Classes="secondary" Content="+ STDIO" Click="OnAddAiMcpStdioClick" />
                                        <Button Grid.Column="1" Classes="secondary" Content="+ HTTP" Click="OnAddAiMcpHttpClick" />
                                        <Button Grid.Column="3" Classes="danger" Content="Remove" Click="OnRemoveAiMcpClick"
                                                IsEnabled="{Binding HasSelectedAiMcpServer}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns"
                                          Background="#393B40" Cursor="SizeWestEast" />

                            <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="13,10,13,16" Spacing="10" IsEnabled="{Binding HasSelectedAiMcpServer}">
                                        <Grid ColumnDefinitions="*,160,Auto,Auto" ColumnSpacing="8">
                                            <StackPanel>
                                                <TextBlock Text="Server configuration" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="Every server and tool can be independently restricted or blocked."
                                                           FontSize="10" Classes="muted" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AiMcpTransports}"
                                                      SelectedItem="{Binding SelectedAiMcpServer.Transport}" />
                                            <CheckBox Grid.Column="2" Content="Enabled" IsChecked="{Binding SelectedAiMcpServer.Enabled}"
                                                      VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="3" Content="Required" IsChecked="{Binding SelectedAiMcpServer.Required}"
                                                      VerticalAlignment="Center" ToolTip.Tip="Fail the AI run when this enabled server cannot initialize" />
                                        </Grid>

                                        <Grid ColumnDefinitions="90,*,70,*" ColumnSpacing="8">
                                            <TextBlock Text="Name" Classes="muted" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding SelectedAiMcpServer.Name}" />
                                            <TextBlock Grid.Column="2" Text="ID" Classes="muted" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="3" Text="{Binding SelectedAiMcpServer.Id}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="90,180,Auto,*" ColumnSpacing="8">
                                            <TextBlock Text="Capability" Classes="muted" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AiMcpCapabilities}"
                                                      SelectedItem="{Binding SelectedAiMcpServer.Capability}" />
                                            <CheckBox Grid.Column="2" Content="Requires network permission"
                                                      IsChecked="{Binding SelectedAiMcpServer.RequiresNetwork}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="ReadWrite servers are omitted unless workspace modification is authorized."
                                                       FontSize="9.5" Foreground="#F2C66D" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>

                                        <Border Height="1" Background="#393B40" />
                                        <StackPanel Spacing="7" IsVisible="{Binding SelectedAiMcpServer.IsStdio}">
                                            <TextBlock Text="STDIO process" FontWeight="SemiBold" />
                                            <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="7">
                                                <TextBlock Text="Command" Classes="muted" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding SelectedAiMcpServer.Command}"
                                                         PlaceholderText="npx, node, python, or an absolute executable path" />
                                                <TextBlock Grid.Row="1" Text="Arguments" Classes="muted" VerticalAlignment="Top" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAiMcpServer.Arguments}"
                                                         AcceptsReturn="True" Height="68" PlaceholderText="One argument per line" />
                                                <TextBlock Grid.Row="2" Text="Working dir" Classes="muted" VerticalAlignment="Center" />
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAiMcpServer.WorkingDirectory}"
                                                         PlaceholderText="Optional; blank uses the project" />
                                            </Grid>
                                            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="Environment values" FontSize="10" Classes="muted" />
                                                    <TextBox Text="{Binding SelectedAiMcpServer.EnvironmentVariables}" AcceptsReturn="True" Height="68"
                                                             PlaceholderText="NAME=value (stored locally)" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="Forward environment names" FontSize="10" Classes="muted" />
                                                    <TextBox Text="{Binding SelectedAiMcpServer.ForwardEnvironmentVariables}" AcceptsReturn="True" Height="68"
                                                             PlaceholderText="TOKEN_NAME (one per line)" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Spacing="7" IsVisible="{Binding SelectedAiMcpServer.IsHttp}">
                                            <TextBlock Text="Streamable HTTP" FontWeight="SemiBold" />
                                            <TextBlock Text="Responses API: requires network permission, an explicit tool allow list, and environment-based authorization. OAuth sessions and custom headers apply to local Codex only."
                                                       FontSize="9.5" Foreground="#F2C66D" TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="105,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="7">
                                                <TextBlock Text="Server URL" Classes="muted" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding SelectedAiMcpServer.Url}" PlaceholderText="https://server.example/mcp" />
                                                <TextBlock Grid.Row="1" Text="Authentication" Classes="muted" VerticalAlignment="Center" />
                                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="150,*" ColumnSpacing="8">
                                                    <ComboBox ItemsSource="{Binding AiMcpHttpAuthModes}"
                                                              SelectedItem="{Binding SelectedAiMcpServer.HttpAuth}" />
                                                    <TextBox Grid.Column="1" Text="{Binding SelectedAiMcpServer.BearerTokenEnvironmentVariable}"
                                                             PlaceholderText="Bearer-token environment variable" />
                                                </Grid>
                                                <TextBlock Grid.Row="2" Text="OAuth" Classes="muted" VerticalAlignment="Center" />
                                                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                                    <TextBox Text="{Binding SelectedAiMcpServer.OAuthScopes}" PlaceholderText="Scopes, comma separated" />
                                                    <TextBox Grid.Column="1" Text="{Binding SelectedAiMcpServer.OAuthResource}" PlaceholderText="OAuth resource (optional)" />
                                                </Grid>
                                            </Grid>
                                            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="Static HTTP headers" FontSize="10" Classes="muted" />
                                                    <TextBox Text="{Binding SelectedAiMcpServer.HttpHeaders}" AcceptsReturn="True" Height="68"
                                                             PlaceholderText="Header=value (stored locally)" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="Headers from environment" FontSize="10" Classes="muted" />
                                                    <TextBox Text="{Binding SelectedAiMcpServer.EnvironmentHttpHeaders}" AcceptsReturn="True" Height="68"
                                                             PlaceholderText="Header=ENV_VARIABLE" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <Border Height="1" Background="#393B40" />
                                        <TextBlock Text="Tool policy" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Enabled tools (allow list)" FontSize="10" Classes="muted" />
                                                <TextBox Text="{Binding SelectedAiMcpServer.EnabledTools}" AcceptsReturn="True" Height="74"
                                                         PlaceholderText="Local: blank allows all. API: list at least one tool." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="Disabled tools (deny list wins)" FontSize="10" Classes="muted" />
                                                <TextBox Text="{Binding SelectedAiMcpServer.DisabledTools}" AcceptsReturn="True" Height="74"
                                                         PlaceholderText="One blocked tool per line" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="150,*,100,90,100,90" ColumnSpacing="8">
                                            <ComboBox ItemsSource="{Binding AiMcpApprovalModes}"
                                                      SelectedItem="{Binding SelectedAiMcpServer.ApprovalMode}" />
                                            <TextBlock Grid.Column="1" Text="Default approval: Prompt/Writes remain blocked in non-interactive runs unless explicitly approved by policy."
                                                       FontSize="9.5" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Startup (s)" Classes="muted" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="3" Text="{Binding SelectedAiMcpServer.StartupTimeoutSeconds}" />
                                            <TextBlock Grid.Column="4" Text="Tool (s)" Classes="muted" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="5" Text="{Binding SelectedAiMcpServer.ToolTimeoutSeconds}" />
                                        </Grid>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Per-tool approval overrides" FontSize="10" Classes="muted" />
                                            <TextBox Text="{Binding SelectedAiMcpServer.ToolApprovalOverrides}" AcceptsReturn="True" Height="62"
                                                     PlaceholderText="tool_name=approve | prompt | writes | auto" />
                                        </StackPanel>
                                        <Border Background="#2B2520" BorderBrush="#6D5731" BorderThickness="1" CornerRadius="4" Padding="9,6">
                                            <TextBlock Text="Security: prefer environment-variable references for tokens. Static environment values and headers are saved in the local CyRevision profile, never in Git."
                                                       FontSize="10" Foreground="#F2C66D" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="PluginsWorkspaceTab" Header="Plugins">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="0.85*,1.4*" ColumnSpacing="8">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="CyRevision plugins" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Plugins are packaged separately and can be enabled only when needed."
                                               Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding Plugins}"
                                          SelectedItem="{Binding SelectedPlugin}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="Horizontal"
                                          Background="Transparent"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Plugin" Binding="{Binding Name}" Width="1.4*" />
                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="75" />
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="105" />
                                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="105" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary" Content="Enable"
                                            IsEnabled="{Binding CanEnableSelectedPlugin}"
                                            Click="OnEnablePluginClick" />
                                    <Button Classes="secondary" Content="Disable"
                                            IsEnabled="{Binding CanDisableSelectedPlugin}"
                                            Click="OnDisablePluginClick" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8">
                                <Border Classes="card">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Unreal Engine Integration" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock Text="Optional CyRevision plugin · autonomous Unreal Editor companion included"
                                                           Classes="muted" FontSize="11" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#203D50" BorderBrush="#3BAA96"
                                                    BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                <TextBlock Text="{Binding IsUnrealIntegrationEnabled, StringFormat='Enabled: {0}'}"
                                                           Foreground="#7DE2CC" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>

                                        <Border Height="1" Background="#393B40" />
                                        <TextBlock Text="Unreal project" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Text="{Binding UnrealProjectPath}" IsReadOnly="True"
                                                     PlaceholderText="Select a .uproject file…" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Choose project…"
                                                    Click="OnPickUnrealProjectClick" />
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,Auto,24,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Text="Bundled" Classes="muted" />
                                            <TextBlock Grid.Column="1" Text="{Binding UnrealEditorPluginVersion}"
                                                       Foreground="#78D7B7" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="Installed" Classes="muted" />
                                            <TextBlock Grid.Column="4" Text="{Binding UnrealInstalledPluginVersion}"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <TextBlock Text="{Binding UnrealPluginSummary}" TextWrapping="Wrap" />

                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="primary" Content="Install / update in project"
                                                    IsEnabled="{Binding CanInstallUnrealEditorPlugin}"
                                                    Click="OnInstallUnrealPluginClick" Margin="0,3,8,3" />
                                            <Button Classes="secondary" Content="Configure direct connection"
                                                    IsEnabled="{Binding CanInstallUnrealEditorPlugin}"
                                                    Click="OnConfigureUnrealBridgeClick" Margin="0,3,8,3" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Private CyRevision bridge" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding UnrealBridgeSummary}" TextWrapping="Wrap" Foreground="#78D7B7" />
                                        <TextBlock Text="The bridge listens on loopback only. Each Unreal project receives a random token under Saved/CyRevision; the token is not added to Git."
                                                   Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                        <TextBlock Text="CyRevisionUnreal remains useful without CyRevision: its revision dashboard, Git actions, and advisory reservations work independently. Connecting unlocks application refresh and the extended Git/LFS/Sync/backup workflow."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem x:Name="HelpWorkspaceTab" Header="Aide">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="310,*" ColumnSpacing="8">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                                <StackPanel>
                                    <TextBlock Text="Guide hors ligne" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Disponible sans navigateur ni connexion réseau."
                                               FontSize="11" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Row="1" Text="{Binding DocumentationSearch}"
                                         PlaceholderText="Rechercher dans la documentation…" />
                                <ListBox Grid.Row="2" ItemsSource="{Binding DocumentationTopics}"
                                         SelectedItem="{Binding SelectedDocumentationTopic}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="7,6" Spacing="3">
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#78D7B7" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Summary}" FontSize="10" Classes="muted"
                                                           TextWrapping="Wrap" MaxHeight="44" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
                            <Border Classes="card" Padding="16">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Mises à jour de CyRevision" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="Canal stable · uniquement les releases GitHub publiées"
                                                   Classes="muted" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Classes="secondary" Content="Vérifier les mises à jour"
                                                IsEnabled="{Binding CanCheckForUpdates}"
                                                Click="OnCheckForUpdatesClick" />
                                        <Button Classes="primary" Content="Télécharger et installer"
                                                IsVisible="{Binding HasUpdateAvailable}"
                                                IsEnabled="{Binding CanInstallUpdate}"
                                                Click="OnInstallUpdateClick" />
                                        <Button Classes="secondary" Content="Voir la release"
                                                IsVisible="{Binding HasUpdateAvailable}"
                                                Click="OnOpenUpdateReleaseClick" />
                                    </StackPanel>

                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,Auto,20,*" ColumnSpacing="7">
                                        <TextBlock Text="Version installée" Classes="muted" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentApplicationVersion}"
                                                   Foreground="#78D7B7" FontWeight="SemiBold" />
                                        <Border Grid.Column="2" Background="#49381E" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="ALPHA" Foreground="#FFD479" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{Binding UpdateStatus}"
                                                   TextWrapping="Wrap" FontSize="11" />
                                    </Grid>

                                    <Grid Grid.Row="2" Grid.ColumnSpan="2" RowDefinitions="Auto,Auto" RowSpacing="5">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress}"
                                                     Height="5" IsVisible="{Binding IsDownloadingUpdate}" />
                                        <TextBlock Grid.Row="1" Text="{Binding UpdateReleaseNotes}"
                                                   IsVisible="{Binding HasUpdateAvailable}"
                                                   MaxHeight="42" TextTrimming="CharacterEllipsis"
                                                   Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Classes="card">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel MaxWidth="860" HorizontalAlignment="Left" Spacing="11" Margin="4">
                                        <TextBlock Text="{Binding SelectedDocumentationTopic.Category}"
                                                   FontSize="11" Foreground="#78D7B7" />
                                        <TextBlock Text="{Binding SelectedDocumentationTopic.Title}"
                                                   FontSize="25" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedDocumentationTopic.Summary}"
                                                   FontSize="13" Foreground="#B8C1D8" TextWrapping="Wrap" />
                                        <Border Height="1" Background="#29324A" Margin="0,5,0,7" />
                                        <TextBlock Text="{Binding SelectedDocumentationTopic.Body}"
                                                   FontSize="12" LineHeight="20" TextWrapping="Wrap" />
                                        <Border Background="#10241F" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                            <TextBlock Text="Cette documentation est livrée avec CyRevision et reste accessible hors ligne."
                                                       FontSize="11" Foreground="#78D7B7" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="3" Grid.Column="1" Background="#25272A" BorderBrush="#393B40" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="9.5" Classes="muted" />
                <TextBlock Grid.Column="1" Text="Git actif · Sync sur demande" VerticalAlignment="Center" FontSize="9.5" Foreground="#78D7B7" />
            </Grid>
        </Border>
    </Grid>
</Window>
