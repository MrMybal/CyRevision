<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:CyRevision.Desktop.Controls"
        xmlns:views="using:CyRevision.Desktop.Views"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        x:Class="CyRevision.Desktop.MainWindow"
        Title="CyRevision Alpha"
        Icon="/Assets/Branding/cyrevision-icon-master.png"
        Width="1480"
        Height="900"
        MinWidth="1024"
        MinHeight="680"
        x:CompileBindings="False"
        Background="#1E1F22">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#3574F0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#393B40" />
            <Setter Property="Foreground" Value="#DFE1E5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#4A2930" />
            <Setter Property="Foreground" Value="#FF9BAB" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="9,5" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="ToolTip.ShowDelay" Value="650" />
        </Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#9B9DA3" /></Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#26282B" />
            <Setter Property="BorderBrush" Value="#393B40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#1E1F22" />
            <Setter Property="BorderBrush" Value="#4B4D52" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="27" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="7,3" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Height" Value="27" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style Selector="CheckBox"><Setter Property="FontSize" Value="11.5" /></Style>
        <Style Selector="ToggleButton.panelToggle">
            <Setter Property="Background" Value="#1E1F22" />
            <Setter Property="Foreground" Value="#AFB1B7" />
            <Setter Property="BorderBrush" Value="#4B4D52" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style Selector="ToggleButton.panelToggle:checked">
            <Setter Property="Background" Value="#203D50" />
            <Setter Property="Foreground" Value="#7DE2CC" />
            <Setter Property="BorderBrush" Value="#3BAA96" />
        </Style>
        <Style Selector="ToggleButton.layoutChoice">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#AFB1B7" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style Selector="ToggleButton.layoutChoice:pointerover">
            <Setter Property="Background" Value="#34363A" />
            <Setter Property="Foreground" Value="#F2F3F5" />
        </Style>
        <Style Selector="ToggleButton.layoutChoice:checked">
            <Setter Property="Background" Value="#34363A" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="BorderBrush" Value="#6C7078" />
        </Style>
        <Style Selector="ToggleButton.workspaceCategory">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A9ABB2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,6,12,5" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ToggleButton.workspaceCategory:pointerover">
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="Background" Value="#2B2D30" />
        </Style>
        <Style Selector="ToggleButton.workspaceCategory:checked">
            <Setter Property="Foreground" Value="#7DE2CC" />
            <Setter Property="BorderBrush" Value="#4EC9B0" />
            <Setter Property="Background" Value="#26282B" />
        </Style>
        <Style Selector="Menu.topMenu">
            <Setter Property="Background" Value="#242529" />
            <Setter Property="Foreground" Value="#DFE1E5" />
            <Setter Property="Padding" Value="7,0" />
        </Style>
        <Style Selector="Menu.topMenu MenuItem">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="9,4" />
        </Style>
        <Style Selector="Menu.topMenu MenuItem:pointerover">
            <Setter Property="Background" Value="#393B40" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="28,48,*,Auto,26" ColumnDefinitions="204,*">
        <Menu Grid.Row="0" Grid.ColumnSpan="2" Classes="topMenu">
            <MenuItem Header="File">
                <MenuItem Header="Add folder..." HotKey="Ctrl+Shift+O" Click="OnAddFolderClick" />
                <MenuItem Header="Open repository..." HotKey="Ctrl+O" Click="OnAddExistingClick" />
                <MenuItem Header="Clone repository..." HotKey="Ctrl+Shift+N" Click="OnCloneGitClick" />
                <MenuItem Header="Create repository..." HotKey="Ctrl+N" Click="OnCreateGitClick" />
                <Separator />
                <MenuItem Header="Remove selected project" IsEnabled="{Binding HasSelectedProject}" Click="OnRemoveProjectClick" />
                <Separator />
                <MenuItem Header="Exit" HotKey="Ctrl+Q" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Find in files..." Click="OnOpenGlobalSearchClick" />
                <Separator />
                <MenuItem Header="Refresh project" HotKey="F5" IsEnabled="{Binding HasSelectedProject}" Click="OnRefreshClick" />
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Project overview" Click="OnShowProjectWorkspaceClick" />
                <MenuItem Header="Changes" Click="OnShowChangesWorkspaceClick" />
                <MenuItem Header="Code explorer" Click="OnShowCodeWorkspaceClick" />
                <MenuItem Header="Repository console &amp; logs" Click="OnShowConsoleWorkspaceClick" />
                <MenuItem Header="History" Click="OnShowHistoryWorkspaceClick" />
                <MenuItem Header="Git graphs" Click="OnShowGitGraphsWorkspaceClick" />
                <Separator />
                <MenuItem Header="Open detached workspace">
                    <MenuItem Header="Current workspace" Click="OnDetachCurrentWorkspaceClick" />
                    <Separator />
                    <MenuItem Header="Changes" Tag="Changes" Click="OnDetachWorkspaceClick" />
                    <MenuItem Header="History" Tag="History" Click="OnDetachWorkspaceClick" />
                    <MenuItem Header="Compose" Tag="Compose" Click="OnDetachWorkspaceClick" />
                    <MenuItem Header="Branches" Tag="Branches" Click="OnDetachWorkspaceClick" />
                    <MenuItem Header="Pull Requests" Tag="PullRequests" Click="OnDetachWorkspaceClick" />
                    <MenuItem Header="CI / Actions" Tag="Ci" Click="OnDetachWorkspaceClick" />
                    <MenuItem Header="Git graphs" Tag="GitGraphs" Click="OnDetachWorkspaceClick" />
                    <MenuItem Header="File locks" Tag="FileLocks" Click="OnDetachWorkspaceClick" />
                    <MenuItem Header="Git LFS" Tag="GitLfs" Click="OnDetachWorkspaceClick" />
                    <MenuItem Header="Backups" Tag="Backups" Click="OnDetachWorkspaceClick" />
                    <Separator />
                    <MenuItem Header="Solution Explorer" Tag="SolutionExplorer" Click="OnDetachWorkspaceClick" />
                    <MenuItem Header="Code search" Tag="Code" Click="OnDetachWorkspaceClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Workspace layout">
                    <MenuItem Header="Save current layout" Click="OnSaveWorkspaceLayoutClick" />
                    <MenuItem Header="Reset layout" Click="OnResetWorkspaceLayoutClick" />
                    <Separator />
                    <MenuItem Header="Changes: Review" Click="OnBalancedChangesLayoutClick" />
                    <MenuItem Header="Changes: Diff focus" Click="OnDiffFocusChangesLayoutClick" />
                    <MenuItem Header="Code: Balanced" Click="OnBalancedCodeLayoutClick" />
                    <MenuItem Header="Code: Editor focus" Click="OnEditorFocusCodeLayoutClick" />
                    <MenuItem Header="Code: Search focus" Click="OnSearchFocusCodeLayoutClick" />
                    <MenuItem Header="History: Columns" Click="OnColumnsHistoryLayoutClick" />
                    <MenuItem Header="History: Review" Click="OnReviewHistoryLayoutClick" />
                    <MenuItem Header="History: Diff focus" Click="OnDiffFocusedHistoryLayoutClick" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Git" IsEnabled="{Binding AreGitActionsEnabled}"
                      ToolTip.Tip="Git actions are temporarily disabled while another repository operation is running">
                <MenuItem Header="Refresh" Click="OnRefreshClick" />
                <Separator />
                <MenuItem Header="Stage all" Click="OnStageAllClick" />
                <MenuItem Header="Unstage all" Click="OnUnstageAllClick" />
                <MenuItem Header="Commit changes..." Click="OnShowChangesWorkspaceClick" />
                <Separator />
                <MenuItem Header="Fetch" Click="OnFetchClick" />
                <MenuItem Header="Pull" Click="OnPullClick" />
                <MenuItem Header="Push" Click="OnPushClick" />
                <Separator />
                <MenuItem Header="Branches" Click="OnShowBranchesWorkspaceClick" />
                <MenuItem Header="Commit Explorer window…" Click="OnOpenCommitExplorerWindowClick" />
                <MenuItem Header="Compare branches &amp; cherry-pick" Click="OnShowCherryPickWorkspaceClick" />
                <MenuItem Header="Multi restore composer" Click="OnShowMultiRestoreWorkspaceClick" />
                <MenuItem Header="Pull Requests" Click="OnShowPullRequestsWorkspaceClick" />
                <MenuItem Header="File locks" Click="OnShowLfsLocksWorkspaceClick" />
                <MenuItem Header="Git LFS" Click="OnShowGitLfsWorkspaceClick" />
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Repository console &amp; logs" Click="OnShowConsoleWorkspaceClick" />
                <Separator />
                <MenuItem Header="System integration">
                    <MenuItem x:Name="LaunchAtLoginMenuItem"
                              Header="Launch at system login"
                              ToggleType="CheckBox"
                              Click="OnToggleLaunchAtLoginClick" />
                    <MenuItem x:Name="StartHiddenAtLoginMenuItem"
                              Header="Start hidden in tray"
                              ToggleType="CheckBox"
                              Click="OnToggleStartHiddenAtLoginClick" />
                    <MenuItem x:Name="CloseToTrayMenuItem"
                              Header="Close window to tray"
                              ToggleType="CheckBox"
                              Click="OnToggleCloseToTrayClick" />
                    <MenuItem x:Name="ShowTrayIconMenuItem"
                              Header="Show system tray icon"
                              ToggleType="CheckBox"
                              Click="OnToggleShowTrayIconClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Backups" Click="OnShowBackupsWorkspaceClick" />
                <MenuItem Header="Syncthing" Click="OnShowSynchronizationWorkspaceClick" />
                <Separator />
                <MenuItem Header="WireGuard VPN" Click="OnShowVpnWorkspaceClick" />
                <MenuItem Header="Swarm over VPN" Click="OnShowSwarmWorkspaceClick" />
                <MenuItem Header="VPN files" Click="OnShowVpnFilesWorkspaceClick" />
                <MenuItem Header="Remote builds" Click="OnShowRemoteBuildsWorkspaceClick" />
                <Separator />
                <MenuItem Header="Discord agent" Click="OnShowDiscordWorkspaceClick" />
                <MenuItem Header="AI assistant" Click="OnShowAiWorkspaceClick" />
                <MenuItem Header="MCP" Click="OnShowMcpWorkspaceClick" />
                <MenuItem Header="Plugins" Click="OnShowPluginsWorkspaceClick" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="Offline documentation" Click="OnShowHelpWorkspaceClick" />
                <MenuItem Header="Check for updates" Click="OnCheckForUpdatesClick" />
                <Separator />
                <MenuItem Header="About CyRevision" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#2B2D30" BorderBrush="#393B40" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="190,*,Auto" Margin="10,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="6" ClipToBounds="True" Background="#17191D">
                        <Image Source="/Assets/Branding/cyrevision-icon-master.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="CyRevision" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                    <Border Background="#49381E" BorderBrush="#A8792C" BorderThickness="1"
                            CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                        <TextBlock Text="ALPHA" Foreground="#FFD479" FontSize="8" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding CurrentProjectName}" FontSize="13" FontWeight="Bold" Foreground="#F2F3F5" />
                        <Border Background="#203B38" CornerRadius="4" Padding="7,1">
                            <TextBlock Text="{Binding CurrentBranch}" FontSize="13" FontWeight="Bold" Foreground="#78D7B7" />
                        </Border>
                        <Border Background="#303238" BorderBrush="#50535A" BorderThickness="1" CornerRadius="4" Padding="6,1">
                            <TextBlock Text="{Binding GitConnectionKind}" FontSize="9" Foreground="#B8C1D8" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding RepositoryPath}" FontSize="9.5" Classes="muted" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox Width="112"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NativeName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="secondary" Content="Ajouter un dossier" Click="OnAddFolderClick"
                            ToolTip.Tip="Add a folder for Sync or Backup without creating a Git repository" />
                    <Button Classes="secondary" Content="Ouvrir un dépôt" Click="OnAddExistingClick"
                            ToolTip.Tip="Add an existing local Git repository to CyRevision" />
                    <Button Classes="secondary" Content="Cloner" Click="OnCloneGitClick"
                            ToolTip.Tip="Clone a remote Git repository into a local folder" />
                    <Button Classes="primary" Content="Créer un dépôt" Click="OnCreateGitClick"
                            ToolTip.Tip="Create a new local Git repository with the main branch and local Git LFS" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.RowSpan="3" Grid.Column="0" Background="#25272A" BorderBrush="#393B40" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Margin="6,8">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,0,2,5" ColumnSpacing="3">
                    <TextBlock Text="PROJECTS" FontSize="9" FontWeight="Bold" Classes="muted" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="secondary" Content="↑" Padding="6,2" MinHeight="23"
                            ToolTip.Tip="Move project up" Click="OnMoveProjectUpClick"
                            IsEnabled="{Binding CanMoveSelectedProjectUp}" />
                    <Button Grid.Column="2" Classes="secondary" Content="↓" Padding="6,2" MinHeight="23"
                            ToolTip.Tip="Move project down" Click="OnMoveProjectDownClick"
                            IsEnabled="{Binding CanMoveSelectedProjectDown}" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ProjectSidebarGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,4">
                                    <ToggleButton IsChecked="{Binding IsExpanded}" Click="OnProjectGroupExpansionClick"
                                                  Classes="secondary" Padding="5,3" HorizontalContentAlignment="Stretch"
                                                  ToolTip.Tip="Expand or collapse this project group">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                            <TextBlock Text="▾" Foreground="#78D7B7" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="9.5" FontWeight="SemiBold" />
                                            <Border Grid.Column="2" Background="#303238" CornerRadius="7" Padding="5,0">
                                                <TextBlock Text="{Binding CountText}" FontSize="8" Classes="muted" />
                                            </Border>
                                        </Grid>
                                    </ToggleButton>
                                    <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                                             IsVisible="{Binding IsExpanded}" SelectionChanged="OnGroupedProjectSelectionChanged"
                                             Background="Transparent" BorderThickness="0" Margin="0,2,0,0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,2" ColumnDefinitions="4,*,Auto" RowDefinitions="Auto,Auto,Auto,3" ColumnSpacing="7">
                                                    <Border Grid.RowSpan="4" Background="{Binding AccentColor}" CornerRadius="2" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                        <Border Background="#242C47" CornerRadius="4" Padding="5,1">
                                                            <TextBlock Text="{Binding ModeAndServices}" FontSize="8.5" Foreground="#B8C1D8" />
                                                        </Border>
                                                        <Border Background="#6A3D1D" CornerRadius="7" Padding="5,1"
                                                                IsVisible="{Binding HasUnreadNotifications}"
                                                                ToolTip.Tip="Unread project notifications">
                                                            <TextBlock Text="{Binding NotificationBadgeText}" FontSize="8.5"
                                                                       Foreground="#FFD479" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding RootPath}" FontSize="8.5" Classes="muted"
                                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" Margin="0,2,0,1" ColumnSpacing="6">
                                                        <TextBlock Text="{Binding BranchName}" FontSize="10.5" FontWeight="Bold"
                                                                   Foreground="{Binding StatusColor}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding LoadDetail}" FontSize="8" Classes="muted"
                                                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <ProgressBar Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Classes="inlineLoader" Minimum="0" Maximum="100"
                                                                 Value="{Binding LoadProgress}" IsVisible="{Binding IsLoading}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#151D31" CornerRadius="6" Padding="8">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#758098" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SyncState}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding SyncDetails}" TextWrapping="Wrap" FontSize="9" Classes="muted" />
                        <TextBlock Text="Personal Syncthing is not managed" FontSize="9" Foreground="#78D7B7" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Grid.Column="1" Margin="10,7" RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding ChangeSummary}" FontSize="21" FontWeight="Bold"
                               Foreground="{Binding ChangeSummaryColor}" />
                    <TextBlock Text="{Binding ToolStatus}" FontSize="9.5" Classes="muted" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Button Classes="secondary" Content="Docs" Click="OnOpenCurrentPageDocumentationClick"
                            ToolTip.Tip="Open documentation filtered for the current page" />
                    <Button Classes="secondary" Content="Detach current tab ↗" Click="OnDetachCurrentWorkspaceClick"
                            ToolTip.Tip="Open the current tab in a synchronized external window" />
                    <Button Classes="secondary" Content="Open folder" Click="OnOpenProjectFolderClick"
                            ToolTip.Tip="Open the selected project folder in the system file manager" />
                    <Button Classes="secondary" Content="Actualiser" Click="OnRefreshClick" />
                    <Button x:Name="FetchRemotesButton" Classes="secondary" Content="Fetch remotes" Click="OnFetchClick"
                            IsEnabled="{Binding AreGitActionsEnabled}" />
                    <Button x:Name="PullButton" Classes="secondary" Content="Pull" Click="OnPullClick"
                            IsEnabled="{Binding AreGitActionsEnabled}" />
                    <Button x:Name="PushButton" Classes="primary" Content="Push" Click="OnPushClick"
                            IsEnabled="{Binding AreGitActionsEnabled}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,-2" Padding="9,3" CornerRadius="4" Background="#3B311C"
                    BorderBrush="#876B2A" BorderThickness="1" IsVisible="{Binding IsGitInteractionLocked}"
                    ToolTip.Tip="Mutating Git actions are serialized to prevent index.lock conflicts">
                <TextBlock Text="{Binding GitInteractionLockMessage}" FontSize="9" Foreground="#F2C66D" />
            </Border>

            <Border Grid.Row="1" Background="#242529" BorderBrush="#393B40" BorderThickness="1"
                    CornerRadius="5" Margin="0,0,0,5" Padding="4,0">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="OverviewCategoryToggle" Classes="workspaceCategory" Content="Overview"
                                  Click="OnOverviewCategoryClick" />
                    <ToggleButton x:Name="GitCategoryToggle" Classes="workspaceCategory" Content="Git"
                                  Click="OnGitCategoryClick" />
                    <ToggleButton x:Name="CodeCategoryToggle" Classes="workspaceCategory" Content="Code &amp; Assets"
                                  Click="OnCodeCategoryClick" />
                    <ToggleButton x:Name="BackupCategoryToggle" Classes="workspaceCategory" Content="Backup"
                                  Click="OnBackupCategoryClick" />
                    <ToggleButton x:Name="SyncCategoryToggle" Classes="workspaceCategory" Content="Sync"
                                  Click="OnSyncCategoryClick" />
                    <ToggleButton x:Name="PluginModeCategoryToggle" Classes="workspaceCategory"
                                  Content="{Binding ActivePluginOperatingModeName}"
                                  IsVisible="{Binding HasActivePluginOperatingMode}"
                                  Click="OnPluginModeCategoryClick" />
                    <ToggleButton x:Name="NetworkCategoryToggle" Classes="workspaceCategory" Content="Team &amp; Network"
                                  Click="OnNetworkCategoryClick" />
                    <ToggleButton x:Name="ExtensionsCategoryToggle" Classes="workspaceCategory" Content="Extensions &amp; Help"
                                  Click="OnExtensionsCategoryClick" />
                </StackPanel>
            </Border>

            <TabControl x:Name="WorkspaceTabs" Grid.Row="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
                <TabItem x:Name="ProjectWorkspaceTab" Header="Project">
                    <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                        <Grid ColumnDefinitions="1.15*,1*" RowDefinitions="Auto" ColumnSpacing="8" RowSpacing="8">
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Operating mode" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Each module remains independent: Git can run without Sync, and Sync can run without Git."
                                               TextWrapping="Wrap" Classes="muted" />
                                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <Border Background="#183C56" CornerRadius="3" Padding="5,1"
                                                                IsVisible="{Binding IsPluginMode}">
                                                            <TextBlock Text="PLUGIN MODE" FontSize="8" Foreground="#78D7B7" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Classes="muted" />
                                                    <TextBlock Text="{Binding AvailabilitySummary}" FontSize="10"
                                                               Foreground="#F2C66D" TextWrapping="Wrap"
                                                               IsVisible="{Binding IsPluginMode}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Classes="primary" Content="Apply mode" Click="OnApplyPresetClick"
                                            IsEnabled="{Binding SelectedPreset.IsAvailable}"
                                            HorizontalAlignment="Left" />
                                    <Border Background="#102D2A" BorderBrush="#315E54" BorderThickness="1"
                                            CornerRadius="5" Padding="9,6"
                                            IsVisible="{Binding HasActivePluginOperatingMode}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ActivePluginOperatingModeName}" FontWeight="SemiBold"
                                                       Foreground="#78D7B7" />
                                            <TextBlock Text="{Binding ActivePluginOperatingModeSummary}" FontSize="10"
                                                       Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Changing mode never deletes data that is already stored."
                                               TextWrapping="Wrap" FontSize="10.5" Foreground="#78D7B7" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="card">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Project settings" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CurrentProjectName}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{Binding SelectedProjectAccentColor}" />
                                    <TextBlock Text="{Binding RepositoryPath}" Classes="muted" FontSize="10"
                                               TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Text="Project color" VerticalAlignment="Center" Classes="muted" />
                                        <ComboBox Grid.Column="1" MinHeight="28" ItemsSource="{Binding ProjectAccentColors}"
                                                  SelectedItem="{Binding SelectedProjectAccentColor, Mode=OneWay}"
                                                  SelectionChanged="OnProjectAccentColorChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                                                        <Border Width="22" Height="12" CornerRadius="3" Background="{Binding}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="10" Classes="muted" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="Project group" VerticalAlignment="Center" Classes="muted" />
                                        <TextBox Grid.Column="1" Text="{Binding SidebarGroupDraft}"
                                                 PlaceholderText="General, Unreal plugins, Client work…" />
                                        <Button Grid.Column="2" Classes="secondary" Content="Save group"
                                                Click="OnSaveProjectGroupClick"
                                                ToolTip.Tip="Move this project into a collapsible sidebar group; leave blank for General" />
                                    </Grid>
                                    <Border Background="#202633" BorderBrush="#343A46" BorderThickness="1" CornerRadius="5" Padding="9,7">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Project disk" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding ProjectDiskSummary}" Classes="muted" FontSize="9.5" />
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProjectDiskFreePercent}" Height="7" />
                                            <TextBlock Text="{Binding ProjectDiskWarning}" Foreground="{Binding ProjectDiskWarningColor}"
                                                       FontSize="9.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#24262A" CornerRadius="5" Padding="9,7">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                                            <StackPanel>
                                                <TextBlock Text="Automatic project services" FontWeight="SemiBold" />
                                                <TextBlock Text="Start only the services explicitly enabled for this project. Runtime badges appear in the project list."
                                                           Classes="muted" FontSize="9.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <CheckBox Content="Sync" IsChecked="{Binding StartSyncAutomatically, Mode=OneWay}"
                                                          Click="OnProjectAutoStartSyncClick" />
                                                <CheckBox Content="VPN" IsChecked="{Binding StartVpnAutomatically, Mode=OneWay}"
                                                          Click="OnProjectAutoStartVpnClick" />
                                            </StackPanel>
                                            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2">
                                                <Button Classes="secondary" Content="Start Sync" Click="OnStartSyncClick" Margin="0,0,6,0" />
                                                <Button Classes="secondary" Content="Pause Sync" Click="OnPauseSyncClick" Margin="0,0,6,0" />
                                                <Button Classes="secondary" Content="Resume Sync" Click="OnResumeSyncClick" Margin="0,0,6,0" />
                                                <Button Classes="secondary" Content="Start VPN" Click="OnStartVpnClick" Margin="0,0,6,0" />
                                                <Button Classes="danger" Content="Stop VPN" Click="OnStopVpnClick" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="secondary" Content="Open project folder" Click="OnOpenProjectFolderClick" />
                                        <Button Classes="danger" Content="Remove from CyRevision…" Click="OnRemoveProjectClick"
                                                IsEnabled="{Binding HasSelectedProject}" />
                                    </StackPanel>
                                    <TextBlock Text="Removal only updates the CyRevision catalogue. Project files stay on disk; generated CyRevision caches are optional."
                                               TextWrapping="Wrap" FontSize="10.5" Foreground="#78D7B7" />
                                </StackPanel>
                            </Border>

                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="MembersWorkspaceTab" Header="Members">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="8">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Project members" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ProjectMembersSummary}" Classes="muted" FontSize="10.5" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="secondary" Content="Refresh status"
                                        Click="OnRefreshProjectMembersClick" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding SyncMemberPanelWidth}" />
                                <ColumnDefinition Width="{Binding FirstMemberSplitterWidth}" />
                                <ColumnDefinition Width="{Binding GitMemberPanelWidth}" />
                                <ColumnDefinition Width="{Binding SecondMemberSplitterWidth}" />
                                <ColumnDefinition Width="{Binding VpnMemberPanelWidth}" />
                            </Grid.ColumnDefinitions>
                            <Border Classes="card" Padding="0" ClipToBounds="True" IsVisible="{Binding ShowSyncMemberPanel}">
                                <Grid RowDefinitions="42,30,*">
                                    <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Sync identities" FontWeight="SemiBold" />
                                            <TextBlock Text="Authorized devices and live connection state" Classes="muted" FontSize="9" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding SyncProjectMembers}"
                                              AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                              GridLinesVisibility="Horizontal" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="82" />
                                            <DataGridTemplateColumn Header="Status" Width="88">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" />
                                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Identity" Binding="{Binding Identity}" Width="100" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <GridSplitter Grid.Column="1" Width="7" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                          IsVisible="{Binding ShowSyncMemberPanel}"
                                          Background="#45484E" Cursor="SizeWestEast" />

                            <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True" IsVisible="{Binding ShowGitMemberPanel}">
                                <Grid RowDefinitions="42,*">
                                    <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Git contributors" FontWeight="SemiBold" />
                                            <TextBlock Text="Authors found in the loaded repository history" Classes="muted" FontSize="9" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding GitProjectMembers}"
                                              AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                              GridLinesVisibility="Horizontal" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Author" Binding="{Binding DisplayName}" Width="*" />
                                            <DataGridTextColumn Header="Activity" Binding="{Binding Status}" Width="84" />
                                            <DataGridTextColumn Header="Last commit" Binding="{Binding LastActivity}" Width="112" />
                                            <DataGridTextColumn Header="Email" Binding="{Binding Identity}" Width="130" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <GridSplitter Grid.Column="3" Width="7" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                          IsVisible="{Binding ShowVpnMemberPanel}"
                                          Background="#45484E" Cursor="SizeWestEast" />

                            <Border Grid.Column="4" Classes="card" Padding="0" ClipToBounds="True" IsVisible="{Binding ShowVpnMemberPanel}">
                                <Grid RowDefinitions="42,*">
                                    <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="VPN peers" FontWeight="SemiBold" />
                                            <TextBlock Text="WireGuard capabilities and handshake state" Classes="muted" FontSize="9" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding VpnProjectMembers}"
                                              AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                              GridLinesVisibility="Horizontal" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Peer" Binding="{Binding DisplayName}" Width="*" />
                                            <DataGridTemplateColumn Header="Status" Width="88">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" />
                                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Address" Binding="{Binding Identity}" Width="100" />
                                            <DataGridTextColumn Header="Capabilities" Binding="{Binding Role}" Width="120" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="NotificationsWorkspaceTab" Header="Notifications">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <StackPanel>
                                    <TextBlock Text="Project notifications" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ProjectNotificationSummary}" Classes="muted" FontSize="10" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Content="Enabled for this project"
                                          IsChecked="{Binding ProjectNotificationsEnabled, Mode=OneWay}"
                                          Click="OnProjectNotificationsEnabledClick" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="secondary" Content="Mark all read"
                                        Click="OnMarkProjectNotificationsReadClick" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="*,140" ColumnSpacing="8">
                            <TextBox Text="{Binding ProjectNotificationSearch}"
                                     PlaceholderText="Search task, result or error…" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ProjectNotificationStateFilters}"
                                      SelectedItem="{Binding ProjectNotificationStateFilter}" />
                        </Grid>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding ProjectNotifications}"
                                  AutoGenerateColumns="False" IsReadOnly="True" Classes="historyCompact"
                                  GridLinesVisibility="Horizontal" Background="#17191D">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Status" Binding="{Binding NotificationState}" Width="60" />
                                <DataGridTextColumn Header="Result" Binding="{Binding State}" Width="80" />
                                <DataGridTextColumn Header="Action" Binding="{Binding Title}" Width="180" />
                                <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*" />
                                <DataGridTextColumn Header="Started" Binding="{Binding StartedText}" Width="75" />
                                <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="VisibleTabsWorkspaceTab" Header="Visible tabs">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Visible project tabs" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WorkspaceTabVisibilitySummary" Classes="muted" FontSize="10.5"
                                               Text="Project and Visible tabs are always available so hidden tools can be restored." />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="secondary" Content="Show all" Click="OnShowAllWorkspaceTabsClick" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Classes="card" Padding="8">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="Workspace presets" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Choose a documented mode, then adjust individual tabs below if needed."
                                                   Classes="muted" FontSize="9.5" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="primary" Content="Apply selected preset"
                                            Click="OnApplyWorkspaceTabVisibilityPresetClick" />
                                </Grid>

                                <ListBox x:Name="WorkspaceTabPresetSelector" Grid.Row="1" Height="102"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="5" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="235" Height="88" RowDefinitions="Auto,Auto,Auto,*"
                                                  ColumnDefinitions="*,Auto" Margin="2" ToolTip.Tip="{Binding IncludedTools}">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Background="#263247" CornerRadius="4" Padding="6,1">
                                                    <TextBlock Text="{Binding TabCountLabel}" FontSize="8.5" Foreground="#9CC7FF" />
                                                </Border>
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}"
                                                           Classes="muted" FontSize="9" TextWrapping="Wrap" Height="26"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding BestFor}"
                                                           Foreground="#80D7BD" FontSize="8.5" TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" />
                                                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding IncludedTools}"
                                                           Classes="muted" FontSize="8" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Bottom" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Classes="card" Padding="5">
                            <ListBox x:Name="WorkspaceTabVisibilityList" Background="#14171D"
                                     BorderBrush="#343A46" BorderThickness="1" Padding="2" SelectionMode="Single">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemWidth="285" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="277" Height="31" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7" Margin="1,0">
                                            <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsAvailableInMode}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                            <Border Grid.Column="2" Background="#252C3A" CornerRadius="3" Padding="5,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AvailabilitySummary}" FontSize="8.5" Foreground="#9AA8C2" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="LicenseWorkspaceTab" Header="License">
                    <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="9">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Project license" FontSize="18" FontWeight="SemiBold" />
                                            <Border Background="#24334D" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProjectLicenseDetectedId}" FontSize="9.5" Foreground="#8ED8C2" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ProjectLicenseStatus}" Classes="muted" FontSize="10.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="secondary" Content="Refresh license" Click="OnRefreshProjectLicenseClick" />
                                </Grid>

                                <ProgressBar Grid.Row="1" Classes="inlineLoader" IsVisible="{Binding IsProjectLicenseLoading}"
                                             IsIndeterminate="True" />

                                <Grid Grid.Row="2" ColumnDefinitions="1.4*,1*,78,1*" ColumnSpacing="8">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Starter template" FontSize="9.5" Classes="muted" />
                                        <ComboBox ItemsSource="{Binding ProjectLicenseTemplates}"
                                                  SelectedItem="{Binding SelectedProjectLicenseTemplate}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" FontSize="9.5" Classes="muted"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="Copyright holder" FontSize="9.5" Classes="muted" />
                                        <TextBox Text="{Binding ProjectLicenseHolder}" PlaceholderText="Name or organization" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Text="Year" FontSize="9.5" Classes="muted" />
                                        <TextBox Text="{Binding ProjectLicenseYear}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="3">
                                        <TextBlock Text="Root file name" FontSize="9.5" Classes="muted" />
                                        <TextBox Text="{Binding ProjectLicenseFileName}" PlaceholderText="LICENSE" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="3" Background="#202633" BorderBrush="#343A46" BorderThickness="1"
                                        CornerRadius="5" Padding="9,7">
                                    <Grid ColumnDefinitions="1*,1*,1*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="4">
                                        <StackPanel>
                                            <TextBlock Text="Permissions" FontWeight="SemiBold" Foreground="#78D7B7" />
                                            <TextBlock Text="{Binding SelectedProjectLicenseTemplate.Permissions}" Classes="muted"
                                                       FontSize="9.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Conditions" FontWeight="SemiBold" Foreground="#F2C66D" />
                                            <TextBlock Text="{Binding SelectedProjectLicenseTemplate.Conditions}" Classes="muted"
                                                       FontSize="9.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Limitations" FontWeight="SemiBold" Foreground="#FF9BAB" />
                                            <TextBlock Text="{Binding SelectedProjectLicenseTemplate.Limitations}" Classes="muted"
                                                       FontSize="9.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                                                   Text="{Binding SelectedProjectLicenseTemplate.ReferenceUrl}"
                                                   Foreground="#61AFEF" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="5" MinHeight="420">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="secondary" Content="Apply template to editor" Click="OnApplyProjectLicenseTemplateClick" />
                                        <Button Classes="secondary" Content="Import text file…" Click="OnImportProjectLicenseClick" />
                                        <TextBlock Text="Nothing is written until you save." Classes="muted" FontSize="10"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox Grid.Row="1" Text="{Binding ProjectLicenseDraft}" AcceptsReturn="True"
                                             FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11"
                                             TextWrapping="NoWrap" MinHeight="380"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             PlaceholderText="Select a template, import a file, or enter custom license terms." />
                                </Grid>

                                <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="Changing a project license can affect copyright and redistribution rights. Review the final terms with qualified legal counsel."
                                               Foreground="#F0C56A" TextWrapping="Wrap" FontSize="10.5" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="primary" Content="Save license…" Click="OnSaveProjectLicenseClick"
                                            IsEnabled="{Binding CanSaveProjectLicense}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="ChangesWorkspaceTab" Header="Modifications">
                    <Grid x:Name="ChangesWorkspaceGrid" Margin="0,8,0,0"
                          ColumnDefinitions="1.05*,8,1.35*" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                        <Border Grid.ColumnSpan="3" Background="#26282B" BorderBrush="#393B40" BorderThickness="1"
                                CornerRadius="6" Padding="7,5">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Text="LAYOUT" FontSize="9" FontWeight="Bold" Foreground="#7E8189"
                                           VerticalAlignment="Center" Margin="3,0,2,0" />
                                <ToggleButton x:Name="ChangesBalancedLayoutToggle" Grid.Column="1" Classes="layoutChoice"
                                              Content="Review" Click="OnBalancedChangesLayoutClick"
                                              ToolTip.Tip="Balanced file list and diff" />
                                <ToggleButton x:Name="ChangesDiffFocusLayoutToggle" Grid.Column="2" Classes="layoutChoice"
                                               Content="Diff focus" Click="OnDiffFocusChangesLayoutClick"
                                               ToolTip.Tip="Give more space to the diff viewer" />
                                <ToggleButton x:Name="ChangesCommitFocusLayoutToggle" Grid.Column="3" Classes="layoutChoice"
                                              Content="Commit focus" Click="OnCommitFocusChangesLayoutClick"
                                              ToolTip.Tip="Give more space to file selection and commit preparation" />
                                <TextBlock Grid.Column="4" Text="Drag the divider to resize panels. Layout sizes are saved locally."
                                           FontSize="9.5" Classes="muted" VerticalAlignment="Center" Margin="8,0" />
                                <ToggleButton x:Name="ChangesDiffToggle" Grid.Column="5" Classes="layoutChoice" Content="Diff"
                                              Click="OnChangesDiffToggleClick" ToolTip.Tip="Show or hide the inline diff preview" />
                                <Button Grid.Column="6" Classes="secondary" Content="Open diff ↗" Click="OnOpenChangesDiffWindowClick" />
                                <Button Grid.Column="7" Classes="secondary" Content="Save layout" Click="OnSaveWorkspaceLayoutClick" />
                                <Button Grid.Column="8" Classes="secondary" Content="Reset" Click="OnResetWorkspaceLayoutClick" />
                            </Grid>
                        </Border>

                        <Border x:Name="ChangesListPanel" Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True" MinWidth="300">
                            <Grid RowDefinitions="42,28,34,*,32">
                                <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,0">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="5">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Commit editor" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Choose exactly what is committed" Classes="muted" FontSize="8.5" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="danger" Content="{Binding GitConflictActionText}"
                                                Click="OnOpenGitConflictResolverClick" Padding="8,4"
                                                IsVisible="{Binding HasGitConflicts}"
                                                ToolTip.Tip="Open the three-way Base / Result / Incoming conflict resolver" />
                                        <Button Grid.Column="2" Classes="secondary" Content="Scan untracked" Click="OnScanAllUntrackedClick" Padding="8,4"
                                                IsEnabled="{Binding AreGitActionsEnabled}"
                                                ToolTip.Tip="Expand every untracked folder. This can take time on very large Unreal projects." />
                                        <Button Grid.Column="3" Classes="secondary" Content="Include all" Click="OnIncludeAllChangesClick" Padding="8,4"
                                                IsEnabled="{Binding AreGitActionsEnabled}" />
                                        <Button Grid.Column="4" Classes="secondary" Content="Keep all" Click="OnKeepAllChangesClick" Padding="8,4"
                                                IsEnabled="{Binding AreGitActionsEnabled}" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Background="#232427" BorderBrush="#34363A" BorderThickness="0,0,0,1" Padding="9,0">
                                    <TextBlock Text="{Binding ChangePreparationSummary}" Classes="muted" FontSize="9"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Border>

                                <Grid Grid.Row="2" ColumnDefinitions="*,112" ColumnSpacing="6" Margin="6,4">
                                    <TextBox Text="{Binding ChangeSearch, UpdateSourceTrigger=PropertyChanged}" Classes="searchBox"
                                             PlaceholderText="Search name, path, *.cpp, *.cpp;*.h, state, lock owner or area…"
                                             ToolTip.Tip="Use * and ? for file patterns. Separate alternative patterns with ; and additional filters with spaces." />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ChangeSortOptions}"
                                              SelectedItem="{Binding ChangeSort}" ToolTip.Tip="Sort change list" />
                                </Grid>

                                <TabControl Grid.Row="3" Padding="0" Background="Transparent">
                                    <TabItem Header="List">
                                        <TreeView x:Name="ChangesFlatTree" ItemsSource="{Binding FlatChangeTree}"
                                                  SelectionMode="Multiple"
                                                  SelectionChanged="OnChangeTreeSelectionChanged"
                                                  PointerPressed="OnChangesTreePointerPressed"
                                                  Classes="compactTree" Background="Transparent" BorderThickness="0" Margin="3">
                                            <TreeView.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Set selected local" Click="OnSetContextChangesLocalClick" />
                                                    <MenuItem Header="Restore selected to list" Click="OnRestoreContextChangesClick" />
                                                    <Separator />
                                                    <MenuItem Header="Rollback selected…" Click="OnRollbackContextChangesClick" />
                                                    <MenuItem Header="Delete from disk…" Click="OnDeleteContextChangesClick" />
                                                </ContextMenu>
                                            </TreeView.ContextMenu>
                                            <TreeView.Styles>
                                                <Style Selector="TreeViewItem">
                                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                </Style>
                                            </TreeView.Styles>
                                            <TreeView.ItemTemplate>
                                                <TreeDataTemplate ItemsSource="{Binding Children}">
                                                    <Grid ColumnDefinitions="16,20,2*,*,Auto" Height="24"
                                                          Margin="0" ToolTip.Tip="{Binding RelativePath}">
                                                        <TextBlock Text="{Binding Icon}" Foreground="{Binding AccentColor}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <CheckBox Grid.Column="1" IsVisible="{Binding CanIncludeRecursively}"
                                                                  IsChecked="{Binding IsIncluded, Mode=OneWay}"
                                                                  Click="OnChangeTreeIncludeClick"
                                                                  VerticalAlignment="Center" Margin="0,0,4,0"
                                                                  ToolTip.Tip="Include or keep every selected file" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{Binding AccentColor}"
                                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Change.DirectoryPath}"
                                                                   Foreground="#666D78" FontSize="8" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="5" Margin="5,0,2,0">
                                                            <TextBlock IsVisible="{Binding IsDirectory}"
                                                                       Text="{Binding LeafCount, StringFormat={}{0:N0} file(s)}"
                                                                       Foreground="{Binding AccentColor}" FontSize="9" FontWeight="SemiBold" />
                                                            <TextBlock IsVisible="{Binding HasChange}" Text="{Binding Change.PreparationState}"
                                                                       Foreground="{Binding Change.PreparationColor}" FontSize="8.5" />
                                                            <TextBlock IsVisible="{Binding Change.HasLock}" Text="✓"
                                                                       Foreground="{Binding Change.LockColor}" FontSize="10" FontWeight="Bold"
                                                                       ToolTip.Tip="{Binding Change.LockOwner}" />
                                                            <TextBlock IsVisible="{Binding HasChange}" Text="{Binding Change.State}"
                                                                       Foreground="{Binding Change.StatusColor}" FontSize="8.5" />
                                                        </StackPanel>
                                                    </Grid>
                                                </TreeDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </TabItem>

                                    <TabItem Header="Legacy table" IsVisible="False">
                                        <Grid RowDefinitions="26,*,26,*">
                                            <Border Background="#24262A" BorderBrush="#34363A" BorderThickness="0,0,0,1" Padding="8,0">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                                    <TextBlock Text="●" Foreground="#61AFEF" FontSize="8" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="Versioned files" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FilteredVersionedChanges.Count, StringFormat={}{0:N0} file(s)}"
                                                               Foreground="#61AFEF" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Button Grid.Column="3" Classes="secondary" Content="Clear selection" Padding="6,2"
                                                            Click="OnDeselectVersionedChangesClick"
                                                            ToolTip.Tip="Keep every versioned file out of the next commit" />
                                                </Grid>
                                            </Border>
                                            <DataGrid x:Name="VersionedChangesGrid" Grid.Row="1" ItemsSource="{Binding FilteredVersionedChanges}"
                                                      SelectedItem="{Binding SelectedChange, Mode=OneWayToSource}"
                                                      SelectionMode="Extended"
                                                      SelectionChanged="OnChangesGridSelectionChanged"
                                                      PointerPressed="OnChangesGridPointerPressed"
                                                      DoubleTapped="OnVersionedChangeDoubleTapped"
                                                      Classes="historyCompact" AutoGenerateColumns="False" IsReadOnly="True"
                                                      Sorting="OnChangesDataGridSorting"
                                                      CanUserSortColumns="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0"
                                                      ToolTip.Tip="Click a header to sort. Right-click to choose visible columns.">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu Opened="OnChangeColumnsMenuOpened">
                                                        <MenuItem Header="Set selected local" Click="OnSetContextChangesLocalClick" />
                                                        <MenuItem Header="Restore selected to list" Click="OnRestoreContextChangesClick" />
                                                        <Separator />
                                                        <MenuItem Header="Rollback selected…" Click="OnRollbackContextChangesClick" />
                                                        <MenuItem Header="Delete from disk…" Click="OnDeleteContextChangesClick" />
                                                        <Separator />
                                                        <MenuItem Header="Visible columns">
                                                            <MenuItem Header="Selection" Tag="Checked" ToggleType="CheckBox" Click="OnChangeColumnVisibilityClick" />
                                                            <MenuItem Header="Name and path (always visible)" ToggleType="CheckBox" IsChecked="True" IsEnabled="False" />
                                                            <MenuItem Header="State" Tag="State" ToggleType="CheckBox" Click="OnChangeColumnVisibilityClick" />
                                                            <MenuItem Header="Lock" Tag="Lock" ToggleType="CheckBox" Click="OnChangeColumnVisibilityClick" />
                                                            <MenuItem Header="Area" Tag="Area" ToggleType="CheckBox" Click="OnChangeColumnVisibilityClick" />
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="✓" Width="29" Tag="Checked" SortMemberPath="IsIncluded">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      ToolTip.Tip="Include this file in the next commit" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Name" Width="*" MinWidth="190" Tag="Name" SortMemberPath="FileName">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <Grid RowDefinitions="Auto,Auto" Margin="1,1">
                                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                                           FontSize="10.5" FontWeight="SemiBold" Foreground="#E6E9EF" />
                                                                <TextBlock Grid.Row="1" Text="{Binding DirectoryPath}" TextTrimming="CharacterEllipsis"
                                                                           Foreground="#666D78" FontSize="8" />
                                                            </Grid>
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="State" Width="70" Tag="State" SortMemberPath="State">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <TextBlock Text="{Binding State}" Foreground="{Binding StatusColor}" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Lock" Width="38" Tag="Lock" SortMemberPath="HasLock">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <TextBlock Text="{Binding LockIndicator}" Foreground="{Binding LockColor}"
                                                                       FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                                                                       ToolTip.Tip="{Binding LockOwner}" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="76" Tag="Area" SortMemberPath="Area" />
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <Border Grid.Row="2" Background="#24262A" BorderBrush="#34363A" BorderThickness="0,1" Padding="8,0">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                                    <TextBlock Text="●" Foreground="#78D7B7" FontSize="8" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="Unversioned files" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FilteredUnversionedChanges.Count, StringFormat={}{0:N0} file(s)}"
                                                               Foreground="#78D7B7" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Button Grid.Column="3" Classes="secondary" Content="Clear selection" Padding="6,2"
                                                            Click="OnDeselectUnversionedChangesClick"
                                                            ToolTip.Tip="Keep every unversioned file out of the next commit" />
                                                </Grid>
                                            </Border>
                                            <DataGrid x:Name="UnversionedChangesGrid" Grid.Row="3" ItemsSource="{Binding FilteredUnversionedChanges}"
                                                      SelectedItem="{Binding SelectedChange, Mode=OneWayToSource}"
                                                      SelectionMode="Extended"
                                                      SelectionChanged="OnChangesGridSelectionChanged"
                                                      PointerPressed="OnChangesGridPointerPressed"
                                                      Classes="historyCompact" AutoGenerateColumns="False" IsReadOnly="True"
                                                      Sorting="OnChangesDataGridSorting"
                                                      CanUserSortColumns="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0"
                                                      ToolTip.Tip="Click a header to sort. Right-click to choose visible columns.">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu Opened="OnChangeColumnsMenuOpened">
                                                        <MenuItem Header="Set selected local" Click="OnSetContextChangesLocalClick" />
                                                        <MenuItem Header="Restore selected to list" Click="OnRestoreContextChangesClick" />
                                                        <Separator />
                                                        <MenuItem Header="Rollback selected…" Click="OnRollbackContextChangesClick" />
                                                        <MenuItem Header="Delete from disk…" Click="OnDeleteContextChangesClick" />
                                                        <Separator />
                                                        <MenuItem Header="Visible columns">
                                                            <MenuItem Header="Selection" Tag="Checked" ToggleType="CheckBox" Click="OnChangeColumnVisibilityClick" />
                                                            <MenuItem Header="Name and path (always visible)" ToggleType="CheckBox" IsChecked="True" IsEnabled="False" />
                                                            <MenuItem Header="State" Tag="State" ToggleType="CheckBox" Click="OnChangeColumnVisibilityClick" />
                                                            <MenuItem Header="Lock" Tag="Lock" ToggleType="CheckBox" Click="OnChangeColumnVisibilityClick" />
                                                            <MenuItem Header="Area" Tag="Area" ToggleType="CheckBox" Click="OnChangeColumnVisibilityClick" />
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="✓" Width="29" Tag="Checked" SortMemberPath="IsIncluded">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      ToolTip.Tip="Include this file in the next commit" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Name" Width="*" MinWidth="190" Tag="Name" SortMemberPath="FileName">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <Grid RowDefinitions="Auto,Auto" Margin="1,1">
                                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                                           FontSize="10.5" FontWeight="SemiBold" Foreground="#E6E9EF" />
                                                                <TextBlock Grid.Row="1" Text="{Binding DirectoryPath}" TextTrimming="CharacterEllipsis"
                                                                           Foreground="#666D78" FontSize="8" />
                                                            </Grid>
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="State" Width="70" Tag="State" SortMemberPath="State">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <TextBlock Text="{Binding State}" Foreground="{Binding StatusColor}" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Lock" Width="38" Tag="Lock" SortMemberPath="HasLock">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <TextBlock Text="{Binding LockIndicator}" Foreground="{Binding LockColor}"
                                                                       FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                                                                       ToolTip.Tip="{Binding LockOwner}" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="76" Tag="Area" SortMemberPath="Area" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="Folders">
                                        <Grid RowDefinitions="28,*">
                                            <Border Background="#24262A" BorderBrush="#34363A" BorderThickness="0,0,0,1" Padding="6,2">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                                                    <TextBlock Text="Checking a folder includes every eligible file below it."
                                                               Classes="muted" FontSize="8.5" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1" Classes="secondary" Content="Expand all"
                                                            Click="OnExpandAllChangesTreeClick" Padding="6,2" MinHeight="22" FontSize="9" />
                                                    <Button Grid.Column="2" Classes="secondary" Content="Collapse all"
                                                            Click="OnCollapseAllChangesTreeClick" Padding="6,2" MinHeight="22" FontSize="9" />
                                                </Grid>
                                            </Border>
                                            <TreeView x:Name="ChangesFolderTree" Grid.Row="1" ItemsSource="{Binding ChangeTree}"
                                                      SelectionMode="Multiple"
                                                      SelectionChanged="OnChangeTreeSelectionChanged"
                                                      PointerPressed="OnChangesTreePointerPressed"
                                                      Classes="compactTree" Background="Transparent" BorderThickness="0" Margin="3">
                                                <TreeView.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Set folder changes local" Click="OnSetContextChangesLocalClick" />
                                                        <MenuItem Header="Restore folder changes to list" Click="OnRestoreContextChangesClick" />
                                                        <Separator />
                                                        <MenuItem Header="Rollback folder changes…" Click="OnRollbackContextChangesClick" />
                                                        <MenuItem Header="Delete changed files from disk…" Click="OnDeleteContextChangesClick" />
                                                    </ContextMenu>
                                                </TreeView.ContextMenu>
                                                <TreeView.Styles>
                                                    <Style Selector="TreeViewItem">
                                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                    </Style>
                                                </TreeView.Styles>
                                                <TreeView.ItemTemplate>
                                                    <TreeDataTemplate ItemsSource="{Binding Children}">
                                                        <Grid ColumnDefinitions="16,20,*,Auto" Height="22" Margin="0" ToolTip.Tip="{Binding RelativePath}">
                                                            <TextBlock Text="{Binding Icon}" Foreground="{Binding AccentColor}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <CheckBox Grid.Column="1" IsVisible="{Binding CanIncludeRecursively}"
                                                                      IsChecked="{Binding IsIncluded, Mode=OneWay}"
                                                                      Click="OnChangeTreeIncludeClick"
                                                                      VerticalAlignment="Center" Margin="0,0,4,0"
                                                                      ToolTip.Tip="Include or keep this folder recursively" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{Binding AccentColor}"
                                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" Margin="5,0,2,0">
                                                                <TextBlock IsVisible="{Binding IsDirectory}"
                                                                           Text="{Binding LeafCount, StringFormat={}{0:N0} file(s)}"
                                                                           Foreground="{Binding AccentColor}" FontSize="9" FontWeight="SemiBold" />
                                                                <TextBlock IsVisible="{Binding HasChange}" Text="{Binding Change.PreparationState}"
                                                                           Foreground="{Binding Change.PreparationColor}" FontSize="8.5" />
                                                                <TextBlock IsVisible="{Binding Change.HasLock}" Text="✓"
                                                                           Foreground="{Binding Change.LockColor}" FontSize="10" FontWeight="Bold"
                                                                           ToolTip.Tip="{Binding Change.LockOwner}" />
                                                                <TextBlock IsVisible="{Binding HasChange}" Text="{Binding Detail}"
                                                                           Foreground="#666D78" FontSize="8" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </TreeDataTemplate>
                                                </TreeView.ItemTemplate>
                                            </TreeView>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="Local only" IsVisible="False">
                                        <Grid RowDefinitions="Auto,*">
                                            <Border Background="#24262A" Padding="9,6">
                                                <TextBlock Text="Persistent per-project list. These untracked files are never committed; .gitignore is unchanged."
                                                           Classes="muted" FontSize="9" TextWrapping="Wrap" />
                                            </Border>
                                            <DataGrid x:Name="LocalOnlyChangesGrid" Grid.Row="1" ItemsSource="{Binding FilteredLocalOnlyChanges}"
                                                      SelectedItem="{Binding SelectedChange}"
                                                      SelectionMode="Extended"
                                                      SelectionChanged="OnChangesGridSelectionChanged"
                                                      PointerPressed="OnChangesGridPointerPressed"
                                                      Classes="historyCompact" AutoGenerateColumns="False" IsReadOnly="True"
                                                      GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Restore selected to list" Click="OnRestoreContextChangesClick" />
                                                        <Separator />
                                                        <MenuItem Header="Rollback selected…" Click="OnRollbackContextChangesClick" />
                                                        <MenuItem Header="Delete from disk…" Click="OnDeleteContextChangesClick" />
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
                                                    <DataGridTextColumn Header="Folder" Binding="{Binding DirectoryPath}" Width="1.4*" />
                                                    <DataGridTextColumn Header="Lock" Binding="{Binding LockShort}" Width="95" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>
                                </TabControl>

                                <Border Grid.Row="4" Background="#232427" BorderBrush="#34363A" BorderThickness="0,1,0,0" Padding="5,2">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="5">
                                        <Button Classes="secondary" Content="Set local" Click="OnSetSelectedChangeLocalClick"
                                                IsEnabled="{Binding AreGitActionsEnabled}"
                                                Padding="6,2" MinHeight="22" FontSize="9.5" ToolTip.Tip="Move the selected untracked file to the local-only list" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Restore to list" Click="OnRestoreSelectedLocalChangeClick"
                                                IsEnabled="{Binding AreGitActionsEnabled}"
                                                Padding="6,2" MinHeight="22" FontSize="9.5" ToolTip.Tip="Return a local-only file to commit preparation" />
                                        <Button Grid.Column="2" Classes="danger" Content="Delete…" Click="OnDeleteSelectedChangesClick"
                                                IsEnabled="{Binding AreGitActionsEnabled}"
                                                Padding="6,2" MinHeight="22" FontSize="9.5" ToolTip.Tip="Delete selected working-tree files after confirmation" />
                                        <Button Grid.Column="4" Classes="danger" Content="Rollback…" Click="OnRollbackSelectedChangeClick"
                                                IsEnabled="{Binding AreGitActionsEnabled}"
                                                Padding="6,2" MinHeight="22" FontSize="9.5" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <GridSplitter x:Name="ChangesWorkspaceSplitter" Grid.Row="1" Grid.Column="1" Width="8"
                                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                      Background="#4B4D52" Cursor="SizeWestEast" />

                        <Border x:Name="ChangesDiffPanel" Grid.Row="1" Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True" MinWidth="360">
                            <Grid RowDefinitions="42,28,*">
                                <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,0">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Diff preview" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedChange.Path}" Classes="muted" FontSize="8.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedChange.PreparationState}"
                                                   Foreground="{Binding SelectedChange.PreparationColor}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Background="#232427" BorderBrush="#34363A" BorderThickness="0,0,0,1" Padding="9,0">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="9">
                                        <TextBlock Text="{Binding SelectedChange.State}" Foreground="{Binding SelectedChange.StatusColor}" FontSize="9" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedChange.Area}" Classes="muted" FontSize="9" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding SelectedChange.LockOwner}" Foreground="{Binding SelectedChange.LockColor}"
                                                   FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <controls:CodeDiffView Grid.Row="2"
                                                       DiffText="{Binding DiffText}"
                                                       PreviewImage="{Binding DiffPreviewImage}"
                                                       PresentationSummary="{Binding DiffPresentationSummary}"
                                                       FilePath="{Binding SelectedChange.Path}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="card" Padding="9">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="7">
                                <TextBlock Text="Commit" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ChangePreparationSummary}" Classes="muted" FontSize="9.5"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Row="1" Grid.Column="2" Classes="secondary" Content="Tasks…"
                                        Click="OnAddCommitTaskLinksClick"
                                        IsVisible="{Binding HasWorkItemPlugins}"
                                        ToolTip.Tip="Search enabled Jira or ClickUp plugins and add selected task links to this commit message" />
                                <Button Grid.Row="1" Grid.Column="3" Classes="secondary" Content="AI description"
                                        Click="OnGenerateAiCommitDescriptionClick"
                                        IsEnabled="{Binding CanGenerateAiCommitDescription}"
                                        ToolTip.Tip="Uses the connected project AI to draft a message; it never commits automatically" />
                                <Button Grid.Row="1" Grid.Column="4" Classes="secondary" Content="Stage selected" Click="OnStageAllClick"
                                        IsEnabled="{Binding AreGitActionsEnabled}" />
                                <Button Grid.Row="1" Grid.Column="5" Classes="danger" Content="Rollback selected…" Click="OnRollbackIncludedChangesClick"
                                        IsEnabled="{Binding AreGitActionsEnabled}" />
                                <Button Grid.Row="1" Grid.Column="6" Classes="primary" Content="Commit selected" Click="OnCommitClick"
                                        IsEnabled="{Binding CanCommitPreparedChanges}" />
                                <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CommitMessage}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="76"
                                         PlaceholderText="Describe the selected changes…" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="SolutionExplorerWorkspaceTab" Header="Solution Explorer">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="7">
                        <Border Classes="card" Padding="9">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,140,1,Auto,Auto,Auto" ColumnSpacing="7">
                                <TextBox Text="{Binding CodeTreeFilter, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="File name, .cpp, *.bat, Reality\*.cpp* or patterns separated by ;" />
                                <CheckBox Grid.Column="1" Content="Hidden" IsChecked="{Binding CodeIncludeHidden}"
                                          VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="primary" Content="Refresh" Click="OnRefreshCodeWorkspaceClick" />
                                <TextBlock Grid.Column="3" Text="AUTO" Classes="muted" FontSize="9" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="4" ItemsSource="{Binding CodeAutoRefreshFrequencies}"
                                          SelectedItem="{Binding CodeAutoRefreshFrequency}" />
                                <Border Grid.Column="5" Width="1" Background="#4B4D52" Margin="3,0" />
                                <TextBlock Grid.Column="6" Text="VIEW" Classes="muted" FontSize="9" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <ToggleButton x:Name="SolutionTreeLayoutToggle" Grid.Column="7" Classes="layoutChoice"
                                              Content="Tree" IsChecked="True" Click="OnSolutionTreeLayoutClick" />
                                <ToggleButton x:Name="SolutionListLayoutToggle" Grid.Column="8" Classes="layoutChoice"
                                              Content="List" Click="OnSolutionListLayoutClick" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" IsVisible="{Binding IsCodeWorkspaceLoading}" Background="#202633"
                                VerticalAlignment="Bottom" ZIndex="20"
                                BorderBrush="#393B40" BorderThickness="1" CornerRadius="4" Padding="9,5">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock Text="Indexing project files…" Classes="muted" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1" Classes="inlineLoader" IsIndeterminate="True" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" IsVisible="{Binding IsCodeFileSearchRunning}" Background="#202633"
                                VerticalAlignment="Bottom" ZIndex="21"
                                BorderBrush="#393B40" BorderThickness="1" CornerRadius="4" Padding="9,5">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock Text="Searching every file name and path…" Classes="muted" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1" Classes="inlineLoader" IsIndeterminate="True" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="0.9*,8,1.4*">
                            <Border Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="38,*">
                                    <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Project files" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{Binding CodeWorkspaceSummary}" Classes="muted" FontSize="8.5"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CodeWorkspaceLastUpdatedText}" Foreground="#78D7B7"
                                                           FontSize="8.5" HorizontalAlignment="Right" />
                                                <TextBlock Text="Caches and build outputs excluded" Classes="muted"
                                                           FontSize="8" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TreeView x:Name="SolutionTreePanel" Grid.Row="1" ItemsSource="{Binding CodeTree}"
                                              SelectedItem="{Binding SelectedCodeNode}" Classes="compactTree"
                                              Background="Transparent" BorderThickness="0" Margin="3">
                                        <TreeView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="View Sync history for this file" Click="OnShowSelectedFileSyncHistoryClick" />
                                            </ContextMenu>
                                        </TreeView.ContextMenu>
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                                <Grid ColumnDefinitions="22,*,Auto" Margin="1,1" ToolTip.Tip="{Binding RelativePath}">
                                                    <Border Width="18" Height="18" CornerRadius="3" Background="#31343A">
                                                        <TextBlock Text="{Binding Icon}" FontSize="8" FontWeight="Bold"
                                                                   Foreground="{Binding AccentColor}" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding AccentColor}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" FontSize="8.5"
                                                               VerticalAlignment="Center" Margin="4,0" />
                                                </Grid>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>

                                    <ListBox x:Name="SolutionSearchResultsPanel" Grid.Row="1"
                                             ItemsSource="{Binding CodeFileSearchResults}"
                                             SelectedItem="{Binding SelectedCodeFileSearchResult}"
                                             SelectionChanged="OnSolutionSearchSelectionChanged"
                                             Classes="compactList"
                                             IsVisible="False" Background="Transparent" BorderThickness="0" Margin="3"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="View Sync history for this file" Click="OnShowSelectedFileSyncHistoryClick" />
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="21" ColumnDefinitions="190,*,72,62" ColumnSpacing="6"
                                                      Margin="4,0" ToolTip.Tip="{Binding RelativePath}">
                                                    <TextBlock Text="{Binding Name}" Foreground="#61AFEF"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DirectoryPath}" Classes="muted"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Language}" Classes="muted"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Classes="muted"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <DataGrid x:Name="SolutionListPanel" Grid.Row="1" ItemsSource="{Binding CodeFileList}"
                                              SelectedItem="{Binding SelectedCodeNode}" IsVisible="False"
                                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                               Background="Transparent" BorderThickness="0">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="View Sync history for this file" Click="OnShowSelectedFileSyncHistoryClick" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="190" />
                                            <DataGridTextColumn Header="Path" Binding="{Binding RelativePath}" Width="*" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding Language}" Width="90" />
                                            <DataGridTextColumn Header="Size" Binding="{Binding Detail}" Width="110" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                          Background="#4B4D52" Cursor="SizeWestEast" />

                            <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="42,Auto,*">
                                    <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,0">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="File preview" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{Binding CodePreviewSummary}" Classes="muted" FontSize="9"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="secondary" Content="AI summary"
                                                    Click="OnGenerateAiCodeSummaryClick"
                                                    IsEnabled="{Binding CanGenerateAiCodeSummary}"
                                                    ToolTip.Tip="Summarize the selected file with the connected project AI" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" IsVisible="{Binding HasCodeAiSummary}"
                                            Background="#202633" BorderBrush="#35445B" BorderThickness="0,0,0,1"
                                            Padding="10,7" MaxHeight="170">
                                        <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                                            <TextBlock Text="AI file summary" Foreground="#78D7B7" FontWeight="SemiBold" FontSize="10" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Close" Padding="7,2" MinHeight="22"
                                                    Click="OnClearAiCodeSummaryClick" />
                                            <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0"
                                                          VerticalScrollBarVisibility="Auto">
                                                <controls:MarkdownMessageView Text="{Binding CodeAiSummary}"
                                                                              RenderMarkdown="{Binding AiRenderMarkdown}" />
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="2">
                                        <Image Source="{Binding CodePreviewImage}" IsVisible="{Binding CodePreviewIsImage}"
                                               Stretch="Uniform" Margin="14" />
                                        <controls:SyntaxHighlightedCodeView Text="{Binding CodePreviewText}"
                                                                            IsVisible="{Binding CodePreviewIsText}"
                                                                            FilePath="{Binding CodePreviewPath}"
                                                                            TargetFilePath="{Binding SelectedCodeSearchResult.RelativePath}"
                                                                            TargetLine="{Binding SelectedCodeSearchResult.LineNumber}"
                                                                            TargetColumn="{Binding SelectedCodeSearchResult.ColumnNumber}"
                                                                            TargetLength="{Binding SelectedCodeSearchResult.MatchText.Length}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="CodeWorkspaceTab" Header="Code">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="7">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,115,Auto,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto,4">
                                <TextBox x:Name="GlobalCodeSearch" Text="{Binding CodeSearchQuery}" Classes="searchBox"
                                         PlaceholderText="Search text, symbol, or pattern across the project…"
                                         KeyDown="OnCodeSearchBoxKeyDown" />
                                <TextBox Grid.Column="1" Text="{Binding CodeFilePatterns}"
                                         PlaceholderText="*.cs;*.cpp" ToolTip.Tip="Optional file patterns separated with semicolons" />
                                <Button Grid.Column="2" Classes="primary" Content="Search" Click="OnSearchCodeClick" />
                                <Button Grid.Column="3" Classes="secondary" Content="Cancel" Click="OnCancelCodeSearchClick" />
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="14" Margin="2,7,0,0">
                                    <CheckBox Content="Match case" IsChecked="{Binding CodeSearchMatchCase}" />
                                    <CheckBox Content="Whole words" IsChecked="{Binding CodeSearchWholeWord}" />
                                    <CheckBox Content="Regular expression" IsChecked="{Binding CodeSearchRegex}" />
                                    <TextBlock Text="Ctrl+Shift+F" Foreground="#78D7B7" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CodeSearchSummary}" Classes="muted" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ProgressBar Grid.Row="2" Grid.ColumnSpan="4" Classes="inlineLoader" IsVisible="{Binding IsCodeSearchRunning}"
                                             IsIndeterminate="True" Margin="2,1,2,0" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="3,0">
                            <TextBlock Text="{Binding CodeWorkspaceSummary}" FontSize="10.5" Classes="muted" />
                            <TextBlock Grid.Column="1" Text="Heavy build/cache folders are excluded automatically"
                                       FontSize="10.5" Foreground="#78D7B7" />
                        </Grid>

                        <Border Grid.Row="2" Background="#26282B" BorderBrush="#393B40" BorderThickness="1"
                                CornerRadius="6" Padding="7,5">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,1,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Text="LAYOUT" FontSize="9" FontWeight="Bold" Foreground="#7E8189"
                                           VerticalAlignment="Center" Margin="3,0,2,0" />
                                <ToggleButton x:Name="CodeBalancedLayoutToggle" Grid.Column="1" Classes="layoutChoice"
                                              Content="Balanced" Click="OnBalancedCodeLayoutClick" />
                                <ToggleButton x:Name="CodeEditorFocusLayoutToggle" Grid.Column="2" Classes="layoutChoice"
                                              Content="Editor" Click="OnEditorFocusCodeLayoutClick" />
                                <ToggleButton x:Name="CodeSearchFocusLayoutToggle" Grid.Column="3" Classes="layoutChoice"
                                              Content="Search" Click="OnSearchFocusCodeLayoutClick" />
                                <Border Grid.Column="4" Width="1" Height="18" Background="#4B4D52" Margin="4,0" />
                                <TextBlock Grid.Column="5" Text="PANELS" FontSize="9" FontWeight="Bold" Foreground="#7E8189"
                                           VerticalAlignment="Center" />
                                <ToggleButton x:Name="CodeExplorerPanelToggle" Grid.Column="6" Classes="panelToggle"
                                              Content="Results" Click="OnCodePanelToggleClick" />
                                <ToggleButton x:Name="CodeSymbolsPanelToggle" Grid.Column="7" Classes="panelToggle"
                                              Content="Symbols" Click="OnCodePanelToggleClick" />
                                <ToggleButton x:Name="CodeResultsPanelToggle" Grid.Column="8" Classes="panelToggle"
                                              Content="History" Click="OnCodePanelToggleClick" />
                                <TextBlock Grid.Column="9" Text="Drag dividers to resize · workspace is saved locally"
                                           FontSize="9.5" Classes="muted" VerticalAlignment="Center" Margin="8,0" />
                                <Button Grid.Column="10" Classes="secondary" Content="Save layout" Click="OnSaveWorkspaceLayoutClick" />
                                <Button Grid.Column="11" Classes="secondary" Content="Reset" Click="OnResetWorkspaceLayoutClick" />
                                <Button Grid.Column="12" Classes="secondary" Content="Open in window ↗"
                                        Click="OnOpenDetachedCodeClick" />
                            </Grid>
                        </Border>

                        <Grid x:Name="CodeDockWorkspaceGrid" Grid.Row="3" ColumnDefinitions="0.8*,8,1.45*,8,1*">
                            <Border x:Name="CodeExplorerPanel" Classes="card" Padding="0" ClipToBounds="True" MinWidth="190">
                                <Grid RowDefinitions="42,*">
                                    <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="9,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Find in Files" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CodeSearchSummary}" FontSize="8.5" Classes="muted"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="5,3">
                                        <TextBox Text="{Binding CodeSearchFileFilter, UpdateSourceTrigger=PropertyChanged}" Classes="searchBox"
                                                 PlaceholderText="Filter results by file name or path…" Padding="6,2" />
                                        <TextBlock Grid.Column="1" Text="{Binding CodeSearchResultFilterSummary}" Classes="muted"
                                                   FontSize="8.5" VerticalAlignment="Center" Margin="3,0" />
                                    </Grid>
                                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredCodeSearchResults}"
                                             SelectedItem="{Binding SelectedCodeSearchResult}"
                                             Classes="compactList"
                                             Background="Transparent" BorderThickness="0" Margin="2"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="21" ColumnDefinitions="46,*,175" Margin="4,0"
                                                      ColumnSpacing="6" ToolTip.Tip="{Binding Location}">
                                                    <TextBlock Text="{Binding Position}" Foreground="#7E8799" FontSize="9"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               FontFamily="Cascadia Mono,Consolas" FontSize="9.5">
                                                        <Run Text="{Binding PreviewBeforeMatch}" />
                                                        <Run Text="{Binding PreviewMatch}" Foreground="#FFD866" FontWeight="Bold" />
                                                        <Run Text="{Binding PreviewAfterMatch}" />
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" FontSize="8.5" HorizontalAlignment="Right">
                                                        <Run Text="{Binding FileName}" Foreground="#61AFEF" FontWeight="SemiBold" />
                                                        <Run Text="  " />
                                                        <Run Text="{Binding DirectoryPath}" Foreground="#7E8799" />
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <GridSplitter x:Name="CodeExplorerSplitter" Grid.Column="1" Width="8"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                          Background="#4B4D52" Cursor="SizeWestEast" />

                            <Border x:Name="CodeEditorPanel" Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True" MinWidth="300">
                                <Grid x:Name="CodeEditorDockGrid" RowDefinitions="Auto,1*,8,0.32*">
                                    <Grid Margin="10,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Selected result preview" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CodePreviewSummary}" FontSize="10" Classes="muted"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary" Content="History of selection"
                                                Click="OnCodeSelectionHistoryClick"
                                                ToolTip.Tip="Select lines in the editor, then follow only those lines through Git" />
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <Image Source="{Binding CodePreviewImage}" IsVisible="{Binding CodePreviewIsImage}"
                                               Stretch="Uniform" Margin="14" />
                                        <controls:SyntaxHighlightedCodeView x:Name="CodePreview"
                                                                            Text="{Binding CodePreviewText}"
                                                                            IsVisible="{Binding CodePreviewIsText}"
                                                                            FilePath="{Binding CodePreviewPath}"
                                                                            TargetFilePath="{Binding SelectedCodeSearchResult.RelativePath}"
                                                                            TargetLine="{Binding SelectedCodeSearchResult.LineNumber}"
                                                                            TargetColumn="{Binding SelectedCodeSearchResult.ColumnNumber}"
                                                                            TargetLength="{Binding SelectedCodeSearchResult.MatchText.Length}" />
                                    </Grid>
                                    <GridSplitter x:Name="CodeSymbolsSplitter" Grid.Row="2" Height="8"
                                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                                  Background="#4B4D52" Cursor="SizeNorthSouth" />
                                    <Border x:Name="CodeSymbolsPanel" Grid.Row="3" BorderBrush="#393B40" BorderThickness="0,1,0,0"
                                            MinHeight="90">
                                        <Grid RowDefinitions="Auto,*">
                                            <Grid Margin="10,6" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Symbols" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding CodeSelectionSummary}" FontSize="10" Classes="muted"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding CodeSymbols}" SelectedItem="{Binding SelectedCodeSymbol}"
                                                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                      Background="Transparent" BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="85" />
                                                    <DataGridTextColumn Header="Symbol" Binding="{Binding Name}" Width="*" />
                                                    <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="65" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <GridSplitter x:Name="CodeResultsSplitter" Grid.Column="3" Width="8"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                          Background="#4B4D52" Cursor="SizeWestEast" />

                            <Border x:Name="CodeResultsPanel" Grid.Column="4" Classes="card" Padding="0" ClipToBounds="True" MinWidth="230">
                                <Grid RowDefinitions="42,*">
                                    <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="9,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Git history" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="File or selected-line history" FontSize="8.5" Classes="muted" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding CodeHistory}"
                                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              Background="Transparent" BorderThickness="0" Margin="3">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Rev" Binding="{Binding ShortHash}" Width="65" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Subject}" Width="*" />
                                            <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="80" />
                                            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="105" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ConsoleWorkspaceTab" Header="Console &amp; Logs">
                    <TabControl x:Name="ConsoleAndLogsTabs" Margin="0,8,0,0">
                        <TabItem Header="Repository console">
                            <Grid Margin="5" RowDefinitions="Auto,*,Auto" RowSpacing="7">
                                <Border Classes="card" Padding="9">
                                    <Grid ColumnDefinitions="*,Auto,150,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="7" RowSpacing="4">
                                        <StackPanel>
                                            <TextBlock Text="Repository console" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RepositoryConsoleWorkingDirectory}" Foreground="#78D7B7"
                                                       FontFamily="Cascadia Mono, Consolas" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Shell" Classes="muted" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding RepositoryShells}"
                                                  SelectedItem="{Binding SelectedRepositoryShell}" />
                                        <Button Grid.Column="3" Classes="secondary" Content="Clear output"
                                                Click="OnClearRepositoryConsoleOutputClick" />
                                        <Button Grid.Column="4" Classes="danger" Content="Stop"
                                                IsEnabled="{Binding CanStopRepositoryCommand}" Click="OnStopRepositoryCommandClick" />
                                        <Button Grid.Column="5" Classes="primary" Content="Run"
                                                IsEnabled="{Binding CanRunRepositoryCommand}" Click="OnRunRepositoryCommandClick" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="Commands run in the selected project root with your user permissions. They may modify files or Git."
                                                   Foreground="#F2C66D" FontSize="9.5" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3"
                                                   Text="{Binding RepositoryConsoleStatus}" Classes="muted"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" ColumnDefinitions="*,8,360">
                                    <Border Classes="card" Padding="0" ClipToBounds="True">
                                        <Grid RowDefinitions="36,*">
                                            <Border Background="#2B2D30" BorderBrush="#393B40" BorderThickness="0,0,0,1" Padding="10,0">
                                                <TextBlock Text="Output" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBox x:Name="RepositoryConsoleOutputBox" Grid.Row="1"
                                                     Text="{Binding RepositoryConsoleOutput}" IsReadOnly="True"
                                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                                     FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                     Background="#0D111A" BorderThickness="0" Padding="9"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     TextChanged="OnRepositoryConsoleOutputTextChanged" />
                                        </Grid>
                                    </Border>

                                    <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns"
                                                  ResizeBehavior="PreviousAndNext" Background="#4B4D52" Cursor="SizeWestEast" />

                                    <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                        <Grid RowDefinitions="Auto,*,Auto">
                                            <StackPanel Margin="8,7,8,4" Spacing="5">
                                                <TextBlock Text="Persistent history for this project" FontWeight="SemiBold" />
                                                <TextBox Text="{Binding RepositoryConsoleHistorySearch, UpdateSourceTrigger=PropertyChanged}" Classes="searchBox"
                                                         PlaceholderText="Search previous commands…" />
                                            </StackPanel>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredRepositoryCommandHistory}"
                                                      SelectedItem="{Binding SelectedRepositoryCommand}"
                                                      DoubleTapped="OnRepositoryCommandHistoryDoubleTapped"
                                                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                      Background="Transparent" BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*" />
                                                    <DataGridTextColumn Header="Shell" Binding="{Binding Shell}" Width="92" />
                                                    <DataGridTextColumn Header="Date" Binding="{Binding TimeText}" Width="118" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="7" Margin="8,5,8,8">
                                                <Button Classes="secondary" Content="Use selected" Click="OnUseRepositoryCommandClick" />
                                                <Button Classes="danger" Content="Clear history" Click="OnClearRepositoryConsoleHistoryClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Classes="card" Padding="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text=">" Foreground="#78D7B7" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBox x:Name="RepositoryConsoleInput" Grid.Column="1"
                                                 Text="{Binding RepositoryConsoleCommand, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Enter a command · Enter to run · Up/Down for history"
                                                 FontFamily="Cascadia Mono, Consolas" KeyDown="OnRepositoryConsoleInputKeyDown" />
                                        <Button Grid.Column="2" Classes="primary" Content="Run"
                                                IsEnabled="{Binding CanRunRepositoryCommand}" Click="OnRunRepositoryCommandClick" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Application log">
                            <Grid Margin="5" RowDefinitions="Auto,*,170" RowSpacing="7">
                                <Border Classes="card" Padding="9">
                                    <Grid ColumnDefinitions="*,145,Auto,Auto,Auto" ColumnSpacing="7" RowDefinitions="Auto,Auto">
                                        <TextBox Text="{Binding ApplicationLogSearch, UpdateSourceTrigger=PropertyChanged}" Classes="searchBox"
                                                 PlaceholderText="Search log message or area…" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding ApplicationLogLevelFilters}"
                                                  SelectedItem="{Binding ApplicationLogLevelFilter}" />
                                        <Button Grid.Column="2" Classes="secondary" Content="Refresh" Click="OnRefreshApplicationLogsClick" />
                                        <Button Grid.Column="3" Classes="secondary" Content="Open log folder ↗" Click="OnOpenApplicationLogFolderClick" />
                                        <Button Grid.Column="4" Classes="secondary" Content="Clear view" Click="OnClearApplicationLogViewClick" />
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding ApplicationLogProjectSummary}" Foreground="#78D7B7"
                                                       FontSize="9" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CurrentApplicationLogPath}"
                                                       Classes="muted" FontSize="9" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True" Background="#101114">
                                    <ListBox ItemsSource="{Binding FilteredApplicationLogEntries}" Classes="compactLog"
                                             SelectedItem="{Binding SelectedApplicationLogEntry}"
                                             Background="#101114" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LinuxLine}" Foreground="{Binding LevelColor}"
                                                            FontFamily="Cascadia Mono, Consolas" FontSize="9.5"
                                                            TextWrapping="NoWrap" Margin="6,0" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <Border Grid.Row="2" Classes="card" Padding="9">
                                    <Grid RowDefinitions="Auto,*">
                                        <TextBlock Text="Selected log details" FontWeight="SemiBold" />
                                        <TextBox Grid.Row="1" Text="{Binding SelectedApplicationLogEntry.Message}"
                                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                 FontFamily="Cascadia Mono, Consolas"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem x:Name="HistoryWorkspaceTab" Header="Historique">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,*" RowSpacing="7">
                        <Border Classes="card" Padding="13">
                            <Grid ColumnDefinitions="*,Auto,250,Auto,Auto,Auto" ColumnSpacing="10">
                                <TextBox Text="{Binding ExplorerSearch}" Classes="searchBox" PlaceholderText="Search by message, author, or hash…" />
                                <TextBlock Grid.Column="1" Text="Comparer avec" Classes="muted" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedComparisonRevision}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Inlines>
                                                    <Run Text="{Binding ShortHash}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding Subject}" />
                                                </TextBlock.Inlines>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="3" Classes="primary" Content="Comparer A ↔ B" Click="OnCompareExplorerCommitsClick" />
                                <Button Grid.Column="4" Classes="secondary" Content="Compose restore…" Click="OnShowMultiRestoreWorkspaceClick" />
                                <Button Grid.Column="5" Classes="secondary" Content="Fetch remotes" Click="OnFetchClick"
                                        ToolTip.Tip="Fetch remote refs, then include them in the history list" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#26282B" BorderBrush="#393B40" BorderThickness="1"
                                CornerRadius="6" Padding="7,5">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,1,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Text="LAYOUT" FontSize="9" FontWeight="Bold" Foreground="#7E8189"
                                           VerticalAlignment="Center" Margin="3,0,2,0" />
                                <ToggleButton x:Name="HistoryColumnsLayoutToggle" Grid.Column="1" Classes="layoutChoice"
                                              Content="Colonnes" Click="OnColumnsHistoryLayoutClick"
                                              ToolTip.Tip="Trois panneaux côte à côte" />
                                <ToggleButton x:Name="HistoryReviewLayoutToggle" Grid.Column="2" Classes="layoutChoice"
                                              Content="Révision" Click="OnReviewHistoryLayoutClick"
                                              ToolTip.Tip="Chronologie à gauche, fichiers et diff empilés" />
                                <ToggleButton x:Name="HistoryDiffFocusLayoutToggle" Grid.Column="3" Classes="layoutChoice"
                                              Content="Diff principal" Click="OnDiffFocusedHistoryLayoutClick"
                                              ToolTip.Tip="Grand diff avec panneaux secondaires empilés" />

                                <Border Grid.Column="4" Width="1" Height="18" Background="#4B4D52" Margin="4,0" />
                                <TextBlock Grid.Column="5" Text="PANNEAUX" FontSize="9" FontWeight="Bold" Foreground="#7E8189"
                                           VerticalAlignment="Center" Margin="3,0,2,0" />
                                <ToggleButton x:Name="HistoryTimelineToggle" Grid.Column="6" Classes="panelToggle"
                                              Content="Chronologie" IsChecked="True" Click="OnHistoryPanelToggleClick"
                                              ToolTip.Tip="Afficher la chronologie" />
                                <ToggleButton x:Name="HistoryFilesToggle" Grid.Column="7" Classes="panelToggle"
                                              Content="Fichiers" IsChecked="True" Click="OnHistoryPanelToggleClick"
                                              ToolTip.Tip="Afficher les fichiers" />
                                <ToggleButton x:Name="HistoryDiffToggle" Grid.Column="8" Classes="panelToggle"
                                              Content="Diff ciblé" IsChecked="True" Click="OnHistoryPanelToggleClick"
                                              ToolTip.Tip="Afficher le diff ciblé" />

                                <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock Text="Drag dividers to resize" FontSize="9.5" Classes="muted"
                                               VerticalAlignment="Center" Margin="6,0" />
                                    <Button Classes="secondary" Content="Save layout" Click="OnSaveWorkspaceLayoutClick" />
                                    <Button Classes="secondary" Content="Reset" Click="OnResetWorkspaceLayoutClick" />
                                </StackPanel>

                                <Button Grid.Column="10" Classes="secondary" Content="Ouvrir le diff dans une fenêtre ↗"
                                        Click="OnOpenFocusedDiffWindowClick" ToolTip.Tip="Ouvrir le diff ciblé dans une fenêtre redimensionnable" />
                                <Button Grid.Column="11" Classes="secondary" Content="Commit Explorer ↗"
                                        Click="OnOpenCommitExplorerWindowClick"
                                        ToolTip.Tip="Open commits, committed files and a live diff in a separate window" />
                            </Grid>
                        </Border>

                        <Grid x:Name="HistoryWorkspaceGrid" Grid.Row="2"
                              ColumnDefinitions="0.9*,6,1.25*,6,1.15*" RowDefinitions="*,0,0">
                            <Border x:Name="HistoryTimelinePanel" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Background="#2B2D30" BorderBrush="#393B40" BorderThickness="0,0,0,1" Padding="12,9">
                                        <StackPanel>
                                            <TextBlock Text="Chronologie" FontSize="14" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="Cliquez sur une révision pour l'inspecter." FontSize="9.5" Classes="muted" />
                                                <TextBlock Text="{Binding HistoryScope}" FontSize="9.5" Foreground="#61AFEF" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedExplorerRevision}"
                                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              Background="Transparent" BorderThickness="0" Margin="6,3,6,6">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Révision" Binding="{Binding ShortHash}" Width="78" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Subject}" Width="*" />
                                            <DataGridTextColumn Header="Auteur" Binding="{Binding AuthorName}" Width="110" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <GridSplitter x:Name="HistorySplitterOne" Grid.Column="1" Width="6" Margin="1,14"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                          Background="#4B4D52" Cursor="SizeWestEast" />

                            <Border x:Name="HistoryFilesPanel" Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,1.45*,Auto,0.75*">
                                    <Border Background="#2B2D30" BorderBrush="#393B40" BorderThickness="0,0,0,1" Padding="12,9">
                                        <StackPanel>
                                            <TextBlock Text="Fichiers de la révision" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ExplorerSummary}" FontSize="9.5" Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding ExplorerFiles}" SelectedItem="{Binding SelectedExplorerFile}"
                                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              Background="Transparent" BorderThickness="0" Margin="6,3,6,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="État" Binding="{Binding Kind}" Width="78" />
                                            <DataGridTextColumn Header="Fichier" Binding="{Binding Path}" Width="*" />
                                            <DataGridTextColumn Header="Variation" Binding="{Binding ChangeSummary}" Width="92" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="12,8,12,5">
                                        <TextBlock Text="Historique du fichier" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Exporter cette version…" Click="OnExportExplorerFileClick" />
                                    </Grid>
                                    <DataGrid Grid.Row="3" Classes="historyCompact" ItemsSource="{Binding ExplorerFileHistory}" AutoGenerateColumns="False"
                                              IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent"
                                              BorderThickness="0" Margin="6,0,6,6">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Révision" Binding="{Binding Revision.ShortHash}" Width="76" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Revision.Subject}" Width="*" />
                                            <DataGridTextColumn Header="Date" Binding="{Binding Revision.AuthoredAt}" Width="128" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <GridSplitter x:Name="HistorySplitterTwo" Grid.Column="3" Width="6" Margin="1,14"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                          Background="#4B4D52" Cursor="SizeWestEast" />

                            <Border x:Name="HistoryDiffPanel" Grid.Column="4" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,Auto,*">
                                    <Border Background="#2B2D30" BorderBrush="#393B40" BorderThickness="0,0,0,1" Padding="12,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel>
                                                <TextBlock Text="Diff ciblé" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="Lecture seule · aucun checkout" FontSize="9.5" Foreground="#78D7B7" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="secondary" Content="Ouvrir ↗"
                                                    Click="OnOpenFocusedDiffWindowClick"
                                                    ToolTip.Tip="Ouvrir le diff ciblé dans une fenêtre redimensionnable" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" IsVisible="{Binding IsExplorerAnyLoading}" Background="#202633" Padding="8,4">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <TextBlock Text="Loading diff…" Classes="muted" FontSize="9" />
                                            <ProgressBar Grid.Column="1" Classes="inlineLoader" IsIndeterminate="True" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <controls:CodeDiffView Grid.Row="2"
                                                           DiffText="{Binding ExplorerDiff}"
                                                           PreviewImage="{Binding ExplorerDiffPreviewImage}"
                                                           PresentationSummary="{Binding ExplorerDiffPresentationSummary}"
                                                           FilePath="{Binding SelectedExplorerFile.Path}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="CompositionWorkspaceTab" Header="Compose">
                    <controls:RevisionCompositionView x:Name="MainRevisionCompositionView" Margin="0,1,0,0" />
                </TabItem>

                <TabItem x:Name="BranchesWorkspaceTab" Header="Branches">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="1.1*,1*" ColumnSpacing="8">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,34,*,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="Local and remote branches" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Remote refs are read-only until you create or switch to a local branch"
                                                   FontSize="9" Classes="muted" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="secondary" Content="Fetch remotes" Click="OnFetchClick" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,105" ColumnSpacing="6" Margin="0,5,0,3">
                                    <TextBox Text="{Binding BranchSearch, UpdateSourceTrigger=PropertyChanged}" Classes="searchBox"
                                             PlaceholderText="Search branch, remote or status…" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding BranchSortOptions}"
                                              SelectedItem="{Binding BranchSort}" />
                                </Grid>
                                <ListBox x:Name="BranchListBox" Grid.Row="2" Margin="0,3" ItemsSource="{Binding FilteredBranches}"
                                         SelectedItem="{Binding SelectedBranch}" SelectionMode="Multiple"
                                         SelectionChanged="OnBranchSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="5,3" ColumnSpacing="8">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{Binding DisplayColor}"
                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TipSubject}" />
                                                <TextBlock Grid.Column="1" Text="{Binding ShortCommitHash}" Classes="muted" />
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Scope}" Foreground="{Binding DisplayColor}" FontSize="8.5" />
                                                    <TextBlock Text="{Binding PublicationStatus}" Foreground="{Binding PublicationColor}" FontSize="8.5" />
                                                    <TextBlock Text="{Binding SyncStatus}" Foreground="{Binding PublicationColor}" FontSize="8.5" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TipUpdateText}"
                                                           Classes="muted" FontSize="8.5" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Grid.Row="3">
                                    <Button Classes="secondary" Content="Switch / create local" Click="OnCheckoutBranchClick" Margin="0,0,6,4" />
                                    <Button Classes="primary" Content="Merge from" Click="OnMergeBranchClick" Margin="0,0,6,4"
                                            ToolTip.Tip="Merge the selected branch into the current branch" />
                                    <Button Classes="secondary" Content="Merge to" Click="OnMergeCurrentBranchIntoSelectedClick" Margin="0,0,6,4"
                                            ToolTip.Tip="Switch to the selected local branch, then merge the current branch into it" />
                                    <Button Classes="danger" Content="Remove selected local branch(es)…" Margin="0,0,6,4"
                                            IsEnabled="{Binding CanRemoveSelectedLocalBranch}"
                                            Click="OnRemoveLocalBranchClick"
                                            ToolTip.Tip="Remove the selected local branches in one operation; remote branches are never removed" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,Auto,*,Auto,145" RowSpacing="7">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Selected branch commits" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedBranchSummary}" Classes="muted" FontSize="9" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Classes="secondary" Content="Browse branch files ↗"
                                                IsEnabled="{Binding SelectedBranch, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Click="OnOpenSelectedBranchFilesClick"
                                                ToolTip.Tip="Explore and retrieve individual files without switching branches" />
                                        <Button Classes="secondary" Content="Open selected commit ↗"
                                                Click="OnOpenSelectedBranchCommitClick"
                                                ToolTip.Tip="Open the selected commit, its files and diffs in the external Commit Explorer" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="#24262A" CornerRadius="5" Padding="8">
                                    <Grid ColumnDefinitions="1*,1*,1*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="COMPARISON BASE" Classes="muted" FontSize="8" />
                                            <TextBlock Text="{Binding SelectedBranchDetails.ComparisonBaseText}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="COMMITS AHEAD" Classes="muted" FontSize="8" />
                                            <TextBlock Text="{Binding SelectedBranchDetails.UniqueCommitText}" Foreground="#78D7B7"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="CREATED BY (INFERRED)" Classes="muted" FontSize="8" />
                                            <TextBlock Text="{Binding SelectedBranchDetails.CreatorText}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="ESTIMATED CREATION" Classes="muted" FontSize="8" />
                                            <TextBlock Text="{Binding SelectedBranchDetails.CreatedText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="LAST UPDATE" Classes="muted" FontSize="8" />
                                            <TextBlock Text="{Binding SelectedBranchDetails.UpdatedText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock Text="LAST COMMIT" Classes="muted" FontSize="8" />
                                            <TextBlock Text="{Binding SelectedBranchDetails.LastSubject}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding SelectedBranchDetails.LastAuthorName}" />
                                            <TextBlock Text="{Binding SelectedBranchDetails.LastAuthorName}" Classes="muted" FontSize="8.5" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataGrid x:Name="SelectedBranchCommitGrid" Grid.Row="2"
                                          ItemsSource="{Binding SelectedBranchHistory}"
                                          SelectedItem="{Binding SelectedBranchRevision, Mode=TwoWay}"
                                          DoubleTapped="OnSelectedBranchCommitDoubleTapped"
                                          Classes="historyCompact"
                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Commit" Binding="{Binding ShortHash}" Width="72" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Subject}" Width="*" />
                                        <DataGridTextColumn Header="Author" Binding="{Binding AuthorName}" Width="105" />
                                        <DataGridTextColumn Header="Date" Binding="{Binding AuthoredAt}" Width="130" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="3" Background="#24262A" CornerRadius="5" Padding="8">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="7" RowSpacing="5">
                                        <TextBlock Text="Create branch" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Remote origin" FontWeight="SemiBold" />
                                        <TextBox Grid.Row="1" x:Name="NewBranchName" PlaceholderText="feature/name" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Width="250" Text="{Binding RemoteUrl}" PlaceholderText="https:// or ssh://" />
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                            <Button Classes="primary" Content="Create and switch" Click="OnCreateBranchClick" />
                                            <Button Classes="secondary" Content="Create from selected commit"
                                                    Click="OnCreateBranchFromCommitClick"
                                                    IsEnabled="{Binding SelectedBranchRevision, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    ToolTip.Tip="Create and switch to a new branch starting at the commit selected above" />
                                            <CheckBox Content="Isolated worktree (recommended)"
                                                      IsChecked="{Binding CreateHistoricalBranchInWorktree}"
                                                      VerticalAlignment="Center"
                                                      ToolTip.Tip="Creates the branch in a separate worktree without changing the main repository" />
                                        </StackPanel>
                                        <Button Grid.Row="2" Grid.Column="1" Classes="secondary" Content="Save origin" Click="OnSaveRemoteClick" HorizontalAlignment="Left" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="4" Background="#24262A" CornerRadius="5" Padding="7">
                                    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                        <StackPanel>
                                            <TextBlock Text="Historical worktrees" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding HistoricalWorktreeStatus}" Classes="muted" FontSize="8.5"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary" Content="Refresh" Click="OnRefreshHistoricalWorktreesClick" />
                                        <Button Grid.Column="2" Classes="secondary" Content="Open folder" Click="OnOpenHistoricalWorktreeClick" />
                                        <Button Grid.Column="3" Classes="danger" Content="Remove" Click="OnRemoveHistoricalWorktreeClick" />
                                        <DataGrid Grid.Row="1" Grid.ColumnSpan="4" ItemsSource="{Binding HistoricalWorktrees}"
                                                  SelectedItem="{Binding SelectedHistoricalWorktree}" Classes="historyCompact"
                                                  AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                                  GridLinesVisibility="Horizontal" Background="Transparent">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                                                <DataGridTextColumn Header="Branch" Binding="{Binding Branch}" Width="150" />
                                                <DataGridTextColumn Header="Commit" Binding="{Binding ShortCommitHash}" Width="72" />
                                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="70" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="GitAnnotationsWorkspaceTab" Header="Annotations">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="1.15*,8,1*">
                        <Border Classes="card" Padding="0">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <Border Background="#2B2D30" Padding="10,7">
                                    <StackPanel>
                                        <TextBlock Text="Local Git annotations" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Personal notes for commits and branches. Stored by CyRevision; the repository is never modified."
                                                   Classes="muted" FontSize="9.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Row="1" ColumnDefinitions="*,130" ColumnSpacing="7" Margin="8,7">
                                    <TextBox Text="{Binding GitAnnotationSearch}"
                                             PlaceholderText="Search target, title, note or tags…" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding GitAnnotationKindFilters}"
                                              SelectedItem="{Binding GitAnnotationKindFilter}" />
                                </Grid>
                                <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredGitAnnotations}"
                                          SelectedItem="{Binding SelectedGitAnnotation}"
                                          AutoGenerateColumns="False" IsReadOnly="True" Classes="historyCompact"
                                          GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding KindText}" Width="75" />
                                        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="145" />
                                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.2*" />
                                        <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="100" />
                                        <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedText}" Width="125" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" />

                        <Border Grid.Column="2" Classes="card">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Text="Annotation editor" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding GitAnnotationStatus}" Classes="muted" FontSize="9.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="secondary" Content="New" Click="OnNewGitAnnotationClick" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="120,*" ColumnSpacing="7">
                                    <ComboBox ItemsSource="{Binding GitAnnotationEditorKinds}"
                                              SelectedItem="{Binding GitAnnotationEditorKind}" />
                                    <TextBox Grid.Column="1" Text="{Binding GitAnnotationTarget}"
                                             PlaceholderText="Full commit hash or branch name" />
                                </Grid>
                                <WrapPanel Grid.Row="2">
                                    <Button Classes="secondary" Content="Use selected commit" Click="OnUseSelectedCommitAnnotationClick" Margin="0,0,6,0" />
                                    <Button Classes="secondary" Content="Use selected branch" Click="OnUseSelectedBranchAnnotationClick" />
                                </WrapPanel>
                                <Grid Grid.Row="3" ColumnDefinitions="1.5*,1*" ColumnSpacing="7">
                                    <TextBox Text="{Binding GitAnnotationTitle}" PlaceholderText="Short title" />
                                    <TextBox Grid.Column="1" Text="{Binding GitAnnotationTags}" PlaceholderText="Tags, comma separated" />
                                </Grid>
                                <TextBox Grid.Row="4" Text="{Binding GitAnnotationNote}" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalContentAlignment="Top"
                                         PlaceholderText="Local note…" />
                                <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
                                    <TextBlock Text="Future team sharing can reuse this metadata without changing Git history."
                                               Classes="muted" FontSize="9" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Classes="danger" Content="Delete" Click="OnDeleteGitAnnotationClick" />
                                    <Button Grid.Column="2" Classes="primary" Content="Save locally" Click="OnSaveGitAnnotationClick" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="PullRequestsWorkspaceTab" Header="Pull Requests">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="8">
                        <Border Classes="card" Padding="10">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Pull Request Manager" FontSize="16" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding PullRequestRepositoryName}" Foreground="#78D7B7" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PullRequestStatus}" Classes="muted" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                                    <ComboBox Width="105" ItemsSource="{Binding PullRequestStateFilters}"
                                              SelectedItem="{Binding PullRequestStateFilter}" />
                                    <Button Classes="secondary" Content="Detect remote" Click="OnResolvePullRequestRepositoryClick" />
                                    <Button Classes="primary" Content="Refresh" Click="OnRefreshPullRequestsClick" />
                                </StackPanel>
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,170,Auto,230,Auto,230,*,Auto"
                                      ColumnSpacing="7">
                                    <TextBlock Text="API" Classes="muted" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding PullRequestApiBaseUrl}"
                                             PlaceholderText="Auto / GitHub Enterprise API" />
                                    <TextBlock Grid.Column="2" Text="Token env" Classes="muted" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="3" Text="{Binding PullRequestTokenEnvironmentVariable}"
                                             PlaceholderText="GITHUB_TOKEN" />
                                    <TextBlock Grid.Column="4" Text="Session token" Classes="muted" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="5" Text="{Binding PullRequestToken}" PasswordChar="●"
                                             PlaceholderText="Never saved" />
                                    <TextBlock Grid.Column="6" Text="{Binding PullRequestAuthenticationState}" FontSize="9.5"
                                               Foreground="#F2C66D" VerticalAlignment="Center" Margin="8,0" />
                                    <Button Grid.Column="7" Classes="secondary" Content="Token help ↗"
                                            Click="OnOpenGitHubTokenHelpClick"
                                            ToolTip.Tip="Private repositories require a GitHub token with repository and pull-request access" />
                                </Grid>
                                <Border Grid.Row="2" Grid.ColumnSpan="2" IsVisible="{Binding IsPullRequestLoading}"
                                        Background="#202633" CornerRadius="4" Padding="8,4">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <TextBlock Text="Loading pull request data…" Classes="muted" FontSize="9" />
                                        <ProgressBar Grid.Column="1" Classes="inlineLoader" IsIndeterminate="True" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="420,8,*">
                            <Border Classes="card" Padding="0" ClipToBounds="True" MinWidth="310">
                                <TabControl>
                                    <TabItem Header="Requests">
                                        <Grid RowDefinitions="34,*">
                                            <TextBox Margin="4" Text="{Binding PullRequestSearch, UpdateSourceTrigger=PropertyChanged}" Classes="searchBox"
                                                     PlaceholderText="Search pull requests by number, title, author, branch or state…" />
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredPullRequests}" SelectedItem="{Binding SelectedPullRequest}"
                                                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                  Background="Transparent" BorderThickness="0" Margin="4">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding NumberText}" Width="58" />
                                                <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="72" />
                                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="100" />
                                                <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedText}" Width="125" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Create">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="12" Spacing="8">
                                                <TextBlock Text="Create pull request" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="The source branch must already be pushed to the remote."
                                                           Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
                                                    <TextBox Text="{Binding NewPullRequestTitle}" PlaceholderText="Title" />
                                                    <Button Grid.Column="1" Classes="secondary" Content="Tasks…"
                                                            Click="OnAddPullRequestTaskLinksClick"
                                                            IsVisible="{Binding HasWorkItemPlugins}"
                                                            ToolTip.Tip="Search enabled Jira or ClickUp plugins and add selected task links to this pull request draft" />
                                                    <Button Grid.Column="2" Classes="secondary" Content="AI draft"
                                                            Click="OnGenerateAiPullRequestDraftClick"
                                                            IsEnabled="{Binding CanGenerateAiPullRequestDraft}"
                                                            ToolTip.Tip="Uses the connected project AI to draft the title and description; it never creates the pull request" />
                                                </Grid>
                                                <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="Head branch" FontSize="10" Classes="muted" />
                                                        <TextBox Text="{Binding NewPullRequestHeadBranch}" PlaceholderText="feature/name" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="Base branch" FontSize="10" Classes="muted" />
                                                        <TextBox Text="{Binding NewPullRequestBaseBranch}" PlaceholderText="main" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBox Text="{Binding NewPullRequestBody}" AcceptsReturn="True" Height="180"
                                                         TextWrapping="Wrap" PlaceholderText="Description (Markdown)" />
                                                <CheckBox Content="Create as draft" IsChecked="{Binding NewPullRequestIsDraft}" />
                                                <Button Classes="primary" Content="Create pull request" Click="OnCreatePullRequestClick"
                                                        HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </Border>

                            <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns"
                                          ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                          Background="#4B4D52" Cursor="SizeWestEast" />

                            <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Background="#2B2D30" BorderBrush="#393B40" BorderThickness="0,0,0,1" Padding="12,9">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding SelectedPullRequest.NumberText}" FontWeight="Bold" Foreground="#78D7B7" />
                                                    <TextBlock Text="{Binding SelectedPullRequest.Title}" FontSize="15" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Background="#34363A" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding SelectedPullRequest.StateText}" FontSize="9" FontWeight="Bold"
                                                                   Foreground="#F2C66D" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedPullRequest.BranchText}" FontSize="10" Classes="muted" />
                                                <TextBlock Text="{Binding PullRequestDetailsSummary}" FontSize="10" Foreground="#78D7B7" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Classes="secondary" Content="Commit Explorer ↗"
                                                        Click="OnOpenPullRequestCommitExplorerClick"
                                                        IsEnabled="{Binding HasSelectedPullRequest}" />
                                                <Button Classes="secondary" Content="Open ↗" Click="OnOpenPullRequestClick"
                                                        IsEnabled="{Binding HasSelectedPullRequest}" />
                                                <Button Classes="secondary" Content="Checkout" Click="OnCheckoutPullRequestClick"
                                                        IsEnabled="{Binding HasSelectedPullRequest}" />
                                                <Button Classes="secondary" Content="Close / reopen" Click="OnTogglePullRequestStateClick"
                                                        IsEnabled="{Binding HasSelectedPullRequest}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding PullRequestBody}" TextWrapping="Wrap"
                                                       MaxHeight="72" Classes="muted" />
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                        VerticalAlignment="Bottom">
                                                <ComboBox Width="105" ItemsSource="{Binding PullRequestMergeMethods}"
                                                          SelectedItem="{Binding PullRequestMergeMethod}" />
                                                <Button Classes="primary" Content="Merge" Click="OnMergePullRequestClick"
                                                        IsEnabled="{Binding CanMergeSelectedPullRequest}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TabControl Grid.Row="1">
                                        <TabItem Header="Files and patch">
                                            <Grid RowDefinitions="30,*" Margin="4">
                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                                                    <TextBlock Text="LAYOUT" Classes="muted" FontSize="9" FontWeight="Bold"
                                                               VerticalAlignment="Center" />
                                                    <ToggleButton x:Name="PullRequestBalancedLayoutToggle" Grid.Column="1"
                                                                  Classes="layoutChoice" Content="Balanced" IsChecked="True"
                                                                  Click="OnPullRequestBalancedLayoutClick" />
                                                    <ToggleButton x:Name="PullRequestDiffFocusLayoutToggle" Grid.Column="2"
                                                                  Classes="layoutChoice" Content="Diff focus"
                                                                  Click="OnPullRequestDiffFocusLayoutClick" />
                                                    <TextBlock Text="Select a file to inspect its provider patch" Classes="muted" FontSize="9"
                                                               Grid.Column="3" VerticalAlignment="Center" />
                                                    <ToggleButton x:Name="PullRequestDiffToggle" Grid.Column="4" Classes="layoutChoice"
                                                                  Content="Diff" Click="OnPullRequestDiffToggleClick" />
                                                    <Button Grid.Column="5" Classes="secondary" Content="Open diff ↗"
                                                            Click="OnOpenPullRequestDiffWindowClick" />
                                                </Grid>
                                            <Grid x:Name="PullRequestFilesWorkspaceGrid" Grid.Row="1" ColumnDefinitions="0.78*,8,1.22*">
                                                <DataGrid ItemsSource="{Binding PullRequestFiles}" SelectedItem="{Binding SelectedPullRequestFile}"
                                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                          Background="Transparent" BorderThickness="0">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="78" />
                                                        <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*" />
                                                        <DataGridTextColumn Header="Change" Binding="{Binding ChangeText}" Width="95" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <GridSplitter x:Name="PullRequestDiffSplitter" Grid.Column="1" Width="8" ResizeDirection="Columns"
                                                              ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                                              Background="#4B4D52" Cursor="SizeWestEast" />
                                                <controls:CodeDiffView x:Name="PullRequestDiffPanel" Grid.Column="2" DiffText="{Binding PullRequestPatch}"
                                                                       FilePath="{Binding SelectedPullRequestFile.Path}" />
                                            </Grid>
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="Conversation">
                                            <Grid Margin="8" RowDefinitions="*,Auto" RowSpacing="8">
                                                <TabControl>
                                                    <TabItem Header="Comments">
                                                        <DataGrid ItemsSource="{Binding PullRequestComments}" AutoGenerateColumns="False"
                                                                  IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent"
                                                                  BorderThickness="0">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="110" />
                                                                <DataGridTextColumn Header="Comment" Binding="{Binding Body}" Width="*" />
                                                                <DataGridTextColumn Header="Date" Binding="{Binding CreatedText}" Width="135" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </TabItem>
                                                    <TabItem Header="Reviews">
                                                        <DataGrid ItemsSource="{Binding PullRequestReviews}" AutoGenerateColumns="False"
                                                                  IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent"
                                                                  BorderThickness="0">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="110" />
                                                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120" />
                                                                <DataGridTextColumn Header="Review" Binding="{Binding Body}" Width="*" />
                                                                <DataGridTextColumn Header="Date" Binding="{Binding SubmittedText}" Width="135" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </TabItem>
                                                </TabControl>
                                                <Grid Grid.Row="1" ColumnDefinitions="1*,Auto,1*,125,Auto" ColumnSpacing="7">
                                                    <TextBox Text="{Binding PullRequestComment}" PlaceholderText="General comment…" />
                                                    <Button Grid.Column="1" Classes="secondary" Content="Comment" Click="OnAddPullRequestCommentClick" />
                                                    <TextBox Grid.Column="2" Text="{Binding PullRequestReviewBody}" PlaceholderText="Review summary…" />
                                                    <ComboBox Grid.Column="3" ItemsSource="{Binding PullRequestReviewActions}"
                                                              SelectedItem="{Binding PullRequestReviewAction}" />
                                                    <Button Grid.Column="4" Classes="primary" Content="Submit review" Click="OnSubmitPullRequestReviewClick" />
                                                </Grid>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="CiWorkspaceTab" Header="CI / Actions">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,3,*" RowSpacing="6">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Continuous integration" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CiStatus}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PullRequestAuthenticationState}" Foreground="#E5C07B" FontSize="9" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primary" Content="Refresh workflows &amp; runs"
                                        Click="OnRefreshCiClick" />
                            </Grid>
                        </Border>
                        <ProgressBar Grid.Row="1" Classes="inlineLoader" IsVisible="{Binding IsCiLoading}" IsIndeterminate="True" />
                        <Grid Grid.Row="2" ColumnDefinitions="0.82*,7,1.15*,7,1.25*">
                            <Border Classes="card" Padding="10">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="7">
                                    <TextBlock Text="Start a workflow" FontSize="14" FontWeight="SemiBold" />
                                    <ComboBox Grid.Row="1" ItemsSource="{Binding CiWorkflows}"
                                              SelectedItem="{Binding SelectedCiWorkflow}">
                                        <ComboBox.ItemTemplate><DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid Grid.Row="2" ColumnDefinitions="72,*" ColumnSpacing="6">
                                        <TextBlock Text="Git ref" Classes="muted" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding CiGitRef}" PlaceholderText="main or current branch" />
                                    </Grid>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                                        <Button Classes="primary" Content="Run selected" Click="OnDispatchCiClick" />
                                    </StackPanel>
                                    <Border Grid.Row="4" BorderBrush="#45484E" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Create a release" FontWeight="SemiBold" />
                                            <TextBlock Text="Dispatches the release workflow with its version input. No local tag or commit is created."
                                                       Classes="muted" FontSize="9.5" TextWrapping="Wrap" />
                                            <TextBox Text="{Binding CiReleaseVersion}" PlaceholderText="0.1.15" />
                                            <Button Classes="primary" Content="Build release on CI" HorizontalAlignment="Left"
                                                    Click="OnDispatchReleaseCiClick" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <GridSplitter Grid.Column="1" Width="7" Background="#45484E"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                            <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="36,*">
                                    <TextBlock Text="Recent runs" Margin="9,0" VerticalAlignment="Center"
                                               FontSize="13" FontWeight="SemiBold" />
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding CiRuns}" SelectedItem="{Binding SelectedCiRun}"
                                              Classes="historyCompact" AutoGenerateColumns="False" IsReadOnly="True"
                                              GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Workflow" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Branch" Binding="{Binding Branch}" Width="105" />
                                            <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="82" />
                                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedText}" Width="116" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <GridSplitter Grid.Column="3" Width="7" Background="#45484E"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                            <Border Grid.Column="4" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,0.8*,Auto,1.2*">
                                    <Grid Margin="9,7" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                        <TextBlock Text="Jobs and failures" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Open on GitHub" Click="OnOpenCiRunClick" />
                                        <Button Grid.Column="2" Classes="secondary" Content="Rerun failed" Click="OnRerunFailedCiClick" />
                                        <Button Grid.Column="3" Classes="danger" Content="Cancel" Click="OnCancelCiRunClick" />
                                    </Grid>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding CiJobs}" Classes="historyCompact"
                                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              BorderThickness="0" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Job" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="90" />
                                            <DataGridTextColumn Header="Failed step" Binding="{Binding FailedStepSummary}" Width="1.2*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Grid.Row="2" Text="Error summary" Margin="9,7,9,4" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="3" Text="{Binding CiRunDetails}" IsReadOnly="True" AcceptsReturn="True"
                                             FontFamily="Cascadia Mono,Consolas" FontSize="10" TextWrapping="Wrap"
                                             BorderThickness="0" Background="#111820" Padding="8" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="GitGraphsWorkspaceTab" Header="Graphes Git">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="7">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Visualisations alternatives de l'historique" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding GitGraphSummary}" Classes="muted" TextWrapping="Wrap" />
                                    <TextBlock Text="Analyse locale et strictement en lecture seule. Aucun commit, index ou fichier n'est modifié."
                                               FontSize="10" Foreground="#78D7B7" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Commits" VerticalAlignment="Center" Classes="muted" FontSize="11" />
                                    <TextBox Text="{Binding GitGraphCommitLimit}" Width="62" />
                                    <TextBlock Text="Fichiers" VerticalAlignment="Center" Classes="muted" FontSize="11" />
                                    <TextBox Text="{Binding GitGraphFileLimit}" Width="56" />
                                    <CheckBox Content="Toutes les branches" IsChecked="{Binding GitGraphIncludeAllBranches}" VerticalAlignment="Center" />
                                    <Button Classes="primary" Content="Analyser le dépôt" Click="OnAnalyzeGitGraphsClick" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TabControl Grid.Row="1">
                            <TabItem Header="Réseau de commits">
                                <Border Margin="0,6,0,0" Classes="card" Padding="3">
                                    <controls:GitCommitGraphView Commits="{Binding GitGraphCommits}" CommitSelected="OnGraphCommitSelected" />
                                </Border>
                            </TabItem>

                            <TabItem Header="Relations entre fichiers">
                                <Grid Margin="0,6,0,0" ColumnDefinitions="*,5,300">
                                    <Border Classes="card" Padding="5">
                                        <Grid RowDefinitions="Auto,*">
                                            <WrapPanel Margin="10,6,10,3" Orientation="Horizontal">
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,0"><Border Width="9" Height="9" CornerRadius="5" Background="#55A7F3" VerticalAlignment="Center" /><TextBlock Text="Code" FontSize="10" Classes="muted" /></StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,0"><Border Width="9" Height="9" CornerRadius="5" Background="#A477D4" VerticalAlignment="Center" /><TextBlock Text="Unreal" FontSize="10" Classes="muted" /></StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,0"><Border Width="9" Height="9" CornerRadius="5" Background="#E56B91" VerticalAlignment="Center" /><TextBlock Text="Textures" FontSize="10" Classes="muted" /></StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,0"><Border Width="9" Height="9" CornerRadius="5" Background="#E5A94D" VerticalAlignment="Center" /><TextBlock Text="3D" FontSize="10" Classes="muted" /></StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,0"><Border Width="9" Height="9" CornerRadius="5" Background="#36C5A1" VerticalAlignment="Center" /><TextBlock Text="Audio" FontSize="10" Classes="muted" /></StackPanel>
                                                <TextBlock Text="Taille = quantité de modifications · lien = fichiers modifiés ensemble · liens les plus forts affichés" FontSize="10" Classes="muted" />
                                            </WrapPanel>
                                            <controls:GitFileRelationGraphView Grid.Row="1"
                                                                                  Files="{Binding GitFileActivities}"
                                                                                  Relations="{Binding GitFileRelations}" />
                                        </Grid>
                                    </Border>
                                    <GridSplitter Grid.Column="1" Width="6" Margin="1,16" ResizeDirection="Columns"
                                                  Background="#34415D" Cursor="SizeWestEast" />
                                    <Border Grid.Column="2" Classes="card" Padding="12" Margin="10,0,0,0" MinWidth="220">
                                        <Grid RowDefinitions="Auto,*">
                                            <StackPanel>
                                                <TextBlock Text="Fichiers les plus actifs" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="Cliquez ou survolez un nœud pour le détail." FontSize="10" Classes="muted" />
                                            </StackPanel>
                                            <DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding GitFileActivities}"
                                                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                      Background="Transparent" BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Fichier" Binding="{Binding Path}" Width="*" />
                                                    <DataGridTextColumn Header="Modif." Binding="{Binding ChangeCount}" Width="72" />
                                                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="92" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Activité d'équipe">
                                <Grid Margin="0,6,0,0" RowDefinitions="Auto,190,*" RowSpacing="7">
                                    <Border Classes="card" Padding="13">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Vue d'activité Git" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding GitInsightsSummary}" Classes="muted" TextWrapping="Wrap" />
                                            <TextBlock Text="Données calculées localement depuis les commits — aucun suivi utilisateur en arrière-plan."
                                                       FontSize="10" Foreground="#78D7B7" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Classes="card" Padding="5">
                                        <controls:GitActivityTimelineView Activity="{Binding GitDailyActivity}" />
                                    </Border>
                                    <Grid Grid.Row="2" ColumnDefinitions="1.15*,1*" ColumnSpacing="10">
                                        <Border Classes="card" Padding="10">
                                            <Grid RowDefinitions="Auto,*">
                                                <TextBlock Text="Contributeurs" FontSize="15" FontWeight="SemiBold" Margin="6" />
                                                <DataGrid Grid.Row="1" ItemsSource="{Binding GitContributors}" AutoGenerateColumns="False"
                                                          IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Auteur" Binding="{Binding AuthorName}" Width="*" />
                                                        <DataGridTextColumn Header="Commits" Binding="{Binding CommitCount}" Width="72" />
                                                        <DataGridTextColumn Header="Fichiers" Binding="{Binding FilesTouched}" Width="70" />
                                                        <DataGridTextColumn Header="Lignes" Binding="{Binding LineSummary}" Width="110" />
                                                        <DataGridTextColumn Header="Dernière activité" Binding="{Binding LastActiveAt}" Width="145" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" Classes="card" Padding="10">
                                            <Grid RowDefinitions="Auto,*">
                                                <TextBlock Text="Points chauds" FontSize="15" FontWeight="SemiBold" Margin="6" />
                                                <DataGrid Grid.Row="1" ItemsSource="{Binding GitHotFiles}" AutoGenerateColumns="False"
                                                          IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Fichier" Binding="{Binding Path}" Width="*" />
                                                        <DataGridTextColumn Header="Modif." Binding="{Binding ChangeCount}" Width="70" />
                                                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="92" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Dépendances Unreal" IsVisible="{Binding IsUnrealIntegrationEnabled}">
                                <Grid Margin="0,6,0,0" ColumnDefinitions="*,5,320">
                                    <Border Classes="card" Padding="5">
                                        <Grid RowDefinitions="Auto,*">
                                            <StackPanel Margin="10,7,10,5" Spacing="3">
                                                <TextBlock Text="Graphe des dépendances Unreal hors moteur" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding UnrealDependencySummary}" Classes="muted" TextWrapping="Wrap" />
                                                <TextBlock Text="Analyse simplifiée des références /Game détectables dans les .uasset et .umap présents localement."
                                                           FontSize="10" Foreground="#78D7B7" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <controls:GitFileRelationGraphView Grid.Row="1"
                                                                                  Files="{Binding UnrealDependencyFiles}"
                                                                                  Relations="{Binding UnrealDependencyRelations}" />
                                        </Grid>
                                    </Border>
                                    <GridSplitter Grid.Column="1" Width="6" Margin="1,16" ResizeDirection="Columns"
                                                  Background="#34415D" Cursor="SizeWestEast" />
                                    <Border Grid.Column="2" Classes="card" Padding="10" Margin="10,0,0,0">
                                        <Grid RowDefinitions="Auto,*">
                                            <StackPanel Margin="6,3,6,8">
                                                <TextBlock Text="Assets inspectés" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="Dépendances sortantes / références entrantes" FontSize="10" Classes="muted" />
                                            </StackPanel>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding UnrealAssets}" AutoGenerateColumns="False"
                                                      IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Asset" Binding="{Binding Path}" Width="*" />
                                                    <DataGridTextColumn Header="Type" Binding="{Binding AssetType}" Width="95" />
                                                    <DataGridTextColumn Header="Relations" Binding="{Binding RelationSummary}" Width="90" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <TabItem x:Name="LfsLocksWorkspaceTab" Header="File locks">
                            <Grid Margin="0,8,0,0" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                                <Border Classes="card" Padding="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Git LFS file locks" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding LfsLocksSummary}" Classes="muted" FontSize="10.5"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary" Content="Refresh"
                                                Click="OnRefreshLfsLocksClick" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" ColumnDefinitions="1.35*,7,1*">
                                    <Border Classes="card" Padding="0" ClipToBounds="True">
                                        <Grid RowDefinitions="42,34,*">
                                            <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1"
                                                    Padding="10,0">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="All project locks" FontWeight="SemiBold" />
                                                    <TextBlock Text="Verified remote locks, including files held by teammates"
                                                               Classes="muted" FontSize="9" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="danger"
                                                        IsVisible="{Binding HasSelectedProjectLocks}" Click="OnUnlockSelectedProjectLocksClick"
                                                        Padding="7,3" MinHeight="23">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="Unlock selected" />
                                                        <TextBlock Text="{Binding SelectedProjectLockCount}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Classes="danger" Content="Force unlock all…"
                                                        Click="OnForceUnlockAllLfsLocksClick" Padding="7,3" MinHeight="23"
                                                        ToolTip.Tip="Administrative action: also removes locks owned by other users" />
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,120,Auto" ColumnSpacing="6" Margin="5,4">
                                                <TextBox Text="{Binding AllLfsLockSearch, UpdateSourceTrigger=PropertyChanged}" Classes="searchBox"
                                                         PlaceholderText="Search all locks by file, folder, owner, locked by, source or ID…" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding LfsLockSortOptions}"
                                                          SelectedItem="{Binding AllLfsLockSort}" />
                                                <TextBlock Grid.Column="2" Text="{Binding FilteredLfsLocks.Count}" Classes="muted"
                                                           VerticalAlignment="Center" ToolTip.Tip="Visible locks" />
                                            </Grid>
                                            <TabControl Grid.Row="2" Padding="0" Background="Transparent">
                                            <TabItem Header="List">
                                            <DataGrid x:Name="AllLfsLocksGrid" Classes="historyCompact" ItemsSource="{Binding FilteredLfsLocks}"
                                                      AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                                      GridLinesVisibility="Horizontal" Background="Transparent"
                                                      SelectionMode="Extended" SelectionChanged="OnAllLfsLocksSelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Owner" Width="92" SortMemberPath="Ownership">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <TextBlock Text="{Binding Ownership}" Foreground="{Binding OwnershipColor}" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="File" Width="*" SortMemberPath="Path">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <TextBlock Text="{Binding Path}" Foreground="{Binding FileColor}"
                                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Locked by" Width="120" SortMemberPath="OwnerName">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <TextBlock Text="{Binding OwnerName}" Foreground="{Binding OwnerColor}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Date" Binding="{Binding LockedAtText}" SortMemberPath="LockedAt" Width="120" />
                                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" SortMemberPath="Source" Width="62" />
                                                    <DataGridTextColumn Header="ID" Binding="{Binding ShortId}" SortMemberPath="Id" Width="82" />
                                                    <DataGridTemplateColumn Header="" Width="112">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <Button Classes="secondary" Content="{Binding UnlockAction}"
                                                                    Padding="7,3" MinHeight="23"
                                                                    Click="OnUnlockLfsLockClick" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            </TabItem>
                                            <TabItem Header="Folders">
                                                <TreeView ItemsSource="{Binding LfsLockTree}" Classes="compactTree"
                                                          Background="Transparent" BorderThickness="0" Margin="2">
                                                    <TreeView.ItemTemplate>
                                                        <TreeDataTemplate ItemsSource="{Binding Children}">
                                                            <Grid ColumnDefinitions="16,*,Auto" Height="22" Margin="0"
                                                                  ToolTip.Tip="{Binding RelativePath}">
                                                                <TextBlock Text="{Binding Icon}" Foreground="{Binding AccentColor}"
                                                                           HorizontalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding AccentColor}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted"
                                                                           FontSize="8" Margin="5,0,2,0" />
                                                            </Grid>
                                                        </TreeDataTemplate>
                                                    </TreeView.ItemTemplate>
                                                </TreeView>
                                            </TabItem>
                                            </TabControl>
                                        </Grid>
                                    </Border>

                                    <GridSplitter Grid.Column="1" Width="7" ResizeDirection="Columns"
                                                  ResizeBehavior="PreviousAndNext" Background="#45484E"
                                                  Cursor="SizeWestEast" />

                                    <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                        <Grid RowDefinitions="42,34,*">
                                            <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1"
                                                    Padding="10,0">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Locked by me" FontWeight="SemiBold" />
                                                    <TextBlock Text="Locks this Git LFS identity can release normally"
                                                               Classes="muted" FontSize="9" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="secondary"
                                                        IsVisible="{Binding HasSelectedMyLocks}" Click="OnUnlockSelectedMyLocksClick"
                                                        Padding="7,3" MinHeight="23">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="Unlock selected" />
                                                        <TextBlock Text="{Binding SelectedMyLockCount}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Classes="secondary" Content="Unlock all mine…"
                                                        Click="OnUnlockAllMyLfsLocksClick" Padding="7,3" MinHeight="23" />
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,120,Auto" ColumnSpacing="6" Margin="5,4">
                                                <TextBox Text="{Binding MyLfsLockSearch, UpdateSourceTrigger=PropertyChanged}" Classes="searchBox"
                                                         PlaceholderText="Search my locks by file, folder, owner, source or ID…" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding LfsLockSortOptions}"
                                                          SelectedItem="{Binding MyLfsLockSort}" />
                                                <TextBlock Grid.Column="2" Text="{Binding FilteredMyLfsLocks.Count}" Classes="muted"
                                                           VerticalAlignment="Center" ToolTip.Tip="Visible locks" />
                                            </Grid>
                                            <TabControl Grid.Row="2" Padding="0" Background="Transparent">
                                            <TabItem Header="List">
                                            <DataGrid x:Name="MyLfsLocksGrid" Classes="historyCompact" ItemsSource="{Binding FilteredMyLfsLocks}"
                                                      AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                                      GridLinesVisibility="Horizontal" Background="Transparent"
                                                      SelectionMode="Extended" SelectionChanged="OnMyLfsLocksSelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="File" Width="*" SortMemberPath="Path">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <TextBlock Text="{Binding Path}" Foreground="{Binding FileColor}"
                                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Locked by" Binding="{Binding OwnerName}" SortMemberPath="OwnerName" Width="92" />
                                                    <DataGridTextColumn Header="Date" Binding="{Binding LockedAtText}" SortMemberPath="LockedAt" Width="120" />
                                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" SortMemberPath="Source" Width="62" />
                                                    <DataGridTextColumn Header="ID" Binding="{Binding ShortId}" SortMemberPath="Id" Width="82" />
                                                    <DataGridTemplateColumn Header="" Width="82">
                                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <Button Classes="secondary" Content="Unlock" Padding="7,3" MinHeight="23"
                                                                    Click="OnUnlockLfsLockClick" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            </TabItem>
                                            <TabItem Header="Folders">
                                                <TreeView ItemsSource="{Binding MyLfsLockTree}" Classes="compactTree"
                                                          Background="Transparent" BorderThickness="0" Margin="2">
                                                    <TreeView.ItemTemplate>
                                                        <TreeDataTemplate ItemsSource="{Binding Children}">
                                                            <Grid ColumnDefinitions="16,*,Auto" Height="22" Margin="0"
                                                                  ToolTip.Tip="{Binding RelativePath}">
                                                                <TextBlock Text="{Binding Icon}" Foreground="{Binding AccentColor}"
                                                                           HorizontalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding AccentColor}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted"
                                                                           FontSize="8" Margin="5,0,2,0" />
                                                            </Grid>
                                                        </TreeDataTemplate>
                                                    </TreeView.ItemTemplate>
                                                </TreeView>
                                            </TabItem>
                                            </TabControl>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Background="#302A1F" BorderBrush="#68552F" BorderThickness="1"
                                        CornerRadius="5" Padding="9">
                                    <TextBlock Text="Force unlock is reserved for stale or abandoned locks. It can let two people modify the same binary asset; CyRevision always asks for confirmation before removing another user's lock."
                                               Foreground="#E5C07B" FontSize="10" TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                </TabItem>

                <TabItem x:Name="GitIgnoreWorkspaceTab" Header="Ignore rules">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="8">
                        <Border Classes="card" Padding="9">
                            <Grid ColumnDefinitions="Auto,245,*,Auto,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="Source" Classes="muted" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding GitIgnoreSources}"
                                          SelectedItem="{Binding GitIgnoreSource}" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding GitIgnoreFilePath}" FontFamily="Cascadia Mono,Consolas"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GitIgnoreFilePath}" />
                                    <TextBlock Text="{Binding GitIgnoreSummary}" Classes="muted" FontSize="10" />
                                </StackPanel>
                                <Button Grid.Column="3" Classes="secondary" Content="Reload" Click="OnReloadGitIgnoreClick" />
                                <Button Grid.Column="4" Classes="secondary" Content="Scan ignored" Click="OnRefreshIgnoredFilesClick" />
                                <Button Grid.Column="5" Classes="primary" Content="Save" Click="OnSaveGitIgnoreClick"
                                        IsEnabled="{Binding CanSaveGitIgnore}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="1.35*,7,1*">
                            <Border Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Grid Margin="9,7" ColumnDefinitions="*,180,Auto" ColumnSpacing="7">
                                        <StackPanel>
                                            <TextBlock Text="Git ignore editor" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="Comments, negations, directory rules and glob patterns are preserved exactly."
                                                       Classes="muted" FontSize="10" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding GitIgnoreTemplates}"
                                                  SelectedItem="{Binding GitIgnoreTemplate}" />
                                        <Button Grid.Column="2" Classes="secondary" Content="Append template"
                                                Click="OnApplyGitIgnoreTemplateClick" />
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <TextBox Text="{Binding GitIgnoreContent, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                                 FontFamily="Cascadia Mono,Consolas" FontSize="12"
                                                 Padding="10" Background="#0E1625" BorderThickness="0"
                                                 VerticalContentAlignment="Top"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        <ProgressBar Classes="inlineLoader" IsVisible="{Binding IsGitIgnoreLoading}" IsIndeterminate="True"
                                                     VerticalAlignment="Top" />
                                    </Grid>
                                    <Border Grid.Row="2" BorderBrush="#3A3D43" BorderThickness="0,1,0,0" Padding="8">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="7" RowSpacing="5">
                                            <TextBox Text="{Binding GitIgnoreTestPath}" PlaceholderText="Content/MyAsset.uasset"
                                                     KeyDown="OnGitIgnoreTestPathKeyDown" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Test path"
                                                    Click="OnTestGitIgnorePathClick" />
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding GitIgnoreTestResult}"
                                                       Foreground="#78D7B7" FontSize="10" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <GridSplitter Grid.Column="1" Width="7" ResizeDirection="Columns"
                                          ResizeBehavior="PreviousAndNext" Background="#45484E" Cursor="SizeWestEast" />

                            <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                <TabControl Background="Transparent" Padding="0">
                                    <TabItem Header="Rule assistant">
                                        <Grid RowDefinitions="Auto,*,Auto" Margin="7" RowSpacing="6">
                                            <StackPanel>
                                                <TextBlock Text="Choose from this project" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding IgnoreSuggestionSummary}" Classes="muted" FontSize="9"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Grid Grid.Row="1" ColumnDefinitions="1.25*,6,0.75*">
                                                <Border BorderBrush="#3A3D43" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                                    <Grid RowDefinitions="Auto,*">
                                                        <Grid Margin="5" RowDefinitions="Auto,Auto" ColumnDefinitions="*,95" ColumnSpacing="5">
                                                            <TextBlock Text="Folders" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="Filter" Classes="muted" FontSize="8.5"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            <TextBox Grid.Row="1" Text="{Binding IgnoreFolderSearch, UpdateSourceTrigger=PropertyChanged}" Classes="searchBox"
                                                                     PlaceholderText="Search folders or patterns…" Padding="6,3" />
                                                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding IgnoreSuggestionFilters}"
                                                                      SelectedItem="{Binding IgnoreFolderFilter}" Padding="5,2" />
                                                        </Grid>
                                                        <TabControl Grid.Row="1" Padding="0" Background="Transparent">
                                                            <TabItem Header="List">
                                                                <ListBox ItemsSource="{Binding IgnoreFolderSuggestions}"
                                                                         Classes="compactList" Background="Transparent" BorderThickness="0">
                                                                    <ListBox.ItemsPanel>
                                                                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                                                    </ListBox.ItemsPanel>
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox IsChecked="{Binding IsSelected}" Height="21" Margin="3,0"
                                                                                      HorizontalContentAlignment="Stretch">
                                                                                <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Pattern}">
                                                                                    <TextBlock Text="{Binding Pattern}" FontFamily="Cascadia Mono,Consolas"
                                                                                               FontSize="10" TextTrimming="CharacterEllipsis"
                                                                                               VerticalAlignment="Center" />
                                                                                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="muted"
                                                                                               FontSize="9" VerticalAlignment="Center" Margin="6,0,2,0" />
                                                                                </Grid>
                                                                            </CheckBox>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                            </TabItem>
                                                            <TabItem Header="Tree">
                                                                <TreeView ItemsSource="{Binding IgnoreFolderTree}" Classes="compactTree"
                                                                          Background="Transparent" BorderThickness="0" Margin="2">
                                                                    <TreeView.ItemTemplate>
                                                                        <TreeDataTemplate ItemsSource="{Binding Children}">
                                                                            <Grid Height="21" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                                                                                <CheckBox IsChecked="{Binding IsSelected}" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10"
                                                                                           Foreground="#E5C07B" VerticalAlignment="Center" />
                                                                                <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="muted"
                                                                                           FontSize="9" VerticalAlignment="Center" />
                                                                            </Grid>
                                                                        </TreeDataTemplate>
                                                                    </TreeView.ItemTemplate>
                                                                </TreeView>
                                                            </TabItem>
                                                        </TabControl>
                                                    </Grid>
                                                </Border>
                                                <GridSplitter Grid.Column="1" Width="6" Background="#45484E"
                                                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                                                <Border Grid.Column="2" BorderBrush="#3A3D43" BorderThickness="1"
                                                        CornerRadius="4" ClipToBounds="True">
                                                    <Grid RowDefinitions="Auto,*">
                                                        <Grid Margin="5" RowDefinitions="Auto,Auto" ColumnDefinitions="*,95" ColumnSpacing="5">
                                                            <TextBlock Text="File types" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="Filter" Classes="muted" FontSize="8.5"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            <TextBox Grid.Row="1" Text="{Binding IgnoreFileTypeSearch, UpdateSourceTrigger=PropertyChanged}" Classes="searchBox"
                                                                     PlaceholderText="Search extensions…" Padding="6,3" />
                                                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding IgnoreSuggestionFilters}"
                                                                      SelectedItem="{Binding IgnoreFileTypeFilter}" Padding="5,2" />
                                                        </Grid>
                                                        <ListBox Grid.Row="1" ItemsSource="{Binding IgnoreFileTypeSuggestions}"
                                                                 Classes="compactList" Background="Transparent" BorderThickness="0">
                                                            <ListBox.ItemsPanel>
                                                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                                            </ListBox.ItemsPanel>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox IsChecked="{Binding IsSelected}" Height="21" Margin="3,0"
                                                                              HorizontalContentAlignment="Stretch">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Text="{Binding Pattern}" FontFamily="Cascadia Mono,Consolas"
                                                                                       FontSize="10" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="muted"
                                                                                       FontSize="9" VerticalAlignment="Center" Margin="6,0,2,0" />
                                                                        </Grid>
                                                                    </CheckBox>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
                                                <ProgressBar Classes="inlineLoader" IsVisible="{Binding IsIgnoreSuggestionLoading}" IsIndeterminate="True"
                                                             VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Classes="secondary" Content="Rescan project"
                                                        Click="OnRefreshIgnoreSuggestionsClick" />
                                                <Button Grid.Column="2" Classes="primary" Content="Add selected rules"
                                                        Click="OnAppendGitIgnoreSuggestionsClick" />
                                            </Grid>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Parsed rules">
                                        <DataGrid ItemsSource="{Binding GitIgnoreRules}" Classes="historyCompact"
                                                  AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                                  GridLinesVisibility="Horizontal" Background="Transparent">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="44" />
                                                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="78" />
                                                <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" Width="*" />
                                                <DataGridTextColumn Header="Validation" Binding="{Binding Warning}" Width="150" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="Ignored paths">
                                        <Grid RowDefinitions="Auto,*">
                                            <TextBlock Margin="8" Text="Loaded on demand (maximum 2,500 paths)."
                                                       Classes="muted" FontSize="10" />
                                            <ListBox Grid.Row="1" ItemsSource="{Binding IgnoredFiles}"
                                                     Background="Transparent" BorderThickness="0">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontFamily="Cascadia Mono,Consolas"
                                                                   FontSize="11" Margin="7,3"
                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="GitLfsWorkspaceTab" Header="Git LFS">
                    <TabControl Margin="0">
                        <TabItem Header="Time Machine">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="285,*,350" ColumnSpacing="8">
                        <Border Classes="card" Padding="12">
                            <Grid RowDefinitions="Auto,150,Auto,*">
                                <Grid ColumnDefinitions="*,Auto" Margin="5">
                                    <TextBlock Text="Motifs suivis par Git LFS" FontSize="16" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Setup assistant…"
                                            Click="OnOpenGitLfsSetupAssistantClick" Padding="8,4"
                                            ToolTip.Tip="Review recommended .gitattributes and Git LFS patterns without overwriting existing rules" />
                                </Grid>
                                <ListBox Grid.Row="1" Margin="0,7" ItemsSource="{Binding LfsPatterns}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="6">
                                                <TextBlock Text="{Binding Pattern}" FontFamily="Cascadia Mono,Consolas" />
                                                <TextBlock Grid.Column="1" Text="{Binding SourceFile}" Classes="muted" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="7" Margin="0,4,0,10">
                                    <TextBox Text="{Binding LfsPattern}" PlaceholderText="*.uasset" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Ajouter" Click="OnTrackLfsClick" />
                                </Grid>
                                <Grid Grid.Row="3" RowDefinitions="Auto,*">
                                    <Grid Margin="5,0,5,7" ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="Fichiers versionnés" FontWeight="SemiBold" />
                                            <TextBlock Text="On-demand inventory to keep large repositories responsive"
                                                       FontSize="10" Classes="muted" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary" Content="Load LFS files"
                                                Click="OnLoadLfsInventoryClick" Padding="8,4" />
                                    </Grid>
                                    <TabControl Grid.Row="1" Padding="0" Background="Transparent">
                                        <TabItem Header="List">
                                            <ListBox ItemsSource="{Binding LfsFiles}" SelectedItem="{Binding SelectedLfsFile}"
                                                     Classes="compactList" Background="Transparent" BorderThickness="0">
                                                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="24" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="5,0">
                                                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="10.5" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Availability}" Foreground="#78D7B7" FontSize="9" />
                                                            <TextBlock Grid.Row="1" Text="{Binding Kind}" Classes="muted" FontSize="8.5" />
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}" Classes="muted" FontSize="8.5" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </TabItem>
                                        <TabItem Header="Folders">
                                            <TreeView ItemsSource="{Binding LfsFileTree}" SelectedItem="{Binding SelectedLfsFileTreeNode}"
                                                      Classes="compactTree" Background="Transparent" BorderThickness="0" Margin="2">
                                                <TreeView.ItemTemplate>
                                                    <TreeDataTemplate ItemsSource="{Binding Children}">
                                                        <Grid Height="22" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5" ToolTip.Tip="{Binding RelativePath}">
                                                            <TextBlock Text="{Binding Icon}" Foreground="#E5C07B" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" FontSize="8.5"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </TreeDataTemplate>
                                                </TreeView.ItemTemplate>
                                            </TreeView>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card" Padding="12">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel Margin="5,2,5,9">
                                    <TextBlock Text="Time Machine LFS" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LfsTimelineSummary}" FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding LfsVersions}" SelectedItem="{Binding SelectedLfsVersion}"
                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Révision" Binding="{Binding Revision.ShortHash}" Width="76" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Revision.Subject}" Width="*" />
                                        <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" Width="78" />
                                        <DataGridTextColumn Header="Stockage" Binding="{Binding Availability}" Width="155" />
                                        <DataGridTextColumn Header="Date" Binding="{Binding Revision.AuthoredAt}" Width="135" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Classes="card" Padding="14">
                            <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
                                <StackPanel>
                                    <TextBlock Text="Aperçu de la version" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Textures affichées sans ouvrir Unreal" FontSize="10" Foreground="#78D7B7" />
                                </StackPanel>
                                <Border Grid.Row="1" Margin="0,12" Background="#0E1526" BorderBrush="#303A55" BorderThickness="1" CornerRadius="9">
                                    <Grid>
                                        <TextBlock Text="Aperçu disponible pour PNG, JPEG, TIFF, BMP et WebP"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                   MaxWidth="250" TextWrapping="Wrap" Classes="muted" />
                                        <Image Source="{Binding LfsPreview}" Stretch="Uniform" Margin="8" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="2" Spacing="5" Margin="0,0,0,12">
                                    <TextBlock Text="• Local : l'objet peut être prévisualisé, exporté ou restauré immédiatement." TextWrapping="Wrap" FontSize="10" Classes="muted" />
                                    <TextBlock Text="• Pair : présence annoncée dans un inventaire signé, sans téléchargement silencieux." TextWrapping="Wrap" FontSize="10" Classes="muted" />
                                    <TextBlock Text="• Archive : copie détectée dans l'archive froide configurée." TextWrapping="Wrap" FontSize="10" Classes="muted" />
                                    <TextBlock Text="• Missing : aucun emplacement vérifié n'est actuellement connu." TextWrapping="Wrap" FontSize="10" Classes="muted" />
                                    <TextBlock Text="• La restauration modifie seulement le fichier de travail et ne l'indexe pas." TextWrapping="Wrap" FontSize="10" Foreground="#E5A94D" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Text="{Binding PeerLfsTransferSummary}" Margin="0,0,0,9"
                                           FontSize="10" Foreground="#78D7B7" TextWrapping="Wrap" />
                                <StackPanel Grid.Row="4" Spacing="7">
                                    <Button Classes="primary" Content="Demander au pair" Click="OnRequestLfsVersionClick"
                                            IsEnabled="{Binding CanRequestSelectedLfsVersion}" HorizontalAlignment="Stretch" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Button Classes="secondary" Content="Exporter…" Click="OnExportLfsVersionClick"
                                                IsEnabled="{Binding SelectedLfsVersion.IsAvailableLocally}" />
                                        <Button Grid.Column="1" Classes="danger" Content="Restaurer dans le projet…"
                                                Click="OnRestoreLfsVersionClick" IsEnabled="{Binding SelectedLfsVersion.IsAvailableLocally}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                        </TabItem>
                        <TabItem Header="Storage &amp; safe cleanup">
                            <ScrollViewer Margin="0,4,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid RowDefinitions="Auto,Auto,180,240,Auto" RowSpacing="8">
                                <Border Classes="card" Padding="12">
                                    <Grid ColumnDefinitions="1.2*,Auto,1.2*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="7">
                                        <StackPanel Grid.ColumnSpan="4" Margin="0,0,0,4">
                                            <TextBlock Text="External Git LFS storage and retention policy" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="Safe by default: current checkouts, worktrees and protected refs stay hot. Cleanup always requires proof on a remote, peer, or verified archive." FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBox Grid.Row="1" Text="{Binding LfsExternalStoragePath}" PlaceholderText="External lfs.storage directory" />
                                        <Button Grid.Row="1" Grid.Column="1" Classes="secondary" Content="Browse..." Click="OnPickLfsExternalStorageClick" />
                                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding LfsManagementArchivePath}" PlaceholderText="Verified archive directory" />
                                        <Button Grid.Row="1" Grid.Column="3" Classes="secondary" Content="Browse..." Click="OnPickLfsManagementArchiveClick" />
                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="Remote" VerticalAlignment="Center" Classes="muted" />
                                            <TextBox Width="110" Text="{Binding LfsCleanupRemoteName}" />
                                            <CheckBox Content="Verify remote" IsChecked="{Binding LfsVerifyRemote}" VerticalAlignment="Center" />
                                            <TextBlock Text="Remote budget (s)" VerticalAlignment="Center" Classes="muted" />
                                            <TextBox Width="55" Text="{Binding LfsRemoteVerificationTimeoutSeconds}" HorizontalContentAlignment="Right" />
                                            <TextBlock Text="Required copies" VerticalAlignment="Center" Classes="muted" />
                                            <TextBox Width="55" Text="{Binding LfsRequiredCopies}" />
                                            <TextBlock Text="Grace days" VerticalAlignment="Center" Classes="muted" />
                                            <TextBox Width="55" Text="{Binding LfsCleanupGraceDays}" />
                                            <TextBlock Text="Peer proof max age (h)" VerticalAlignment="Center" Classes="muted" />
                                            <TextBox Width="65" Text="{Binding LfsPeerProofMaximumAgeHours}" />
                                            <Button Classes="secondary" Content="Save policy" Click="OnSaveLfsManagementClick" />
                                        </StackPanel>
                                        <Grid Grid.Row="3" Grid.ColumnSpan="4" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="9" Margin="0,3,0,0">
                                            <CheckBox Content="Trim old remote-backed asset versions" IsChecked="{Binding LfsTrimRemoteBackedHistory}"
                                                      VerticalAlignment="Center" ToolTip.Tip="Off by default. Current files remain protected and every removable object still needs verified retention evidence." />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="Keep recent" Classes="muted" VerticalAlignment="Center" />
                                                <TextBox Width="48" Text="{Binding LfsRecentVersionsPerFile}" HorizontalContentAlignment="Right" />
                                                <TextBlock Text="versions/file" Classes="muted" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="Types" Classes="muted" VerticalAlignment="Center" />
                                                <TextBox Width="170" Text="{Binding LfsRecentVersionExtensions}" PlaceholderText=".uasset;.umap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="Remote-backed trimming is opt-in. Unpublished objects stay blocked unless another configured copy is verified."
                                                       Classes="muted" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Classes="card" Padding="12">
                                    <Grid RowDefinitions="Auto,28" RowSpacing="6">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LfsStorageSummary}" TextWrapping="Wrap" />
                                                <TextBlock Text="Native prune is the recommended quick cleanup. Preview is non-destructive; execution always verifies the remote first." FontSize="10" Foreground="#78D7B7" />
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <Button Classes="secondary" Content="Preview git lfs prune" Click="OnPreviewNativeLfsPruneClick" Margin="0,0,6,4"
                                                        IsEnabled="{Binding CanStartLfsAnalysis}" />
                                                <Button Classes="danger" Content="Run git lfs prune…" Click="OnRunNativeLfsPruneClick" Margin="0,0,6,4"
                                                        IsEnabled="{Binding CanStartLfsAnalysis}" />
                                                <Button Classes="secondary" Content="Advanced analysis" Click="OnAnalyzeLfsStorageClick" Margin="0,0,6,4"
                                                        IsEnabled="{Binding CanStartLfsAnalysis}" />
                                                <Button Classes="secondary" Content="Cancel" Click="OnCancelLfsStorageAnalysisClick" Margin="0,0,6,4"
                                                        IsVisible="{Binding IsLfsAnalysisRunning}" />
                                                <Button Classes="secondary" Content="Archive candidates" Click="OnArchiveLfsCandidatesClick" Margin="0,0,6,4" />
                                                <Button Classes="danger" Content="Clean verified objects..." Click="OnExecuteLfsCleanupClick" Margin="0,0,0,4" />
                                            </WrapPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="44,190,*" ColumnSpacing="8">
                                            <TextBlock Text="{Binding LfsAnalysisPercentText}" FontWeight="SemiBold" Foreground="#78D7B7" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding LfsAnalysisPercent}" Height="6" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding LfsAnalysisStage}" FontSize="10" Classes="muted"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Classes="card" Padding="10">
                                    <Grid RowDefinitions="Auto,150" RowSpacing="6">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel>
                                                <TextBlock Text="Repository disk usage" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding LfsRepositorySizeSummary}" FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="secondary" Content="Quick size scan" Click="OnAnalyzeRepositoryStorageClick" />
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="0.8*,1.5*" ColumnSpacing="8">
                                            <DataGrid ItemsSource="{Binding LfsStorageAreas}" AutoGenerateColumns="False" IsReadOnly="True"
                                                      GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0" RowHeight="24">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Area" Binding="{Binding Name}" Width="*" />
                                                    <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="70" />
                                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <DataGrid Grid.Column="1" ItemsSource="{Binding LfsLargestFiles}" AutoGenerateColumns="False" IsReadOnly="True"
                                                      GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0" RowHeight="24">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Largest working files" Binding="{Binding RelativePath}" Width="*" />
                                                    <DataGridTextColumn Header="Type" Binding="{Binding Extension}" Width="85" />
                                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="3" ColumnDefinitions="1.55*,1*" ColumnSpacing="8">
                                    <Border Classes="card" Padding="10">
                                        <DataGrid ItemsSource="{Binding LfsCleanupItems}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="File / version" Binding="{Binding DisplayPath}" Width="1.2*" />
                                                <DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="70" />
                                                <DataGridTextColumn Header="OID" Binding="{Binding ShortOid}" Width="95" />
                                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80" />
                                                <DataGridTextColumn Header="Copies" Binding="{Binding Evidence.Count}" Width="65" />
                                                <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="1.4*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                    <Border Grid.Column="1" Classes="card" Padding="12">
                                        <Grid RowDefinitions="Auto,100,*" RowSpacing="6">
                                            <TextBlock Text="Remote verification report" FontWeight="SemiBold" />
                                            <TextBox Grid.Row="1" Text="{Binding LfsRemoteVerification}" IsReadOnly="True"
                                                     AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                            <StackPanel Grid.Row="2" Spacing="7">
                                                <CheckBox Content="After verification, remove the old object cache" IsChecked="{Binding LfsRemoveOriginalAfterRelocation}" />
                                                <Button Classes="secondary" Content="Relocate and activate external storage..." Click="OnRelocateLfsStorageClick" />
                                                <TextBlock Text="A destination ownership marker prevents multiple repositories from sharing one lfs.storage directory." FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="4" Text="Nothing is deleted during analysis. Local-only versions without verified retention evidence remain blocked; cleanup writes an audit and re-checks protection immediately before deletion." FontSize="10" Foreground="#E5A94D" TextWrapping="Wrap" />
                            </Grid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem x:Name="CyStoreWorkspaceTab" Header="CyStore ALPHA">
                    <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid RowDefinitions="Auto,Auto,360,Auto" RowSpacing="8">
                            <Border Classes="card" Padding="14">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,34" ColumnSpacing="12" RowSpacing="8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="CyStore" FontSize="20" FontWeight="SemiBold" />
                                            <Border Background="#6B4A12" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                <TextBlock Text="ALPHA" Foreground="#FFD166" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Git-compatible segmented storage for hydrated Git LFS files"
                                                   Foreground="#78D7B7" FontSize="11" />
                                        <TextBlock Text="Git remains authoritative: commits, branches, remotes and standard LFS pointers are never rewritten. CyStore only adds a project-local, content-addressed chunk cache when you explicitly initialize and capture it."
                                                   Classes="muted" FontSize="10" TextWrapping="Wrap" MaxWidth="920" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Classes="primary" Content="Initialize store" Click="OnInitializeCyStoreClick"
                                                IsEnabled="{Binding CanInitializeCyStore}" Margin="0,0,6,4"
                                                ToolTip.Tip="Create .cyrevision/cystore and add only that cache path to the repository's local Git exclude file." />
                                        <Button Classes="secondary" Content="Refresh" Click="OnRefreshCyStoreClick"
                                                IsEnabled="{Binding !IsCyStoreBusy}" Margin="0,0,6,4" />
                                        <Button Classes="primary" Content="Capture hydrated Git LFS" Click="OnCaptureCyStoreLfsClick"
                                                IsEnabled="{Binding CanCaptureCyStoreLfs}" Margin="0,0,6,4"
                                                ToolTip.Tip="Capture working-tree LFS files as verified chunks. Pointer-only or missing files are skipped." />
                                        <Button Classes="secondary" Content="Cancel" Click="OnCancelCyStoreClick"
                                                IsVisible="{Binding IsCyStoreBusy}" />
                                    </WrapPanel>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CyStoreStatusSummary}"
                                               TextWrapping="Wrap" />
                                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="180,*" ColumnSpacing="9">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding CyStoreProgress}"
                                                     Height="7" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding CyStoreProgressText}"
                                                   Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" ColumnDefinitions="1.25*,1*,1*,1.4*" ColumnSpacing="8">
                                <Border Classes="card" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Store" Classes="muted" FontSize="9" />
                                        <TextBlock Text="{Binding CyStoreStorePath}" FontFamily="Cascadia Mono,Consolas"
                                                   FontSize="10" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding CyStoreStorePath}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="card" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Logical versions" Classes="muted" FontSize="9" />
                                        <TextBlock Text="{Binding CyStoreLogicalSize}" FontSize="17" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Classes="card" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Unique chunks" Classes="muted" FontSize="9" />
                                        <TextBlock Text="{Binding CyStoreStoredSize}" FontSize="17" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Classes="card" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Deduplication" Classes="muted" FontSize="9" />
                                        <TextBlock Text="{Binding CyStoreDeduplicationSummary}" FontSize="10"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Classes="card" Padding="10">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,7">
                                        <StackPanel>
                                            <TextBlock Text="Captured versions" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="Each row references a verified file manifest; identical chunks are stored once."
                                                       Classes="muted" FontSize="9" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Classes="secondary" Content="Verify" Click="OnVerifyCyStoreVersionClick"
                                                    IsEnabled="{Binding CanOperateOnSelectedCyStoreVersion}" />
                                            <Button Classes="secondary" Content="Reconstruct safely…" Click="OnReconstructCyStoreVersionClick"
                                                    IsEnabled="{Binding CanOperateOnSelectedCyStoreVersion}"
                                                    ToolTip.Tip="Reconstruct into .cyrevision/cystore/restored. The working tree is never overwritten." />
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding CyStoreVersions}"
                                              SelectedItem="{Binding SelectedCyStoreVersion}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              Classes="historyCompact" GridLinesVisibility="Horizontal"
                                              Background="Transparent" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="2*" />
                                            <DataGridTextColumn Header="Version" Binding="{Binding ShortId}" Width="105" />
                                            <DataGridTextColumn Header="SHA-256" Binding="{Binding FileSha256}" Width="150" />
                                            <DataGridTextColumn Header="Bytes" Binding="{Binding Size}" Width="90" />
                                            <DataGridTextColumn Header="Chunks" Binding="{Binding ChunkCount}" Width="70" />
                                            <DataGridCheckBoxColumn Header="LFS" Binding="{Binding IsGitLfsTracked}" Width="48" />
                                            <DataGridTextColumn Header="Captured" Binding="{Binding CapturedAt}" Width="155" />
                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="85" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Classes="card" Padding="11">
                                <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="14">
                                    <StackPanel>
                                        <TextBlock Text="Last result" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CyStoreLastResult}" TextWrapping="Wrap" FontSize="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Skipped files / warnings" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CyStoreWarnings}" TextWrapping="Wrap" Classes="muted" FontSize="9"
                                                   MaxHeight="80" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="BackupsWorkspaceTab" Header="Backups">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="1.25*,1*" ColumnSpacing="8">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="Snapshots disponibles" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Les données identiques ne sont stockées qu'une fois." FontSize="11" Classes="muted" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="primary" Content="Sauvegarder maintenant" Click="OnCreateBackupClick" />
                                </Grid>
                                <DataGrid Grid.Row="1" Margin="0,12" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt}" Width="*" />
                                        <DataGridTextColumn Header="ID" Binding="{Binding ShortId}" Width="90" />
                                        <DataGridTextColumn Header="Taille" Binding="{Binding LogicalSize}" Width="90" />
                                        <DataGridTextColumn Header="Ajouté" Binding="{Binding StoredSize}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Grid.Row="2" Classes="secondary" Content="Restaurer la sélection dans…" Click="OnRestoreBackupClick" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <ScrollViewer>
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Stockage et conservation" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Emplacement local, volume réseau monté ou dossier NAS" FontSize="11" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Text="{Binding BackupStorePath}" IsReadOnly="True" PlaceholderText="Emplacement par défaut CyRevision" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Choisir…" Click="OnPickBackupStoreClick" />
                                    </Grid>
                                    <TextBlock Text="Mode de rétention" Margin="0,7,0,0" />
                                    <ComboBox ItemsSource="{Binding RetentionModes}" SelectedItem="{Binding SelectedRetentionMode}" />
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Versions max." FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding RetentionVersions}" PlaceholderText="30" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Âge max. (jours)" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding RetentionDays}" PlaceholderText="90" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Budget (Go)" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding RetentionBudgetGb}" PlaceholderText="illimité" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="#29324A" Margin="0,6" />
                                    <TextBlock Text="Archive froide des anciens snapshots" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Copie vers un disque, NAS ou stockage monté moins cher. Le stockage actif n'est jamais supprimé automatiquement."
                                               TextWrapping="Wrap" FontSize="10" Classes="muted" />
                                    <Border Background="#151E2C" BorderBrush="#35445B" BorderThickness="1" CornerRadius="5" Padding="8,6">
                                        <Grid ColumnDefinitions="1*,1*,1*" ColumnSpacing="9">
                                            <TextBlock Text="1 · Choose a safety profile" FontSize="9.5" Foreground="#9CC7FF" />
                                            <TextBlock Grid.Column="1" Text="2 · Choose separate cold storage" FontSize="9.5" Foreground="#9CC7FF" />
                                            <TextBlock Grid.Column="2" Text="3 · Copy, verify, then optionally reclaim" FontSize="9.5" Foreground="#9CC7FF" />
                                        </Grid>
                                    </Border>
                                    <Grid ColumnDefinitions="190,*" ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding BackupArchiveProfiles}" SelectedItem="{Binding SelectedBackupArchiveProfile}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Column="1" Text="{Binding BackupArchiveProfileDescription}" Classes="muted" FontSize="9.5" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Text="{Binding ColdArchivePath}" IsReadOnly="True" PlaceholderText="Archive froide facultative" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Choisir…" Click="OnPickColdArchiveClick" />
                                    </Grid>
                                    <Grid ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Archiver après (jours)" FontSize="10" Classes="muted" />
                                            <TextBox Text="{Binding ColdArchiveAfterDays}" PlaceholderText="180" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ColdArchiveStatus}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" FontSize="10" Classes="muted" />
                                        <Button Grid.Column="2" Classes="secondary" Content="Archiver maintenant" Click="OnArchiveOldBackupsClick" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <Border Background="#35281D" BorderBrush="#6C4D28" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                        <StackPanel Spacing="4">
                                            <CheckBox Content="After archive verification, remove eligible copies from hot storage"
                                                      IsChecked="{Binding RemoveArchivedHotCopies}" />
                                            <TextBlock Text="OFF by default. CyRevision verifies the cold manifest and every object before removing a hot manifest; only then are unreferenced hot objects reclaimed. Remote Git history and active branches are never rewritten by this option."
                                                       Foreground="#E5C07B" FontSize="9" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Expander IsVisible="{Binding IsGitProject}" Header="Git branches and old history · verified cold bundles"
                                              Margin="0,5,0,0">
                                        <StackPanel Spacing="7" Margin="0,7,0,0">
                                            <TextBlock Text="Remote-backed old branches can be copied to compressed cold bundles. Current and recent branches are always protected; commits and remote history are never rewritten."
                                                       TextWrapping="Wrap" FontSize="9.5" Classes="muted" />
                                            <Grid ColumnDefinitions="180,*" ColumnSpacing="8">
                                                <ComboBox ItemsSource="{Binding GitArchiveProfiles}" SelectedItem="{Binding SelectedGitArchiveProfile}">
                                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Grid.Column="1" Text="{Binding GitArchiveProfileDescription}" FontSize="9.5"
                                                           Classes="muted" TextWrapping="Wrap" />
                                            </Grid>
                                            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                                <Border BorderBrush="#343841" BorderThickness="1" CornerRadius="4" Padding="5">
                                                    <Grid RowDefinitions="Auto,150,Auto" RowSpacing="5">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="Eligible hot branches" FontWeight="SemiBold" />
                                                            <Button Grid.Column="1" Classes="secondary" Content="Analyze" Padding="7,3"
                                                                    Click="OnAnalyzeGitArchiveClick" />
                                                        </Grid>
                                                        <DataGrid Grid.Row="1" ItemsSource="{Binding GitArchiveCandidates}"
                                                                  SelectedItem="{Binding SelectedGitArchiveCandidate}"
                                                                  AutoGenerateColumns="False" IsReadOnly="True" RowHeight="23"
                                                                  GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Branch" Binding="{Binding Branch}" Width="*" />
                                                                <DataGridTextColumn Header="Age" Binding="{Binding AgeDays, StringFormat='{}{0} d'}" Width="60" />
                                                                <DataGridCheckBoxColumn Header="Remote copy" Binding="{Binding HasRemoteCopy}" Width="82" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <Button Grid.Row="2" Classes="secondary" Content="Create verified cold bundle"
                                                                IsEnabled="{Binding CanArchiveSelectedGitBranch}"
                                                                Click="OnArchiveGitBranchClick" HorizontalAlignment="Left" Padding="8,4" />
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Column="1" BorderBrush="#343841" BorderThickness="1" CornerRadius="4" Padding="5">
                                                    <Grid RowDefinitions="Auto,150,Auto" RowSpacing="5">
                                                        <TextBlock Text="Restorable cold bundles" FontWeight="SemiBold" />
                                                        <DataGrid Grid.Row="1" ItemsSource="{Binding ArchivedGitBranches}"
                                                                  SelectedItem="{Binding SelectedArchivedGitBranch}"
                                                                  AutoGenerateColumns="False" IsReadOnly="True" RowHeight="23"
                                                                  GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Branch" Binding="{Binding Branch}" Width="*" />
                                                                <DataGridTextColumn Header="Archived" Binding="{Binding ArchivedAt}" Width="120" />
                                                                <DataGridCheckBoxColumn Header="Hot removed" Binding="{Binding SourceBranchRemoved}" Width="82" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <Button Grid.Row="2" Classes="secondary" Content="Restore as a new local branch"
                                                                IsEnabled="{Binding CanRestoreSelectedGitArchive}"
                                                                Click="OnRestoreGitArchiveClick" HorizontalAlignment="Left" Padding="8,4" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <Border Background="#35281D" BorderBrush="#6C4D28" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                                <StackPanel Spacing="4">
                                                    <CheckBox Content="After bundle verification, remove the eligible local branch reference"
                                                              IsChecked="{Binding RemoveGitBranchAfterArchive}" />
                                                    <TextBlock Text="OFF by default. This requires a second confirmation. A matching remote copy is shown above, the verified bundle remains restorable, and CyRevision never runs automatic gc or rewrites remote history."
                                                               Foreground="#E5C07B" FontSize="9" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Git safety note: an ancestor still required by the current branch cannot be removed independently. Cold bundles target history reachable only from eligible branches. Removing a local ref does not run gc, so pack-file disk space is not reclaimed immediately."
                                                       FontSize="9" Classes="muted" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding GitArchiveStatus}" FontSize="9.5" Foreground="#78D7B7" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                    <Button Classes="primary" Content="Enregistrer la stratégie" Click="OnSaveBackupSettingsClick" HorizontalAlignment="Left" Margin="0,7,0,0" />
                                    <TextBlock Text="La restauration refuse d'écraser des fichiers existants afin de protéger le projet courant." TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="SynchronizationWorkspaceTab" Header="Syncthing">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="6">
                    <Border Classes="card" Padding="10,7">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding SynchronizationProfileTitle}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#78D7B7" />
                                <TextBlock Text="{Binding SynchronizationProfileDescription}" FontSize="10"
                                           Classes="muted" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SynchronizationScopeSummary}" FontSize="9.5"
                                           Foreground="#9CC7FF" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Top">
                                <Button Classes="secondary" Content="Setup wizard" Click="OnOpenSyncSetupWizardClick"
                                        Padding="8,3" MinHeight="24" />
                                <Border IsVisible="{Binding IsGitPeerSyncMode}" Background="#243B52" CornerRadius="4" Padding="7,2">
                                    <TextBlock Text="GIT EXCHANGE" FontSize="8.5" Foreground="#70B7FF" FontWeight="Bold" />
                                </Border>
                                <Border IsVisible="{Binding IsVersionedSyncMode}" Background="#3A3420" CornerRadius="4" Padding="7,2">
                                    <TextBlock Text="VERSIONED" FontSize="8.5" Foreground="#E5C07B" FontWeight="Bold" />
                                </Border>
                                <Border IsVisible="{Binding IsPlainProjectSyncMode}" Background="#1E3B34" CornerRadius="4" Padding="7,2">
                                    <TextBlock Text="CURRENT STATE" FontSize="8.5" Foreground="#78D7B7" FontWeight="Bold" />
                                </Border>
                                <Border IsVisible="{Binding IsOptionalSyncMode}" Background="#30333A" CornerRadius="4" Padding="7,2">
                                    <TextBlock Text="OPTIONAL FOLDERS" FontSize="8.5" Foreground="#B7BDCA" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TabControl x:Name="SynchronizationDetailTabs" Grid.Row="1">
                    <TabItem x:Name="SyncSetupWizardTab" Header="Setup wizard">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid ColumnDefinitions="1*,1*,1*" ColumnSpacing="8">
                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <Border Background="#243B52" CornerRadius="12" Width="28" Height="28" HorizontalAlignment="Left">
                                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="Choose the mode scope" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SynchronizationProfileDescription}" Classes="muted" TextWrapping="Wrap" />
                                        <Border IsVisible="{Binding IsGitPeerSyncMode}" Background="#10241F" CornerRadius="5" Padding="8">
                                            <TextBlock Text="Git + Sync uses the protected exchange folder automatically. The repository folder and active .git directory cannot be selected here." Foreground="#78D7B7" TextWrapping="Wrap" />
                                        </Border>
                                        <StackPanel IsVisible="{Binding ShowProjectFolderSyncSettings}" Spacing="5">
                                            <TextBlock Text="Folder to synchronize" FontSize="9" Classes="muted" />
                                            <TextBox Text="{Binding SyncSourceFolderPath}" />
                                            <Button Classes="secondary" Content="Choose source folder…" Click="OnPickSyncSourceFolderClick" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="card">
                                    <StackPanel Spacing="8">
                                        <Border Background="#243B52" CornerRadius="12" Width="28" Height="28" HorizontalAlignment="Left">
                                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="Prepare the isolated runtime" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="CyRevision never reuses or stops another Syncthing process. It creates a project-scoped config, data directory, API, and port." Classes="muted" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SyncthingRuntimeSummary}" Foreground="#78D7B7" TextWrapping="Wrap" />
                                        <Button Classes="primary" Content="Detect and configure runtime" Click="OnDetectSyncthingClick" HorizontalAlignment="Left" />
                                        <StackPanel IsVisible="{Binding IsVersionedSyncMode}" Spacing="5">
                                            <TextBlock Text="Optional separate version store" FontSize="9" Classes="muted" />
                                            <TextBox Text="{Binding SyncVersionStorePath}" />
                                            <Button Classes="secondary" Content="Choose version store…" Click="OnPickSyncVersionStoreClick" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Classes="card">
                                    <StackPanel Spacing="8">
                                        <Border Background="#243B52" CornerRadius="12" Width="28" Height="28" HorizontalAlignment="Left">
                                            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="Save, start, and verify" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Save the mode-specific settings, start the isolated engine, then inspect devices, differences, and persistent history." Classes="muted" TextWrapping="Wrap" />
                                        <Button Classes="primary" Content="Save settings" Click="OnSaveSyncthingSettingsClick" HorizontalAlignment="Left" />
                                        <WrapPanel>
                                            <Button Classes="secondary" Content="Start" Click="OnStartSyncClick" Margin="0,2,6,2" />
                                            <Button Classes="secondary" Content="Refresh" Click="OnRefreshSyncthingClick" Margin="0,2,6,2" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding SyncState}" FontSize="13" Foreground="#78D7B7" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SyncDetails}" Classes="muted" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Binding SynchronizationOverviewTabTitle}">
                    <Grid ColumnDefinitions="1*,1.25*" ColumnSpacing="8">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Instance Syncthing CyRevision" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SyncState}" FontSize="14" FontWeight="SemiBold" Foreground="#78D7B7" />
                                <TextBlock Text="{Binding SyncDetails}" TextWrapping="Wrap" Classes="muted" />
                                <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Classes="primary" Content="Detect and configure runtime" Click="OnDetectSyncthingClick" Margin="0,2,7,2" />
                                    <Button Classes="secondary" Content="Refresh devices and differences" Click="OnRefreshSyncthingClick" Margin="0,2,7,2" />
                                    <Button Classes="secondary" Content="Scan folder" Click="OnScanSyncthingClick" Margin="0,2,7,2"
                                            IsVisible="{Binding ShowProjectFolderSyncSettings}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding SyncthingRuntimeSummary}" TextWrapping="Wrap" FontSize="10" Classes="muted" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding ShowProjectFolderSyncSettings}">
                                    <StackPanel>
                                        <TextBlock Text="Folder to synchronize" FontSize="10" Classes="muted" />
                                        <TextBox Text="{Binding SyncSourceFolderPath}" PlaceholderText="Project root by default" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="OnPickSyncSourceFolderClick"
                                            VerticalAlignment="Bottom" />
                                </Grid>
                                <Grid ColumnDefinitions="180,100,*" ColumnSpacing="8" IsVisible="{Binding ShowProjectFolderSyncSettings}">
                                    <StackPanel>
                                        <TextBlock Text="Folder mode" FontSize="10" Classes="muted" />
                                        <ComboBox ItemsSource="{Binding SyncthingFolderModeNames}" SelectedItem="{Binding SelectedSyncthingFolderModeName}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Rescan (s)" FontSize="10" Classes="muted" />
                                        <TextBox Text="{Binding SyncthingRescanInterval}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <CheckBox Content="Watch file-system changes" IsChecked="{Binding SyncthingFileWatcherEnabled}" />
                                        <Button Classes="secondary" Content="Save and apply" Click="OnSaveSyncthingSettingsClick" HorizontalAlignment="Left" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Expander Header="Advanced runtime override">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                                    <TextBox Text="{Binding SyncthingExecutablePath}" IsReadOnly="True" PlaceholderText="Non configuré" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Choisir…" Click="OnPickSyncthingClick" />
                                </Grid>
                                </Expander>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="primary" Content="Démarrer" Click="OnStartSyncClick" Margin="0,4,7,4" />
                                    <Button Classes="secondary" Content="Pause" Click="OnPauseSyncClick" Margin="0,4,7,4" />
                                    <Button Classes="secondary" Content="Reprendre" Click="OnResumeSyncClick" Margin="0,4,7,4" />
                                    <Button Classes="danger" Content="Arrêter" Click="OnStopSyncClick" Margin="0,4,7,4" />
                                    <Button Classes="secondary" Content="Échanger Git maintenant" Click="OnExchangeGitClick"
                                            IsVisible="{Binding IsGitPeerSyncMode}" Margin="0,4,7,4" />
                                </WrapPanel>
                                <Border Background="#10241F" CornerRadius="8" Padding="11" Margin="0,8,0,0">
                                    <TextBlock Text="CyRevision utilise ses propres dossiers config/data, une API locale dédiée et ne recherche ni n'arrête les autres processus Syncthing." TextWrapping="Wrap" FontSize="11" Foreground="#78D7B7" />
                                </Border>
                                <StackPanel IsVisible="{Binding IsGitPeerSyncMode}" Spacing="7">
                                    <Border Height="1" Background="#29324A" Margin="0,5" />
                                    <TextBlock Text="Smart Git/LFS exchange policy" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="The working tree and active .git directory remain local. Only signed bundles, inventories and selected LFS objects enter the exchange folder."
                                               TextWrapping="Wrap" FontSize="9.5" Foreground="#78D7B7" />
                                    <TextBlock Text="{Binding SmartSyncPlanSummary}" TextWrapping="Wrap" FontSize="10" Classes="muted" />
                                    <Grid ColumnDefinitions="*,90,Auto" ColumnSpacing="7">
                                        <ComboBox ItemsSource="{Binding LfsHistoryModes}" SelectedItem="{Binding SelectedLfsHistoryMode}" />
                                        <TextBox Grid.Column="1" Text="{Binding SmartSyncRecentVersionCount}" PlaceholderText="Versions" />
                                        <CheckBox Grid.Column="2" Content="Replicate backups" IsChecked="{Binding SmartSyncReplicateBackups}" VerticalAlignment="Center" />
                                    </Grid>
                                    <ListBox ItemsSource="{Binding SmartSyncPlanItems}" MaxHeight="210">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="5">
                                                    <TextBlock Text="{Binding Content}" FontWeight="SemiBold" />
                                                    <Border Grid.Column="1" Background="#242C47" CornerRadius="5" Padding="6,2">
                                                        <TextBlock Text="{Binding Priority}" FontSize="9" Foreground="#B8C1D8" />
                                                    </Border>
                                                    <TextBlock Grid.Row="1" Text="{Binding Strategy}" FontSize="10" Classes="muted" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}" FontSize="10" Classes="muted" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <Border IsVisible="{Binding IsVersionedSyncMode}" Background="#25251E" BorderBrush="#665D35"
                                        BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,5,0,0">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Versioned project synchronization" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Syncthing keeps recoverable file versions using this project's retention policy. Backup snapshots remain independently available."
                                                   FontSize="9.5" Classes="muted" TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <StackPanel>
                                                <TextBlock Text="Version store (optional separate folder)" FontSize="9" Classes="muted" />
                                                <TextBox Text="{Binding SyncVersionStorePath}" PlaceholderText="Default: .stversions inside the synchronized folder" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="OnPickSyncVersionStoreClick"
                                                    VerticalAlignment="Bottom" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                            <CheckBox Content="Compressed backup copy" IsChecked="{Binding SyncCompressedBackupEnabled}"
                                                      VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding SyncCompressedBackupPath}" PlaceholderText="Destination outside the synchronized folder" />
                                            <Button Grid.Column="2" Classes="secondary" Content="Browse…" Click="OnPickSyncCompressedBackupFolderClick" />
                                            <Button Grid.Column="3" Classes="secondary" Content="Create now" Click="OnCreateCompressedSyncBackupClick" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,85,85,85,Auto" ColumnSpacing="6">
                                            <ComboBox ItemsSource="{Binding RetentionModes}" SelectedItem="{Binding SelectedRetentionMode}" />
                                            <TextBox Grid.Column="1" Text="{Binding RetentionVersions}" PlaceholderText="Versions" />
                                            <TextBox Grid.Column="2" Text="{Binding RetentionDays}" PlaceholderText="Days" />
                                            <TextBox Grid.Column="3" Text="{Binding RetentionBudgetGb}" PlaceholderText="GB" />
                                            <Button Grid.Column="4" Classes="primary" Content="Save Sync + Versions" Click="OnSaveVersionedSyncSettingsClick" />
                                        </Grid>
                                        <TextBlock Text="{Binding SyncStorageStatus}" FontSize="9.5" Foreground="#E5C07B" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,Auto,110,*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Admission sécurisée des pairs" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Échanges signés, invitation à usage unique et code de vérification." TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,105,*" ColumnSpacing="8" Margin="0,10,0,8">
                                    <ComboBox ItemsSource="{Binding PeerRoles}" SelectedItem="{Binding SelectedPeerRole}" MinWidth="145" />
                                    <TextBox Grid.Column="1" Text="{Binding PeerVerificationCode}" PlaceholderText="Code" />
                                    <Button Grid.Column="2" Classes="primary" Content="Créer une invitation (24 h)" Click="OnCreateInvitationClick" HorizontalAlignment="Left" />
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ListBox ItemsSource="{Binding PeerMembers}" SelectedItem="{Binding SelectedPeerMember}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="5" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Role}" Classes="muted" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DeviceIdShort}" FontFamily="Consolas" Classes="muted" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Top" MinWidth="155">
                                        <TextBlock Text="Selected member role" FontSize="9" Classes="muted" />
                                        <ComboBox ItemsSource="{Binding PeerRoles}" SelectedItem="{Binding SelectedPeerMemberRole}" />
                                        <Button Classes="primary" Content="Update signed role" Click="OnUpdatePeerRoleClick"
                                                IsEnabled="{Binding CanUpdateSelectedPeerRole}"
                                                ToolTip.Tip="Reissues the selected member certificate with a new signed role and membership epoch" />
                                        <Button Classes="danger" Content="Revoke" Click="OnRevokePeerClick" />
                                    </StackPanel>
                                </Grid>
                                <TextBox Grid.Row="3" Text="{Binding PeerExchangeText}" AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Cascadia Mono,Consolas" FontSize="11" PlaceholderText="Collez ici une invitation, une demande ou un certificat…"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <WrapPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Classes="secondary" Content="Préparer la demande" Click="OnPrepareJoinRequestClick" Margin="0,3,7,3" />
                                    <Button Classes="secondary" Content="Approuver la demande" Click="OnApproveJoinRequestClick" Margin="0,3,7,3" />
                                    <Button Classes="primary" Content="Importer le certificat" Click="OnImportMembershipGrantClick" Margin="0,3,7,3" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Commits" IsVisible="{Binding IsSyncCommitMode}">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="7">
                        <Border Classes="card" Padding="10,7">
                            <Grid ColumnDefinitions="*,180,2*,Auto" ColumnSpacing="7">
                                <StackPanel>
                                    <TextBlock Text="Sync + Commit" FontSize="15" FontWeight="SemiBold" Foreground="#78D7B7" />
                                    <TextBlock Text="The exchange changes only when a complete compressed commit is published." Classes="muted" FontSize="9.5" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding SyncCommitAuthor}" PlaceholderText="Author" />
                                <TextBox Grid.Column="2" Text="{Binding SyncCommitMessage}" PlaceholderText="Commit message…" />
                                <Button Grid.Column="3" Classes="primary" Content="Commit &amp; publish"
                                        IsEnabled="{Binding CanCreateSyncCommit}" Click="OnCreateSyncCommitClick" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="1.05*,7,1.25*">
                            <Border Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Background="#2B2D30" Padding="9,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel><TextBlock Text="Published commits" FontWeight="SemiBold" /><TextBlock Text="Immutable packages · newest first" Classes="muted" FontSize="9" /></StackPanel>
                                            <Button Grid.Column="1" Classes="secondary" Content="Refresh" Click="OnRefreshSyncCommitsClick" />
                                        </Grid>
                                    </Border>
                                    <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding SyncCommits}"
                                              SelectedItem="{Binding SelectedSyncCommit}" AutoGenerateColumns="False"
                                              IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Commit" Binding="{Binding ShortId}" Width="92" />
                                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="1.5*" />
                                            <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="110" />
                                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="155" />
                                            <DataGridTextColumn Header="Files" Binding="{Binding SizeText}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <GridSplitter Grid.Column="1" Width="7" Background="#45484E" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                            <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Border Background="#2B2D30" Padding="9,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel><TextBlock Text="Incoming analysis &amp; conflicts" FontWeight="SemiBold" /><TextBlock Text="{Binding SyncCommitConflictSummary}" Classes="muted" FontSize="9" /></StackPanel>
                                            <Button Grid.Column="1" Classes="secondary" Content="Analyze selected" IsEnabled="{Binding CanAnalyzeSyncCommit}" Click="OnAnalyzeSyncCommitClick" />
                                        </Grid>
                                    </Border>
                                    <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding SyncCommitConflicts}"
                                              SelectedItem="{Binding SelectedSyncCommitConflict}" AutoGenerateColumns="False"
                                              IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="2*" />
                                            <DataGridTextColumn Header="Conflict" Binding="{Binding State}" Width="130" />
                                            <DataGridTextColumn Header="Resolution" Binding="{Binding ChoiceText}" Width="120" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7" Margin="8,6">
                                        <TextBlock Text="Every apply creates a recovery ZIP outside the synchronized folder." Classes="muted" FontSize="9" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Keep local" Click="OnKeepLocalSyncCommitConflictClick" />
                                        <Button Grid.Column="2" Classes="secondary" Content="Use incoming" Click="OnUseIncomingSyncCommitConflictClick" />
                                        <Button Grid.Column="3" Classes="primary" Content="Apply commit" IsEnabled="{Binding CanApplySyncCommit}" Click="OnApplySyncCommitClick" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding SyncCommitStatus}" Foreground="#E5C07B" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Grid.Column="1" Classes="inlineLoader" IsVisible="{Binding IsSyncCommitBusy}" IsIndeterminate="True" Width="100" />
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Devices">
                    <Border Classes="card" Padding="0">
                        <Grid RowDefinitions="Auto,*">
                            <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel><TextBlock Text="Configured and connected devices" FontWeight="SemiBold" /><TextBlock Text="Refresh explicitly to query the live Syncthing API." FontSize="9" Classes="muted" /></StackPanel>
                                    <Button Grid.Column="1" Classes="secondary" Content="Refresh" Click="OnRefreshSyncthingClick" />
                                </Grid>
                            </Border>
                            <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding SyncthingDevices}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="1.2*" />
                                    <DataGridTemplateColumn Header="Status" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90" />
                                    <DataGridTextColumn Header="Device ID" Binding="{Binding Identity}" Width="130" />
                                    <DataGridTextColumn Header="Address" Binding="{Binding Details}" Width="1.4*" />
                                    <DataGridTextColumn Header="Last activity" Binding="{Binding LastActivity}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Differences">
                    <Border Classes="card" Padding="0">
                        <Grid RowDefinitions="Auto,*">
                            <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10">
                                <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Folder differences" FontWeight="SemiBold" /><TextBlock Text="{Binding SyncthingFolderSummary}" FontSize="9" Classes="muted" /></StackPanel><WrapPanel Grid.Column="1"><ProgressBar Classes="inlineLoader" IsIndeterminate="True" IsVisible="{Binding IsSyncthingRefreshing}" Width="90" Margin="0,0,8,0" /><Button Classes="secondary" Content="Scan and refresh" Click="OnScanSyncthingClick" /></WrapPanel></Grid>
                            </Border>
                            <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding SyncthingDifferences}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="120" />
                                    <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                                    <DataGridTextColumn Header="Size (bytes)" Binding="{Binding Size}" Width="110" />
                                    <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedAt}" Width="180" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem x:Name="SyncHistoryTab" Header="History">
                    <Border Classes="card" Padding="0">
                        <Grid RowDefinitions="Auto,*">
                            <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="9,7">
                                <Grid ColumnDefinitions="1.2*,1*,Auto,Auto" ColumnSpacing="6">
                                    <StackPanel>
                                        <TextBlock Text="Persistent Sync history" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SyncHistorySummary}" FontSize="9" Classes="muted" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding SyncHistorySearch}" Classes="searchBox"
                                             PlaceholderText="Search path, action, direction, scope, or detail…" />
                                    <Button Grid.Column="2" Classes="secondary" Content="Clear file filter" Click="OnClearSyncHistoryFileFilterClick" />
                                    <Button Grid.Column="3" Classes="primary" Content="Search" Click="OnRefreshSyncHistoryClick" />
                                </Grid>
                            </Border>
                            <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding SyncHistory}"
                                      AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                      GridLinesVisibility="Horizontal" Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="155" />
                                    <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="135" />
                                    <DataGridTextColumn Header="File / folder" Binding="{Binding Path}" Width="2*" />
                                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="140" />
                                    <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="120" />
                                    <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="1.3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Ignore rules (.stignore)">
                    <Grid ColumnDefinitions="1.2*,7,1*">
                    <Border Classes="card">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="7">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel><TextBlock Text="Syncthing ignore rules" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding SyncthingIgnoreStatus}" FontSize="10" Classes="muted" /></StackPanel>
                                <WrapPanel Grid.Column="1"><Button Classes="secondary" Content="Reload" Click="OnLoadSyncthingIgnoreClick" Margin="0,2,6,2" /><Button Classes="secondary" Content="Unreal template" Click="OnUseSyncthingUnrealIgnoreClick" Margin="0,2,6,2" /><Button Classes="primary" Content="Save .stignore" Click="OnSaveSyncthingIgnoreClick" Margin="0,2,0,2" /></WrapPanel>
                            </Grid>
                            <TextBox Grid.Row="1" Text="{Binding SyncthingIgnoreRules}" AcceptsReturn="True" FontFamily="Cascadia Mono,Consolas" FontSize="11" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            <TextBlock Grid.Row="2" Text="Patterns are relative to the synchronized folder root. The first matching rule wins; use ! to include and // for comments." FontSize="10" Classes="muted" />
                        </Grid>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="7" Background="#45484E"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                    <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*,Auto" Margin="7" RowSpacing="6">
                            <StackPanel>
                                <TextBlock Text="Project rule assistant" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding IgnoreSuggestionSummary}" Classes="muted" FontSize="9"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TabControl Grid.Row="1" Background="Transparent" Padding="0">
                                <TabItem Header="Folders">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="5">
                                        <Grid ColumnDefinitions="*,95" ColumnSpacing="5">
                                            <TextBox Text="{Binding IgnoreFolderSearch, UpdateSourceTrigger=PropertyChanged}" Classes="searchBox"
                                                     PlaceholderText="Search folders or patterns…" Padding="6,3" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding IgnoreSuggestionFilters}"
                                                      SelectedItem="{Binding IgnoreFolderFilter}" Padding="5,2" />
                                        </Grid>
                                        <TabControl Grid.Row="1" Padding="0" Background="Transparent">
                                            <TabItem Header="List">
                                                <ListBox ItemsSource="{Binding IgnoreFolderSuggestions}"
                                                         Classes="compactList" Background="Transparent" BorderThickness="0">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected}" Height="21" Margin="3,0"
                                                                      HorizontalContentAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Pattern}">
                                                                    <TextBlock Text="{Binding Pattern}" FontFamily="Cascadia Mono,Consolas"
                                                                               FontSize="10" TextTrimming="CharacterEllipsis"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="muted"
                                                                               FontSize="9" VerticalAlignment="Center" Margin="6,0,2,0" />
                                                                </Grid>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </TabItem>
                                            <TabItem Header="Tree">
                                                <TreeView ItemsSource="{Binding IgnoreFolderTree}" Classes="compactTree"
                                                          Background="Transparent" BorderThickness="0" Margin="2">
                                                    <TreeView.ItemTemplate>
                                                        <TreeDataTemplate ItemsSource="{Binding Children}">
                                                            <Grid Height="21" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                                                                <CheckBox IsChecked="{Binding IsSelected}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10"
                                                                           Foreground="#E5C07B" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="muted"
                                                                           FontSize="9" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </TreeDataTemplate>
                                                    </TreeView.ItemTemplate>
                                                </TreeView>
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="File types">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="5">
                                        <Grid ColumnDefinitions="*,95" ColumnSpacing="5">
                                            <TextBox Text="{Binding IgnoreFileTypeSearch, UpdateSourceTrigger=PropertyChanged}" Classes="searchBox"
                                                     PlaceholderText="Search extensions…" Padding="6,3" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding IgnoreSuggestionFilters}"
                                                      SelectedItem="{Binding IgnoreFileTypeFilter}" Padding="5,2" />
                                        </Grid>
                                        <ListBox Grid.Row="1" ItemsSource="{Binding IgnoreFileTypeSuggestions}"
                                                 Classes="compactList" Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" Height="21" Margin="3,0"
                                                              HorizontalContentAlignment="Stretch">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding Pattern}" FontFamily="Cascadia Mono,Consolas"
                                                                       FontSize="10" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="muted"
                                                                       FontSize="9" VerticalAlignment="Center" Margin="6,0,2,0" />
                                                        </Grid>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
                                <ProgressBar Classes="inlineLoader" IsVisible="{Binding IsIgnoreSuggestionLoading}" IsIndeterminate="True"
                                             VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="secondary" Content="Rescan"
                                        Click="OnRefreshIgnoreSuggestionsClick" />
                                <Button Grid.Column="2" Classes="primary" Content="Add selected"
                                        Click="OnAppendSyncthingIgnoreSuggestionsClick" />
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Logs">
                    <Border Classes="card" Padding="0">
                        <Grid RowDefinitions="Auto,*">
                            <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Syncthing logs" FontWeight="SemiBold" /><TextBlock Text="Up to 500 recent entries from this project's isolated instance." FontSize="9" Classes="muted" /></StackPanel><Button Grid.Column="1" Classes="secondary" Content="Refresh" Click="OnRefreshSyncthingClick" /></Grid></Border>
                            <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding SyncthingLogs}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" Background="Transparent">
                                <DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="180" /><DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="85" /><DataGridTextColumn Header="Facility" Binding="{Binding Facility}" Width="130" /><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" /></DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>
                </TabControl>
                </Grid>
                </TabItem>

                <TabItem x:Name="SyncConflictsWorkspaceTab" Header="Conflicts">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*,Auto" RowSpacing="7">
                        <Border Classes="card" Padding="10,7">
                            <Grid ColumnDefinitions="*,260,Auto,70,Auto" ColumnSpacing="7">
                                <StackPanel>
                                    <TextBlock Text="Safe Sync conflict resolver" FontSize="15" FontWeight="SemiBold" Foreground="#78D7B7" />
                                    <TextBlock Text="{Binding SyncConflictSummary}" FontSize="9.5" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding SyncConflictSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Classes="searchBox" PlaceholderText="Filter file, folder, scope, or state…" />
                                <TextBlock Grid.Column="2" Text="Keep backups" Classes="muted" VerticalAlignment="Center" />
                                <TextBox Grid.Column="3" Text="{Binding SyncConflictRetentionDays}" HorizontalContentAlignment="Right" ToolTip.Tip="Retention in days" />
                                <Button Grid.Column="4" Classes="primary" Content="Scan conflicts" Click="OnRefreshSyncConflictsClick" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="1.2*,7,0.9*">
                            <Border Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="9,6">
                                        <StackPanel>
                                            <TextBlock Text="Unresolved conflict copies" FontWeight="SemiBold" />
                                            <TextBlock Text="Select a conflict, then keep the current original or replace it with the conflict version." FontSize="9" Classes="muted" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding SyncConflicts}"
                                              SelectedItem="{Binding SelectedSyncConflict}" AutoGenerateColumns="False"
                                              IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="1.2*" />
                                            <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="1.6*" />
                                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="120" />
                                            <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="150" />
                                            <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedAt}" Width="145" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7" Margin="8,6">
                                        <TextBlock Text="Both files are copied to CyRevision recovery storage before resolution." Classes="muted" FontSize="9" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Keep original"
                                                IsEnabled="{Binding CanResolveSelectedSyncConflict}" Click="OnKeepOriginalSyncConflictClick" />
                                        <Button Grid.Column="2" Classes="primary" Content="Use conflict version"
                                                IsEnabled="{Binding CanResolveSelectedSyncConflict}" Click="OnUseSyncConflictVersionClick" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <GridSplitter Grid.Column="1" Width="7" Background="#45484E"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                            <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="9,6">
                                        <StackPanel>
                                            <TextBlock Text="Recoverable resolutions" FontWeight="SemiBold" />
                                            <TextBlock Text="Restore recreates the original and conflict copy as they were before resolution." FontSize="9" Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding SyncConflictBackups}"
                                              SelectedItem="{Binding SelectedSyncConflictBackup}" AutoGenerateColumns="False"
                                              IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="1.2*" />
                                            <DataGridTextColumn Header="Choice" Binding="{Binding Resolution}" Width="100" />
                                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="145" />
                                            <DataGridTextColumn Header="Retention" Binding="{Binding RetentionStatus}" Width="1*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7" Margin="8,6">
                                        <TextBlock Text="Recovery data is stored outside the synchronized folder." Classes="muted" FontSize="9" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Clean expired" Click="OnCleanExpiredSyncConflictsClick" />
                                        <Button Grid.Column="2" Classes="primary" Content="Restore selected…"
                                                IsEnabled="{Binding CanRestoreSelectedSyncConflictBackup}" Click="OnRestoreSyncConflictClick" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <ProgressBar Grid.Row="2" Classes="inlineLoader" IsIndeterminate="True"
                                     IsVisible="{Binding IsSyncConflictBusy}" Height="3" />
                    </Grid>
                </TabItem>

                <TabItem x:Name="SharedSyncWorkspaceTab" Header="Shared Sync folders">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="7">
                        <Border Classes="card" Padding="10,7">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Optional shared folders" FontSize="15" FontWeight="SemiBold" Foreground="#78D7B7" />
                                    <TextBlock Text="Share builds, deliveries, references, or any team folder independently of the project operating mode. The repository itself is not included automatically."
                                               Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1E3B34" CornerRadius="4" Padding="7,2" VerticalAlignment="Top">
                                    <TextBlock Text="OPTIONAL FOR EVERY PROJECT" FontSize="8.5" Foreground="#78D7B7" FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="1.15*,0.85*" ColumnSpacing="8">
                            <Border Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,7">
                                        <StackPanel>
                                            <TextBlock Text="Independent project shares" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="Each mapping has its own source folder, direction, identity, and scan policy."
                                                       FontSize="9.5" Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding SharedSyncFolders}"
                                              SelectedItem="{Binding SelectedSharedSyncFolder}" AutoGenerateColumns="False"
                                              IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1*" />
                                            <DataGridTextColumn Header="Local folder" Binding="{Binding Path}" Width="2*" />
                                            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="105" />
                                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="70" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Shared-folder settings" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="This uses the isolated CyRevision Syncthing instance even when the project mode is Git only."
                                               TextWrapping="Wrap" FontSize="9.5" Foreground="#78D7B7" />
                                    <TextBlock Text="Name" FontSize="9" Classes="muted" />
                                    <TextBox Text="{Binding SharedSyncFolderName}" PlaceholderText="Build versions" />
                                    <TextBlock Text="Local folder" FontSize="9" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TextBox Text="{Binding SharedSyncFolderPath}" PlaceholderText="Choose a folder outside or inside the repository…" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="OnPickSharedSyncFolderClick" />
                                    </Grid>
                                    <TextBlock Text="Direction" FontSize="9" Classes="muted" />
                                    <ComboBox ItemsSource="{Binding SyncthingFolderModeNames}"
                                              SelectedItem="{Binding SelectedSharedSyncFolderModeName}" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="primary" Content="Add / update" Click="OnSaveSharedSyncFolderClick" Margin="0,3,6,3" />
                                        <Button Classes="secondary" Content="Scan" Click="OnScanSharedSyncFolderClick" Margin="0,3,6,3" />
                                        <Button Classes="danger" Content="Remove mapping" Click="OnRemoveSharedSyncFolderClick" Margin="0,3,6,3" />
                                    </WrapPanel>
                                    <TextBlock Text="Removing a mapping never deletes the local folder or its files."
                                               TextWrapping="Wrap" Classes="muted" FontSize="9.5" />
                                    <Border Background="#1B2237" CornerRadius="5" Padding="8,6">
                                        <TextBlock Text="{Binding SharedSyncFolderStatus}" TextWrapping="Wrap" Foreground="#78D7B7" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" Classes="card" Padding="0">
                            <Grid RowDefinitions="Auto,*">
                                <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="9,6">
                                    <Grid ColumnDefinitions="*,1.2*,Auto,Auto" ColumnSpacing="6">
                                        <StackPanel>
                                            <TextBlock Text="Shared Sync history" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SyncHistorySummary}" FontSize="8.5" Classes="muted" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding SyncHistorySearch}" Classes="searchBox"
                                                 PlaceholderText="Search file, folder, action, or direction…" />
                                        <Button Grid.Column="2" Classes="secondary" Content="Clear file filter" Click="OnClearSyncHistoryFileFilterClick" />
                                        <Button Grid.Column="3" Classes="primary" Content="Search" Click="OnRefreshSyncHistoryClick" />
                                    </Grid>
                                </Border>
                                <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding SyncHistory}"
                                          AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                          GridLinesVisibility="Horizontal" Background="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="150" />
                                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="125" />
                                        <DataGridTextColumn Header="File / folder" Binding="{Binding Path}" Width="2*" />
                                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="130" />
                                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="110" />
                                        <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="1.2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="VpnWorkspaceTab" Header="VPN WireGuard">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="0.95*,1.25*" ColumnSpacing="8">
                        <Border Classes="card">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Assistant WireGuard CyRevision" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding VpnState}" FontSize="14" FontWeight="SemiBold" Foreground="#78D7B7" />
                                    <TextBlock Text="{Binding VpnDetails}" TextWrapping="Wrap" Classes="muted" />
                                    <Grid ColumnDefinitions="190,*" ColumnSpacing="9">
                                        <StackPanel>
                                            <TextBlock Text="Moteur WireGuard" FontSize="11" Classes="muted" />
                                            <ComboBox ItemsSource="{Binding VpnBackendModes}" SelectedItem="{Binding SelectedVpnBackendMode}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding VpnBackendDetails}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" FontSize="10.5" Foreground="#78D7B7" />
                                    </Grid>
                                    <Button Classes="primary" Content="Configurer le moteur sélectionné" Click="OnConfigureVpnClick" HorizontalAlignment="Left" />

                                    <TextBlock Text="Runtime actif" Margin="0,5,0,0" />
                                    <TextBox Text="{Binding WireGuardExecutablePath}" IsReadOnly="True" PlaceholderText="WireGuard non détecté" />

                                    <Grid ColumnDefinitions="1.25*,1*,0.65*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Réseau privé" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding VpnNetworkCidr}" PlaceholderText="10.80.1.0/24" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Adresse locale" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding VpnLocalAddress}" PlaceholderText="10.80.1.1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Port" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding VpnListenPort}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Endpoint public ou DNS (facultatif)" FontSize="11" Classes="muted" />
                                    <TextBox Text="{Binding VpnPublicEndpoint}" PlaceholderText="vpn.mondomaine.fr:51820" />
                                    <TextBlock Text="Fonction de cet appareil" FontSize="11" Classes="muted" />
                                    <ComboBox ItemsSource="{Binding VpnCapabilities}" SelectedItem="{Binding SelectedVpnCapability}" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="secondary" Content="Enregistrer" Click="OnSaveVpnClick" Margin="0,3,7,3" />
                                        <Button Classes="primary" Content="Activer" Click="OnStartVpnClick" Margin="0,3,7,3" />
                                        <Button Classes="danger" Content="Arrêter" Click="OnStopVpnClick" Margin="0,3,7,3" />
                                        <Button Classes="secondary" Content="Actualiser" Click="OnRefreshVpnClick" Margin="0,3,7,3" />
                                    </WrapPanel>
                                    <Border Background="#10241F" CornerRadius="8" Padding="11">
                                        <TextBlock Text="CyRevision contrôle uniquement l'interface cyrev-* de ce projet. Tes autres tunnels WireGuard ne sont jamais arrêtés ni modifiés." TextWrapping="Wrap" FontSize="11" Foreground="#78D7B7" />
                                    </Border>
                                    <Expander Header="Guided setup · computer, firewall, router" Margin="0,3,0,0">
                                        <StackPanel Spacing="8" Margin="0,8,0,2">
                                            <TextBlock Text="{Binding VpnSetupSummary}" TextWrapping="Wrap" FontSize="11" Foreground="#78D7B7" />
                                            <WrapPanel Orientation="Horizontal">
                                                <CheckBox Content="This computer accepts incoming VPN connections"
                                                          IsChecked="{Binding VpnSetupAcceptIncoming}" Margin="0,2,14,2" />
                                                <CheckBox Content="Unreal Swarm over VPN"
                                                          IsChecked="{Binding VpnSetupAllowSwarm}" Margin="0,2,14,2" />
                                                <CheckBox Content="CyRevision control API over VPN"
                                                          IsChecked="{Binding VpnSetupAllowControlApi}" Margin="0,2,14,2" />
                                                <CheckBox Content="Secure file exchange over VPN"
                                                          IsChecked="{Binding VpnSetupAllowFileExchange}" Margin="0,2,14,2" />
                                                <CheckBox Content="Remote build agent over VPN"
                                                          IsChecked="{Binding VpnSetupAllowRemoteBuild}" Margin="0,2,14,2" />
                                            </WrapPanel>
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Classes="primary" Content="1 · Diagnose this computer"
                                                        Click="OnInspectVpnSetupClick" Margin="0,3,7,3" />
                                                <Button Classes="secondary" Content="2 · Apply firewall rules"
                                                        IsEnabled="{Binding VpnCanApplyFirewall}"
                                                        Click="OnApplyVpnFirewallClick" Margin="0,3,7,3" />
                                                <Button Classes="danger" Content="Remove CyRevision rules"
                                                        IsEnabled="{Binding VpnCanApplyFirewall}"
                                                        Click="OnRemoveVpnFirewallClick" Margin="0,3,7,3" />
                                                <Button Classes="secondary" Content="3 · Open router page"
                                                        IsEnabled="{Binding VpnCanOpenRouter}"
                                                        Click="OnOpenVpnRouterClick" Margin="0,3,7,3" />
                                                <Button Classes="secondary" Content="4 · Test tunnel and peers"
                                                        Click="OnTestVpnConnectivityClick" Margin="0,3,7,3" />
                                            </WrapPanel>
                                            <Border Background="#111A2D" CornerRadius="6" Padding="9">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding VpnSetupNetwork}" TextWrapping="Wrap" FontSize="10.5" />
                                                    <TextBlock Text="{Binding VpnFirewallStatus}" TextWrapping="Wrap" FontSize="10.5" Foreground="#78D7B7" />
                                                </StackPanel>
                                            </Border>
                                            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                                <StackPanel>
                                                    <TextBlock Text="Computer checklist" FontSize="10.5" Classes="muted" />
                                                    <TextBox Text="{Binding VpnComputerGuide}" IsReadOnly="True" AcceptsReturn="True"
                                                             TextWrapping="Wrap" MinHeight="105" FontSize="10" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Router / modem checklist" FontSize="10.5" Classes="muted" />
                                                    <TextBox Text="{Binding VpnRouterGuide}" IsReadOnly="True" AcceptsReturn="True"
                                                             TextWrapping="Wrap" MinHeight="105" FontSize="10" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Generated commands" FontSize="10.5" Classes="muted" />
                                            <TextBox Text="{Binding VpnFirewallCommands}" IsReadOnly="True" AcceptsReturn="True"
                                                     TextWrapping="Wrap" MinHeight="58" FontFamily="Cascadia Mono,Consolas" FontSize="9.5" />
                                            <TextBlock Text="Connectivity" FontSize="10.5" Classes="muted" />
                                            <TextBlock Text="{Binding VpnConnectivityStatus}" TextWrapping="Wrap"
                                                       FontSize="10.5" Foreground="#78D7B7" />
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock Text="Aperçu sécurisé de la configuration" FontSize="11" Classes="muted" />
                                    <TextBox Text="{Binding VpnConfigurationPreview}" IsReadOnly="True" AcceptsReturn="True"
                                             MinHeight="110" FontFamily="Cascadia Mono,Consolas" FontSize="10"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,125,Auto,150,Auto,Auto,125,Auto">
                                <StackPanel>
                                    <TextBlock Text="Pairs et services VPN" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="VPN seul, Swarm, CI ou service : aucun accès Git/Sync n'est ajouté automatiquement." TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                </StackPanel>
                                <DataGrid Grid.Row="1" Margin="0,10,0,8" ItemsSource="{Binding VpnPeers}" SelectedItem="{Binding SelectedVpnPeer}"
                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Appareil" Binding="{Binding DisplayName}" Width="1.1*" />
                                        <DataGridTextColumn Header="IP VPN" Binding="{Binding TunnelAddress}" Width="0.8*" />
                                        <DataGridTextColumn Header="Fonction" Binding="{Binding Capabilities}" Width="1.15*" />
                                        <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="1.2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Row="2" ColumnDefinitions="190,*" ColumnSpacing="8" Margin="0,2,0,8">
                                    <StackPanel Spacing="5">
                                        <TextBox Text="{Binding VpnInvitationClientName}" PlaceholderText="Client name" />
                                        <ComboBox ItemsSource="{Binding VpnCapabilities}" SelectedItem="{Binding SelectedVpnInvitationCapability}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="primary" Content="Créer une invitation VPN (24 h)" Click="OnCreateVpnInvitationClick" HorizontalAlignment="Left" />
                                </Grid>
                                <TextBox Grid.Row="3" Text="{Binding VpnExchangeText}" AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Cascadia Mono,Consolas" FontSize="10"
                                         PlaceholderText="Collez ici une invitation VPN ou la réponse signée d'un pair…"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="secondary" Content="Rejoindre l'invitation" Click="OnJoinVpnInvitationClick" Margin="0,3,7,3" />
                                        <Button Classes="primary" Content="Accepter la réponse" Click="OnAcceptVpnResponseClick" Margin="0,3,7,3" />
                                        <Button Classes="danger" Content="Retirer le pair" Click="OnRemoveVpnPeerClick" Margin="0,3,7,3" />
                                    </WrapPanel>
                                    <Border Grid.Column="1" Background="#1B2237" CornerRadius="8" Padding="10,6">
                                        <TextBlock Text="Swarm : Windows · TCP 8008/8009" FontSize="10" Foreground="#B8C1D8" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="5" Margin="0,10,0,4">
                                    <TextBlock Text="Signed VPN exchange through Sync" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Only signed invitations and responses are synchronized. Private keys never enter Sync."
                                               TextWrapping="Wrap" FontSize="10.5" Classes="muted" />
                                </StackPanel>
                                <DataGrid Grid.Row="6" ItemsSource="{Binding VpnSyncMessages}"
                                          SelectedItem="{Binding SelectedVpnSyncMessage}"
                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="0.8*" />
                                        <DataGridTextColumn Header="Sender" Binding="{Binding Sender}" Width="0.7*" />
                                        <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="1*" />
                                        <DataGridTextColumn Header="Expires" Binding="{Binding Expires}" Width="1*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Row="7" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="7" Margin="0,6,0,0">
                                    <Button Classes="primary" Content="Share current message"
                                            Click="OnPublishVpnSyncClick" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Refresh Sync inbox"
                                            Click="OnRefreshVpnSyncClick" />
                                    <Button Grid.Column="2" Classes="secondary" Content="Load selected"
                                            Click="OnLoadVpnSyncClick" />
                                    <TextBlock Grid.Column="3" Text="{Binding VpnSyncStatus}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" FontSize="10" Foreground="#78D7B7" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="SwarmWorkspaceTab" Header="Swarm over VPN">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="1.03*,0.97*" ColumnSpacing="8">
                        <Border Classes="card">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Unreal Swarm session" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Configure Swarm Agent and an optional Coordinator on the project WireGuard network. Swarm remains Windows-only."
                                               TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                    <TextBlock Text="{Binding SwarmStatus}" TextWrapping="Wrap" Foreground="#78D7B7" />

                                    <Grid ColumnDefinitions="180,*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="This computer" FontSize="10.5" Classes="muted" />
                                            <ComboBox ItemsSource="{Binding SwarmRoles}" SelectedItem="{Binding SelectedSwarmRole}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Coordinator VPN IPv4" FontSize="10.5" Classes="muted" />
                                            <TextBox Text="{Binding SwarmCoordinatorAddress}" PlaceholderText="10.80.40.1" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Local coordinator alias" FontSize="10.5" Classes="muted" />
                                    <TextBox Text="{Binding SwarmCoordinatorAlias}" PlaceholderText="cyrev-swarm-project" />
                                    <TextBlock Text="The alias is an optional local hosts/DNS entry. Swarm can also use the VPN IPv4 directly."
                                               TextWrapping="Wrap" FontSize="10" Classes="muted" />

                                    <TextBlock Text="SwarmAgent.exe" FontSize="10.5" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <TextBox Text="{Binding SwarmAgentPath}" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="OnPickSwarmAgentClick" />
                                    </Grid>
                                    <TextBlock Text="SwarmCoordinator.exe" FontSize="10.5" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <TextBox Text="{Binding SwarmCoordinatorPath}" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="OnPickSwarmCoordinatorClick" />
                                    </Grid>
                                    <TextBlock Text="SwarmAgent.Options.xml" FontSize="10.5" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <TextBox Text="{Binding SwarmOptionsPath}" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="OnPickSwarmOptionsClick" />
                                    </Grid>

                                    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Agent group" FontSize="10.5" Classes="muted" />
                                            <TextBox Text="{Binding SwarmAgentGroup}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Allowed remote group" FontSize="10.5" Classes="muted" />
                                            <TextBox Text="{Binding SwarmAllowedGroup}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Allowed remote agent names" FontSize="10.5" Classes="muted" />
                                    <TextBox Text="{Binding SwarmAllowedAgents}" />
                                    <TextBlock Text="Swarm cache folder (optional)" FontSize="10.5" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <TextBox Text="{Binding SwarmCacheFolder}" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="OnPickSwarmCacheClick" />
                                    </Grid>

                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="secondary" Content="Save session" Click="OnSaveSwarmClick" Margin="0,3,7,3" />
                                        <Button Classes="primary" Content="Apply Agent configuration" Click="OnApplySwarmOptionsClick" Margin="0,3,7,3" />
                                        <Button Classes="secondary" Content="Apply local DNS alias" Click="OnApplySwarmDnsClick" Margin="0,3,7,3" />
                                        <Button Classes="danger" Content="Remove local alias" Click="OnRemoveSwarmDnsClick" Margin="0,3,7,3" />
                                    </WrapPanel>
                                    <Border Background="#10241F" CornerRadius="7" Padding="10">
                                        <TextBlock Text="CyRevision backs up the existing Swarm XML and edits only known fields. Its DNS entry is enclosed in a project-owned block. Firewall rules remain restricted to the VPN subnet; never forward TCP 8008/8009 on the modem."
                                                   TextWrapping="Wrap" FontSize="10.5" Foreground="#78D7B7" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,Auto,*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Connection and configuration tests" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Tests the VPN address, executable paths, Agent XML, local DNS, project firewall and TCP 8008/8009."
                                               TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                </StackPanel>
                                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
                                    <Button Classes="primary" Content="Run full diagnosis" Click="OnDiagnoseSwarmClick" Margin="0,3,7,3" />
                                    <Button Classes="secondary" Content="Launch Agent" Click="OnLaunchSwarmAgentClick" Margin="0,3,7,3" />
                                    <Button Classes="secondary" Content="Launch Coordinator" Click="OnLaunchSwarmCoordinatorClick" Margin="0,3,7,3"
                                            IsEnabled="{Binding SwarmHostsCoordinator}" />
                                </WrapPanel>
                                <TextBox Grid.Row="2" Text="{Binding SwarmDiagnostic}" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas" FontSize="10.5"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <Border Grid.Row="3" Background="#1B2237" CornerRadius="7" Padding="10" Margin="0,8,0,0">
                                    <TextBlock Text="When automatic repair is unavailable, every failed check includes an exact corrective step. Swarm is never exposed to the public Internet."
                                               TextWrapping="Wrap" FontSize="10.5" Classes="muted" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="VpnFilesWorkspaceTab" Header="VPN files">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="0.92*,1.08*" ColumnSpacing="8">
                        <Border Classes="card">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Private inbox and explicit folder share" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="The endpoint binds only to this project's VPN IPv4. WireGuard encrypts transport and a 256-bit project token authorizes every operation."
                                               TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                    <TextBlock Text="{Binding VpnFileStatus}" TextWrapping="Wrap" Foreground="#78D7B7" />
                                    <Grid ColumnDefinitions="*,115" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Project access token" FontSize="10.5" Classes="muted" />
                                            <TextBox Text="{Binding VpnFileAccessToken}" PasswordChar="*" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="TCP port" FontSize="10.5" Classes="muted" />
                                            <TextBox Text="{Binding VpnFileListenPort}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Private inbox for received files" FontSize="10.5" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <TextBox Text="{Binding VpnFileInboxPath}" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="OnPickVpnInboxClick" />
                                    </Grid>
                                    <TextBlock Text="Folder explicitly shared with authorized VPN peers" FontSize="10.5" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <TextBox Text="{Binding VpnFileSharedFolderPath}" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="OnPickVpnSharedFolderClick" />
                                    </Grid>
                                    <WrapPanel Orientation="Horizontal">
                                        <CheckBox Content="Receive into inbox" IsChecked="{Binding VpnFileAllowReceive}" Margin="0,2,14,2" />
                                        <CheckBox Content="Expose file list" IsChecked="{Binding VpnFileAllowBrowse}" Margin="0,2,14,2" />
                                        <CheckBox Content="Allow downloads" IsChecked="{Binding VpnFileAllowDownload}" Margin="0,2,14,2" />
                                        <CheckBox Content="Start with project" IsChecked="{Binding VpnFileStartAutomatically}" Margin="0,2,14,2" />
                                    </WrapPanel>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="secondary" Content="Save" Click="OnSaveVpnFilesClick" Margin="0,3,7,3" />
                                        <Button Classes="primary" Content="Start endpoint" Click="OnStartVpnFilesClick" Margin="0,3,7,3" />
                                        <Button Classes="danger" Content="Stop endpoint" Click="OnStopVpnFilesClick" Margin="0,3,7,3" />
                                        <Button Classes="danger" Content="Rotate token" Click="OnRotateVpnFileTokenClick" Margin="0,3,7,3" />
                                    </WrapPanel>
                                    <Border Background="#10241F" CornerRadius="7" Padding="10">
                                        <TextBlock Text="Received files never overwrite existing files, every transfer is checked with SHA-256, partial files are discarded on failure, and symbolic links/junctions cannot escape the shared root. Share the token only through a separate trusted channel."
                                                   TextWrapping="Wrap" FontSize="10.5" Foreground="#78D7B7" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Send, receive and browse" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Select an authorized WireGuard peer. Git, Sync and repository files are not touched."
                                               TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,10,0,8">
                                    <ComboBox ItemsSource="{Binding VpnPeers}" SelectedItem="{Binding SelectedVpnFilePeer}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding TunnelAddress}" Classes="muted" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" Classes="secondary" Content="Test authenticated peer" Click="OnTestVpnFilePeerClick" />
                                </Grid>
                                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Classes="primary" Content="Send file to inbox…" Click="OnSendVpnFileClick" Margin="0,3,7,3" />
                                    <Button Classes="secondary" Content="Refresh shared folder" Click="OnRefreshVpnSharedFilesClick" Margin="0,3,7,3" />
                                        <Button Classes="secondary" Content="Download selected…" Click="OnDownloadVpnSharedFileClick" Margin="0,3,7,3" />
                                </WrapPanel>
                                <DataGrid Grid.Row="3" ItemsSource="{Binding VpnSharedFiles}" SelectedItem="{Binding SelectedVpnSharedFile}"
                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Shared file" Binding="{Binding RelativePath}" Width="1.8*" />
                                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="0.55*" />
                                        <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="0.8*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="4" Text="No SMB share, no public listener, no automatic overwrite and no implicit repository access."
                                           Margin="0,8,0,0" TextWrapping="Wrap" FontSize="10.5" Classes="muted" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TeamChatWorkspaceTab" Header="Team chat">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*,Auto" RowSpacing="7">
                        <Expander Classes="card" Header="Connection settings" Padding="8">
                            <Grid Margin="0,7,0,0" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                                <Grid ColumnDefinitions="145,170,*,Auto" ColumnSpacing="7">
                                    <StackPanel>
                                        <TextBlock Text="Transport" Classes="muted" FontSize="9" />
                                        <ComboBox ItemsSource="{Binding TeamChatTransports}" SelectedItem="{Binding SelectedTeamChatTransport}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Display name" Classes="muted" FontSize="9" />
                                        <TextBox Text="{Binding TeamChatDisplayName}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TeamChatStatus}" Foreground="#78D7B7"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <Button Classes="secondary" Content="Save" Click="OnSaveTeamChatClick" />
                                        <Button Classes="primary" Content="Host VPN" IsVisible="{Binding TeamChatUsesVpn}"
                                                Click="OnStartTeamChatClick" />
                                        <Button Classes="danger" Content="Stop" IsVisible="{Binding TeamChatUsesVpn}"
                                                IsEnabled="{Binding IsTeamChatHostRunning}" Click="OnStopTeamChatClick" />
                                        <Button Classes="secondary" Content="Refresh" Click="OnRefreshTeamChatClick" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" IsVisible="{Binding TeamChatUsesVpn}"
                                      ColumnDefinitions="150,*,1.25*,Auto" ColumnSpacing="7">
                                    <StackPanel>
                                        <TextBlock Text="Listen port" Classes="muted" FontSize="9" />
                                        <TextBox Text="{Binding TeamChatPort}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="VPN listen address" Classes="muted" FontSize="9" />
                                        <TextBox Text="{Binding TeamChatListenAddress}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Host endpoint (VPN IP:port)" Classes="muted" FontSize="9" />
                                        <TextBox Text="{Binding TeamChatPeerEndpoint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Width="250">
                                        <TextBlock Text="Project chat token" Classes="muted" FontSize="9" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                            <TextBox Text="{Binding TeamChatAccessToken}" PasswordChar="●" />
                                            <Button Grid.Column="1" Classes="danger" Content="Rotate" Click="OnRotateTeamChatTokenClick" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" IsVisible="{Binding TeamChatUsesSyncFolder}" ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                    <StackPanel>
                                        <TextBlock Text="Synchronized conversation folder" Classes="muted" FontSize="9" />
                                        <TextBox Text="{Binding TeamChatSyncFolderPath}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="secondary" Content="Browse..." VerticalAlignment="Bottom"
                                            Click="OnPickTeamChatSyncFolderClick" />
                                </Grid>

                                <Grid Grid.Row="1" IsVisible="{Binding TeamChatUsesPrivateServer}"
                                      ColumnDefinitions="1.35*,1*,Auto" ColumnSpacing="7">
                                    <StackPanel>
                                        <TextBlock Text="CyRevision private server URL" Classes="muted" FontSize="9" />
                                        <TextBox Text="{Binding TeamChatServerBaseUrl}" PlaceholderText="https://cyrevision.example.com/" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Server access token" Classes="muted" FontSize="9" />
                                        <TextBox Text="{Binding TeamChatServerApiToken}" PasswordChar="●" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Content="Allow HTTP on trusted LAN/VPN only"
                                              IsChecked="{Binding TeamChatAllowPrivateServerHttp}" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                                </Grid>

                                <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                    <CheckBox Content="Save conversations" IsChecked="{Binding TeamChatSaveConversations}" Margin="0,2,12,2" />
                                    <CheckBox Content="Encrypt local/sync archive" IsChecked="{Binding TeamChatEncryptStoredConversations}" Margin="0,2,12,2" />
                                    <TextBlock Text="Retention days" Classes="muted" VerticalAlignment="Center" />
                                    <TextBox Width="62" Text="{Binding TeamChatRetentionDays}" Margin="5,0,12,0" />
                                    <TextBlock Text="Max attachment MB" Classes="muted" VerticalAlignment="Center" />
                                    <TextBox Width="62" Text="{Binding TeamChatMaxAttachmentMb}" Margin="5,0,12,0" />
                                    <TextBlock Text="HTTPS is mandatory outside a trusted private network."
                                               Foreground="#E5A94D" VerticalAlignment="Center" />
                                </WrapPanel>
                            </Grid>
                        </Expander>

                        <Grid Grid.Row="1" ColumnDefinitions="190,6,*,6,220">
                            <Border Classes="card" Padding="0">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <StackPanel Margin="10,9,8,6">
                                        <TextBlock Text="PROJECT CHANNELS" Classes="muted" FontSize="9" FontWeight="Bold" />
                                        <TextBlock Text="Text channels" FontSize="15" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding TeamChatChannels}"
                                             SelectedItem="{Binding SelectedTeamChatChannel}" Background="Transparent"
                                             BorderThickness="0" Padding="4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="20,*" Margin="5,3">
                                                    <TextBlock Text="#" FontSize="16" Foreground="#7F879C" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Topic}" Classes="muted" FontSize="8.5"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Row="2" Margin="7" Spacing="5" IsVisible="{Binding TeamChatUsesPrivateServer}">
                                        <TextBox Text="{Binding TeamChatNewChannelName}" PlaceholderText="new-channel" />
                                        <TextBox Text="{Binding TeamChatNewChannelTopic}" PlaceholderText="Channel topic" />
                                        <Button Classes="secondary" Content="+ Create channel" HorizontalAlignment="Stretch"
                                                Click="OnCreateTeamChatChannelClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <GridSplitter Grid.Column="1" Width="6" Background="#343843"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

                            <Border Grid.Column="2" Classes="card" Padding="0">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid Margin="11,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedTeamChatChannelTitle}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedTeamChatChannelTopic}" Classes="muted" FontSize="9.5" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary" Content="Open attachment"
                                                Click="OnOpenTeamChatAttachmentClick" />
                                    </Grid>
                                    <ListBox x:Name="TeamChatMessageList" Grid.Row="1" ItemsSource="{Binding TeamChatMessages}"
                                             SelectedItem="{Binding SelectedTeamChatMessage}" Background="#0D1426"
                                             BorderThickness="0" Padding="4" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#24304B" BorderThickness="0,0,0,1" Padding="9,6">
                                                    <Grid ColumnDefinitions="30,*" ColumnSpacing="8">
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="#314467"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="●" Foreground="#58D8B5" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" FontSize="11" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Author}" FontWeight="Bold" Foreground="#E7EAF2" />
                                                                <TextBlock Text="{Binding SentAt}" Classes="muted" FontSize="8.5" />
                                                                <TextBlock Text="{Binding DeliveryState}" Foreground="#78D7B7" FontSize="8.5" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11" />
                                                            <Border Background="#18243B" CornerRadius="4" Padding="7,4"
                                                                    IsVisible="{Binding HasAttachment}">
                                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                                    <TextBlock Text="📎" />
                                                                    <TextBlock Text="{Binding AttachmentName}" Foreground="#61AEFF" />
                                                                    <TextBlock Text="{Binding AttachmentSize}" Classes="muted" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                            <GridSplitter Grid.Column="3" Width="6" Background="#343843"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

                            <Border Grid.Column="4" Classes="card" Padding="0">
                                <Grid RowDefinitions="Auto,*">
                                    <StackPanel Margin="10,9,8,6">
                                        <TextBlock Text="MEMBERS" Classes="muted" FontSize="9" FontWeight="Bold" />
                                        <TextBlock Text="Connected teammates" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding TeamChatParticipants}" Background="Transparent"
                                             BorderThickness="0" Padding="5">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="16,*,Auto" Margin="4,4">
                                                    <TextBlock Text="●" Foreground="#58D8B5" FontSize="9" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding LastSeen}" Classes="muted" FontSize="8.5" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Transport}" Classes="muted"
                                                               FontSize="8.5" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" ColumnDefinitions="190,6,*,6,220">
                            <Border Grid.Column="2" Classes="card" Padding="7">
                                <Grid ColumnDefinitions="*,Auto,230,Auto" ColumnSpacing="6">
                                    <TextBox Text="{Binding TeamChatMessageText}" PlaceholderText="Message the selected channel..."
                                             AcceptsReturn="True" MinHeight="38" MaxHeight="96" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Attach..." Click="OnPickTeamChatAttachmentClick" />
                                    <TextBox Grid.Column="2" Text="{Binding TeamChatAttachmentPath}" IsReadOnly="True"
                                             PlaceholderText="No attachment" />
                                    <Button Grid.Column="3" Classes="primary" Content="Send" Click="OnSendTeamChatClick" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="RemoteBuildsWorkspaceTab" Header="Remote builds">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="0.9*,1.25*" ColumnSpacing="8">
                        <Border Classes="card" Padding="14">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8">
                                <StackPanel>
                                    <TextBlock Text="VPN remote build agent" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Run a locally allowlisted recipe on a CI/build machine without pushing a branch or polluting a Git remote." FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Project ID for agent.json:" FontSize="10" Foreground="#78D7B7" />
                                        <TextBlock Text="{Binding SelectedProject.Id}" FontSize="10" FontFamily="Cascadia Mono,Consolas" />
                                    </StackPanel>
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="Endpoint" VerticalAlignment="Center" Classes="muted" />
                                    <TextBox Grid.Column="1" Text="{Binding RemoteBuildEndpoint}" PlaceholderText="http://10.70.0.10:47841" />
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="Agent token" VerticalAlignment="Center" Classes="muted" />
                                    <TextBox Grid.Column="1" Text="{Binding RemoteBuildAccessToken}" PasswordChar="●" />
                                </Grid>
                                <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="Recipe ID" VerticalAlignment="Center" Classes="muted" />
                                    <TextBox Grid.Column="1" Text="{Binding RemoteBuildRecipeId}" PlaceholderText="unreal-win64-development" />
                                    <TextBlock Grid.Column="2" Text="Source" VerticalAlignment="Center" Classes="muted" />
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding RemoteBuildSourceModes}" SelectedItem="{Binding SelectedRemoteBuildSourceMode}" />
                                </Grid>
                                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding RemoteBuildArtifactDestination}" PlaceholderText="Downloaded artifact directory" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Browse..." Click="OnPickRemoteBuildArtifactsClick" />
                                </Grid>
                                <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10">
                                    <CheckBox Content="Trust plain HTTP only on private/VPN IP" IsChecked="{Binding RemoteBuildAllowPrivateHttp}" />
                                    <TextBlock Text="Max upload (GB)" VerticalAlignment="Center" Classes="muted" />
                                    <TextBox Width="70" Text="{Binding RemoteBuildMaximumUploadGb}" />
                                </StackPanel>
                                <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="secondary" Content="Save" Click="OnSaveRemoteBuildClick" />
                                    <Button Classes="secondary" Content="Test agent" Click="OnTestRemoteBuildClick" />
                                    <Button Classes="primary" Content="Start remote build" Click="OnStartRemoteBuildClick" />
                                    <Button Classes="danger" Content="Cancel" Click="OnCancelRemoteBuildClick" IsEnabled="{Binding IsRemoteBuildRunning}" />
                                </StackPanel>
                                <StackPanel Grid.Row="7" Margin="0,12,0,0" Spacing="6">
                                    <TextBlock Text="Security model" FontWeight="SemiBold" />
                                    <TextBlock Text="• The agent owns agent.json and the executable, arguments, timeout, workspace, and artifact allowlist." FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                    <TextBlock Text="• Existing workspace mode transfers no source; Uploaded snapshot sends tracked and non-ignored files without .git or build caches." FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                    <TextBlock Text="• Bind the agent to its WireGuard IP and never forward port 47841 on the router." FontSize="10" Foreground="#E5A94D" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card" Padding="14">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel>
                                    <TextBlock Text="Build status and live log" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RemoteBuildStatus}" FontSize="11" Foreground="#78D7B7" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Row="1" Margin="0,12,0,0" Text="{Binding RemoteBuildLog}" IsReadOnly="True"
                                         AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="DiscordWorkspaceTab" Header="Agent Discord">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="1.08*,0.92*" ColumnSpacing="8">
                        <Border Classes="card">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Notifications du projet vers Discord" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Le webhook choisit directement le salon cible. Aucun bot Discord complet ni jeton global n'est nécessaire."
                                               TextWrapping="Wrap" FontSize="11" Classes="muted" />

                                    <Grid ColumnDefinitions="180,*" ColumnSpacing="10" Margin="0,5,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Mode d'exécution" FontSize="11" Classes="muted" />
                                            <ComboBox ItemsSource="{Binding DiscordExecutionModes}"
                                                      SelectedItem="{Binding SelectedDiscordExecutionMode}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DiscordConnectionSummary}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   FontSize="11" Foreground="#78D7B7" />
                                    </Grid>

                                    <Border IsVisible="{Binding DiscordUsesAutonomousAgent}"
                                            Background="#1B2237" BorderBrush="#3D4965" BorderThickness="1"
                                            CornerRadius="6" Padding="10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Contrôle de l'agent autonome" FontSize="14" FontWeight="SemiBold" />
                                            <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="8">
                                                <StackPanel>
                                                    <TextBlock Text="Adresse de l'API" FontSize="10.5" Classes="muted" />
                                                    <TextBox Text="{Binding DiscordAgentEndpoint}" PlaceholderText="http://127.0.0.1:47831" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Jeton de contrôle" FontSize="10.5" Classes="muted" />
                                                    <TextBox Text="{Binding DiscordAgentApiToken}" PasswordChar="●"
                                                             PlaceholderText="{Binding DiscordControlTokenHint}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Chemin du dépôt vu par la machine agent" FontSize="10.5" Classes="muted" />
                                            <TextBox Text="{Binding DiscordAgentRepositoryPath}" PlaceholderText="D:\Projects\MonProjet ou /srv/projects/mon-projet" />
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <CheckBox Content="Autoriser HTTP uniquement dans un VPN WireGuard de confiance"
                                                          IsChecked="{Binding DiscordAllowPrivateHttp}"
                                                          VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Classes="secondary" Content="Connecter"
                                                        Click="OnConnectDiscordAgentClick" />
                                                <Button Grid.Column="2" Classes="primary" Content="Lancer l'agent local"
                                                        Click="OnLaunchLocalDiscordAgentClick" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Webhook entrant du salon" FontSize="11" Classes="muted" Margin="0,5,0,0" />
                                    <TextBox Text="{Binding DiscordWebhookUrl}"
                                             PasswordChar="●"
                                             PlaceholderText="{Binding DiscordWebhookHint}" />
                                    <TextBlock Text="L'URL existante n'est jamais réaffichée après son enregistrement."
                                               TextWrapping="Wrap" FontSize="10" Foreground="#78D7B7" />

                                    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Nom affiché" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding DiscordDisplayName}" PlaceholderText="CyRevision" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Nom du projet dans Discord" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding DiscordProjectLabel}" PlaceholderText="Mon projet" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Page web du dépôt (facultatif)" FontSize="11" Classes="muted" />
                                    <TextBox Text="{Binding DiscordRepositoryWebUrl}" PlaceholderText="https://github.com/organisation/projet" />

                                    <Grid ColumnDefinitions="145,*" ColumnSpacing="12">
                                        <StackPanel>
                                            <TextBlock Text="Intervalle (secondes)" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding DiscordPollIntervalSeconds}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="7" Margin="0,2,0,0">
                                            <CheckBox Content="Nouveaux commits groupés" IsChecked="{Binding DiscordNotifyCommits}" />
                                            <CheckBox Content="Changements de branche active" IsChecked="{Binding DiscordNotifyBranchChanges}" />
                                            <CheckBox Content="Démarrer automatiquement avec ce projet" IsChecked="{Binding DiscordStartAutomatically}" />
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Classes="secondary" Content="Enregistrer" Click="OnSaveDiscordAgentClick" Margin="0,3,7,3" />
                                        <Button Classes="secondary" Content="Envoyer un test" Click="OnTestDiscordWebhookClick" Margin="0,3,7,3" />
                                        <Button Classes="danger" Content="Retirer le webhook" Click="OnRemoveDiscordWebhookClick" Margin="0,3,7,3" />
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="État de l'agent" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DiscordAgentState}" FontSize="14" FontWeight="SemiBold" Foreground="#78D7B7" />
                                    <TextBlock Text="{Binding DiscordAgentDetails}" TextWrapping="Wrap" Classes="muted" />
                                    <TextBlock Text="{Binding DiscordLastActivity}" TextWrapping="Wrap" FontSize="11" Foreground="#B8C1D8" />
                                </StackPanel>

                                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,13,0,8">
                                    <Button Classes="primary" Content="Démarrer" Click="OnStartDiscordAgentClick" Margin="0,3,7,3" />
                                    <Button Classes="danger" Content="Arrêter" Click="OnStopDiscordAgentClick" Margin="0,3,7,3" />
                                    <Button Classes="secondary" Content="Vérifier maintenant" Click="OnCheckDiscordAgentClick" Margin="0,3,7,3" />
                                </WrapPanel>

                                <Border Grid.Row="2" Height="1" Background="#393B40" Margin="0,4,0,12" />

                                <StackPanel Grid.Row="3" Spacing="9">
                                    <TextBlock Text="Comportement" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="• Le premier démarrage mémorise HEAD sans publier l'ancien historique." TextWrapping="Wrap" />
                                    <TextBlock Text="• Les commits reçus par Pull, Sync ou créés localement sont détectés." TextWrapping="Wrap" />
                                    <TextBlock Text="• Le point de contrôle avance uniquement après une réponse Discord valide." TextWrapping="Wrap" />
                                    <TextBlock Text="• Les mentions Discord sont toujours désactivées dans les messages automatiques." TextWrapping="Wrap" />
                                    <TextBlock Text="• Active l'agent automatique sur une seule machine par projet pour éviter les doublons." TextWrapping="Wrap" />
                                    <TextBlock Text="• Le mode autonome continue de fonctionner lorsque l'interface CyRevision est fermée." TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Row="4" Background="#151D31" CornerRadius="6" Padding="11" Margin="0,12,0,0">
                                    <TextBlock Text="Les pull requests restent un événement propre à GitHub/GitLab. L'agent CyRevision couvre les mises à jour Git visibles localement, même sans forge centrale."
                                               TextWrapping="Wrap" FontSize="10.5" Foreground="#B8C1D8" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="WorkInProgressWorkspaceTab" Header="Travail en cours">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="1.45*,0.75*" ColumnSpacing="8">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel>
                                    <TextBlock Text="Réservations souples des assets" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Présence informative partagée par CyRevision, sans checkout ni verrou LFS."
                                               FontSize="11" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <DataGrid Grid.Row="1" Margin="0,12,0,0"
                                          ItemsSource="{Binding AdvisoryReservations}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Asset" Binding="{Binding Asset}" Width="1.7*" />
                                        <DataGridTextColumn Header="Personne" Binding="{Binding Owner}" Width="1*" />
                                        <DataGridTextColumn Header="Machine" Binding="{Binding Machine}" Width="1*" />
                                        <DataGridTextColumn Header="Actualisé" Binding="{Binding UpdatedAt}" Width="155" />
                                        <DataGridTextColumn Header="État" Binding="{Binding State}" Width="85" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <StackPanel Spacing="11">
                                <TextBlock Text="Mode non bloquant" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ReservationSummary}" TextWrapping="Wrap" Foreground="#78D7B7" />
                                <Border Height="1" Background="#29324A" Margin="0,4" />
                                <TextBlock Text="• Le fichier reste modifiable par tout le monde." TextWrapping="Wrap" />
                                <TextBlock Text="• Aucun checkout Unreal n'est déclenché." TextWrapping="Wrap" />
                                <TextBlock Text="• Aucun verrou Git LFS n'est créé." TextWrapping="Wrap" />
                                <TextBlock Text="• Le plugin renouvelle automatiquement le signalement pendant le travail." TextWrapping="Wrap" />
                                <TextBlock Text="• Après un crash ou un oubli, le signalement passe automatiquement à Expirée." TextWrapping="Wrap" />
                                <Border Height="1" Background="#29324A" Margin="0,4" />
                                <Button Classes="primary" Content="Actualiser" Click="OnRefreshAdvisoryReservationsClick" HorizontalAlignment="Left" />
                                <Button Classes="secondary" Content="Nettoyer les expirées" Click="OnCleanExpiredAdvisoryReservationsClick" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="AssetDiffWorkspaceTab" Header="Asset preview &amp; diff">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="0.9*,8,1.08*,8,1*">
                        <Border Classes="card" Padding="0" ClipToBounds="True">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="Project files" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AssetExplorerSummary}" FontSize="9" Classes="muted"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="8">
                                    <TextBox Text="{Binding AssetExplorerSearch, UpdateSourceTrigger=PropertyChanged}" Classes="searchBox"
                                             PlaceholderText="Search file name, folder, or extension…" />
                                    <Button Grid.Column="1" Classes="secondary" Content="As reference"
                                            Click="OnUseSelectedAssetAsBaselineClick" />
                                    <Button Grid.Column="2" Classes="secondary" Content="As candidate"
                                            Click="OnUseSelectedAssetAsCandidateClick" />
                                </Grid>
                                <Grid Grid.Row="2">
                                    <ListBox ItemsSource="{Binding AssetExplorerFiles}"
                                             SelectedItem="{Binding SelectedAssetExplorerFile}"
                                             SelectionMode="Single" SelectionChanged="OnAssetExplorerSelectionChanged"
                                             Classes="compactList"
                                             Background="Transparent" BorderThickness="0" Margin="3"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="21" ColumnDefinitions="*,170,66" ColumnSpacing="6"
                                                      ToolTip.Tip="{Binding RelativePath}">
                                                    <TextBlock Text="{Binding Name}" Foreground="#61AFEF" FontWeight="SemiBold"
                                                               FontSize="9.5" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" Margin="5,0,0,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DirectoryPath}" Classes="muted" FontSize="8.5"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="muted"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border IsVisible="{Binding IsAssetExplorerLoading}" VerticalAlignment="Bottom"
                                            Background="#202633" Padding="8,5">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <TextBlock Text="Loading project files…" Classes="muted" />
                                            <ProgressBar Grid.Column="1" Classes="inlineLoader" IsIndeterminate="True" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                      Background="#4B4D52" Cursor="SizeWestEast" />

                        <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                                <StackPanel Margin="10,9,10,0">
                                    <TextBlock Text="Universal file comparison" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Built-in and plugin providers are used everywhere in CyRevision."
                                               FontSize="9.5" Classes="muted" />
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="7" Margin="10,0">
                                    <TextBox Text="{Binding AssetBaselinePath}" IsReadOnly="True" PlaceholderText="Reference file" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="OnPickAssetBaselineClick" />
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7" Margin="10,0">
                                    <TextBox Text="{Binding AssetCandidatePath}" IsReadOnly="True" PlaceholderText="Candidate file" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Browse…" Click="OnPickAssetCandidateClick" />
                                    <Button Grid.Column="2" Classes="primary" Content="Compare" Click="OnCompareAssetsClick" />
                                    <Button Grid.Column="3" Classes="secondary" Content="Git ↔ HEAD" Click="OnCompareSelectedToHeadClick" />
                                </Grid>
                                <TextBox Grid.Row="3" Margin="10,0,10,10" Text="{Binding AssetDiffReport}" IsReadOnly="True"
                                         AcceptsReturn="True" FontFamily="Cascadia Mono,Consolas" FontSize="10.5"
                                         TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <Border Grid.Row="3" IsVisible="{Binding IsAssetExplorerPreviewLoading}"
                                        VerticalAlignment="Bottom" ZIndex="10" Background="#202633" Padding="8,5" Margin="10">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <TextBlock Text="Loading selected file preview…" Classes="muted" />
                                        <ProgressBar Grid.Column="1" Classes="inlineLoader" IsIndeterminate="True" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="3" Width="8" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                      Background="#4B4D52" Cursor="SizeWestEast" />

                        <Border Grid.Column="4" Classes="card" Padding="0" ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,8">
                                    <TextBlock Text="Visual preview / diff" FontSize="14" FontWeight="SemiBold" />
                                </Border>
                                <Border Grid.Row="1" Margin="10" Background="#0B1222" CornerRadius="6" ClipToBounds="True">
                                    <Image Source="{Binding AssetDiffPreview}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Grid.Row="2" Margin="10,0,10,10"
                                           Text="A plugin can register a reader, preview, and diff provider. Once enabled, its formats work in the explorer, Git diffs, history, commits, pull requests, and this workspace."
                                           TextWrapping="Wrap" FontSize="9.5" Classes="muted" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="AiWorkspaceTab" Header="AI Assistant">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="350,6,250,6,*">
                        <Border Classes="card" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="9">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="AI Workspace" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="Optional, project-scoped agent connection" FontSize="10.5" Classes="muted" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#203D50" BorderBrush="#3BAA96" BorderThickness="1"
                                                CornerRadius="4" Padding="7,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IsAiIntegrationEnabled, StringFormat='Enabled: {0}'}"
                                                       FontSize="10" Foreground="#7DE2CC" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding AiStatus}" TextWrapping="Wrap" Foreground="#78D7B7" />
                                    <TextBlock Text="Enable or disable this integration from the Plugins tab. API keys are never saved to disk."
                                               FontSize="10.5" Classes="muted" TextWrapping="Wrap" />
                                    <Border Background="#151E2C" BorderBrush="#35445B" BorderThickness="1"
                                            CornerRadius="5" Padding="10">
                                        <StackPanel Spacing="7">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <StackPanel>
                                                    <TextBlock Text="Local Codex connection" FontWeight="SemiBold" />
                                                    <TextBlock Text="Auto-detected installation and project-scoped App Server"
                                                               FontSize="9.5" Classes="muted" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                    <Button Content="Detect" Click="OnDetectCodexClick"
                                                            IsEnabled="{Binding IsAiIntegrationEnabled}" />
                                                    <Button Classes="primary" Content="{Binding CodexConnectButtonText}"
                                                            Click="OnToggleCodexConnectionClick"
                                                            IsEnabled="{Binding CanConnectCodex}" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Height="3" IsIndeterminate="True"
                                                         IsVisible="{Binding IsCodexChatBusy}" />
                                            <TextBlock Text="{Binding CodexConnectionStatus}" TextWrapping="Wrap"
                                                       Foreground="#78D7B7" FontSize="10.5" />
                                            <Grid ColumnDefinitions="78,*" RowDefinitions="Auto,Auto,Auto"
                                                  ColumnSpacing="7" RowSpacing="3">
                                                <TextBlock Text="Version" Classes="muted" FontSize="9.5" />
                                                <TextBlock Grid.Column="1" Text="{Binding CodexDetectedVersion}"
                                                           FontSize="9.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" Text="Executable" Classes="muted" FontSize="9.5" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CodexDetectedPath}"
                                                           FontSize="9.5" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding CodexDetectedPath}" />
                                                <TextBlock Grid.Row="2" Text="Thread" Classes="muted" FontSize="9.5" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CodexChatThreadId}"
                                                           FontSize="9.5" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <TextBlock Text="CyRevision starts a private local Codex session using the same installed CLI and account. It never attaches to another app's private process pipes."
                                                       FontSize="9.5" Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Height="1" Background="#393B40" />

                                    <TextBlock Text="Provider" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding AiProviders}" SelectedItem="{Binding SelectedAiProvider}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" FontSize="9.5" Classes="muted"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding AiProviderDescription}" FontSize="10.5" Classes="muted" TextWrapping="Wrap" />

                                    <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                        <TextBlock Text="Model" VerticalAlignment="Center" Classes="muted" />
                                        <TextBox Grid.Column="1" Text="{Binding AiModel}" PlaceholderText="Provider default" />
                                        <TextBlock Grid.Row="1" Text="Endpoint" VerticalAlignment="Center" Classes="muted" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AiEndpoint}" PlaceholderText="Responses API endpoint" />
                                        <TextBlock Grid.Row="2" Text="API key" VerticalAlignment="Center" Classes="muted" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AiApiKey}" PasswordChar="●"
                                                 PlaceholderText="Session only" />
                                        <TextBlock Grid.Row="3" Text="Codex CLI" VerticalAlignment="Center" Classes="muted" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AiExecutablePath}"
                                                 PlaceholderText="codex or an absolute executable path" />
                                    </Grid>

                                    <Border Height="1" Background="#393B40" />
                                    <TextBlock Text="Workspace permissions" FontWeight="SemiBold" />
                                    <CheckBox Content="Read repository (required)" IsChecked="True" IsEnabled="False" />
                                    <CheckBox Content="Modify files inside this project" IsChecked="{Binding AiAllowModify}"
                                              IsEnabled="{Binding AiProviderSupportsEdits}" />
                                    <CheckBox Content="Allow network / web search" IsChecked="{Binding AiAllowNetwork}" />
                                    <CheckBox Content="Stage changed files after success" IsChecked="{Binding AiStageAfterRun}"
                                              IsEnabled="{Binding AiAllowModify}" />
                                    <CheckBox Content="Create a Git commit after success" IsChecked="{Binding AiCommitAfterRun}"
                                              IsEnabled="{Binding AiStageAfterRun}" />
                                    <TextBox Text="{Binding AiCommitMessage}" PlaceholderText="Commit message" />
                                    <TextBlock Text="Codex never receives direct permission to push. Stage and commit operations are brokered by CyRevision after a successful run."
                                               FontSize="10.5" Foreground="#F2C66D" TextWrapping="Wrap" />
                                    <Button Content="Run as one-shot provider" Click="OnRunAiAgentClick"
                                            IsEnabled="{Binding IsAiIntegrationEnabled}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns"
                                      Background="#393B40" Cursor="SizeWestEast" />

                        <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                            <Grid RowDefinitions="Auto,Auto,*,Auto">
                                <StackPanel Margin="9,8,9,6" Spacing="2">
                                    <TextBlock Text="Conversations" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Persistent per project" Classes="muted" FontSize="9.5" />
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="5" Margin="7,0,7,7">
                                    <TextBox Text="{Binding NewAiConversationTitle}"
                                             PlaceholderText="Conversation title…" Padding="6,3" />
                                    <Button Grid.Column="1" Classes="primary" Content="+" Width="30"
                                            Click="OnCreateAiConversationClick" ToolTip.Tip="New conversation" />
                                </Grid>
                                <ListBox Grid.Row="2" ItemsSource="{Binding AiConversations}"
                                         SelectedItem="{Binding SelectedAiConversation}"
                                         Classes="compactList" Background="#0B1221" BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="44" Margin="6,1" RowDefinitions="Auto,Auto"
                                                  ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                                                <TextBlock Grid.Row="1" Text="{Binding UpdatedText}" Classes="muted"
                                                           FontSize="8.5" VerticalAlignment="Top" />
                                                <TextBlock Grid.RowSpan="2" Grid.Column="1" Text="WT"
                                                           Foreground="#65D6B5" FontSize="8.5"
                                                           IsVisible="{Binding UseWorktree}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="3" Margin="7" Spacing="5">
                                    <CheckBox Content="Render Markdown" IsChecked="{Binding AiRenderMarkdown}" />
                                    <CheckBox Content="Isolated worktree" IsChecked="{Binding AiConversationUseWorktree}"
                                              ToolTip.Tip="Creates a codex/ai-* branch outside the main working tree on first connection" />
                                    <TextBlock Text="Pre-prompt" Classes="muted" FontSize="9" />
                                    <TextBox Text="{Binding AiConversationPrePrompt}" AcceptsReturn="True"
                                             TextWrapping="Wrap" MinHeight="48" MaxHeight="90"
                                             PlaceholderText="Conversation-specific instructions…" />
                                    <TextBlock Text="{Binding AiConversationWorkspace}" Classes="muted" FontSize="8.5"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AiConversationWorkspace}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                        <Button Content="Save settings" Click="OnSaveAiConversationClick" />
                                        <Button Grid.Column="1" Classes="danger" Content="Delete"
                                                Click="OnDeleteAiConversationClick" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="3" Width="6" ResizeDirection="Columns"
                                      Background="#393B40" Cursor="SizeWestEast" />

                        <Grid Grid.Column="4" RowDefinitions="Auto,*,Auto" RowSpacing="7">
                            <Border Classes="card" Padding="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedAiConversation.Title, FallbackValue='Project Codex chat'}"
                                                   FontSize="16" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding SelectedProject.Name}" Foreground="#65D6B5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedProject.RootPath}" FontSize="10" Classes="muted"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="720" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Cancel turn" Click="OnCancelAiChatClick"
                                            IsEnabled="{Binding IsCodexChatBusy}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
                                <ListBox x:Name="AiChatList" ItemsSource="{Binding AiChatMessages}"
                                         Background="#0B1221" BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding BackgroundColor}" BorderBrush="#2D3A4E"
                                                    BorderThickness="0,0,0,1" Padding="12,9">
                                                <StackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding RoleLabel}" Foreground="{Binding AccentColor}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding TimestampText}" Classes="muted" FontSize="9.5" />
                                                    </StackPanel>
                                                    <controls:MarkdownMessageView Text="{Binding Text}"
                                                                                  RenderMarkdown="{Binding DataContext.AiRenderMarkdown, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <Border Grid.Row="2" Classes="card" Padding="10">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                                    <TextBox x:Name="AiChatInput" Text="{Binding AiPrompt}" AcceptsReturn="True"
                                             TextWrapping="Wrap" MinHeight="72" MaxHeight="190"
                                             PlaceholderText="Ask Codex about this project…"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="Read-only by default · project path is sent at connection · no automatic push"
                                                   FontSize="10" Foreground="#78D7B7" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="primary" Content="Send"
                                                Click="OnSendAiChatClick" IsEnabled="{Binding CanSendAiChat}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="McpWorkspaceTab" Header="MCP">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="7">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Model Context Protocol" FontSize="16" FontWeight="SemiBold" />
                                        <Border Background="#34363A" CornerRadius="4" Padding="7,2">
                                            <TextBlock Text="{Binding AiMcpEmergencyState}" FontSize="9" FontWeight="Bold"
                                                       Foreground="#F2C66D" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding AiMcpStatus}" FontSize="10.5" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Content="Enable MCP for project" IsChecked="{Binding AiMcpEnabled}"
                                          VerticalAlignment="Center" />
                                <CheckBox Grid.Column="2" Content="Block unmanaged Codex servers" IsChecked="{Binding AiMcpBlockUnmanagedServers}"
                                          VerticalAlignment="Center" ToolTip.Tip="Only MCP servers listed here are exposed to the CyRevision agent run" />
                                <Button Grid.Column="3" Classes="secondary" Content="Unblock" Click="OnUnblockAiMcpClick" />
                                <Button Grid.Column="4" Classes="danger" Content="BLOCK ALL MCP" Click="OnEmergencyBlockAiMcpClick"
                                        ToolTip.Tip="Blocks every MCP server and cancels the current CyRevision AI run" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="385,6,*">
                            <Border Classes="card" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Grid Margin="10,9" ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="Project MCP servers" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="Stored locally; never written into the repository" FontSize="9.5" Classes="muted" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="primary" Content="Save policy" Click="OnSaveAiMcpClick" />
                                    </Grid>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding AiMcpServers}" SelectedItem="{Binding SelectedAiMcpServer}"
                                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              Background="Transparent" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Server" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Transport" Binding="{Binding Transport}" Width="100" />
                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="70" />
                                            <DataGridTextColumn Header="Policy" Binding="{Binding PolicySummary}" Width="130" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Grid.Row="2" Margin="8" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="7">
                                        <Button Classes="secondary" Content="+ STDIO" Click="OnAddAiMcpStdioClick" />
                                        <Button Grid.Column="1" Classes="secondary" Content="+ HTTP" Click="OnAddAiMcpHttpClick" />
                                        <Button Grid.Column="3" Classes="danger" Content="Remove" Click="OnRemoveAiMcpClick"
                                                IsEnabled="{Binding HasSelectedAiMcpServer}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns"
                                          Background="#393B40" Cursor="SizeWestEast" />

                            <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="13,10,13,16" Spacing="10" IsEnabled="{Binding HasSelectedAiMcpServer}">
                                        <Grid ColumnDefinitions="*,160,Auto,Auto" ColumnSpacing="8">
                                            <StackPanel>
                                                <TextBlock Text="Server configuration" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="Every server and tool can be independently restricted or blocked."
                                                           FontSize="10" Classes="muted" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AiMcpTransports}"
                                                      SelectedItem="{Binding SelectedAiMcpServer.Transport}" />
                                            <CheckBox Grid.Column="2" Content="Enabled" IsChecked="{Binding SelectedAiMcpServer.Enabled}"
                                                      VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="3" Content="Required" IsChecked="{Binding SelectedAiMcpServer.Required}"
                                                      VerticalAlignment="Center" ToolTip.Tip="Fail the AI run when this enabled server cannot initialize" />
                                        </Grid>

                                        <Grid ColumnDefinitions="90,*,70,*" ColumnSpacing="8">
                                            <TextBlock Text="Name" Classes="muted" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding SelectedAiMcpServer.Name}" />
                                            <TextBlock Grid.Column="2" Text="ID" Classes="muted" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="3" Text="{Binding SelectedAiMcpServer.Id}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="90,180,Auto,*" ColumnSpacing="8">
                                            <TextBlock Text="Capability" Classes="muted" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AiMcpCapabilities}"
                                                      SelectedItem="{Binding SelectedAiMcpServer.Capability}" />
                                            <CheckBox Grid.Column="2" Content="Requires network permission"
                                                      IsChecked="{Binding SelectedAiMcpServer.RequiresNetwork}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="ReadWrite servers are omitted unless workspace modification is authorized."
                                                       FontSize="9.5" Foreground="#F2C66D" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>

                                        <Border Height="1" Background="#393B40" />
                                        <StackPanel Spacing="7" IsVisible="{Binding SelectedAiMcpServer.IsStdio}">
                                            <TextBlock Text="STDIO process" FontWeight="SemiBold" />
                                            <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="7">
                                                <TextBlock Text="Command" Classes="muted" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding SelectedAiMcpServer.Command}"
                                                         PlaceholderText="npx, node, python, or an absolute executable path" />
                                                <TextBlock Grid.Row="1" Text="Arguments" Classes="muted" VerticalAlignment="Top" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAiMcpServer.Arguments}"
                                                         AcceptsReturn="True" Height="68" PlaceholderText="One argument per line" />
                                                <TextBlock Grid.Row="2" Text="Working dir" Classes="muted" VerticalAlignment="Center" />
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAiMcpServer.WorkingDirectory}"
                                                         PlaceholderText="Optional; blank uses the project" />
                                            </Grid>
                                            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="Environment values" FontSize="10" Classes="muted" />
                                                    <TextBox Text="{Binding SelectedAiMcpServer.EnvironmentVariables}" AcceptsReturn="True" Height="68"
                                                             PlaceholderText="NAME=value (stored locally)" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="Forward environment names" FontSize="10" Classes="muted" />
                                                    <TextBox Text="{Binding SelectedAiMcpServer.ForwardEnvironmentVariables}" AcceptsReturn="True" Height="68"
                                                             PlaceholderText="TOKEN_NAME (one per line)" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Spacing="7" IsVisible="{Binding SelectedAiMcpServer.IsHttp}">
                                            <TextBlock Text="Streamable HTTP" FontWeight="SemiBold" />
                                            <TextBlock Text="Responses API: requires network permission, an explicit tool allow list, and environment-based authorization. OAuth sessions and custom headers apply to local Codex only."
                                                       FontSize="9.5" Foreground="#F2C66D" TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="105,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="7">
                                                <TextBlock Text="Server URL" Classes="muted" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding SelectedAiMcpServer.Url}" PlaceholderText="https://server.example/mcp" />
                                                <TextBlock Grid.Row="1" Text="Authentication" Classes="muted" VerticalAlignment="Center" />
                                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="150,*" ColumnSpacing="8">
                                                    <ComboBox ItemsSource="{Binding AiMcpHttpAuthModes}"
                                                              SelectedItem="{Binding SelectedAiMcpServer.HttpAuth}" />
                                                    <TextBox Grid.Column="1" Text="{Binding SelectedAiMcpServer.BearerTokenEnvironmentVariable}"
                                                             PlaceholderText="Bearer-token environment variable" />
                                                </Grid>
                                                <TextBlock Grid.Row="2" Text="OAuth" Classes="muted" VerticalAlignment="Center" />
                                                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                                    <TextBox Text="{Binding SelectedAiMcpServer.OAuthScopes}" PlaceholderText="Scopes, comma separated" />
                                                    <TextBox Grid.Column="1" Text="{Binding SelectedAiMcpServer.OAuthResource}" PlaceholderText="OAuth resource (optional)" />
                                                </Grid>
                                            </Grid>
                                            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="Static HTTP headers" FontSize="10" Classes="muted" />
                                                    <TextBox Text="{Binding SelectedAiMcpServer.HttpHeaders}" AcceptsReturn="True" Height="68"
                                                             PlaceholderText="Header=value (stored locally)" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="Headers from environment" FontSize="10" Classes="muted" />
                                                    <TextBox Text="{Binding SelectedAiMcpServer.EnvironmentHttpHeaders}" AcceptsReturn="True" Height="68"
                                                             PlaceholderText="Header=ENV_VARIABLE" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <Border Height="1" Background="#393B40" />
                                        <TextBlock Text="Tool policy" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Enabled tools (allow list)" FontSize="10" Classes="muted" />
                                                <TextBox Text="{Binding SelectedAiMcpServer.EnabledTools}" AcceptsReturn="True" Height="74"
                                                         PlaceholderText="Local: blank allows all. API: list at least one tool." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="Disabled tools (deny list wins)" FontSize="10" Classes="muted" />
                                                <TextBox Text="{Binding SelectedAiMcpServer.DisabledTools}" AcceptsReturn="True" Height="74"
                                                         PlaceholderText="One blocked tool per line" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="150,*,100,90,100,90" ColumnSpacing="8">
                                            <ComboBox ItemsSource="{Binding AiMcpApprovalModes}"
                                                      SelectedItem="{Binding SelectedAiMcpServer.ApprovalMode}" />
                                            <TextBlock Grid.Column="1" Text="Default approval: Prompt/Writes remain blocked in non-interactive runs unless explicitly approved by policy."
                                                       FontSize="9.5" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Startup (s)" Classes="muted" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="3" Text="{Binding SelectedAiMcpServer.StartupTimeoutSeconds}" />
                                            <TextBlock Grid.Column="4" Text="Tool (s)" Classes="muted" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="5" Text="{Binding SelectedAiMcpServer.ToolTimeoutSeconds}" />
                                        </Grid>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Per-tool approval overrides" FontSize="10" Classes="muted" />
                                            <TextBox Text="{Binding SelectedAiMcpServer.ToolApprovalOverrides}" AcceptsReturn="True" Height="62"
                                                     PlaceholderText="tool_name=approve | prompt | writes | auto" />
                                        </StackPanel>
                                        <Border Background="#2B2520" BorderBrush="#6D5731" BorderThickness="1" CornerRadius="4" Padding="9,6">
                                            <TextBlock Text="Security: prefer environment-variable references for tokens. Static environment values and headers are saved in the local CyRevision profile, never in Git."
                                                       FontSize="10" Foreground="#F2C66D" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="PluginsWorkspaceTab" Header="Plugins">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="0.85*,1.4*" ColumnSpacing="8">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="CyRevision plugins" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Plugin activation is saved separately for the selected project."
                                               Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding Plugins}"
                                          SelectedItem="{Binding SelectedPlugin}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="Horizontal"
                                          Background="Transparent"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Plugin" Binding="{Binding Name}" Width="1.4*" />
                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="75" />
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="105" />
                                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="105" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary" Content="Enable"
                                            IsEnabled="{Binding CanEnableSelectedPlugin}"
                                            Click="OnEnablePluginClick" />
                                    <Button Classes="secondary" Content="Disable"
                                            IsEnabled="{Binding CanDisableSelectedPlugin}"
                                            Click="OnDisablePluginClick" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8">
                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding SelectedPlugin.Name, FallbackValue='Select a plugin'}"
                                                           FontSize="18" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding SelectedPlugin.Category}" Foreground="#78D7B7" />
                                                    <TextBlock Text="{Binding SelectedPlugin.Version, StringFormat='Version {0}'}"
                                                               Classes="muted" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#203D50" BorderBrush="#3BAA96"
                                                    BorderThickness="1" CornerRadius="4" Padding="8,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedPlugin.State}"
                                                           Foreground="#7DE2CC" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <Border Height="1" Background="#393B40" />
                                        <TextBlock Text="{Binding SelectedPlugin.Description}"
                                                   TextWrapping="Wrap" FontSize="12" />
                                        <TextBlock Text="Select another plugin on the left to inspect its own capabilities and configuration."
                                                   Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="8" IsVisible="{Binding IsSelectedUnrealPlugin}">
                                <Border Classes="card">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Unreal Engine Integration" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock Text="Optional CyRevision plugin · autonomous Unreal Editor companion included"
                                                           Classes="muted" FontSize="11" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#203D50" BorderBrush="#3BAA96"
                                                    BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                <TextBlock Text="{Binding IsUnrealIntegrationEnabled, StringFormat='Enabled: {0}'}"
                                                           Foreground="#7DE2CC" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>

                                        <Border Height="1" Background="#393B40" />
                                        <TextBlock Text="Unreal project" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Text="{Binding UnrealProjectPath}" IsReadOnly="True"
                                                     PlaceholderText="Select a .uproject file…" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Choose project…"
                                                    Click="OnPickUnrealProjectClick" />
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,Auto,24,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Text="Bundled" Classes="muted" />
                                            <TextBlock Grid.Column="1" Text="{Binding UnrealEditorPluginVersion}"
                                                       Foreground="#78D7B7" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="Installed" Classes="muted" />
                                            <TextBlock Grid.Column="4" Text="{Binding UnrealInstalledPluginVersion}"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,24,Auto,Auto,24,Auto,Auto" ColumnSpacing="7">
                                            <TextBlock Text="Engine" Classes="muted" />
                                            <TextBlock Grid.Column="1" Text="{Binding UnrealEngineVersion}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="Project" Classes="muted" />
                                            <TextBlock Grid.Column="4" Text="{Binding UnrealProjectKindSummary}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="6" Text="Install" Classes="muted" />
                                            <TextBlock Grid.Column="7" Text="{Binding UnrealInstallModeSummary}" FontWeight="SemiBold" />
                                        </Grid>
                                        <Border Background="#111820" BorderBrush="#394655" BorderThickness="1"
                                                CornerRadius="4" Padding="9">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding UnrealCompatibilityStatus}" TextWrapping="Wrap"
                                                           Foreground="#78D7B7" FontWeight="SemiBold"
                                                           IsVisible="{Binding IsUnrealPluginCompatible}" />
                                                <TextBlock Text="{Binding UnrealCompatibilityStatus}" TextWrapping="Wrap"
                                                           Foreground="#FF8A8A" FontWeight="SemiBold"
                                                           IsVisible="{Binding !IsUnrealPluginCompatible}" />
                                                <TextBlock Text="{Binding UnrealSupportedVersions}" TextWrapping="Wrap"
                                                           Classes="muted" FontSize="10" />
                                                <TextBlock Text="{Binding UnrealPrecompiledVersions}" TextWrapping="Wrap"
                                                           Classes="muted" FontSize="10" />
                                                <TextBlock Text="C++ projects use the portable source plugin. Blueprint-only projects require an exact precompiled package for the engine and operating system."
                                                           Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding UnrealPluginSummary}" TextWrapping="Wrap" />

                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="primary" Content="Install / update in project"
                                                    IsEnabled="{Binding CanInstallUnrealEditorPlugin}"
                                                    Click="OnInstallUnrealPluginClick" Margin="0,3,8,3" />
                                            <Button Classes="secondary" Content="Configure direct connection"
                                                    IsEnabled="{Binding CanInstallUnrealEditorPlugin}"
                                                    Click="OnConfigureUnrealBridgeClick" Margin="0,3,8,3" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Private CyRevision bridge" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding UnrealBridgeSummary}" TextWrapping="Wrap" Foreground="#78D7B7" />
                                        <TextBlock Text="The bridge listens on loopback only. Each Unreal project receives a random token under Saved/CyRevision; the token is not added to Git."
                                                   Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                        <TextBlock Text="CyRevisionUnreal remains useful without CyRevision: its revision dashboard, Git actions, and advisory reservations work independently. Connecting unlocks application refresh and the extended Git/LFS/Sync/backup workflow."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <Border Classes="card" IsVisible="{Binding IsSelectedAiPlugin}">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="AI Workspace configuration" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Open Code &amp; Assets > AI Assistant to manage providers, persistent conversations, Markdown rendering, permissions, pre-prompts, and isolated worktrees."
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="The plugin is optional. Conversation history remains project-scoped under .cyrevision and is ignored by Git."
                                                   Classes="muted" FontSize="10.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="card" IsVisible="{Binding IsSelectedLorePlugin}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Lore Project Management" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Experimental integration for Epic Games Lore 0.x. Lore remains an external CLI and centralized server; this plugin does not replace it or silently initialize a workspace."
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Open Extensions &amp; Help > Lore to detect the CLI, inspect .lore/config.toml, read status and branches, explicitly scan the workspace, and install the CyRevision Unreal companion."
                                                   Classes="muted" FontSize="10.5" TextWrapping="Wrap" />
                                        <Border Background="#2B2520" BorderBrush="#6D5731" BorderThickness="1" CornerRadius="4" Padding="9">
                                            <TextBlock Text="The bundled Unreal companion is a CyRevision experimental bridge. It is not Epic's future official Unreal Lore source-control provider."
                                                       Foreground="#F2C66D" FontSize="10" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card" IsVisible="{Binding IsSelectedPerforcePlugin}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Perforce Helix Core" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Project-scoped integration using the official p4 CLI: connection validation, opened files, changelists, file history, reconcile, sync, revert and submit."
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Passwords and P4 tickets are never stored by CyRevision. Workspace writes remain disabled until you explicitly enable them after validating P4PORT, P4USER and P4CLIENT."
                                                   Classes="muted" FontSize="10.5" TextWrapping="Wrap" />
                                        <Border Background="#2B2520" BorderBrush="#6D5731" BorderThickness="1" CornerRadius="4" Padding="9">
                                            <TextBlock Text="Perforce is a separate version-control mode. Enabling this plugin does not convert, initialize, or modify the selected project automatically."
                                                       Foreground="#F2C66D" FontSize="10" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem x:Name="UnityWorkspaceTab" Header="Unity">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="8">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Unity Integration" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Optional CyRevision plugin · autonomous Unity Editor package included"
                                               Classes="muted" FontSize="10" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#203D50" BorderBrush="#3BAA96"
                                        BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IsUnityIntegrationEnabled, StringFormat='Plugin enabled: {0}'}"
                                               Foreground="#7DE2CC" FontSize="10" />
                                </Border>
                                <Border Grid.Column="2" Background="#3C3523" BorderBrush="#8A7436"
                                        BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IsUnityProjectDetected, StringFormat='Project detected: {0}'}"
                                               Foreground="#F2C66D" FontSize="10" />
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="1.05*,7,0.95*">
                            <Border Classes="card">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Project companion" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="CyRevision auto-detects Assets and ProjectSettings/ProjectVersion.txt in the selected project."
                                               Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <TextBox Text="{Binding UnityProjectPath}" IsReadOnly="True"
                                                 PlaceholderText="No Unity project detected" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Choose project…"
                                                Click="OnPickUnityProjectClick" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,Auto,22,Auto,Auto,22,Auto,Auto" ColumnSpacing="6">
                                        <TextBlock Text="Engine" Classes="muted" />
                                        <TextBlock Grid.Column="1" Text="{Binding UnityEngineVersion}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="Bundled" Classes="muted" />
                                        <TextBlock Grid.Column="4" Text="{Binding UnityBundledPluginVersion}" Foreground="#78D7B7" />
                                        <TextBlock Grid.Column="6" Text="Installed" Classes="muted" />
                                        <TextBlock Grid.Column="7" Text="{Binding UnityInstalledPluginVersion}" />
                                    </Grid>
                                    <Border Background="#111820" BorderBrush="#394655" BorderThickness="1" CornerRadius="4" Padding="9">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding UnityCompatibilityStatus}" TextWrapping="Wrap" Foreground="#78D7B7" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding UnitySupportedVersions}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding UnityPluginSummary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="primary" Content="Install / update Unity package"
                                                IsEnabled="{Binding CanInstallUnityEditorPlugin}"
                                                Click="OnInstallUnityPluginClick" Margin="0,3,7,3" />
                                        <Button Classes="secondary" Content="Configure direct connection"
                                                IsEnabled="{Binding CanInstallUnityEditorPlugin}"
                                                Click="OnConfigureUnityBridgeClick" Margin="0,3,7,3" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <GridSplitter Grid.Column="1" Width="7" Background="#45484E"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                            <Border Grid.Column="2" Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Private Editor bridge" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UnityBridgeSummary}" Foreground="#78D7B7" TextWrapping="Wrap" />
                                    <Border Height="1" Background="#45484E" />
                                    <TextBlock Text="• Separate loopback-only port and random per-project token." TextWrapping="Wrap" />
                                    <TextBlock Text="• The embedded Unity package can open CyRevision and notify project saves." TextWrapping="Wrap" />
                                    <TextBlock Text="• Existing packages are backed up under Library/CyRevision before updates." TextWrapping="Wrap" />
                                    <Border Background="#2B2520" BorderBrush="#6D5731" BorderThickness="1" CornerRadius="4" Padding="9">
                                        <TextBlock Text="Unity asset preview and diff providers are intentionally not included in this first integration. Standard text and image support remains available."
                                                   Foreground="#F2C66D" FontSize="10" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="GodotWorkspaceTab" Header="Godot">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="8">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Godot Integration" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Optional CyRevision plugin · autonomous Godot 4 Editor dock included"
                                               Classes="muted" FontSize="10" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#203D50" BorderBrush="#3BAA96"
                                        BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IsGodotIntegrationEnabled, StringFormat='Plugin enabled: {0}'}"
                                               Foreground="#7DE2CC" FontSize="10" />
                                </Border>
                                <Border Grid.Column="2" Background="#3C3523" BorderBrush="#8A7436"
                                        BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IsGodotProjectDetected, StringFormat='Project detected: {0}'}"
                                               Foreground="#F2C66D" FontSize="10" />
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="1.05*,7,0.95*">
                            <Border Classes="card">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Project companion" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="CyRevision auto-detects project.godot in the selected project."
                                               Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <TextBox Text="{Binding GodotProjectPath}" IsReadOnly="True"
                                                 PlaceholderText="No Godot project detected" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Choose project…"
                                                Click="OnPickGodotProjectClick" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,Auto,22,Auto,Auto,22,Auto,Auto" ColumnSpacing="6">
                                        <TextBlock Text="Engine" Classes="muted" />
                                        <TextBlock Grid.Column="1" Text="{Binding GodotEngineVersion}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="Bundled" Classes="muted" />
                                        <TextBlock Grid.Column="4" Text="{Binding GodotBundledPluginVersion}" Foreground="#78D7B7" />
                                        <TextBlock Grid.Column="6" Text="Installed" Classes="muted" />
                                        <TextBlock Grid.Column="7" Text="{Binding GodotInstalledPluginVersion}" />
                                    </Grid>
                                    <Border Background="#111820" BorderBrush="#394655" BorderThickness="1" CornerRadius="4" Padding="9">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding GodotCompatibilityStatus}" TextWrapping="Wrap" Foreground="#78D7B7" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding GodotSupportedVersions}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding GodotPluginSummary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="primary" Content="Install / update Godot addon"
                                                IsEnabled="{Binding CanInstallGodotEditorPlugin}"
                                                Click="OnInstallGodotPluginClick" Margin="0,3,7,3" />
                                        <Button Classes="secondary" Content="Configure direct connection"
                                                IsEnabled="{Binding CanInstallGodotEditorPlugin}"
                                                Click="OnConfigureGodotBridgeClick" Margin="0,3,7,3" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <GridSplitter Grid.Column="1" Width="7" Background="#45484E"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                            <Border Grid.Column="2" Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Private Editor bridge" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding GodotBridgeSummary}" Foreground="#78D7B7" TextWrapping="Wrap" />
                                    <Border Height="1" Background="#45484E" />
                                    <TextBlock Text="• Separate loopback-only port and random per-project token." TextWrapping="Wrap" />
                                    <TextBlock Text="• The Godot 4 dock can open CyRevision and notify project changes." TextWrapping="Wrap" />
                                    <TextBlock Text="• Existing addons and project.godot are backed up before an update." TextWrapping="Wrap" />
                                    <Border Background="#2B2520" BorderBrush="#6D5731" BorderThickness="1" CornerRadius="4" Padding="9">
                                        <TextBlock Text="Godot asset preview and diff providers are intentionally not included in this first integration. Standard text and image support remains available."
                                                   Foreground="#F2C66D" FontSize="10" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="LoreWorkspaceTab" Header="Lore">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="8">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Lore Project Management" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Optional CyRevision plugin · Epic Games Lore CLI/server remains an external dependency"
                                               Classes="muted" FontSize="10" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#203D50" BorderBrush="#3BAA96"
                                        BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IsLoreIntegrationEnabled, StringFormat='Plugin enabled: {0}'}"
                                               Foreground="#7DE2CC" FontSize="10" />
                                </Border>
                                <Border Grid.Column="2" Background="#3C3523" BorderBrush="#8A7436"
                                        BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="EXPERIMENTAL · Lore 0.x" Foreground="#F2C66D" FontSize="10" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="1.05*,7,0.95*">
                            <Border Classes="card">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="9">
                                        <TextBlock Text="CLI and workspace" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="CyRevision reads an existing .lore/config.toml. It never creates a Lore repository automatically."
                                                   Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                            <TextBox Text="{Binding LoreProjectPath}" IsReadOnly="True"
                                                     PlaceholderText="No project selected" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Choose project…"
                                                    Click="OnPickLoreProjectClick" />
                                        </Grid>
                                        <Border Background="#111820" BorderBrush="#394655" BorderThickness="1" CornerRadius="4" Padding="9">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding LoreProjectSummary}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding LoreRepositorySummary}" Foreground="#78D7B7" FontSize="10" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                            <TextBox Text="{Binding LoreCliPath}" PlaceholderText="lore executable or PATH command" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Detect CLI"
                                                    IsEnabled="{Binding !IsLoreBusy}" Click="OnDetectLoreCliClick" />
                                        </Grid>
                                        <TextBlock Text="{Binding LoreCliSummary}" Classes="muted" FontSize="10" TextWrapping="Wrap" />

                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="primary" Content="Refresh status"
                                                    IsEnabled="{Binding CanReadLore}" Click="OnReadLoreStatusClick" Margin="0,2,7,2" />
                                            <Button Classes="secondary" Content="Scan working tree…"
                                                    IsEnabled="{Binding CanReadLore}" Click="OnScanLoreStatusClick" Margin="0,2,7,2" />
                                            <Button Classes="secondary" Content="Load branches"
                                                    IsEnabled="{Binding CanReadLore}" Click="OnListLoreBranchesClick" Margin="0,2,7,2" />
                                        </WrapPanel>
                                        <TextBlock Text="Refresh status calls lore status without --scan. Scan working tree is separate because Lore persists refreshed dirty flags."
                                                   Classes="muted" FontSize="9.5" TextWrapping="Wrap" />

                                        <TextBlock Text="Status output" FontWeight="SemiBold" />
                                        <Border Background="#081124" BorderBrush="#243757" BorderThickness="1" CornerRadius="4" Padding="8" MinHeight="150">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding LoreStatusOutput}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="10" TextWrapping="NoWrap" />
                                            </ScrollViewer>
                                        </Border>
                                        <Border Height="1" Background="#45484E" />
                                        <TextBlock Text="Explicit Lore actions" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Nothing below runs automatically. Paths are passed as one CLI argument without a shell."
                                                   Classes="muted" FontSize="9.5" TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                            <TextBox Text="{Binding LoreStagePath}" PlaceholderText="Project-relative file, folder, or Lore glob" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Stage"
                                                    IsEnabled="{Binding CanReadLore}" Click="OnStageLorePathClick" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                            <TextBox Text="{Binding LoreCommitMessage}" PlaceholderText="Lore commit message" />
                                            <Button Grid.Column="1" Classes="primary" Content="Commit"
                                                    IsEnabled="{Binding CanReadLore}" Click="OnCommitLoreClick" />
                                        </Grid>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="secondary" Content="Sync"
                                                    IsEnabled="{Binding CanReadLore}" Click="OnSyncLoreClick" Margin="0,2,7,2" />
                                            <Button Classes="primary" Content="Push…"
                                                    IsEnabled="{Binding CanReadLore}" Click="OnPushLoreClick" Margin="0,2,7,2" />
                                        </WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <GridSplitter Grid.Column="1" Width="7" Background="#45484E"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

                            <Border Grid.Column="2" Classes="card">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="9">
                                        <TextBlock Text="Branches" FontSize="15" FontWeight="SemiBold" />
                                        <Border Background="#081124" BorderBrush="#243757" BorderThickness="1" CornerRadius="4" Padding="8" MinHeight="150">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding LoreBranchesOutput}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="10" TextWrapping="NoWrap" />
                                            </ScrollViewer>
                                        </Border>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
                                            <TextBox Text="{Binding LoreNewBranchName}" PlaceholderText="Branch name" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Create"
                                                    IsEnabled="{Binding CanReadLore}" Click="OnCreateLoreBranchClick" />
                                            <Button Grid.Column="2" Classes="secondary" Content="Switch"
                                                    IsEnabled="{Binding CanReadLore}" Click="OnSwitchLoreBranchClick" />
                                        </Grid>

                                        <Border Height="1" Background="#45484E" />
                                        <TextBlock Text="Unreal companion" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding IsLoreUnrealProjectDetected, StringFormat='Unreal project detected: {0}'}" />
                                        <TextBlock Text="{Binding IsLoreUnrealCompanionInstalled, StringFormat='Companion installed: {0}'}" />
                                        <TextBlock Text="{Binding LoreUnrealCompanionVersion, StringFormat='Installed version: {0}'}" Classes="muted" />
                                        <Button Classes="primary" Content="Install / update Unreal companion"
                                                HorizontalAlignment="Left"
                                                IsEnabled="{Binding CanInstallLoreUnrealCompanion}"
                                                Click="OnInstallLoreUnrealCompanionClick" />
                                        <Border Background="#2B2520" BorderBrush="#6D5731" BorderThickness="1" CornerRadius="4" Padding="9">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="Important" Foreground="#F2C66D" FontWeight="SemiBold" />
                                                <TextBlock Text="This source-only CyRevision companion detects the Lore workspace inside Unreal and links back to CyRevision. It is not Epic's official Lore Source Control provider."
                                                           Foreground="#F2C66D" FontSize="10" TextWrapping="Wrap" />
                                                <TextBlock Text="Epic's public roadmap currently targets the native open-source Unreal Editor provider separately."
                                                           Classes="muted" FontSize="9.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Lore uses a centralized server of record with offline local operations. It is a distinct project-management backend, not a decentralized Git/Syncthing replacement."
                                                   Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="PerforceWorkspaceTab" Header="Perforce">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="8">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Perforce Helix Core" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Optional project plugin · official p4 CLI · no credentials stored"
                                               Classes="muted" FontSize="10" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#203D50" BorderBrush="#3BAA96"
                                        BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IsPerforceIntegrationEnabled, StringFormat='Plugin enabled: {0}'}"
                                               Foreground="#7DE2CC" FontSize="10" />
                                </Border>
                                <Border Grid.Column="2" Background="#2B2520" BorderBrush="#6D5731"
                                        BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IsPerforceConnectionValidated, StringFormat='Validated: {0}'}"
                                               Foreground="#F2C66D" FontSize="10" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" RowDefinitions="Auto,*,7,190" RowSpacing="7">
                            <Border Classes="card" Padding="10">
                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="1.05*,1.1*,0.75*,0.9*,Auto,Auto" ColumnSpacing="7">
                                        <TextBox Text="{Binding PerforceCliPath}" PlaceholderText="p4 or full path to p4.exe" />
                                        <TextBox Grid.Column="1" Text="{Binding PerforceServer}" PlaceholderText="P4PORT · ssl:server:1666" />
                                        <TextBox Grid.Column="2" Text="{Binding PerforceUser}" PlaceholderText="P4USER" />
                                        <TextBox Grid.Column="3" Text="{Binding PerforceWorkspace}" PlaceholderText="P4CLIENT" />
                                        <Button Grid.Column="4" Classes="secondary" Content="Detect CLI"
                                                IsEnabled="{Binding !IsPerforceBusy}" Click="OnDetectPerforceCliClick" />
                                        <Button Grid.Column="5" Classes="primary" Content="Save"
                                                IsEnabled="{Binding CanReadPerforce}" Click="OnSavePerforceConfigurationClick" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding PerforceCliSummary}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PerforceConnectionSummary}" Foreground="#78D7B7" FontSize="10" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Content="Include other workspaces"
                                                  IsChecked="{Binding PerforceIncludeOtherWorkspaces}" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="2" Content="Enable workspace writes"
                                                  IsChecked="{Binding PerforceWriteOperationsEnabled}" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Classes="primary" Content="Validate &amp; refresh"
                                                IsEnabled="{Binding CanReadPerforce}" Click="OnRefreshPerforceClick" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1" ColumnDefinitions="1.15*,7,0.85*">
                                <Border Classes="card" Padding="9">
                                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Opened files" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="Your workspace and optional team workspaces" Classes="muted" FontSize="9.5" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding PerforceOpenedFiles.Count, StringFormat='{}{0} file(s)'}"
                                                       Foreground="#78D7B7" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBox Grid.Row="1" Text="{Binding PerforceOpenedSearch}"
                                                 PlaceholderText="Search file, action, user, workspace or changelist…" />
                                        <DataGrid Grid.Row="2" Classes="historyCompact" ItemsSource="{Binding PerforceOpenedFiles}"
                                                  SelectedItem="{Binding SelectedPerforceOpenedFile}"
                                                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="File" Binding="{Binding LocalPath}" Width="2*" />
                                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="80" />
                                                <DataGridTextColumn Header="CL" Binding="{Binding Change}" Width="70" />
                                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="100" />
                                                <DataGridTextColumn Header="Workspace" Binding="{Binding Workspace}" Width="120" />
                                                <DataGridCheckBoxColumn Header="Other" Binding="{Binding IsLockedByOther}" Width="55" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <WrapPanel Grid.Row="3" Orientation="Horizontal">
                                            <Button Classes="secondary" Content="File history" IsEnabled="{Binding SelectedPerforceOpenedFile}"
                                                    Click="OnLoadPerforceFileHistoryClick" Margin="0,2,7,2" />
                                            <Button Classes="secondary" Content="Revert unchanged" IsEnabled="{Binding CanWritePerforce}"
                                                    Click="OnRevertUnchangedPerforceFileClick" Margin="0,2,7,2" />
                                            <Button Classes="danger" Content="Revert selected…" IsEnabled="{Binding CanWritePerforce}"
                                                    Click="OnRevertPerforceFileClick" Margin="0,2,7,2" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <GridSplitter Grid.Column="1" Width="7" Background="#45484E"
                                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

                                <Border Grid.Column="2" Classes="card" Padding="9">
                                    <Grid RowDefinitions="Auto,*,Auto,*,Auto" RowSpacing="6">
                                        <TextBlock Text="Pending changelists" FontSize="15" FontWeight="SemiBold" />
                                        <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding PerforcePendingChangelists}"
                                                  SelectedItem="{Binding SelectedPerforceChangelist}"
                                                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="CL" Binding="{Binding Number}" Width="70" />
                                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="90" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Grid.Row="2" Text="Recently submitted" FontWeight="SemiBold" />
                                        <DataGrid Grid.Row="3" Classes="historyCompact" ItemsSource="{Binding PerforceSubmittedChangelists}"
                                                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="CL" Binding="{Binding Number}" Width="70" />
                                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="90" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                                            <CheckBox Content="Submit default" IsChecked="{Binding PerforceSubmitDefaultChangelist}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding PerforceSubmitDescription}"
                                                     PlaceholderText="Description required for the default changelist" />
                                            <Button Grid.Column="2" Classes="primary" Content="Submit…"
                                                    IsEnabled="{Binding CanSubmitPerforce}" Click="OnSubmitPerforceClick" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <GridSplitter Grid.Row="2" Height="7" Background="#45484E"
                                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

                            <Grid Grid.Row="3" ColumnDefinitions="1.1*,7,0.9*">
                                <Border Classes="card" Padding="9">
                                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="7">
                                            <TextBlock Text="Explicit workspace actions" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Reconcile preview"
                                                    IsEnabled="{Binding CanReadPerforce}" Click="OnPreviewPerforceReconcileClick" />
                                            <Button Grid.Column="2" Classes="primary" Content="Apply reconcile…"
                                                    IsEnabled="{Binding CanWritePerforce}" Click="OnApplyPerforceReconcileClick" />
                                            <Button Grid.Column="3" Classes="secondary" Content="Sync preview"
                                                    IsEnabled="{Binding CanReadPerforce}" Click="OnPreviewPerforceSyncClick" />
                                            <Button Grid.Column="4" Classes="primary" Content="Sync workspace…"
                                                    IsEnabled="{Binding CanWritePerforce}" Click="OnApplyPerforceSyncClick" />
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                            <TextBox Text="{Binding PerforcePath}" PlaceholderText="Project-relative file to open for edit" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Open for edit"
                                                    IsEnabled="{Binding CanWritePerforce}" Click="OnOpenPerforcePathForEditClick" />
                                        </Grid>
                                        <Border Grid.Row="2" Background="#081124" BorderBrush="#243757" BorderThickness="1" CornerRadius="4" Padding="7">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding PerforceCommandOutput}" FontFamily="Cascadia Mono,Consolas,monospace"
                                                           FontSize="10" TextWrapping="NoWrap" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Border>
                                <GridSplitter Grid.Column="1" Width="7" Background="#45484E"
                                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                                <Border Grid.Column="2" Classes="card" Padding="9">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="5">
                                        <TextBlock Text="Selected file history" FontSize="14" FontWeight="SemiBold" />
                                        <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding PerforceFileHistory}"
                                                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Rev" Binding="{Binding Revision}" Width="55" />
                                                <DataGridTextColumn Header="CL" Binding="{Binding Changelist}" Width="65" />
                                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="70" />
                                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="85" />
                                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="UnrealWorkspaceTab" Header="Unreal">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*" RowSpacing="8">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Unreal Engine Integration" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="CyRevision plugin workspace · the Unreal Editor companion remains autonomous"
                                               Classes="muted" FontSize="10" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#203D50" BorderBrush="#3BAA96"
                                        BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IsUnrealIntegrationEnabled, StringFormat='Plugin enabled: {0}'}"
                                               Foreground="#7DE2CC" FontSize="10" />
                                </Border>
                                <Border Grid.Column="2" Background="#3C3523" BorderBrush="#8A7436"
                                        BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IsUnrealProjectDetected, StringFormat='Project detected: {0}'}"
                                               Foreground="#F2C66D" FontSize="10" />
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="1.05*,7,0.95*">
                            <Border Classes="card">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="9">
                                        <TextBlock Text="Project companion" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="CyRevision checks the selected project root for a .uproject. You can also select another Unreal project manually."
                                                   Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                            <TextBox Text="{Binding UnrealProjectPath}" IsReadOnly="True"
                                                     PlaceholderText="No Unreal project detected" />
                                            <Button Grid.Column="1" Classes="secondary" Content="Choose .uproject…"
                                                    Click="OnPickUnrealProjectClick" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,28,Auto,Auto" ColumnSpacing="7">
                                            <TextBlock Text="Bundled" Classes="muted" />
                                            <TextBlock Grid.Column="1" Text="{Binding UnrealEditorPluginVersion}"
                                                       Foreground="#78D7B7" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="Installed" Classes="muted" />
                                            <TextBlock Grid.Column="4" Text="{Binding UnrealInstalledPluginVersion}"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,22,Auto,Auto,22,Auto,Auto" ColumnSpacing="6">
                                            <TextBlock Text="Engine" Classes="muted" FontSize="10" />
                                            <TextBlock Grid.Column="1" Text="{Binding UnrealEngineVersion}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="Project" Classes="muted" FontSize="10" />
                                            <TextBlock Grid.Column="4" Text="{Binding UnrealProjectKindSummary}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="6" Text="Mode" Classes="muted" FontSize="10" />
                                            <TextBlock Grid.Column="7" Text="{Binding UnrealInstallModeSummary}" FontWeight="SemiBold" />
                                        </Grid>
                                        <Border Background="#10241F" BorderBrush="#2F6D5D" BorderThickness="1"
                                                CornerRadius="4" Padding="9">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding UnrealCompatibilityStatus}" Foreground="#78D7B7"
                                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                                           IsVisible="{Binding IsUnrealPluginCompatible}" />
                                                <TextBlock Text="{Binding UnrealCompatibilityStatus}" Foreground="#FF8A8A"
                                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                                           IsVisible="{Binding !IsUnrealPluginCompatible}" />
                                                <TextBlock Text="{Binding UnrealSupportedVersions}" Classes="muted"
                                                           FontSize="9.5" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding UnrealPrecompiledVersions}" Classes="muted"
                                                           FontSize="9.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#111820" BorderBrush="#394655" BorderThickness="1"
                                                CornerRadius="4" Padding="9">
                                            <TextBlock Text="{Binding UnrealPluginSummary}" TextWrapping="Wrap" />
                                        </Border>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="primary" Content="Install / update Unreal plugin"
                                                    IsEnabled="{Binding CanInstallUnrealEditorPlugin}"
                                                    Click="OnInstallUnrealPluginClick" Margin="0,3,7,3" />
                                            <Button Classes="secondary" Content="Configure direct connection"
                                                    IsEnabled="{Binding CanInstallUnrealEditorPlugin}"
                                                    Click="OnConfigureUnrealBridgeClick" Margin="0,3,7,3" />
                                        </WrapPanel>
                                        <TextBlock Text="Installation is local to this Unreal project. Existing plugin files are moved into a recoverable backup before an update."
                                                   Classes="muted" FontSize="9.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                            <GridSplitter Grid.Column="1" Width="7" Background="#45484E"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                            <Border Grid.Column="2" Classes="card">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="9">
                                        <TextBlock Text="Private editor bridge" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding UnrealBridgeSummary}" Foreground="#78D7B7" TextWrapping="Wrap" />
                                        <Border Height="1" Background="#45484E" />
                                        <TextBlock Text="Connection model" FontWeight="SemiBold" />
                                        <TextBlock Text="• Loopback-only listener; no public editor port." TextWrapping="Wrap" />
                                        <TextBlock Text="• Random token stored under Saved/CyRevision and excluded from Git." TextWrapping="Wrap" />
                                        <TextBlock Text="• Unreal plugin works alone for revision status, Git actions and advisory reservations." TextWrapping="Wrap" />
                                        <TextBlock Text="• Direct CyRevision connection adds refresh, Git LFS, Sync, backup and extended asset providers." TextWrapping="Wrap" />
                                        <Border Background="#10241F" CornerRadius="5" Padding="9" Margin="0,6,0,0">
                                            <TextBlock Text="Preview and diff providers registered by this plugin are available everywhere in CyRevision: explorer, changes, history, commits, pull requests and asset comparison."
                                                       Foreground="#78D7B7" FontSize="10" TextWrapping="Wrap" />
                                        </Border>
                                        <Border Height="1" Background="#45484E" Margin="0,5" />
                                        <StackPanel Spacing="7">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Advanced asset previews and Blueprint diffs" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="Optional · disabled by default · previews and semantic Blueprint diffs are generated on demand"
                                                           Classes="muted" FontSize="9.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <CheckBox Content="Enable advanced Unreal asset inspection"
                                                      IsChecked="{Binding UnrealAdvancedAssetInspectionEnabled}"
                                                      IsEnabled="{Binding CanConfigureUnrealAssetInspection}" />
                                            <CheckBox Content="Render neutral mesh thumbnails"
                                                      IsChecked="{Binding UnrealRenderMeshThumbnails}"
                                                      IsEnabled="{Binding CanConfigureUnrealAssetInspection}" />
                                            <Grid ColumnDefinitions="Auto,82,18,Auto,82" ColumnSpacing="7">
                                                <TextBlock Text="Preview" Classes="muted" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding UnrealAssetPreviewResolution}"
                                                         PlaceholderText="512" HorizontalContentAlignment="Right"
                                                         IsEnabled="{Binding CanConfigureUnrealAssetInspection}" />
                                                <TextBlock Grid.Column="2" Text="px" Classes="muted" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="Cache" Classes="muted" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="4" Text="{Binding UnrealAssetCacheBudgetGigabytes}"
                                                         PlaceholderText="2 GB" HorizontalContentAlignment="Right"
                                                         IsEnabled="{Binding CanConfigureUnrealAssetInspection}" />
                                            </Grid>
                                            <TextBlock Text="512 px is recommended for fast mesh review. Blueprint graphs, nodes, pins and variables are compared semantically. Generated data stays under .cyrevision/cache/unreal-assets and is trimmed to the configured budget."
                                                       Classes="muted" FontSize="9.5" TextWrapping="Wrap" />
                                            <Border Background="#111820" BorderBrush="#394655" BorderThickness="1"
                                                    CornerRadius="4" Padding="8">
                                                <TextBlock Text="{Binding UnrealAssetInspectionSummary}" FontSize="10"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Classes="primary" Content="Save preview settings"
                                                        IsEnabled="{Binding CanConfigureUnrealAssetInspection}"
                                                        Click="OnSaveUnrealAssetInspectionClick" Margin="0,2,7,2" />
                                                <Button Classes="secondary" Content="Refresh cache status"
                                                        IsEnabled="{Binding CanConfigureUnrealAssetInspection}"
                                                        Click="OnRefreshUnrealAssetInspectionClick" Margin="0,2,7,2" />
                                                <Button Classes="danger" Content="Clear cache…"
                                                        IsEnabled="{Binding CanConfigureUnrealAssetInspection}"
                                                        Click="OnClearUnrealAssetInspectionClick" Margin="0,2,7,2" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="UnrealBuildWorkspaceTab" Header="Unreal builds">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Unreal local build lab" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Auto-detect project and plugin targets, validate toolchains, then test one or several Unreal versions."
                                               Classes="muted" FontSize="10" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="secondary" Content="Discover" Click="OnDiscoverUnrealBuildClick" />
                                <Button Grid.Column="2" Classes="primary" Content="Build selected"
                                        IsEnabled="{Binding CanRunUnrealBuild}" Click="OnRunUnrealBuildClick" />
                                <Button Grid.Column="3" Classes="secondary" Content="Cancel"
                                        IsEnabled="{Binding IsUnrealBuildRunning}" Click="OnCancelUnrealBuildClick" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Classes="card" Padding="9">
                            <Grid ColumnDefinitions="1.15*,1*,1*,1*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                <StackPanel>
                                    <TextBlock Text="Build target" Classes="muted" FontSize="9" />
                                    <ComboBox ItemsSource="{Binding UnrealBuildTargets}" SelectedItem="{Binding SelectedUnrealBuildTarget}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Engine" Classes="muted" FontSize="9" />
                                    <ComboBox ItemsSource="{Binding UnrealBuildEngines}" SelectedItem="{Binding SelectedUnrealBuildEngine}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Version, StringFormat='UE {0}'}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Platform" Classes="muted" FontSize="9" />
                                    <ComboBox ItemsSource="{Binding UnrealBuildPlatforms}" SelectedItem="{Binding SelectedUnrealBuildPlatform}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Configuration" Classes="muted" FontSize="9" />
                                    <ComboBox ItemsSource="{Binding UnrealBuildConfigurations}" SelectedItem="{Binding SelectedUnrealBuildConfiguration}" />
                                </StackPanel>

                                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox Text="{Binding UnrealLinuxToolchainPath}" PlaceholderText="Linux cross-compiler / LINUX_MULTIARCH_ROOT" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Browse..." Click="OnPickUnrealLinuxToolchainClick" />
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox Text="{Binding UnrealAndroidSdkPath}" PlaceholderText="Android SDK root" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Browse..." Click="OnPickUnrealAndroidSdkClick" />
                                </Grid>

                                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox Text="{Binding UnrealBuildOutputPath}" PlaceholderText="Build output directory" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Browse..." Click="OnPickUnrealBuildOutputClick" />
                                </Grid>
                                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <CheckBox Content="Auto-configure toolchains" IsChecked="{Binding UnrealBuildAutoConfigureToolchains}" />
                                    <CheckBox Content="Cook &amp; package" IsChecked="{Binding UnrealBuildCookAndPackage}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="Timeout" VerticalAlignment="Center" Classes="muted" />
                                    <TextBox Width="58" Text="{Binding UnrealBuildTimeoutMinutes}" />
                                    <TextBlock Text="min" VerticalAlignment="Center" Classes="muted" />
                                    <TextBlock Text="Parallel" VerticalAlignment="Center" Classes="muted" Margin="8,0,0,0" />
                                    <TextBox Width="38" Text="{Binding UnrealBuildMaximumParallel}" />
                                </StackPanel>

                                <TextBox Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding UnrealAndroidNdkPath}"
                                         PlaceholderText="Android NDK root (optional override)" />
                                <TextBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding UnrealJavaHomePath}"
                                         PlaceholderText="JAVA_HOME (optional override)" />

                                <Grid Grid.Row="4" Grid.ColumnSpan="4" ColumnDefinitions="Auto,150,Auto,150,Auto,*" ColumnSpacing="6">
                                    <TextBlock Text="Version range" VerticalAlignment="Center" Classes="muted" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding UnrealBuildEngines}" SelectedItem="{Binding UnrealBuildRangeFrom}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Version, StringFormat='UE {0}'}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Column="2" Text="to" VerticalAlignment="Center" Classes="muted" />
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding UnrealBuildEngines}" SelectedItem="{Binding UnrealBuildRangeTo}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Version, StringFormat='UE {0}'}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="4" Classes="secondary" Content="Build range" IsEnabled="{Binding CanRunUnrealBuild}"
                                            Click="OnRunUnrealBuildRangeClick" />
                                    <TextBlock Grid.Column="5" Text="{Binding SelectedUnrealBuildEngine.ToolchainSummary}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Classes="muted"
                                               ToolTip.Tip="{Binding SelectedUnrealBuildEngine.ToolchainSummary}" />
                                </Grid>
                                <Grid Grid.Row="5" Grid.ColumnSpan="4" ColumnDefinitions="Auto,180,180,Auto,Auto,Auto,*" ColumnSpacing="6">
                                    <TextBlock Text="Preset" VerticalAlignment="Center" Classes="muted" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding UnrealBuildPresets}"
                                              SelectedItem="{Binding SelectedUnrealBuildPreset}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding PresetName}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Column="2" Text="{Binding UnrealBuildPresetName}" PlaceholderText="Preset name" />
                                    <Button Grid.Column="3" Classes="secondary" Content="Apply" Click="OnApplyUnrealBuildPresetClick" />
                                    <Button Grid.Column="4" Classes="primary" Content="Save preset" Click="OnSaveUnrealBuildPresetClick" />
                                    <Button Grid.Column="5" Classes="danger" Content="Delete" Click="OnDeleteUnrealBuildPresetClick" />
                                    <TextBlock Grid.Column="6" Text="Discovery cache: .cyrevision/cache/unreal" Classes="muted"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" ColumnDefinitions="0.9*,7,1.1*">
                            <Border Classes="card" Padding="0">
                                <Grid RowDefinitions="Auto,0.62*,0.38*">
                                    <StackPanel Margin="9,7" Spacing="2">
                                        <TextBlock Text="Build results" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding UnrealBuildStatus}" Classes="muted" FontSize="9.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding UnrealBuildResults}"
                                              SelectedItem="{Binding SelectedUnrealBuildResult}" Classes="historyCompact"
                                              AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                              GridLinesVisibility="Horizontal" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="OK" Binding="{Binding Succeeded}" Width="42" />
                                            <DataGridTextColumn Header="Engine" Binding="{Binding EngineVersion}" Width="72" />
                                            <DataGridTextColumn Header="Target" Binding="{Binding TargetName}" Width="*" />
                                            <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="76" />
                                            <DataGridTextColumn Header="Exit" Binding="{Binding ExitCode}" Width="48" />
                                            <DataGridTextColumn Header="Warn" Binding="{Binding WarningCount}" Width="48" />
                                            <DataGridTextColumn Header="Error" Binding="{Binding ErrorCount}" Width="48" />
                                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DataGrid Grid.Row="2" ItemsSource="{Binding UnrealBuildDiagnostics}" Classes="historyCompact"
                                              AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                              GridLinesVisibility="Horizontal" Background="#17191D">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Level" Binding="{Binding Severity}" Width="62" />
                                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="64" />
                                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                            <DataGridTextColumn Header="File" Binding="{Binding File}" Width="150" />
                                            <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="52" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <GridSplitter Grid.Column="1" Width="7" Background="#45484E"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                            <Border Grid.Column="2" Classes="card" Padding="0">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid Margin="9,5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <TextBlock Text="Live build log" FontWeight="SemiBold" />
                                        <CheckBox x:Name="AutoScrollUnrealBuildLogCheckBox" Grid.Column="1"
                                                  Content="Auto-scroll" IsChecked="True" FontSize="9.5"
                                                  VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="2" Classes="inlineLoader" Width="140" IsIndeterminate="True"
                                                     IsVisible="{Binding IsUnrealBuildRunning}" />
                                    </Grid>
                                    <ListBox x:Name="UnrealBuildLogList" Grid.Row="1"
                                             ItemsSource="{Binding UnrealBuildLogLines}" Background="#080F21"
                                             BorderThickness="0" Padding="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="MinHeight" Value="16" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="16" ColumnDefinitions="58,54,*" Margin="4,0" ColumnSpacing="4">
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Classes="muted"
                                                               FontFamily="Cascadia Mono,Consolas" FontSize="9"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Stream}" Foreground="#62B0F5"
                                                               FontFamily="Cascadia Mono,Consolas" FontSize="9"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas"
                                                               FontSize="9" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="DiagnosticsWorkspaceTab" Header="Diagnostics">
                    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                        <Border Classes="card" Padding="10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Performance diagnostics" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PerformanceSummary}" Classes="muted" FontSize="10.5" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="secondary" Content="Refresh metrics"
                                        Click="OnRefreshDiagnosticsClick" />
                                <Button Grid.Column="2" Classes="secondary" Content="Clear samples"
                                        Click="OnClearDiagnosticsClick" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding PerformanceMetrics}" Classes="historyCompact"
                                      AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                      GridLinesVisibility="Horizontal" Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="78" />
                                    <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="110" />
                                    <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="2*" />
                                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100" />
                                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Grid.Row="2" Background="#172C2A" BorderBrush="#326A62" BorderThickness="1"
                                CornerRadius="5" Padding="9">
                            <TextBlock Text="Project Git snapshots are stored under .cyrevision/cache. The folder excludes itself from Git, file watching and code indexing. Runtime samples are memory-only and capped at 250 entries."
                                       Foreground="#78D7B7" FontSize="10" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="HelpWorkspaceTab" Header="Aide">
                    <Grid Margin="0,8,0,0" ColumnDefinitions="310,*" ColumnSpacing="8">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                                <StackPanel>
                                    <TextBlock Text="Guide hors ligne" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Disponible sans navigateur ni connexion réseau."
                                               FontSize="11" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Row="1" Text="{Binding DocumentationSearch}"
                                         PlaceholderText="Rechercher dans la documentation…" />
                                <ListBox Grid.Row="2" ItemsSource="{Binding DocumentationTopics}"
                                         SelectedItem="{Binding SelectedDocumentationTopic}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="7,6" Spacing="3">
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#78D7B7" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Summary}" FontSize="10" Classes="muted"
                                                           TextWrapping="Wrap" MaxHeight="44" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
                            <Border Classes="card" Padding="16">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Mises à jour de CyRevision" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="Canal stable · uniquement les releases GitHub publiées"
                                                   Classes="muted" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Classes="secondary" Content="Vérifier les mises à jour"
                                                IsEnabled="{Binding CanCheckForUpdates}"
                                                Click="OnCheckForUpdatesClick" />
                                        <Button Classes="primary" Content="Télécharger et installer"
                                                IsVisible="{Binding HasUpdateAvailable}"
                                                IsEnabled="{Binding CanInstallUpdate}"
                                                Click="OnInstallUpdateClick" />
                                        <Button Classes="secondary" Content="Voir la release"
                                                IsVisible="{Binding HasUpdateAvailable}"
                                                Click="OnOpenUpdateReleaseClick" />
                                    </StackPanel>

                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,Auto,20,*" ColumnSpacing="7">
                                        <TextBlock Text="Version installée" Classes="muted" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentApplicationVersion}"
                                                   Foreground="#78D7B7" FontWeight="SemiBold" />
                                        <Border Grid.Column="2" Background="#49381E" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="ALPHA" Foreground="#FFD479" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{Binding UpdateStatus}"
                                                   TextWrapping="Wrap" FontSize="11" />
                                    </Grid>

                                    <Grid Grid.Row="2" Grid.ColumnSpan="2" RowDefinitions="Auto,Auto" RowSpacing="5">
                                    <ProgressBar Classes="inlineLoader" Minimum="0" Maximum="100" Value="{Binding UpdateProgress}"
                                                 IsVisible="{Binding IsDownloadingUpdate}" />
                                        <TextBlock Grid.Row="1" Text="{Binding UpdateReleaseNotes}"
                                                   IsVisible="{Binding HasUpdateAvailable}"
                                                   MaxHeight="42" TextTrimming="CharacterEllipsis"
                                                   Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Classes="card">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel MaxWidth="860" HorizontalAlignment="Left" Spacing="11" Margin="4">
                                        <TextBlock Text="{Binding SelectedDocumentationTopic.Category}"
                                                   FontSize="11" Foreground="#78D7B7" />
                                        <TextBlock Text="{Binding SelectedDocumentationTopic.Title}"
                                                   FontSize="25" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedDocumentationTopic.Summary}"
                                                   FontSize="13" Foreground="#B8C1D8" TextWrapping="Wrap" />
                                        <Border Height="1" Background="#29324A" Margin="0,5,0,7" />
                                        <TextBlock Text="{Binding SelectedDocumentationTopic.Body}"
                                                   FontSize="12" LineHeight="20" TextWrapping="Wrap" />
                                        <Border Background="#10241F" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                            <TextBlock Text="Cette documentation est livrée avec CyRevision et reste accessible hors ligne."
                                                       FontSize="11" Foreground="#78D7B7" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <views:GlobalActivityCenterView Grid.Row="3" Grid.Column="1" Margin="10,0,10,5" />
        <views:ApplicationStatusBarView Grid.Row="4" Grid.Column="1" />
    </Grid>
</Window>
