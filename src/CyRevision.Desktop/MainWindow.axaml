<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        x:Class="CyRevision.Desktop.MainWindow"
        Title="CyRevision"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        x:CompileBindings="False"
        Background="#0B1020">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#6D5EF5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#202941" />
            <Setter Property="Foreground" Value="#E7EAF2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="13,8" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#3B2029" />
            <Setter Property="Foreground" Value="#FF9BAB" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="11,7" />
        </Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#8D96AC" /></Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#141B2D" />
            <Setter Property="BorderBrush" Value="#29324A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="#101729" />
            <Setter Property="BorderBrush" Value="#303A55" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="64,*,40" ColumnDefinitions="270,*">
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#10172A" BorderBrush="#252E45" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="252,*,Auto" Margin="18,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#6D5EF5">
                        <TextBlock Text="C" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="CyRevision" VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentBranch}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RepositoryPath}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="secondary" Content="Ajouter un dossier" Click="OnAddFolderClick" />
                    <Button Classes="secondary" Content="Ouvrir un dépôt" Click="OnAddExistingClick" />
                    <Button Classes="primary" Content="Créer un dépôt" Click="OnCreateGitClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Background="#10172A" BorderBrush="#252E45" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Margin="14,18">
                <Grid ColumnDefinitions="*,Auto" Margin="8,0,4,10">
                    <TextBlock Text="PROJETS" FontSize="10" FontWeight="Bold" Classes="muted" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="danger" Content="Retirer" Click="OnRemoveProjectClick" IsEnabled="{Binding HasSelectedProject}" />
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <Border Grid.Column="1" Background="#242C47" CornerRadius="5" Padding="6,2">
                                    <TextBlock Text="{Binding Mode}" FontSize="10" Foreground="#B8C1D8" />
                                </Border>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding RootPath}" FontSize="10" Classes="muted" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Background="#151D31" CornerRadius="10" Padding="13">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#758098" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SyncState}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding SyncDetails}" TextWrapping="Wrap" FontSize="11" Classes="muted" />
                        <TextBlock Text="Syncthing personnel non géré" FontSize="11" Foreground="#78D7B7" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="24,18" RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding ChangeSummary}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="{Binding ToolStatus}" FontSize="11" Classes="muted" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Button Classes="secondary" Content="Actualiser" Click="OnRefreshClick" />
                    <Button Classes="secondary" Content="Fetch" Click="OnFetchClick" />
                    <Button Classes="secondary" Content="Pull" Click="OnPullClick" />
                    <Button Classes="primary" Content="Push" Click="OnPushClick" />
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1">
                <TabItem Header="Projet">
                    <Grid Margin="0,14,0,0" ColumnDefinitions="1.15*,1*" ColumnSpacing="14">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Mode de fonctionnement" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Chaque module reste indépendant : Git peut fonctionner sans Sync et inversement." TextWrapping="Wrap" Classes="muted" />
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Classes="muted" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Classes="primary" Content="Appliquer ce mode" Click="OnApplyPresetClick" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <StackPanel Spacing="9">
                                <TextBlock Text="Profils disponibles" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Git uniquement" FontWeight="SemiBold" />
                                <TextBlock Text="Git + Sync" FontWeight="SemiBold" />
                                <TextBlock Text="Sync uniquement" FontWeight="SemiBold" />
                                <TextBlock Text="Sync + versions" FontWeight="SemiBold" />
                                <TextBlock Text="Backup uniquement" FontWeight="SemiBold" />
                                <Border Height="1" Background="#29324A" Margin="0,7" />
                                <TextBlock Text="Changer de profil ne supprime jamais les données déjà stockées." TextWrapping="Wrap" FontSize="11" Foreground="#78D7B7" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Modifications">
                    <Grid Margin="0,14,0,0" ColumnDefinitions="1.05*,1.35*" RowDefinitions="*,Auto" ColumnSpacing="14" RowSpacing="14">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                                    <Button Classes="secondary" Content="Tout indexer" Click="OnStageAllClick" />
                                    <Button Classes="secondary" Content="Retirer de l'index" Click="OnUnstageAllClick" />
                                </StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange}"
                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Fichier" Binding="{Binding Path}" Width="*" />
                                        <DataGridTextColumn Header="État" Binding="{Binding State}" Width="90" />
                                        <DataGridTextColumn Header="Zone" Binding="{Binding Area}" Width="75" />
                                        <DataGridTextColumn Header="" Binding="{Binding Lfs}" Width="45" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Text="Diff" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBox Grid.Row="1" Text="{Binding DiffText}" IsReadOnly="True" AcceptsReturn="True"
                                         FontFamily="Cascadia Mono,Consolas" FontSize="12" TextWrapping="NoWrap"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="card">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                <TextBlock Text="Nouvelle révision" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Text="{Binding CommitMessage}" PlaceholderText="Décrire clairement les changements…" Margin="0,8,0,0" />
                                <Button Grid.Row="1" Grid.Column="1" Classes="primary" Content="Créer la révision" Click="OnCommitClick" Margin="0,8,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Historique">
                    <Border Margin="0,14,0,0" Classes="card">
                        <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Révision" Binding="{Binding ShortHash}" Width="90" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Subject}" Width="*" />
                                <DataGridTextColumn Header="Auteur" Binding="{Binding AuthorName}" Width="160" />
                                <DataGridTextColumn Header="Date" Binding="{Binding AuthoredAt}" Width="190" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>

                <TabItem Header="Branches">
                    <Grid Margin="0,14,0,0" ColumnDefinitions="1.1*,1*" ColumnSpacing="14">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Text="Branches locales" FontSize="16" FontWeight="SemiBold" />
                                <ListBox Grid.Row="1" Margin="0,12" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="6">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding ShortCommitHash}" Classes="muted" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="2" Classes="secondary" Content="Basculer sur la branche" Click="OnCheckoutBranchClick" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Créer une branche" FontSize="16" FontWeight="SemiBold" />
                                <TextBox x:Name="NewBranchName" PlaceholderText="feature/nom" />
                                <Button Classes="primary" Content="Créer et basculer" Click="OnCreateBranchClick" HorizontalAlignment="Left" />
                                <Border Height="1" Background="#29324A" Margin="0,10" />
                                <TextBlock Text="Remote standard" FontSize="16" FontWeight="SemiBold" />
                                <TextBox Text="{Binding RemoteUrl}" PlaceholderText="ssh://, https:// ou chemin local" />
                                <Button Classes="secondary" Content="Enregistrer origin" Click="OnSaveRemoteClick" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Git LFS">
                    <Grid Margin="0,14,0,0" ColumnDefinitions="1.2*,1*" ColumnSpacing="14">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Text="Motifs suivis par Git LFS" FontSize="16" FontWeight="SemiBold" />
                                <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding LfsPatterns}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="6">
                                                <TextBlock Text="{Binding Pattern}" FontFamily="Cascadia Mono,Consolas" />
                                                <TextBlock Grid.Column="1" Text="{Binding SourceFile}" Classes="muted" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Ajouter un motif" FontSize="16" FontWeight="SemiBold" />
                                <TextBox Text="{Binding LfsPattern}" PlaceholderText="*.uasset" />
                                <Button Classes="primary" Content="Suivre avec Git LFS" Click="OnTrackLfsClick" HorizontalAlignment="Left" />
                                <TextBlock Text="Les changements de .gitattributes seront automatiquement placés dans l'index." TextWrapping="Wrap" FontSize="11" Classes="muted" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Sauvegardes">
                    <Grid Margin="0,14,0,0" ColumnDefinitions="1.25*,1*" ColumnSpacing="14">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="Snapshots disponibles" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Les données identiques ne sont stockées qu'une fois." FontSize="11" Classes="muted" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="primary" Content="Sauvegarder maintenant" Click="OnCreateBackupClick" />
                                </Grid>
                                <DataGrid Grid.Row="1" Margin="0,12" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt}" Width="*" />
                                        <DataGridTextColumn Header="ID" Binding="{Binding ShortId}" Width="90" />
                                        <DataGridTextColumn Header="Taille" Binding="{Binding LogicalSize}" Width="90" />
                                        <DataGridTextColumn Header="Ajouté" Binding="{Binding StoredSize}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Grid.Row="2" Classes="secondary" Content="Restaurer la sélection dans…" Click="OnRestoreBackupClick" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <ScrollViewer>
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Stockage et conservation" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Emplacement local, volume réseau monté ou dossier NAS" FontSize="11" Classes="muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Text="{Binding BackupStorePath}" IsReadOnly="True" PlaceholderText="Emplacement par défaut CyRevision" />
                                        <Button Grid.Column="1" Classes="secondary" Content="Choisir…" Click="OnPickBackupStoreClick" />
                                    </Grid>
                                    <TextBlock Text="Mode de rétention" Margin="0,7,0,0" />
                                    <ComboBox ItemsSource="{Binding RetentionModes}" SelectedItem="{Binding SelectedRetentionMode}" />
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Versions max." FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding RetentionVersions}" PlaceholderText="30" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Âge max. (jours)" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding RetentionDays}" PlaceholderText="90" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Budget (Go)" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding RetentionBudgetGb}" PlaceholderText="illimité" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Classes="primary" Content="Enregistrer la stratégie" Click="OnSaveBackupSettingsClick" HorizontalAlignment="Left" Margin="0,7,0,0" />
                                    <TextBlock Text="La restauration refuse d'écraser des fichiers existants afin de protéger le projet courant." TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Synchronisation">
                    <Grid Margin="0,14,0,0" ColumnDefinitions="1*,1.25*" ColumnSpacing="14">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Instance Syncthing CyRevision" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SyncState}" FontSize="14" FontWeight="SemiBold" Foreground="#78D7B7" />
                                <TextBlock Text="{Binding SyncDetails}" TextWrapping="Wrap" Classes="muted" />
                                <TextBlock Text="Exécutable" Margin="0,7,0,0" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding SyncthingExecutablePath}" IsReadOnly="True" PlaceholderText="Non configuré" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Choisir…" Click="OnPickSyncthingClick" />
                                </Grid>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="primary" Content="Démarrer" Click="OnStartSyncClick" Margin="0,4,7,4" />
                                    <Button Classes="secondary" Content="Pause" Click="OnPauseSyncClick" Margin="0,4,7,4" />
                                    <Button Classes="secondary" Content="Reprendre" Click="OnResumeSyncClick" Margin="0,4,7,4" />
                                    <Button Classes="danger" Content="Arrêter" Click="OnStopSyncClick" Margin="0,4,7,4" />
                                </WrapPanel>
                                <Border Background="#10241F" CornerRadius="8" Padding="11" Margin="0,8,0,0">
                                    <TextBlock Text="CyRevision utilise ses propres dossiers config/data, une API locale dédiée et ne recherche ni n'arrête les autres processus Syncthing." TextWrapping="Wrap" FontSize="11" Foreground="#78D7B7" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,Auto,*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Admission sécurisée des pairs" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Échanges signés, invitation à usage unique et code de vérification." TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,105,*" ColumnSpacing="8" Margin="0,10,0,8">
                                    <ComboBox ItemsSource="{Binding PeerRoles}" SelectedItem="{Binding SelectedPeerRole}" MinWidth="145" />
                                    <TextBox Grid.Column="1" Text="{Binding PeerVerificationCode}" PlaceholderText="Code" />
                                    <Button Grid.Column="2" Classes="primary" Content="Créer une invitation (24 h)" Click="OnCreateInvitationClick" HorizontalAlignment="Left" />
                                </Grid>
                                <TextBox Grid.Row="2" Text="{Binding PeerExchangeText}" AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Cascadia Mono,Consolas" FontSize="11" PlaceholderText="Collez ici une invitation, une demande ou un certificat…"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Classes="secondary" Content="Préparer la demande" Click="OnPrepareJoinRequestClick" Margin="0,3,7,3" />
                                    <Button Classes="secondary" Content="Approuver la demande" Click="OnApproveJoinRequestClick" Margin="0,3,7,3" />
                                    <Button Classes="primary" Content="Importer le certificat" Click="OnImportMembershipGrantClick" Margin="0,3,7,3" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Grid.Column="1" Background="#0E1526" BorderBrush="#252E45" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="16,0">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11" Classes="muted" />
                <TextBlock Grid.Column="1" Text="Git actif · Sync sur demande" VerticalAlignment="Center" FontSize="11" Foreground="#78D7B7" />
            </Grid>
        </Border>
    </Grid>
</Window>
