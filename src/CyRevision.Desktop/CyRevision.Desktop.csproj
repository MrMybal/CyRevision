<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Branding\cyrevision.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CyRevision.Backup\CyRevision.Backup.csproj" />
    <ProjectReference Include="..\CyRevision.Code\CyRevision.Code.csproj" />
    <ProjectReference Include="..\CyRevision.Core\CyRevision.Core.csproj" />
    <ProjectReference Include="..\CyRevision.Discord\CyRevision.Discord.csproj" />
    <ProjectReference Include="..\CyRevision.Discord.Control\CyRevision.Discord.Control.csproj" />
    <ProjectReference Include="..\CyRevision.Diff\CyRevision.Diff.csproj" />
    <ProjectReference Include="..\CyRevision.Git\CyRevision.Git.csproj" />
    <ProjectReference Include="..\CyRevision.Plugin.Abstractions\CyRevision.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\CyRevision.Plugin.Unreal\CyRevision.Plugin.Unreal.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CyRevision.Plugin.Unity\CyRevision.Plugin.Unity.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CyRevision.Plugin.Godot\CyRevision.Plugin.Godot.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CyRevision.Plugin.Lore\CyRevision.Plugin.Lore.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CyRevision.Plugin.Perforce\CyRevision.Plugin.Perforce.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CyRevision.Plugin.AI\CyRevision.Plugin.AI.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CyRevision.Plugin.Jira\CyRevision.Plugin.Jira.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CyRevision.Plugin.ClickUp\CyRevision.Plugin.ClickUp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CyRevision.PullRequests\CyRevision.PullRequests.csproj" />
    <ProjectReference Include="..\CyRevision.RemoteBuild\CyRevision.RemoteBuild.csproj" />
    <ProjectReference Include="..\CyRevision.Security\CyRevision.Security.csproj" />
    <ProjectReference Include="..\CyRevision.Sync\CyRevision.Sync.csproj" />
    <ProjectReference Include="..\CyRevision.Vpn\CyRevision.Vpn.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Localization\Locales\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Documentation\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="VpnRuntime\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="SyncthingRuntime\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\plugins\CyRevision.UnrealIntegration\cyrevision-plugin.json"
          Link="Plugins\CyRevision.UnrealIntegration\cyrevision-plugin.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\plugins\CyRevision.AIIntegration\cyrevision-plugin.json"
          Link="Plugins\CyRevision.AIIntegration\cyrevision-plugin.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\plugins\CyRevision.UnityIntegration\cyrevision-plugin.json"
          Link="Plugins\CyRevision.UnityIntegration\cyrevision-plugin.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\plugins\CyRevision.GodotIntegration\cyrevision-plugin.json"
          Link="Plugins\CyRevision.GodotIntegration\cyrevision-plugin.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\plugins\CyRevision.LoreIntegration\cyrevision-plugin.json"
          Link="Plugins\CyRevision.LoreIntegration\cyrevision-plugin.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\plugins\CyRevision.PerforceIntegration\cyrevision-plugin.json"
          Link="Plugins\CyRevision.PerforceIntegration\cyrevision-plugin.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\plugins\CyRevision.JiraIntegration\cyrevision-plugin.json"
          Link="Plugins\CyRevision.JiraIntegration\cyrevision-plugin.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\plugins\CyRevision.ClickUpIntegration\cyrevision-plugin.json"
          Link="Plugins\CyRevision.ClickUpIntegration\cyrevision-plugin.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\plugins\CyRevisionUnreal\**\*"
          Exclude="..\..\plugins\CyRevisionUnreal\Binaries\**\*;..\..\plugins\CyRevisionUnreal\Intermediate\**\*;..\..\plugins\CyRevisionUnreal\Saved\**\*"
          Link="PluginPayloads\Unreal\CyRevisionUnreal\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\plugins\CyRevisionUnity\**\*"
          Link="PluginPayloads\Unity\CyRevisionUnity\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\plugins\CyRevisionGodot\**\*"
          Link="PluginPayloads\Godot\CyRevisionGodot\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\plugins\CyRevisionLore\**\*"
          Exclude="..\..\plugins\CyRevisionLore\Binaries\**\*;..\..\plugins\CyRevisionLore\Intermediate\**\*;..\..\plugins\CyRevisionLore\Saved\**\*"
          Link="PluginPayloads\Lore\CyRevisionLore\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <Target Name="CopyCyRevisionPluginAssembliesToOutput" AfterTargets="Build">
    <PropertyGroup>
      <UnrealPluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.Unreal\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.Unreal.dll</UnrealPluginAssembly>
      <UnityPluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.Unity\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.Unity.dll</UnityPluginAssembly>
      <GodotPluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.Godot\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.Godot.dll</GodotPluginAssembly>
      <AiPluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.AI\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.AI.dll</AiPluginAssembly>
      <LorePluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.Lore\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.Lore.dll</LorePluginAssembly>
      <PerforcePluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.Perforce\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.Perforce.dll</PerforcePluginAssembly>
      <JiraPluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.Jira\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.Jira.dll</JiraPluginAssembly>
      <ClickUpPluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.ClickUp\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.ClickUp.dll</ClickUpPluginAssembly>
    </PropertyGroup>
    <MakeDir Directories="$(OutDir)Plugins\CyRevision.UnrealIntegration" />
    <Copy SourceFiles="$(UnrealPluginAssembly)"
          DestinationFolder="$(OutDir)Plugins\CyRevision.UnrealIntegration"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)Plugins\CyRevision.UnityIntegration" />
    <Copy SourceFiles="$(UnityPluginAssembly)"
          DestinationFolder="$(OutDir)Plugins\CyRevision.UnityIntegration"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)Plugins\CyRevision.GodotIntegration" />
    <Copy SourceFiles="$(GodotPluginAssembly)"
          DestinationFolder="$(OutDir)Plugins\CyRevision.GodotIntegration"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)Plugins\CyRevision.AIIntegration" />
    <Copy SourceFiles="$(AiPluginAssembly)"
          DestinationFolder="$(OutDir)Plugins\CyRevision.AIIntegration"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)Plugins\CyRevision.LoreIntegration" />
    <Copy SourceFiles="$(LorePluginAssembly)"
          DestinationFolder="$(OutDir)Plugins\CyRevision.LoreIntegration"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)Plugins\CyRevision.PerforceIntegration" />
    <Copy SourceFiles="$(PerforcePluginAssembly)"
          DestinationFolder="$(OutDir)Plugins\CyRevision.PerforceIntegration"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)Plugins\CyRevision.JiraIntegration" />
    <Copy SourceFiles="$(JiraPluginAssembly)"
          DestinationFolder="$(OutDir)Plugins\CyRevision.JiraIntegration"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)Plugins\CyRevision.ClickUpIntegration" />
    <Copy SourceFiles="$(ClickUpPluginAssembly)"
          DestinationFolder="$(OutDir)Plugins\CyRevision.ClickUpIntegration"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCyRevisionPluginAssembliesToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <UnrealPluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.Unreal\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.Unreal.dll</UnrealPluginAssembly>
      <UnityPluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.Unity\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.Unity.dll</UnityPluginAssembly>
      <GodotPluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.Godot\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.Godot.dll</GodotPluginAssembly>
      <AiPluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.AI\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.AI.dll</AiPluginAssembly>
      <LorePluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.Lore\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.Lore.dll</LorePluginAssembly>
      <PerforcePluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.Perforce\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.Perforce.dll</PerforcePluginAssembly>
      <JiraPluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.Jira\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.Jira.dll</JiraPluginAssembly>
      <ClickUpPluginAssembly>$(MSBuildProjectDirectory)\..\CyRevision.Plugin.ClickUp\bin\$(Configuration)\$(TargetFramework)\CyRevision.Plugin.ClickUp.dll</ClickUpPluginAssembly>
    </PropertyGroup>
    <MakeDir Directories="$(PublishDir)Plugins\CyRevision.UnrealIntegration" />
    <Copy SourceFiles="$(UnrealPluginAssembly)"
          DestinationFolder="$(PublishDir)Plugins\CyRevision.UnrealIntegration"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(PublishDir)Plugins\CyRevision.UnityIntegration" />
    <Copy SourceFiles="$(UnityPluginAssembly)"
          DestinationFolder="$(PublishDir)Plugins\CyRevision.UnityIntegration"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(PublishDir)Plugins\CyRevision.GodotIntegration" />
    <Copy SourceFiles="$(GodotPluginAssembly)"
          DestinationFolder="$(PublishDir)Plugins\CyRevision.GodotIntegration"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(PublishDir)Plugins\CyRevision.AIIntegration" />
    <Copy SourceFiles="$(AiPluginAssembly)"
          DestinationFolder="$(PublishDir)Plugins\CyRevision.AIIntegration"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(PublishDir)Plugins\CyRevision.LoreIntegration" />
    <Copy SourceFiles="$(LorePluginAssembly)"
          DestinationFolder="$(PublishDir)Plugins\CyRevision.LoreIntegration"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(PublishDir)Plugins\CyRevision.PerforceIntegration" />
    <Copy SourceFiles="$(PerforcePluginAssembly)"
          DestinationFolder="$(PublishDir)Plugins\CyRevision.PerforceIntegration"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(PublishDir)Plugins\CyRevision.JiraIntegration" />
    <Copy SourceFiles="$(JiraPluginAssembly)"
          DestinationFolder="$(PublishDir)Plugins\CyRevision.JiraIntegration"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(PublishDir)Plugins\CyRevision.ClickUpIntegration" />
    <Copy SourceFiles="$(ClickUpPluginAssembly)"
          DestinationFolder="$(PublishDir)Plugins\CyRevision.ClickUpIntegration"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
