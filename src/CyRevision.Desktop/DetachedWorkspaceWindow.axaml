<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CyRevision.Desktop.Controls"
        x:Class="CyRevision.Desktop.DetachedWorkspaceWindow"
        x:CompileBindings="False"
        Title="CyRevision Workspace"
        Icon="/Assets/Branding/cyrevision.ico"
        Width="1460" Height="880" MinWidth="850" MinHeight="520"
        Background="#1E1F22" WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Border.toolCard">
            <Setter Property="Background" Value="#25272B" />
            <Setter Property="BorderBrush" Value="#3A3D43" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button.toolButton">
            <Setter Property="Background" Value="#34373D" />
            <Setter Property="Foreground" Value="#DFE1E5" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Button.toolPrimary">
            <Setter Property="Background" Value="#3574F0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#9B9DA3" /></Style>
    </Window.Styles>

    <Grid RowDefinitions="42,*">
        <Border Background="#2B2D30" BorderBrush="#3A3D43" BorderThickness="0,0,0,1" Padding="10,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <Image Source="/Assets/Branding/cyrevision-icon-master.png" Width="24" Height="24" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Detached workspace" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RepositoryPath}" FontSize="9" Classes="muted" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <CheckBox x:Name="AlwaysOnTopToggle" Grid.Column="2" Content="Always on top" VerticalAlignment="Center"
                          Click="OnAlwaysOnTopClick" />
                <Button Grid.Column="3" Classes="toolButton" Content="Close" Click="OnCloseClick" />
            </Grid>
        </Border>

        <TabControl x:Name="DetachedTabs" Grid.Row="1" Margin="9">
            <TabItem x:Name="DetachedHistoryTab" Header="History explorer">
                <Grid Margin="0,7,0,0" RowDefinitions="Auto,*" RowSpacing="7">
                    <Border Classes="toolCard" Padding="8">
                        <Grid ColumnDefinitions="*,Auto,260,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding ExplorerSearch}" Classes="searchBox" PlaceholderText="Search message, author, or hash…" />
                            <TextBlock Grid.Column="1" Text="Compare with" Classes="muted" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedComparisonRevision}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="3" Classes="toolPrimary" Content="Compare A ↔ B" Click="OnCompareHistoryClick" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="0.85*,7,1.05*,7,1.4*">
                        <Border Classes="toolCard" Padding="0" ClipToBounds="True">
                            <Grid RowDefinitions="34,*">
                                <TextBlock Text="Timeline" FontSize="12" FontWeight="SemiBold" Margin="9,0" VerticalAlignment="Center" />
                                <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding History}"
                                          SelectedItem="{Binding SelectedExplorerRevision}" AutoGenerateColumns="False"
                                          IsReadOnly="True" GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Rev" Binding="{Binding ShortHash}" Width="68" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Subject}" Width="*" />
                                        <DataGridTextColumn Header="Author" Binding="{Binding AuthorName}" Width="95" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="7" Background="#45484E" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                        <Border Grid.Column="2" Classes="toolCard" Padding="0" ClipToBounds="True">
                            <Grid RowDefinitions="34,1.2*,30,0.7*">
                                <TextBlock Text="Revision files" FontSize="12" FontWeight="SemiBold" Margin="9,0" VerticalAlignment="Center" />
                                <DataGrid Grid.Row="1" Classes="historyCompact" ItemsSource="{Binding ExplorerFiles}"
                                          SelectedItem="{Binding SelectedExplorerFile}" AutoGenerateColumns="False"
                                          IsReadOnly="True" GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="State" Binding="{Binding Kind}" Width="68" />
                                        <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*" />
                                        <DataGridTextColumn Header="Change" Binding="{Binding ChangeSummary}" Width="82" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="2" Text="File history" FontWeight="SemiBold" FontSize="10.5" Margin="9,0" VerticalAlignment="Center" />
                                <DataGrid Grid.Row="3" Classes="historyCompact" ItemsSource="{Binding ExplorerFileHistory}"
                                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          BorderThickness="0" Background="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Rev" Binding="{Binding Revision.ShortHash}" Width="68" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Revision.Subject}" Width="*" />
                                        <DataGridTextColumn Header="Date" Binding="{Binding Revision.AuthoredAt}" Width="125" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <GridSplitter Grid.Column="3" Width="7" Background="#45484E" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                        <Border Grid.Column="4" Classes="toolCard" Padding="0" ClipToBounds="True">
                            <Grid RowDefinitions="34,*">
                                <Grid Margin="9,0" ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Focused diff" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Read-only" Foreground="#78D7B7" FontSize="9" VerticalAlignment="Center" />
                                </Grid>
                                <controls:CodeDiffView Grid.Row="1" DiffText="{Binding ExplorerDiff}"
                                                       PreviewImage="{Binding ExplorerDiffPreviewImage}"
                                                       PresentationSummary="{Binding ExplorerDiffPresentationSummary}"
                                                       FilePath="{Binding SelectedExplorerFile.Path}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="DetachedCodeTab" Header="Find in Files">
                <Grid Margin="0,7,0,0" RowDefinitions="Auto,*" RowSpacing="7">
                    <Border Classes="toolCard" Padding="8">
                        <Grid ColumnDefinitions="*,150,Auto,Auto" ColumnSpacing="7" RowDefinitions="Auto,Auto,4">
                            <TextBox x:Name="DetachedCodeSearch" Text="{Binding CodeSearchQuery}" Classes="searchBox"
                                     PlaceholderText="Search text, symbol, or pattern…" KeyDown="OnCodeSearchKeyDown" />
                            <TextBox Grid.Column="1" Text="{Binding CodeFilePatterns}" Classes="searchBox" PlaceholderText="*.cs;*.cpp" />
                            <Button Grid.Column="2" Classes="toolPrimary" Content="Search" Click="OnCodeSearchClick" />
                            <Button Grid.Column="3" Classes="toolButton" Content="Cancel" Click="OnCancelCodeSearchClick" />
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="14" Margin="2,6,0,2">
                                <CheckBox Content="Match case" IsChecked="{Binding CodeSearchMatchCase}" />
                                <CheckBox Content="Whole words" IsChecked="{Binding CodeSearchWholeWord}" />
                                <CheckBox Content="Regular expression" IsChecked="{Binding CodeSearchRegex}" />
                                <TextBlock Text="{Binding CodeSearchSummary}" Classes="muted" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ProgressBar Grid.Row="2" Grid.ColumnSpan="4" Classes="inlineLoader" IsVisible="{Binding IsCodeSearchRunning}"
                                         IsIndeterminate="True" Margin="1,1,1,0" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="1.15*,7,1.35*,7,0.8*">
                        <Border Classes="toolCard" Padding="0" ClipToBounds="True">
                            <Grid RowDefinitions="36,30,*">
                                <StackPanel Margin="8,0" VerticalAlignment="Center">
                                    <TextBlock Text="Results" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="Select a match to preview its exact location" Classes="muted" FontSize="8.5" />
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="5,3">
                                    <TextBox Text="{Binding CodeSearchFileFilter, UpdateSourceTrigger=PropertyChanged}" Classes="searchBox"
                                             PlaceholderText="Filter results by file name or path…" Padding="6,2" />
                                    <TextBlock Grid.Column="1" Text="{Binding CodeSearchResultFilterSummary}" Classes="muted"
                                               FontSize="8.5" VerticalAlignment="Center" />
                                </Grid>
                                <ListBox Grid.Row="2" ItemsSource="{Binding FilteredCodeSearchResults}"
                                         SelectedItem="{Binding SelectedCodeSearchResult}"
                                         Classes="compactList"
                                         Background="Transparent" BorderThickness="0" Margin="2"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="21" ColumnDefinitions="44,*,170" ColumnSpacing="6"
                                                  Margin="4,0" ToolTip.Tip="{Binding Location}">
                                                <TextBlock Text="{Binding Position}" Foreground="#7E8799" FontSize="9"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="9.5">
                                                    <Run Text="{Binding PreviewBeforeMatch}" />
                                                    <Run Text="{Binding PreviewMatch}" Foreground="#FFD866" FontWeight="Bold" />
                                                    <Run Text="{Binding PreviewAfterMatch}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="8.5">
                                                    <Run Text="{Binding FileName}" Foreground="#61AFEF" FontWeight="SemiBold" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding DirectoryPath}" Foreground="#7E8799" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="7" Background="#45484E" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                        <Border Grid.Column="2" Classes="toolCard" Padding="0" ClipToBounds="True">
                            <Grid RowDefinitions="34,*">
                                <StackPanel Margin="8,0" VerticalAlignment="Center">
                                    <TextBlock Text="Selected result preview" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CodePreviewSummary}" FontSize="8.5" Classes="muted" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            <Grid Grid.Row="1">
                                <Image Source="{Binding CodePreviewImage}" IsVisible="{Binding CodePreviewIsImage}"
                                       Stretch="Uniform" Margin="12" />
                                <controls:SyntaxHighlightedCodeView x:Name="DetachedCodePreview"
                                                                    Text="{Binding CodePreviewText}"
                                                                    IsVisible="{Binding CodePreviewIsText}"
                                                                    FilePath="{Binding CodePreviewPath}"
                                                                    TargetFilePath="{Binding SelectedCodeSearchResult.RelativePath}"
                                                                    TargetLine="{Binding SelectedCodeSearchResult.LineNumber}"
                                                                    TargetColumn="{Binding SelectedCodeSearchResult.ColumnNumber}"
                                                                    TargetLength="{Binding SelectedCodeSearchResult.MatchText.Length}" />
                            </Grid>
                            </Grid>
                        </Border>
                        <GridSplitter Grid.Column="3" Width="7" Background="#45484E" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                        <Border Grid.Column="4" Classes="toolCard" Padding="0" ClipToBounds="True">
                            <TabControl>
                                <TabItem Header="Git history">
                                    <DataGrid Classes="historyCompact" ItemsSource="{Binding CodeHistory}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Rev" Binding="{Binding ShortHash}" Width="65" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Subject}" Width="*" />
                                            <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Symbols">
                                    <DataGrid Classes="historyCompact" ItemsSource="{Binding CodeSymbols}" SelectedItem="{Binding SelectedCodeSymbol}"
                                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                              BorderThickness="0" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="72" />
                                            <DataGridTextColumn Header="Symbol" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="55" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="DetachedCompositionTab" Header="Revision composition">
                <controls:RevisionCompositionView x:Name="DetachedCompositionView" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
