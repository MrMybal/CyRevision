* text=auto

*.sln text eol=crlf
*.cs text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.axaml text eol=crlf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.cpp text eol=crlf
*.h text eol=crlf
*.Build.cs text eol=crlf
*.uplugin text eol=lf
*.ini text eol=crlf
# Preserve the generated reader's checksums across platform checkouts.
Documentation/**/*.js text eol=lf
Documentation/**/*.css text eol=lf
Documentation/**/*.svg text eol=lf
Documentation/**/*.txt text eol=lf
Documentation/Documentation.html text eol=lf
Dockerfile text eol=lf
# Vendored snapshots retain exact upstream bytes for the dependency lock.
native/vendor/CyUI/** -text
